{
  "_comment": "An example project. docs/config.md describes each key.",
  "project": "widget",
  "repo": "example/widget",
  "owner": "example-owner",
  "default_branch": "main",
  "host": "build.example.org",
  "key_dir": "~/agent-keys/widget",
  "naming": {"app_slug_suffix": "widgetagent", "session_prefix": "Widget"},
  "agents": {
    "LeadDev": {"app_id": 101, "installation_id": 201},
    "Reviewer": {"app_id": 102, "installation_id": 202, "kind": "reviewer",
                 "reviews": ["docs/**", "tools/**", "src/core/**"]},
    "UIDev": {"app_id": 103, "installation_id": 203},
    "UIReviewer": {"app_id": null, "installation_id": null,
                   "kind": "reviewer", "reviews": ["web/**"]},
    "Helper": {"app_id": 104, "installation_id": 204,
               "slug": "helperbot", "session_name": "Helper",
               "key": "helper.2026.pem"}
  },
  "machinery": {
    "Merger": {"app_id": 105, "installation_id": 205}
  },
  "labels": {"owner_prefix": "Owner:", "status_prefix": "Status:",
             "waiting_on_owner": "Status:waiting-owner",
             "waiting_external": "Status:waiting-external"},
  "checks": {
    "context": "vm/build-and-test", "poster": "Merger", "slots": 2,
    "memory_max": "16G", "step_timeout_minutes": 30, "merger_first": false,
    "steps": [
      {"name": "web dependencies", "run": ["npm", "ci", "--prefix", "web"],
       "only_if": "web/package.json"},
      {"name": "fmt-check", "run": ["make", "fmt-check"]},
      {"name": "vet", "run": ["make", "vet"]},
      {"name": "test", "run": ["make", "test"]},
      {"name": "doc-check", "run": ["make", "doc-check"]}
    ],
    "caches": {"CARGO_TARGET_DIR": "cargo-target"}
  },
  "merge": {"merger": "Merger", "ci_workflow": "ci", "stall_minutes": 30,
            "gate": [["forge-closing-keywords", "--pr", "{pr}", "--include-subject"],
                     ["forge-commit-identity", "{base}..{head}"]],
            "stall_alert": {"tell": ["LeadDev", "Reviewer"],
                            "retell_minutes": 60, "owner_after_minutes": 120,
                            "title": "forge-merger: the queue is stalled on #{pr}",
                            "labels": ["bug", "Owner:LeadDev"]}},
  "closing_keywords": {"enforced_by": "the Merger",
                       "rerun": "run the check again (the Merger does, on its next tick)"},
  "docs": {"paths": ["README.md", "docs"], "width": 80, "roles": "docs/roles.md"},
  "identity": {"unattributed_domain": "@build.example.org",
               "unattributed_name": "Anonymous Agent"},
  "host_settings": {
    "files": [
      {"from": "tools/host/claude-settings.json", "to": ".claude/settings.json",
       "mode": "0644", "json": true},
      {"from": "tools/host/session-start-hook", "to": ".claude/hooks/session-start",
       "mode": "0755"}
    ],
    "host_keys": ["skipWorkflowUsageWarning"]
  },
  "receiver": {
    "address": "0.0.0.0", "port": 8789, "path": "/hook",
    "secret_file": "~/.config/agent-forge/widget/receiver-secret",
    "max_body": 1048576,
    "ticks": {"pull_request": [["forge-pr-check", "--post"]],
              "pull_request_review": ["forge-merger"],
              "status": ["forge-merger"],
              "push": ["forge-merger"]},
    "route": ["forge-router", "--send", "--only", "{items}"]
  },
  "relay": {"url": "http://127.0.0.1:8788",
            "token_file": "~/.config/xmpp-webhook-relay/token",
            "remind_seconds": 7200,
            "room": "everyone@conference.example.org"}
}
