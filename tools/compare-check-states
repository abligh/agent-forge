#!/usr/bin/env python3
"""Compare two build checks' verdicts, head by head, for a side-by-side
trial before a cutover.

    compare-check-states OLD/state.json NEW/state.json [--since TIME]

Both files are forge-pr-check's `state.json` or a predecessor's of the
same shape: `results` maps a head's SHA to a record with `ok`, `failed`
(a list of step names, or of [name, output] pairs) and `finished`.

For each head both checked (finished at or after --since, if given),
it prints those whose verdict differs. Then it counts the heads only
one of them checked, which is expected for a check that started later
or prunes sooner. The steps' names may differ between the two, so a
difference in the failed steps alone is shown but not counted as a
disagreement.

Exit status: 0 the verdicts agree; 1 at least one head was green in one
and red in the other; 2 a file could not be read.
"""

import argparse
import json
import sys


def failed_names(record):
    names = []
    for entry in record.get("failed") or []:
        names.append(entry[0] if isinstance(entry, (list, tuple)) else entry)
    return sorted(str(n) for n in names)


def results(path, since):
    with open(path) as handle:
        data = json.load(handle)
    return {sha: r for sha, r in (data.get("results") or {}).items()
            if isinstance(r, dict) and (r.get("finished") or "") >= since}


def main(argv=None, out=print):
    parser = argparse.ArgumentParser(
        prog="compare-check-states", description=__doc__.splitlines()[0])
    parser.add_argument("old")
    parser.add_argument("new")
    parser.add_argument("--since", default="",
                        help="only heads finished at or after this time "
                        "(ISO 8601, compared as text)")
    args = parser.parse_args(argv)
    try:
        old = results(args.old, args.since)
        new = results(args.new, args.since)
    except (OSError, ValueError) as err:
        out("compare-check-states: %s" % err)
        return 2
    both = sorted(set(old) & set(new),
                  key=lambda s: old[s].get("finished") or "")
    disagree = steps = 0
    for sha in both:
        a, b = old[sha], new[sha]
        pr = a.get("pr", b.get("pr", "?"))
        if bool(a.get("ok")) != bool(b.get("ok")):
            disagree += 1
            out("DISAGREE #%s %s: old %s %s, new %s %s" % (
                pr, sha[:10], "green" if a.get("ok") else "red",
                ",".join(failed_names(a)), "green" if b.get("ok") else "red",
                ",".join(failed_names(b))))
        elif failed_names(a) != failed_names(b):
            steps += 1
            out("STEPS #%s %s: both red; old %s, new %s" % (
                pr, sha[:10], ",".join(failed_names(a)),
                ",".join(failed_names(b))))
    out("both checked %d: %d disagree, %d red with different steps; "
        "only old %d, only new %d" % (
            len(both), disagree, steps, len(set(old) - set(new)),
            len(set(new) - set(old))))
    return 1 if disagree else 0


if __name__ == "__main__":
    sys.exit(main())
