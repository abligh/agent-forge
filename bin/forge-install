#!/usr/bin/env python3
"""Keep this agent-forge installation at the commit a project pins.

    forge-install [--checkout DIR] [--install DIR] [--wait SECONDS]
                  [--versions]
    forge-install --dry-run

`forge-cron-run` runs a tool only when the installation it runs from is
a git checkout whose `HEAD` is the commit the project's
`.agent-forge/pin` names; otherwise every job exits `PIN-MISMATCH`.
Run from cron every few minutes (directly, not through forge-cron-run,
which would refuse it for the very mismatch it is there to end), this
makes the installation follow the pin:

**Only ever the pinned commit.** The pin's first word is a full commit
SHA, and that SHA is the only thing checked out, detached: never a tag
or a branch, since a tag can move. So it never installs ahead of the
pin.

**Never under a running job.** forge-cron-run holds the installation's
lock (`<install>.lock`, beside it) shared for each whole job, and hands
it on to what the job starts, such as a forge-pr-check worker. This
takes it exclusively to move the installation. First it leaves a marker
(`<install>.install-wanted`) that stops forge-cron-run starting
anything new (`INSTALL-PENDING`), so running jobs drain even on a host
whose checks never all stop at once. It waits up to `--wait` seconds
(default 240); if they haven't drained, it exits 1, leaving the marker,
and the next run waits again. The marker is removed once the
installation is moved, and one older than an hour (an installer that
died) is ignored.

**With `--versions`, a release goes beside the running one, never under
it** (docs/designs/0015). The installation is then a symlink to
`<install>.d/<sha>`, one clean clone per release. A new release is
cloned there from the current one, and the symlink is renamed over to
it: nothing waits, a job that starts afterwards runs the new release,
and one already running keeps its own (each holds `<release>.lock`
shared, as above). A release that is no longer current is retired, and
deleted once it has been retired for RETIRE_AFTER_S and no job holds
its lock. The first `--versions` run on an installation that is a
directory moves it into this layout once, the old way: the marker,
then the wait for running jobs.

**It refuses rather than guesses.** An installation whose `origin`
isn't `--url`, or that has local changes, or a pin that isn't a full
SHA: exit 2, nothing touched. A fetch or checkout that fails leaves
the installation where it was: exit 1. A missing installation is cloned
beside its path and renamed into place, so a half-made clone is never
the installation.

Only one runs at a time for an installation (`<install>.installer.lock`):
another that finds it held says `BUSY` and exits 0, so cron can run it
every minute.

Exit status: 0 at the pin, now installed, no pin, or busy; 1 a step failed or
the jobs didn't drain in time (nothing changed); 2 refused.
"""

import argparse
import fcntl
import os
import re
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(HERE))

from agent_forge import config, locks  # noqa: E402

SHA_RE = re.compile(r"^[0-9a-f]{40}$")
DEFAULT_URL = "https://github.com/abligh/agent-forge.git"
PIN_NAME = os.path.join(config.CONFIG_DIR, "pin")
GIT_TIMEOUT_S = 120
# Releases live in <install> + VERSIONS_SUFFIX with --versions.
VERSIONS_SUFFIX = ".d"
# How long a retired release is kept before it may be deleted, at least,
# so that a job which resolved it just before the switch, and is waiting
# for its other locks (FORGE_CRON_LOCK_WAIT_S, 300 by default), has
# taken that release's lock by then.
RETIRE_AFTER_S = 600


class Refused(Exception):
    """Exit 2: something here isn't what this tool may change."""


class Failed(Exception):
    """Exit 1: a step failed or timed out, and nothing was changed."""


def git(args, cwd=None):
    """git; a timeout comes back as exit 124, as timeout(1) reports it."""
    try:
        return subprocess.run(["git"] + args, cwd=cwd, capture_output=True,
                              text=True, timeout=GIT_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(
            ["git"] + args, 124, "", "timed out after %ss" % GIT_TIMEOUT_S)


def read_pin(checkout):
    """The pinned SHA, or None when the checkout has no pin."""
    try:
        with open(os.path.join(checkout, PIN_NAME)) as handle:
            words = handle.read().split()
    except FileNotFoundError:
        return None
    except OSError as e:
        raise Refused("BAD-PIN: can't read %s: %s" % (PIN_NAME, e.strerror))
    pin = words[0].lower() if words else ""
    if not SHA_RE.match(pin):
        raise Refused("BAD-PIN: %s must start with a full 40-character "
                      "commit SHA, not %r" % (PIN_NAME, pin[:50]))
    return pin


def same_url(a, b):
    def norm(u):
        u = u.strip().rstrip("/")
        return u[:-4] if u.endswith(".git") else u
    return norm(a) == norm(b)


def head(install, run=git):
    got = run(["-C", install, "rev-parse", "HEAD"])
    return got.stdout.strip().lower() if got.returncode == 0 else ""


def check_clone(install, url, run=git):
    """Refuse an installation that isn't a clean clone of `url`."""
    got = run(["-C", install, "remote", "get-url", "origin"])
    if got.returncode != 0 or not same_url(got.stdout, url):
        raise Refused("FOREIGN: %s's origin is %r, not %s; not touching it"
                      % (install, got.stdout.strip(), url))
    got = run(["-C", install, "status", "--porcelain"])
    if got.returncode != 0:
        raise Failed("git status in %s: %s" % (install, got.stderr.strip()))
    if got.stdout.strip():
        raise Refused("DIRTY: %s has local changes; not touching it:\n%s"
                      % (install, got.stdout.rstrip()))


def has_commit(repo, sha, run=git):
    return run(["-C", repo, "cat-file", "-e", sha + "^{commit}"]) \
        .returncode == 0


def fetch_pin(repo, url, pin, run=git):
    """Make `pin` present in `repo`: by SHA first, which GitHub serves for
    a reachable commit, then every ref, for a server that won't."""
    for args in (["fetch", "-q", "origin", pin], ["fetch", "-q", "origin"]):
        if has_commit(repo, pin, run):
            return
        run(["-C", repo] + args)
    if not has_commit(repo, pin, run):
        raise Failed("can't fetch %s from %s" % (pin, url))


def checkout(repo, pin, run=git):
    got = run(["-C", repo, "checkout", "-q", "--detach", pin])
    if got.returncode != 0:
        raise Failed("git checkout %s: %s" % (pin, got.stderr.strip()))
    now = head(repo, run)
    if now != pin:
        raise Failed("%s is at %s after checking out %s"
                     % (repo, now[:12] or "nothing", pin[:12]))


def clone_into_place(install, url, pin, run=git):
    """A new installation: cloned beside `install` and renamed into place
    only once it is at the pin."""
    temp = install.rstrip("/") + ".new"
    shutil.rmtree(temp, ignore_errors=True)
    got = run(["clone", "-q", "--no-checkout", url, temp])
    if got.returncode != 0:
        shutil.rmtree(temp, ignore_errors=True)
        raise Failed("git clone %s: %s" % (url, got.stderr.strip()))
    try:
        fetch_pin(temp, url, pin, run)
        checkout(temp, pin, run)
        os.rename(temp, install)
    except (Failed, OSError):
        shutil.rmtree(temp, ignore_errors=True)
        raise


def drained(install, wait, clock=time.monotonic, nap=time.sleep):
    """The installation's lock, held exclusively, once every job holding
    it shared has finished; None if they haven't within `wait` seconds.
    The wanted marker is left first, so no new job starts meanwhile."""
    with open(locks.install_wanted_path(install), "a"):
        pass
    os.utime(locks.install_wanted_path(install))
    handle = open(locks.install_lock_path(install), "a")
    deadline = clock() + wait
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except OSError:
            if clock() >= deadline:
                handle.close()
                return None
            nap(1)


def install_pin(install, url, pin, wait, run=git, dry_run=False,
                clock=time.monotonic, nap=time.sleep):
    """Bring `install` to `pin`; the line that says what was done."""
    if os.path.islink(install):
        # Checking out in place would change a release under its jobs.
        raise Refused("VERSIONED: %s is a symlink to a release; run with "
                      "--versions" % install)
    fresh = not os.path.exists(install)
    if not fresh:
        check_clone(install, url, run)
        was = head(install, run)
        if was == pin:
            if os.path.exists(locks.install_wanted_path(install)):
                os.unlink(locks.install_wanted_path(install))
            return "AT-PIN: %s is at %s" % (install, pin[:12])
    if dry_run:
        return ("WOULD-CLONE: %s into %s at %s" % (url, install, pin[:12])
                if fresh else "WOULD-INSTALL: %s from %s to %s"
                % (install, was[:12] or "nothing", pin[:12]))
    if fresh:
        clone_into_place(install, url, pin, run)
        return "INSTALLED: %s cloned at %s" % (install, pin[:12])
    # Fetched before waiting for the lock: jobs keep running meanwhile.
    fetch_pin(install, url, pin, run)
    held = drained(install, wait, clock, nap)
    if held is None:
        raise Failed("jobs still hold %s after %gs (new ones are held off; "
                     "the next run waits again)"
                     % (locks.install_lock_path(install), wait))
    with held:
        checkout(install, pin, run)
        os.unlink(locks.install_wanted_path(install))
    return "INSTALLED: %s from %s to %s" % (install, was[:12], pin[:12])


def default_install():
    """The installation this tool belongs to: the symlink, when it runs
    from a release in `<install>.d`, else its own directory."""
    here = os.path.dirname(HERE)
    parent = os.path.dirname(here)
    if parent.endswith(VERSIONS_SUFFIX):
        link = parent[:-len(VERSIONS_SUFFIX)]
        if os.path.islink(link):
            return link
    return here


def versions_dir(install):
    return install.rstrip("/") + VERSIONS_SUFFIX


def point_at(install, release):
    """Make `install` a symlink to `release`, in one rename: a job sees
    the old release or the new one, never neither."""
    link = install.rstrip("/") + ".new-link"
    if os.path.lexists(link):
        os.unlink(link)
    os.symlink(os.path.relpath(release, os.path.dirname(install)), link)
    os.replace(link, install)


def retire(release, now=time.time):
    with open(release + ".retired", "w") as handle:
        handle.write("%d\n" % now())


def make_release(install, url, pin, source, run=git):
    """`<install>.d/<pin>`, a clean clone at the pin: kept if it already
    is one, else cloned beside as `.new` (from `source`, the current
    release, when there is one, so its objects are hard links) and
    renamed into place once it is at the pin."""
    target = os.path.join(versions_dir(install), pin)
    if os.path.isdir(target):
        try:
            check_clone(target, url, run)
            if head(target, run) == pin:
                return target
        except (Refused, Failed):
            pass
        # Never current (the current release is not at the pin), so no
        # job runs it: a leftover, made again.
        shutil.rmtree(target, ignore_errors=True)
    os.makedirs(versions_dir(install), exist_ok=True)
    temp = target + ".new"
    shutil.rmtree(temp, ignore_errors=True)
    got = run(["clone", "-q", "--no-checkout", source or url, temp])
    if got.returncode != 0:
        shutil.rmtree(temp, ignore_errors=True)
        raise Failed("git clone %s: %s" % (source or url, got.stderr.strip()))
    try:
        if source:
            got = run(["-C", temp, "remote", "set-url", "origin", url])
            if got.returncode != 0:
                raise Failed("git remote set-url: %s" % got.stderr.strip())
        fetch_pin(temp, url, pin, run)
        checkout(temp, pin, run)
        os.rename(temp, target)
    except (Failed, OSError):
        shutil.rmtree(temp, ignore_errors=True)
        raise
    return target


def prune(install, now=time.time):
    """Delete each retired release of `install` that has been retired for
    RETIRE_AFTER_S and whose lock no job holds; the names deleted. A
    release that isn't current and has no retirement time (one made
    by a run that died before switching) is retired now."""
    root = versions_dir(install)
    current = os.path.realpath(install)
    gone = []
    try:
        names = sorted(os.listdir(root))
    except OSError:
        return gone
    for name in names:
        release = os.path.join(root, name)
        if (not SHA_RE.match(name) or not os.path.isdir(release)
                or os.path.realpath(release) == current):
            continue
        try:
            with open(release + ".retired") as handle:
                since = float(handle.read().split()[0])
        except (OSError, ValueError, IndexError):
            retire(release, now)
            continue
        if now() - since < RETIRE_AFTER_S:
            continue
        handle = open(locks.install_lock_path(release), "a")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            handle.close()
            continue
        with handle:
            shutil.rmtree(release, ignore_errors=True)
            for leftover in (release + ".retired",
                             locks.install_lock_path(release)):
                if os.path.exists(leftover):
                    os.unlink(leftover)
        gone.append(name[:12])
    return gone


def move_into_versions(install, url, wait, run=git, clock=time.monotonic,
                       nap=time.sleep):
    """Make the directory `install` the first release of the versioned
    layout, once, under its lock as an in-place install would be; the
    release it became."""
    check_clone(install, url, run)
    was = head(install, run)
    if not SHA_RE.match(was):
        raise Failed("%s has no commit to name its release by" % install)
    held = drained(install, wait, clock, nap)
    if held is None:
        raise Failed("jobs still hold %s after %gs (new ones are held off; "
                     "the next run waits again)"
                     % (locks.install_lock_path(install), wait))
    with held:
        if os.path.islink(install) or not os.path.isdir(install):
            # Moved meanwhile, by another run: nothing left to move.
            os.unlink(locks.install_wanted_path(install))
            return os.path.realpath(install)
        os.makedirs(versions_dir(install), exist_ok=True)
        release = os.path.join(versions_dir(install), was)
        if os.path.exists(release):
            shutil.rmtree(release)
        os.rename(install, release)
        point_at(install, release)
        os.unlink(locks.install_wanted_path(install))
    return release


def install_versions(install, url, pin, wait, run=git, dry_run=False,
                     clock=time.monotonic, nap=time.sleep, now=time.time):
    """--versions: bring `install` to `pin` beside the running release;
    the line that says what was done."""
    moved = ""
    if os.path.isdir(install) and not os.path.islink(install):
        if dry_run:
            was = head(install, run)
            return ("WOULD-MOVE: %s into %s%s"
                    % (install, versions_dir(install), "" if was == pin
                       else ", then install %s beside it" % pin[:12]))
        move_into_versions(install, url, wait, run, clock, nap)
        moved = " (moved into %s first)" % versions_dir(install)
    current = os.path.realpath(install) if os.path.lexists(install) else None
    if current and not os.path.isdir(current):
        raise Refused("BROKEN: %s points at %s, which isn't there"
                      % (install, current))
    if os.path.exists(locks.install_wanted_path(install)):
        os.unlink(locks.install_wanted_path(install))
    if current:
        check_clone(current, url, run)
        was = head(current, run)
        if was == pin:
            line = "AT-PIN: %s is at %s%s" % (install, pin[:12], moved)
            gone = [] if dry_run else prune(install, now)
            return line + ("; deleted %s" % ", ".join(gone) if gone else "")
    if dry_run:
        return "WOULD-INSTALL: %s from %s to %s beside it" % (
            install, was[:12] if current else "nothing", pin[:12])
    release = make_release(install, url, pin, current, run)
    point_at(install, release)
    if current:
        retire(current, now)
    gone = prune(install, now)
    return ("INSTALLED: %s from %s to %s, beside it%s%s"
            % (install, was[:12] if current else "nothing", pin[:12], moved,
               "; deleted %s" % ", ".join(gone) if gone else ""))


def main(argv=None, run=git, out=print, err=None, environ=None,
         clock=time.monotonic, nap=time.sleep):
    environ = os.environ if environ is None else environ
    err = err or (lambda line: print(line, file=sys.stderr))
    parser = argparse.ArgumentParser(
        prog="forge-install", description=__doc__.splitlines()[0])
    parser.add_argument("--checkout", default=environ.get(
        "FORGE_CRON_CHECKOUT"), help="the project's cron checkout, whose "
        "pin is followed (default $FORGE_CRON_CHECKOUT)")
    parser.add_argument("--install", default=default_install(),
                        help="the installation to move (default this one)")
    parser.add_argument("--url", default=DEFAULT_URL,
                        help="where agent-forge is cloned from "
                        "(default %(default)s)")
    parser.add_argument("--wait", type=float, default=240,
                        help="seconds to wait for running jobs to finish "
                        "(default %(default)s)")
    parser.add_argument("--versions", action="store_true",
                        help="install each release beside the running one "
                        "and switch a symlink, never waiting for jobs "
                        "(docs/designs/0015)")
    parser.add_argument("--dry-run", action="store_true",
                        help="say what would be done, change nothing")
    args = parser.parse_args(argv)
    if not args.checkout:
        err("forge-install: no --checkout, and FORGE_CRON_CHECKOUT is not "
            "set")
        return 2
    install = os.path.abspath(os.path.expanduser(args.install)).rstrip("/")
    try:
        pin = read_pin(os.path.expanduser(args.checkout))
        if pin is None:
            out("NO-PIN: %s has no %s; nothing to install"
                % (args.checkout, PIN_NAME))
            return 0
        do = install_versions if args.versions else install_pin
        # One installer at a time: cron may start the next run while this
        # one still waits for jobs, and two moving the installation at
        # once could each undo the other's work.
        with open(install + ".installer.lock", "a") as mine:
            try:
                fcntl.flock(mine, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                out("BUSY: another forge-install is running for %s"
                    % install)
                return 0
            out(do(install, args.url, pin, args.wait, run, args.dry_run,
                   clock, nap))
        return 0
    except Refused as why:
        err("forge-install: %s" % why)
        return 2
    except Failed as why:
        err("forge-install: FAILED: %s; %s is unchanged" % (why, install))
        return 1


if __name__ == "__main__":
    sys.exit(main())
