# merge.update_once: no second UPDATE, RESOLVE or UNION after any hand-back
# under the same approval.
UPDATE_ONCE = False
# merge.hand_back_once_per_head (designs/0044, rule 1): a pull request
# is told of a hand-back once per approval and head, whatever the
# reason; False tells it again for each new reason.
ONCE_PER_HEAD = True
# merge.ci_never_started: how long after the head's commit a CI run
# that never started is handed back, or None to wait (and stall).
CI_NEVER_STARTED = None
# merge.queued_stall_minutes: the stall time while the build check has
# the head queued and not yet started, or None.
QUEUED_STALL_AFTER = None
# merge.read_as: the App a dry run reads with, or None for the Merger.
READ_AS = None
# merge.stall_run_factor: a head waiting on its checks stalls only once
# it has waited this many times the median of the build check's recent
# runs (STALL_RUNS of them), when that is longer than STALL_AFTER; 0
# for STALL_AFTER alone. Under load a run takes 30 to 50 minutes, and a
# fixed 30 called every one of them a stall (2026-11-12).
STALL_RUN_FACTOR = 1.5
STALL_RUNS = 20


def configure(project):
    """Set the module's settings from `project`, a loaded configuration.
    The `merge` section: `merger` (the machinery App that acts, default
    "Merger"), `ci_workflow` (default "ci"; "" for none), `gate` (a list
    of argument lists), `stall_minutes` (default 30) and `stall_alert`
    (default none: a stall is only printed), and `test_ahead` (default
    none: nothing is predicted; `depth`, default 3) and
    `hold_conflicting` (default false), `yield_after_hand_back`
    (default none: nobody yields), `yield_cap` (default 3),
    `yield_ignores_conflicts` (default false) and `right_of_way`
    (default none: nobody has it; `after_conflicts`, default 2, and
    `minutes`, default 60) and `code_owners` (default false) and
    `stacks` (default none: a stacked pull request is held; `max_run`,
    default 0, no limit; `wait_hours`, default none: a layer that isn't
    ready when the layer below merges leaves the stack), and design 0026's
    `resolve` (a list of rules, or an object with them as `regenerate`
    and design 0046's `union` globs), `hold_labels`,
    `blocked_by`, `said_since`, `update_once`, `ci_never_started`,
    `queued_stall_minutes` and `read_as` (each off unless set). The
    `checks` section: `context` and `poster` (default the merger).
    `labels.waiting_on_owner` is the label a long stall gets, and
    `labels.urgent` the label that puts a pull request first."""
    global REPO_SLUG, MAIN, APPROVERS, QUIET_LOGINS, ACT_AS, SIGNATURE
    global STATUS_CONTEXT, STATUS_CREATOR, BUILD_HOST, GATE, CI_WORKFLOW
    global STALL_AFTER, STALL_ALERT, STALL_TELL, STALL_RETELL
    global STALL_TO_OWNER, STALL_TITLE, STALL_LABELS, WAITING_OWNER
    global TEST_AHEAD, AHEAD_DEPTH, AHEAD_BATCH, HOLD_CONFLICTING, YIELD_PLACES
    global YIELD_CAP, YIELD_IGNORES_CONFLICTS, RIGHT_OF_WAY, ROW_AFTER
    global ROW_FOR, CODE_OWNERS, CHANGERS, EARLY_CONFLICTS, URGENT_LABEL
    global KEEP_LABEL
    global STACKS, STACK_MAX_RUN, STACK_WAIT, RESOLVE, HOLD_LABELS, BLOCKED_BY
    global UNION, RESOLVE_SLOTS
    global SAID_AUTHOR, SAID_APPROVALS, UPDATE_ONCE, CI_NEVER_STARTED
    global QUEUED_STALL_AFTER, READ_AS, AHEAD_STACKS, AHEAD_BATCHES
    global AGE_FIRST, PREDICT_RESTACKED, ONCE_PER_HEAD, ROW_WHILE_ELIGIBLE
    global FIXED_ORDER, GREEN_BATCH_FIRST, RED_SUSPECT_OUT, UNSTABLE_AFTER
    global UNSTABLE_BATCHES, TELL_BOARDED
    global RERUN_LABEL, TRAINS, TRAINS_WITHIN, GATED, OWN_HEAD_GREEN
    global TRAIN_MERGE, TRAIN_BRANCH, STALL_RUN_FACTOR, LAYERS_OWN_GREEN
    global LEFT_TOP_COVERS
    global OWN_GREEN_TO_BOARD
    merge, checks = project.section("merge"), project.section("checks")
    REPO_SLUG = project.repo
    MAIN = project.default_branch
    ACT_AS = merge.get("merger", "Merger")
    SIGNATURE = "— " + ACT_AS
    APPROVERS = {project.slug(n): n for n in project.reviewers()}
    QUIET_LOGINS = frozenset((project.slug(ACT_AS),))
    CHANGERS = frozenset(APPROVERS) | {project.owner}
    STATUS_CONTEXT = checks.get("context", DEFAULT_CONTEXT)
    STATUS_CREATOR = project.bot_login(checks.get("poster", ACT_AS))
    GATED = tuple(
        (context, project.bot_login(poster or ACT_AS),
         tuple((scope or {}).get("paths", ())) if scope else None,
         (scope or {}).get("label") if scope else None)
        for _name, context, poster, scope
        in config.gated_instances(project.data))
    BUILD_HOST = project.host
    global INSTANCE_RED
    INSTANCE_RED = tuple(instance_red_rules(project))
    GATE = tuple(tuple(argv) for argv in merge.get("gate", DEFAULT_GATE))
    OWN_HEAD_GREEN = merge.get("own_head_green", True)
    CI_WORKFLOW = merge.get("ci_workflow", "ci")
    STALL_AFTER = datetime.timedelta(minutes=merge.get("stall_minutes", 30))
    alert = merge.get("stall_alert")
    STALL_ALERT = alert is not None
    alert = alert or {}
    STALL_TELL = tuple(alert.get("tell", ()))
    STALL_RETELL = datetime.timedelta(minutes=alert.get(
        "retell_minutes", DEFAULT_STALL_RETELL_MINUTES))
    STALL_TO_OWNER = datetime.timedelta(minutes=alert.get(
        "owner_after_minutes", DEFAULT_STALL_OWNER_AFTER_MINUTES))
    STALL_TITLE = alert.get("title", DEFAULT_STALL_TITLE)
    STALL_LABELS = tuple(alert.get("labels", ()))
    global MANUAL
    MANUAL = merge.get("mode", "auto") == "manual"
    global CODE_OWNER_ASK, CODE_OWNER_SEQUENCE
    CODE_OWNER_SEQUENCE = merge.get("code_owner_sequence", False) is True
    ask = merge.get("code_owner_ask")
    CODE_OWNER_ASK = None if ask is None else (
        ask.get("title", DEFAULT_CODE_OWNER_ASK_TITLE),
        tuple(ask.get("labels", ())))
    WAITING_OWNER = project.section("labels").get("waiting_on_owner",
                                                  DEFAULT_WAITING_OWNER)
    URGENT_LABEL = project.section("labels").get("urgent")
    KEEP_LABEL = project.section("labels").get("keep_trains")
    RERUN_LABEL = project.section("labels").get("rerun")
    ahead = config.test_ahead(project.data)   # designs/0050
    TEST_AHEAD = ahead is not None
    AHEAD_DEPTH = (ahead or {}).get("depth", DEFAULT_AHEAD_DEPTH)
    AHEAD_BATCH = (ahead or {}).get("batch", 1)
    AHEAD_BATCHES = (ahead or {}).get("batches", 1)
    FIXED_ORDER = (ahead or {}).get("fixed_order", True) is not False
    GREEN_BATCH_FIRST = (ahead or {}).get("green_batch_first") is True
    TELL_BOARDED = (ahead or {}).get("tell_boarded") is True
    RED_SUSPECT_OUT = (ahead or {}).get("hand_back_red_suspect",
                                        True) is not False
    UNSTABLE_AFTER = (ahead or {}).get("unstable_after_recuts")
    UNSTABLE_BATCHES = (ahead or {}).get("batches_when_unstable", 1)
    TRAINS = (ahead or {}).get("trains")
    TRAINS_WITHIN = (ahead or {}).get("trains_within", "files")
    TRAIN_MERGE = (ahead or {}).get("train_merge") is True
    LEFT_TOP_COVERS = (ahead or {}).get("left_top_covers") is not False
    LAYERS_OWN_GREEN = (ahead or {}).get("layers_need_own_green") \
        is not False
    OWN_GREEN_TO_BOARD = (ahead or {}).get("own_green_to_board") \
        is not False
    TRAIN_BRANCH = (ahead or {}).get("train_branch", "forge/train-")
    HOLD_CONFLICTING = merge.get("hold_conflicting", False) is True
    YIELD_PLACES = merge.get("yield_after_hand_back", 0)
    YIELD_CAP = merge.get("yield_cap", 3)
    YIELD_IGNORES_CONFLICTS = merge.get("yield_ignores_conflicts",
                                        False) is True
    CODE_OWNERS = merge.get("code_owners", False) is True
    EARLY_CONFLICTS = merge.get("early_conflicts", False) is True
    RESOLVE_SLOTS = merge.get("resolve_slots", 0)
    row = merge.get("right_of_way")
    RIGHT_OF_WAY = row is not None
    ROW_AFTER = (row or {}).get("after_conflicts", 2)
    ROW_FOR = datetime.timedelta(minutes=(row or {}).get("minutes", 60))
    ROW_WHILE_ELIGIBLE = (row or {}).get("while_eligible", True) is not False
    age = merge.get("age_first")
    AGE_FIRST = (None if age is None else datetime.timedelta(
        minutes=age.get("after_minutes", 90)))
    stacks = merge.get("stacks")
    STACKS = stacks is not None
    STACK_MAX_RUN = (stacks or {}).get("max_run", 0)
    wait = (stacks or {}).get("wait_hours")
    STACK_WAIT = datetime.timedelta(hours=wait) if wait else None
    AHEAD_STACKS = (STACKS and AHEAD_BATCH > 1
                    and (ahead or {}).get("stacks") is True)
    PREDICT_RESTACKED = (STACKS and TEST_AHEAD
                         and stacks.get("predict_restacked") is True)
    UNION = union.globs(merge)
    rules = merge.get("resolve", ())
    if isinstance(rules, dict):
        rules = rules.get("regenerate", ())
    RESOLVE = tuple({"paths": frozenset(rule["paths"]),
                     "command": tuple(rule["command"]),
                     "check": tuple(rule["check"])}
                    for rule in rules)
    HOLD_LABELS = tuple(merge.get("hold_labels", ()))
    BLOCKED_BY = merge.get("blocked_by", "body")
    said = merge.get("said_since") or {}
    SAID_AUTHOR = said.get("author", False) is True
    SAID_APPROVALS = said.get("approvals", False) is True
    QUIET_LOGINS = QUIET_LOGINS | {project.slug(n)
                                   for n in said.get("quiet", ())}
    UPDATE_ONCE = merge.get("update_once", False) is True
    ONCE_PER_HEAD = merge.get("hand_back_once_per_head", True) is not False
    never = merge.get("ci_never_started")
    CI_NEVER_STARTED = (datetime.timedelta(minutes=never)
                        if never is not None else None)
    queued = merge.get("queued_stall_minutes")
    QUEUED_STALL_AFTER = (datetime.timedelta(minutes=queued)
                          if queued is not None else None)
    READ_AS = merge.get("read_as")
    STALL_RUN_FACTOR = merge.get("stall_run_factor", 1.5)

NOT_A_REVIEW_RE = re.compile(r"^Not-a-review\b", re.MULTILINE | re.IGNORECASE)
BLOCKED_RE = re.compile(r"^\**Blocked-by:\**\s*#(\d+)\s*\**$",
                        re.MULTILINE | re.IGNORECASE)
BLOCKED_LINE_RE = re.compile(r"^\**Blocked-by:", re.IGNORECASE)
UNBLOCK_RE = re.compile(r"^\**Blocked-by:\**\s*(none|nothing)\s*\.?\**$",
                        re.MULTILINE | re.IGNORECASE)
FENCE_RE = re.compile(r"^\s*(```|~~~).*?(^\s*\1|\Z)", re.MULTILINE | re.DOTALL)
DEFER_ANY_RE = re.compile(r"^Defer-until:[ \t]*(.+?)[ \t]*$",
                          re.MULTILINE | re.IGNORECASE)
DEFER_FORMATS = ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M%z", "%Y-%m-%d")

PR_QUERY = """
query($owner:String!, $name:String!, $cursor:String) {
  repository(owner:$owner, name:$name) {
    pullRequests(states:OPEN, first:50, after:$cursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        number title createdAt lastEditedAt isDraft baseRefName headRefName
        headRefOid body
        author { login }
        labels(first:50) { nodes { name } }
        reviews(last:100) {
          nodes { databaseId author { login } authorCanPushToRepository
                  state createdAt submittedAt body commit { oid }
                  comments { totalCount } }
        }
        comments(last:100) {
          nodes { databaseId author { login } createdAt body }
        }
      }
    }
  }
}"""


def sh(args, cwd=None, env=None):
    return subprocess.run(args, cwd=cwd, env=env, capture_output=True,
                          text=True)


def now_utc():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)


def iso(when):
    return when.strftime("%Y-%m-%dT%H:%M:%SZ")


def login(node):
    """The author's login without GitHub's "[bot]" suffix, which REST
    adds and GraphQL leaves off, or "" for a deleted account."""
    name = ((node or {}).get("author") or {}).get("login") or ""
    return name[:-len("[bot]")] if name.endswith("[bot]") else name


def markers_of(text):
    """`text` without fenced or indented code: a comment that quotes
    `Not-a-review` or `Blocked-by:` in code is not marked."""
    text = FENCE_RE.sub("", text or "")
    return "\n".join(l for l in text.splitlines()
                     if not l.startswith(("    ", "\t")))


def approval_of(pr, approvers=None):
    """The newest `APPROVED` review by an APPROVERS App (or one of the
    logins `approvers` names) that is not the pull request's author, or
    None."""
    approvers = APPROVERS if approvers is None else approvers
    best = None
    for review in pr["reviews"]:
        who = login(review)
        if (review.get("state") == "APPROVED" and who in approvers
                and who != login(pr)):
            if best is None or review["submittedAt"] > best["submittedAt"]:
                best = review
    return best


def changes_requested(pr, changers=None):
    """The reviews whose request for changes still stands, oldest first:
    for each login in CHANGERS (or `changers`), or that GitHub says can
    push to the repository, other than the author, its newest
    `APPROVED`, `CHANGES_REQUESTED` or `DISMISSED` review, when that is
    `CHANGES_REQUESTED`. GitHub refuses to merge while one
    stands, whatever another reviewer approved since, and a push or a
    comment doesn't lift it: only that reviewer's next verdict or a
    dismissal does."""
    changers = {c.lower() for c in (CHANGERS if changers is None
                                    else changers)}
    latest = {}
    for review in pr["reviews"]:
        who = login(review).lower()
        if ((who in changers or review.get("authorCanPushToRepository"))
                and who != login(pr).lower()
                and review.get("state") in ("APPROVED", "CHANGES_REQUESTED",
                                            "DISMISSED")
                and (who not in latest or (review.get("submittedAt") or "")
                     > (latest[who].get("submittedAt") or ""))):
            latest[who] = review
    return sorted((r for r in latest.values()
                   if r["state"] == "CHANGES_REQUESTED"),
                  key=lambda r: r.get("submittedAt") or "")


def said_since(pr, approval):
    """Comments and reviews after `approval`, as (login, time, kind),
    less those marked `Not-a-review`, those by QUIET_LOGINS, those by
    the pull request's author and approvals. Empty means nothing has
    been said since. With `merge.said_since.author` the author's remarks
    count too, and with `approvals` so does a later approval with text:
    another reviewer's assent after the one that counts is still a
    remark the approver hasn't seen. A bare approval never counts."""
    at = approval["submittedAt"]
    author = login(pr)
    said = []
    for kind, items, stamp in (("review", pr["reviews"], "submittedAt"),
                               ("comment", pr["comments"], "createdAt")):
        for item in items:
            when = item.get(stamp) or ""
            if item is approval or when <= at:
                continue
            who = login(item)
            if who in QUIET_LOGINS or (author and who == author
                                       and not SAID_AUTHOR):
                continue
            if NOT_A_REVIEW_RE.search(markers_of(item.get("body"))):
                continue
            if (kind == "review" and item.get("state") == "APPROVED"
                    and (not SAID_APPROVALS
                         or not markers_of(item.get("body")).strip())):
                # Assent, whatever its text: a reviewer with second
                # thoughts requests changes instead. Even with
                # `approvals`, an approval with no text says nothing the
                # approver hasn't seen (a code owner's bare approval
                # held pull requests it should have released).
                continue
            said.append((who or "ghost", when, kind))
    return sorted(said, key=lambda s: s[1])


def label_names(pr):
    """`pr`'s label names, from GraphQL's `labels.nodes` or a plain
    list of names or `{"name": ...}` objects."""
    labels = pr.get("labels") or ()
    if isinstance(labels, dict):
        labels = labels.get("nodes") or ()
    return [l.get("name") if isinstance(l, dict) else l for l in labels]


def texts_of(pr):
    """The body, comments and submitted reviews of `pr`, oldest first, as
    (time, text) pairs. The body is dated by its last edit (`lastEditedAt`,
    else `createdAt`), so a body edited after a comment is the newer
    text; the sort is stable, so on a tie the body stays first. A pending
    review has no time and is not read."""
    texts = [(pr.get("lastEditedAt") or pr.get("createdAt") or "",
              pr.get("body"))]
    texts += [(c.get("createdAt") or "", c.get("body"))
              for c in pr.get("comments") or ()]
    texts += [(r.get("submittedAt") or "", r.get("body"))
              for r in pr.get("reviews") or () if r.get("submittedAt")]
    return sorted(texts, key=lambda t: t[0])


def blocker_state(pr):
    """(numbers, unparsed) for `pr`'s `Blocked-by:` lines. With
    `merge.blocked_by: "everywhere"`, the newest text with a
    `Blocked-by:` line decides, across the body, comments and reviews,
    `Not-a-review` included: every strict line in it counts and replaces
    any earlier numbers, and `Blocked-by: none` clears them. `unparsed`
    is the first line in that text that starts `Blocked-by:` but is
    neither strict nor `none`, or None: it was meant as a hold, so it
    holds. Otherwise only the body's strict lines count, and nothing is
    unparsed."""
    if BLOCKED_BY != "everywhere":
        return ({int(m.group(1))
                 for m in BLOCKED_RE.finditer(markers_of(pr.get("body")))},
                None)
    named, unparsed = set(), None
    for _, text in texts_of(pr):
        text = markers_of(text)
        lines = [l for l in text.splitlines() if BLOCKED_LINE_RE.match(l)]
        if not lines:
            continue
        bad = [l for l in lines
               if not (BLOCKED_RE.match(l) or UNBLOCK_RE.match(l))]
        unparsed = bad[0].strip() if bad else None
        if UNBLOCK_RE.search(text):
            named = set()
        found = {int(m.group(1)) for m in BLOCKED_RE.finditer(text)}
        if found:
            named = found
    return named, unparsed


def blockers_of(pr):
    """The pull request and issue numbers `pr` is blocked by; see
    `blocker_state`."""
    return blocker_state(pr)[0]


def parse_defer(value):
    """A `Defer-until:` value as an aware datetime, or None if it is not
    one of DEFER_FORMATS. A value without a zone is UTC."""
    for fmt in DEFER_FORMATS:
        try:
            when = datetime.datetime.strptime(value.replace("Z", "+0000"), fmt)
        except ValueError:
            continue
        return when if when.tzinfo else when.replace(
            tzinfo=datetime.timezone.utc)
    return None


def deferral_of(pr, now):
    """Why `pr` is deferred at `now`, or None. The newest `Defer-until:`
    line wins, across the body, comments and reviews. An unexpired one
    holds the pull request, and so does one that isn't a time: a
    deferral nobody can read is not a release. The body is dated by its
    last edit, as `texts_of` dates it, so a `Defer-until:` edited into the
    body after a comment's is the newer one."""
    latest = None
    for _, text in texts_of(pr):
        found = DEFER_ANY_RE.findall(markers_of(text))
        if found:
            latest = found[-1]
    if latest is None:
        return None
    until = parse_defer(latest)
    if until is None:
        return "Defer-until: %s is not a time" % latest[:40]
    if until > now:
        return "deferred until %s" % iso(until.astimezone(
            datetime.timezone.utc))
    return None


def blocked_prs(held):
    """The pull requests `held` (number -> why) holds for a reason only
    another merge clears: a `Blocked-by:` still open, or stacked on
    another. next.json lists them as `blocked`, and the build check
    starts their heads after other approved ones (agent-forge #256)."""
    return sorted(int(number) for number, why in held.items()
                  if why.startswith(("Blocked-by: #", "stacked on #")))


def eligible(pr, open_numbers, now=None, stacked=None, any_base=False):
    """(approval, None) when `pr` is the Merger's, so far as GitHub's
    records say, or (None, reason). Whether the approval covers the head
    needs git, so `covers_head` asks that separately. `open_numbers` is
    every open pull request and issue a `Blocked-by:` line could name;
    `now` decides whether a `Defer-until:` has passed. With STACKS,
    `stacked` maps each open pull request's head branch to its number,
    so one based on it is held as stacked on it; `any_base` judges the
    rest as if the base were `main`."""
    if pr.get("isDraft"):
        return None, "draft"
    if pr.get("baseRefName") != MAIN and not any_base:
        below = (stacked or {}).get(pr.get("baseRefName"))
        if STACKS and below is not None:
            return None, STACK_REASON % below
        return None, "based on %s, not %s" % (pr.get("baseRefName"), MAIN)
    for label in HOLD_LABELS:
        if label in label_names(pr):
            return None, "labelled %s" % label
    approval = approval_of(pr)
    if approval is None:
        return None, "no Reviewer approval"
    said = said_since(pr, approval)
    if said:
        who, when, kind = said[0]
        return None, "%s by %s at %s, after the approval" % (kind, who, when)
    standing = changes_requested(pr)
    if standing:
        return None, "changes requested by %s at %s" % (
            login(standing[0]), standing[0].get("submittedAt"))
    named, unparsed = blocker_state(pr)
    if unparsed:
        return None, "unparsed Blocked-by line: %s" % unparsed[:60]
    still = sorted(named & set(open_numbers))
    if still:
        return None, "Blocked-by: %s" % ", ".join("#%d" % n for n in still)
    deferred = deferral_of(pr, now or now_utc())
    if deferred:
        return None, deferred
    return approval, None


def labelled_urgent(pr):
    """Whether `pr` carries `labels.urgent`: someone marked it so by
    hand."""
    return bool(URGENT_LABEL) and URGENT_LABEL in [
        (n or {}).get("name") for n in
        ((pr.get("labels") or {}).get("nodes") or [])]


def labelled_keep(pr):
    """Whether `pr` carries labels.keep_trains."""
    return bool(KEEP_LABEL) and KEEP_LABEL in [
        (n or {}).get("name") for n in
        ((pr.get("labels") or {}).get("nodes") or [])]


def urgent(pr):
    """Whether `pr` carries `labels.urgent`, or fixes a red nightly or
    a red default branch."""
    return labelled_urgent(pr) \
        or pr.get("number") in NIGHTLY_FIXES | MAIN_RED_FIXES


def order(candidates, everyone=None):
    """`candidates` in the order the Merger takes them. First come those
    carrying `labels.urgent`, which a person put there; then the other
    urgent ones, a red nightly's or default branch's fixes, which a
    tool found; then those that another open pull request is blocked
    by; then the rest, each group oldest first by `createdAt`, then by
    number.

    `everyone` is every open pull request, candidates or not, and
    defaults to `candidates`. It has to include the ineligible ones: a
    pull request with an open `Blocked-by:` is never a candidate, so
    reading blockers from candidates alone would promote nothing."""
    named = set()
    for pr in candidates if everyone is None else everyone:
        named |= blockers_of(pr)
    key = lambda pr: (not labelled_urgent(pr), not urgent(pr),
                      pr["number"] not in named,
                      pr["createdAt"], pr["number"])
    return sorted(candidates, key=key)


def recent_records(path, since, block=65536):
    """The records of the JSON-lines file `path` stamped (`at`) at or
    after `since`, oldest first, read from the end in blocks until one
    older turns up: a long record is never read whole for one tick."""
    try:
        handle = open(path, "rb")
    except OSError:
        return []
    with handle:
        handle.seek(0, os.SEEK_END)
        end = handle.tell()
        tail, records, done = b"", [], False
        while end > 0 and not done:
            start = max(0, end - block)
            handle.seek(start)
            chunk = handle.read(end - start) + tail
            end = start
            lines = chunk.split(b"\n")
            # The first line may be cut short unless the file starts here.
            tail = lines.pop(0) if start > 0 else b""
            for line in reversed(lines):
                try:
                    record = json.loads(line)
                    at = parse_time(record["at"])
                except (ValueError, KeyError, TypeError):
                    continue
                if at < since:
                    done = True
                    break
                records.append(record)
        if not done and tail:
            try:
                record = json.loads(tail)
                if parse_time(record["at"]) >= since:
                    records.append(record)
            except (ValueError, KeyError, TypeError):
                pass
    records.reverse()
    return records


def author_hand_backs(records):
    """Each distinct (pr, head, reason) handed back to its author in
    `records`, since a tick repeats a hand-back already said; one GitHub
    refused to post is not one. A hand-back to the approving reviewer
    asks for a fresh review and is not the pull request's own failure,
    so it isn't one either."""
    seen = set()
    for record in records:
        for d in record.get("decisions") or ():
            if not isinstance(d, dict) or d.get("action") != "HAND-BACK" \
                    or d.get("to") != "author":
                continue
            if str(d.get("result") or "").startswith("refused"):
                continue
            seen.add((d.get("pr"), d.get("head"), d.get("reason")))
    return seen


def hand_backs(records, conflicts=True):
    """{pr: how many times it was handed back to its author} in
    `records` (see `author_hand_backs`); without `conflicts`, a conflict
    with main doesn't count. A head GitHub lost (LOST_HEAD_REASON), or
    a CI run GitHub never finished (`ci_stuck_reason`), is never the
    pull request's own failure, so it doesn't count either."""
    counts = {}
    for pr, _, reason in author_hand_backs(records):
        if not not_own_failure(reason) and (
                conflicts or reason != CONFLICT_REASON):
            counts[pr] = counts.get(pr, 0) + 1
    return counts


def conflict_hand_backs(records):
    """{pr: how many heads were handed back to its author for a conflict
    with main} in `records`."""
    counts = {}
    for pr, _, reason in author_hand_backs(records):
        if reason == CONFLICT_REASON:
            counts[pr] = counts.get(pr, 0) + 1
    return counts


def yields_spent(records, conflicts=True):
    """{pr: how many other pull requests merged while it was a candidate,
    since its latest hand-back to its author} in `records` (oldest
    first; see `author_hand_backs` for what counts as a hand-back, and
    `hand_backs` for `conflicts`). Each such merge is a place it has
    already yielded: `yield_places` moves it back only by what it still
    owes. Without this, a yield taken afresh from every tick's order is
    a standing penalty, and the oldest candidate, first in that order,
    can't reach the front while enough others are ready."""
    last, spent = {}, {}
    for record in records:
        for d in record.get("decisions") or ():
            if not isinstance(d, dict) or d.get("action") != "HAND-BACK" \
                    or d.get("to") != "author" \
                    or str(d.get("result") or "").startswith("refused"):
                continue
            if not not_own_failure(d.get("reason")) and (
                    conflicts or d.get("reason") != CONFLICT_REASON):
                last[d.get("pr")] = record
                spent[d.get("pr")] = 0
        queue = record.get("queue") or ()
        merged = {d.get("pr") for d in record.get("decisions") or ()
                  if isinstance(d, dict) and d.get("action") == "MERGE"
                  and d.get("result") == "done"}
        for pr in spent:
            if record is not last[pr] and pr in queue:
                spent[pr] += len(merged - {pr})
    return spent


def yield_places(queue, everyone, counts, keep=None, spent=None):
    """(`queue` reordered, {pr: places moved back}): each pull request
    handed back K times (`counts`, K at most YIELD_CAP) moved back
    YIELD_PLACES times K places within its group, less the places it
    has already yielded (`spent`, see `yields_spent`), those another
    open pull request is blocked by being one group and the rest the
    other. `keep`, the pull request a run is in flight for, never moves.
    Later ones are moved first, so one yielding never takes a place
    another yielded."""
    named = set()
    for pr in everyone:
        named |= blockers_of(pr)
    # Urgent ones (labels.urgent) stay first and never yield: a person
    # put them there.
    hot = [pr for pr in queue if urgent(pr)]
    groups = ([pr for pr in queue if pr["number"] in named
               and not urgent(pr)],
              [pr for pr in queue if pr["number"] not in named
               and not urgent(pr)])
    moved = {}
    for group in groups:
        for i in range(len(group) - 1, -1, -1):
            pr = group[i]
            k = min(counts.get(pr["number"], 0), YIELD_CAP)
            owed = YIELD_PLACES * k - (spent or {}).get(pr["number"], 0)
            if owed <= 0 or pr["number"] == keep:
                continue
            to = min(i + owed, len(group) - 1)
            if to > i:
                group.insert(to, group.pop(i))
                moved[pr["number"]] = to - i
    return hot + groups[0] + groups[1], moved


def git(repo, *args, run=sh):
    return run(["git", "-C", repo] + list(args))


def fetch_pr(repo, number, head, run=sh):
    """Fetch pull request `number`'s head into PR_REF, and return the
    first fetch's result when nothing could be fetched. GitHub can fail
    to make `refs/pull/N/head`, and then a fetch of it fails on every
    tick. The head the Merger means is `head`, the SHA it already read,
    and GitHub serves a reachable commit by its SHA, so that is the
    fallback; a SHA that can't be fetched either is still a failure."""
    fetched = git(repo, "fetch", "-q", "origin",
                  "+refs/pull/%d/head:%s" % (number, PR_REF % number),
                  run=run)
    if fetched.returncode == 0 and git(
            repo, "rev-parse", PR_REF % number,
            run=run).stdout.strip() == head:
        return fetched
    # GitHub can also leave `refs/pull/N/head` at an old commit while the
    # API names a newer head: on 2026-10-26 one pull request's ref stayed
    # behind for nine hours, and it was skipped on every tick as "the head
    # moved while reading". A head that really moved can't be fetched by
    # the old SHA's ref either way, and GitHub refuses a write pinned to
    # it, so the SHA is the fallback here too.
    if git(repo, "fetch", "-q", "origin", head, run=run).returncode != 0:
        return fetched
    return git(repo, "update-ref", PR_REF % number, head, run=run)


def is_ancestor(repo, older, newer, run=sh):
    return git(repo, "merge-base", "--is-ancestor", older, newer,
               run=run).returncode == 0


def conflicted_paths(output):
    """The paths `git merge-tree --write-tree --name-only --no-messages`
    lists as conflicted: every line after the tree's id."""
    return {line for line in output.splitlines()[1:] if line}


def resolve_rule(paths):
    """The index of the first `merge.resolve` rule whose paths hold all
    of `paths` (a non-empty set), or None."""
    for at, rule in enumerate(RESOLVE):
        if paths and paths <= rule["paths"]:
            return at
    return None


def regenerated_merge(repo, parents, sha, run=sh):
    """The `merge.resolve` rule's index when merging `parents` conflicts
    only in paths one rule lists and `sha`'s tree differs from that
    merge only in those paths, else None. Whether the files themselves
    are right is the rule's `check`'s question."""
    merged = git(repo, "merge-tree", "--write-tree", "--name-only",
                 "--no-messages", *parents, run=run)
    if merged.returncode != 1:
        return None
    at = resolve_rule(conflicted_paths(merged.stdout))
    if at is None:
        return None
    differs = git(repo, "diff-tree", "-r", "--name-only",
                  merged.stdout.split()[0], sha + "^{tree}", run=run)
    if differs.returncode != 0 or not set(
            differs.stdout.split()) <= RESOLVE[at]["paths"]:
        return None
    return at


def squashed(repo, lower, main_ref, run=sh):
    """Whether a commit on `main_ref`'s first-parent history has exactly
    `lower`'s tree: the squash of the layer whose final head it is."""
    tree = git(repo, "rev-parse", lower + "^{tree}", run=run)
    if tree.returncode != 0:
        return False
    trees = git(repo, "log", "--first-parent", "--format=%T",
                "-n", str(SQUASH_DEPTH), main_ref, run=run)
    return (trees.returncode == 0
            and tree.stdout.strip() in trees.stdout.split())


def on_main(repo, sha, main_tip, run=sh):
    """Whether `sha` brings nothing the default branch at `main_tip`
    lacks: it is in its history, or it is a merged layer's final head,
    whose tree a squash on its first-parent history has (`squashed`).
    A merge of either into a pull request (an update, the Merger's
    RESTACK) changes nothing of the pull request's own. On 2026-11-12 a
    layer the Merger had just restacked was held for its gated
    instance's verdict on the new head, which the walk back past such
    merges didn't reach, and it left its train as a push."""
    return is_ancestor(repo, sha, main_tip, run) or \
        squashed(repo, sha, main_tip, run)


def based_merge(repo, main_side, layer, lower, run=sh):
    """The tree of `main_side` merged into `layer` against `lower`, the
    final head of the merged layer below (designs/0025), or None when it
    isn't clean or isn't safe: `layer` must hold `lower`, and `main_side`
    its squash. Otherwise the base would let the layer undo the lower
    layer's later changes, without a conflict."""
    if not (is_ancestor(repo, lower, layer, run)
            and squashed(repo, lower, main_side, run)):
        return None
    merged = git(repo, "merge-tree", "--write-tree", "--no-messages",
                 "--merge-base=" + lower, main_side, layer, run=run)
    if merged.returncode != 0:
        return None
    return merged.stdout.split()[0]


def covers_head(repo, approved, head, main_ref, run=sh, below=(),
                regenerated=None):
    """(True, None) if the approval at `approved` covers `head`, (False,
    reason) if not, or (None, reason) when `regenerated` could not say,
    a question for the next tick. Both commits and `main_ref` must be in
    `repo`. `below` are the heads of a stack's layers already merged
    (STACKS): a clean merge of one of them, as of `main`, covers the
    head too. With `merge.resolve`, a merge whose only conflict was in a
    rule's paths covers it too, once `regenerated(sha, rule)` says its
    files are what the rule's `check` makes of them. With
    `merge.resolve.union` (designs/0046), so does a merge whose tree is
    `union.resolve` of its parents, in their order, whoever made it."""
    if not is_ancestor(repo, approved, head, run):
        return False, "the approved commit %s is not in the head's history" % (
            approved[:10])
    got = git(repo, "rev-list", "--parents", head, "^" + approved,
              "^" + main_ref, *("^" + b for b in below), run=run)
    if got.returncode != 0:
        return False, "git rev-list failed: %s" % got.stderr.strip()
    for line in got.stdout.splitlines():
        sha, *parents = line.split()
        if len(parents) != 2:
            return False, "%s, after the approval, is not a merge" % sha[:10]
        if not any(is_ancestor(repo, p, main_ref, run)
                   or any(is_ancestor(repo, p, b, run) for b in below)
                   for p in parents):
            return False, "%s merges nothing from %s" % (sha[:10], MAIN)
        merged = git(repo, "merge-tree", "--write-tree", *parents, run=run)
        tree = git(repo, "rev-parse", sha + "^{tree}", run=run)
        if (merged.returncode == 0 and tree.returncode == 0
                and merged.stdout.split()[:1] == tree.stdout.split()[:1]):
            continue
        if tree.returncode == 0 and any(
                based_merge(repo, main_side, layer, b, run)
                == tree.stdout.split()[0]
                for b in below for main_side, layer in (parents,
                                                        parents[::-1])):
            continue
        rule = (regenerated_merge(repo, parents, sha, run)
                if RESOLVE and regenerated is not None else None)
        if rule is not None:
            verdict = regenerated(sha, rule)
            if verdict is None:
                return None, ("could not check %s's regenerated files; "
                              "trying again next tick" % sha[:10])
            if verdict:
                continue
        if UNION and tree.returncode == 0 and union.resolve(
                repo, parents[0], parents[1], UNION, run).tree \
                == tree.stdout.split()[0]:
            continue
        return False, ("%s's tree is not the clean merge of its parents"
                       % sha[:10])
    return True, None


def tokenless_env():
    """The environment with every variable named like a token taken out,
    for code a pull request brings (a rule's own `command` or `check`).
    **This is not a sandbox**: the process runs as the host's user. What
    stands between an approved pull request's tool and the Merger's
    write access is the reviewer's approval of that code; taking the
    tokens out only stops the tool using the Merger's by accident."""
    return {k: v for k, v in os.environ.items() if "TOKEN" not in k.upper()}


class Checkout:
    """A temporary detached worktree of `repo` at `sha`, removed on exit.
    `path` is None when it could not be made, and `error` says why."""

    def __init__(self, repo, sha, run=sh):
        self.repo, self.sha, self.run = repo, sha, run
        self.tmp = self.path = None
        self.error = ""

    def __enter__(self):
        self.tmp = tempfile.mkdtemp(prefix="forge-merger-")
        where = os.path.join(self.tmp, "tree")
        added = git(self.repo, "worktree", "add", "-q", "--detach", where,
                    self.sha, run=self.run)
        if added.returncode == 0:
            self.path = where
        else:
            self.error = added.stderr.strip()
        return self

    def __exit__(self, *exc):
        # Removing the directory and pruning is `worktree remove --force`
        # without its refusals, and also clears a half-made worktree.
        shutil.rmtree(self.tmp, ignore_errors=True)
        git(self.repo, "worktree", "prune", run=self.run)
        return False


def tree_tool(where, argv):
    """`argv` with its tool taken from the worktree at `where`: a rule's
    tool is the tree's own copy, which is what made the tree's files."""
    tool = argv[0]
    return [tool if os.path.isabs(tool) else os.path.join(where, tool)] + \
        list(argv[1:])


def regenerated_in(repo, sha, rule, run=sh):
    """Whether `sha`'s files are what rule `rule`'s `check` makes of them,
    run from `sha`'s own tree: True when it exits 0, False when it exits
    1, and None when the check could not be made (a worktree that would
    not open, or any other exit). None is not a verdict."""
    with Checkout(repo, sha, run) as tree:
        if tree.path is None:
            return None
        try:
            got = run(tree_tool(tree.path, RESOLVE[rule]["check"]),
                      cwd=tree.path, env=tokenless_env())
        except OSError:
            return None
        return {0: True, 1: False}.get(got.returncode)


def remembered(state_dir, check):
    """`check(sha, rule)`, remembered in RESOLVE_CHECKED by commit and
    rule: the head it judges is judged every tick until it merges. Only
    a verdict is remembered; a None is asked again next time."""
    path = os.path.join(state_dir, RESOLVE_CHECKED)

    def regenerated(sha, rule):
        seen = load_json(path, {})
        key = "%s %d" % (sha, rule)
        if key in seen:
            return seen[key]
        verdict = check(sha, rule)
        if verdict is not None:
            seen[key] = bool(verdict)
            save_json(path, seen)
        return verdict
    return regenerated


def push_env(github):
    """`github`'s environment with git told to send its token to GitHub,
    through the environment, never the checkout's config."""
    token = github.env.get("GH_TOKEN", "")
    basic = base64.b64encode(("x-access-token:" + token).encode()).decode()
    return dict(github.env, GIT_CONFIG_COUNT="1",
                GIT_CONFIG_KEY_0="http.https://github.com/.extraheader",
                GIT_CONFIG_VALUE_0="AUTHORIZATION: basic " + basic)


def resolve(repo, decision, branch, main_tip, github, run=sh):
    """Merge `main_tip` into the head in a temporary worktree, regenerate
    the rule's files with the tree's own `command`, commit as the
    Merger, and push to `branch` with a lease on the head. Returns
    "done", "refused: why" when the push was refused (the head moved,
    say: the next tick judges afresh), or "failed: why" when the
    conflict could not be resolved this way."""
    head, rule = decision["head"], RESOLVE[decision["rule"]]
    if RESOLVE_IDENTITY is None:
        return "failed: identity: the Merger's commit identity is unknown"
    who = ["-c", "user.name=" + RESOLVE_IDENTITY[0],
           "-c", "user.email=" + RESOLVE_IDENTITY[1]]
    paths = sorted(rule["paths"])
    message = RESOLVE_MESSAGE % (MAIN, branch, ", ".join(paths))
    with Checkout(repo, head, run) as tree:
        if tree.path is None:
            return "failed: worktree: " + tree.error
        here = tree.path
        # --no-commit either way, so the one commit made below is the
        # merge, whether or not git stopped for the conflict.
        git(here, *who, "merge", "-q", "--no-commit", "--no-ff", main_tip,
            run=run)
        left = set(git(here, "diff", "--name-only", "--diff-filter=U",
                       run=run).stdout.split())
        if not left <= rule["paths"]:
            return "failed: the merge conflicts in %s" % ", ".join(
                sorted(left - rule["paths"]))
        # Staged before regenerating as well as after: a tool may refuse
        # an unmerged index, and it rewrites the files, so the conflict
        # markers staged here don't survive it.
        if left:
            got = git(here, "add", "--", *sorted(left), run=run)
            if got.returncode != 0:
                return "failed: git add: " + got.stderr.strip()
        try:
            made = run(tree_tool(here, rule["command"]), cwd=here,
                       env=tokenless_env())
        except OSError as err:
            return "failed: %s could not run: %s" % (
                os.path.basename(rule["command"][0]), err.strerror or err)
        if made.returncode != 0:
            return "failed: %s exited %d: %s" % (
                os.path.basename(rule["command"][0]), made.returncode,
                tail(made.stderr + "\n" + made.stdout, 2))
        for name, args in (("add", ["add", "-A", "--"] + paths),
                           ("commit", who + ["commit", "-q", "-m",
                                             message])):
            got = git(here, *args, run=run)
            if got.returncode != 0:
                return "failed: git %s: %s" % (name, got.stderr.strip())
        pushed = run(["git", "-C", here, "push", "-q",
                      "--force-with-lease=refs/heads/%s:%s" % (branch, head),
                      "https://github.com/%s.git" % REPO_SLUG,
                      "HEAD:refs/heads/" + branch], env=push_env(github))
        if pushed.returncode != 0:
            return "refused: " + tail(pushed.stderr + "\n" + pushed.stdout,
                                      2)
    return "done"


def stack_update(repo, decision, main_tip, github, run=sh):
    """Commit `decision`'s tree (`based_merge`) as a merge of `main_tip`
    into the head, as the Merger, and push it to the layer's branch with
    a lease on the head. "done", "refused: why" or "failed: why", as
    `resolve`."""
    if RESOLVE_IDENTITY is None:
        return "failed: identity: the Merger's commit identity is unknown"
    head, branch = decision["head"], decision["branch"]
    name, email = RESOLVE_IDENTITY
    made = run(["git", "-C", repo, "commit-tree", decision["tree"],
                "-p", head, "-p", main_tip, "-m", STACK_UPDATE_MESSAGE % (
                    MAIN, branch, decision["after"], decision["below"][:10])],
               env=dict(os.environ, GIT_AUTHOR_NAME=name,
                        GIT_AUTHOR_EMAIL=email, GIT_COMMITTER_NAME=name,
                        GIT_COMMITTER_EMAIL=email))
    if made.returncode != 0:
        return "failed: git commit-tree: " + made.stderr.strip()
    pushed = run(["git", "-C", repo, "push", "-q",
                  "--force-with-lease=refs/heads/%s:%s" % (branch, head),
                  "https://github.com/%s.git" % REPO_SLUG,
                  "%s:refs/heads/%s" % (made.stdout.strip(), branch)],
                 env=push_env(github))
    if pushed.returncode != 0:
        return "refused: " + tail(pushed.stderr + "\n" + pushed.stdout, 2)
    github.write("POST", "repos/%s/issues/%d/comments"
                 % (REPO_SLUG, decision["pr"]), body=STACK_UPDATE_NOTE % (
                     MAIN, head[:10], decision["after"],
                     decision["below"][:10], MAIN, MAIN, decision["after"],
                     SIGNATURE))
    return "done"


def union_push(repo, decision, main_tip, github, run=sh):
    """Commit `decision`'s tree (`union.resolve` of the head and
    `main_tip`) as a merge of `main_tip` into the head, as the Merger,
    push it to the branch with a lease on the head it judged, and say
    on the pull request what it kept from each side (designs/0046).
    "done", "refused: why" or "failed: why", as `resolve`."""
    if RESOLVE_IDENTITY is None:
        return "failed: identity: the Merger's commit identity is unknown"
    head, branch = decision["head"], decision["branch"]
    paths = [path for path, _ in decision["files"]]
    name, email = RESOLVE_IDENTITY
    made = run(["git", "-C", repo, "commit-tree", decision["tree"],
                "-p", head, "-p", main_tip, "-m", UNION_MESSAGE % (
                    MAIN, branch, ", ".join(paths))],
               env=dict(os.environ, GIT_AUTHOR_NAME=name,
                        GIT_AUTHOR_EMAIL=email, GIT_COMMITTER_NAME=name,
                        GIT_COMMITTER_EMAIL=email))
    if made.returncode != 0:
        return "failed: git commit-tree: " + made.stderr.strip()
    pushed = run(["git", "-C", repo, "push", "-q",
                  "--force-with-lease=refs/heads/%s:%s" % (branch, head),
                  "https://github.com/%s.git" % REPO_SLUG,
                  "%s:refs/heads/%s" % (made.stdout.strip(), branch)],
                 env=push_env(github))
    if pushed.returncode != 0:
        return "refused: " + tail(pushed.stderr + "\n" + pushed.stdout, 2)
    github.write("POST", "repos/%s/issues/%d/comments"
                 % (REPO_SLUG, decision["pr"]), body=UNION_NOTE % (
                     MAIN, head[:10], MAIN,
                     union.summary(decision["files"], "this branch",
                                   "`%s`" % MAIN), SIGNATURE))
    return "done"


def tree_of(repo, commit, run=sh):
    """{path: (mode, blob)} for every file in `commit`, or None."""
    got = git(repo, "ls-tree", "-r", "-z", "--full-tree", commit, run=run)
    if got.returncode != 0:
        return None
    files = {}
    for entry in got.stdout.split("\0"):
        if entry:
            meta, path = entry.split("\t", 1)
            mode, _, blob = meta.split()
            files[path] = (mode, blob)
    return files


def merge_base(repo, one, other, run=sh):
    got = git(repo, "merge-base", one, other, run=run)
    return got.stdout.strip() if got.returncode == 0 else None


def review_paths(repo, approved, head, main_ref, run=sh):
    """[[kind, [path, ...]], ...] in `PATH_KINDS` order, leaving out
    empty kinds: where a re-review of `head` should start, as the
    module docstring says. [] when git can't answer."""
    main = merge_base(repo, head, main_ref, run)
    base = main and merge_base(repo, approved, main, run)
    trees = [tree_of(repo, c, run) for c in (base, approved, main, head)
             if base]
    if not trees or None in trees:
        return []
    b, a, m, h = trees
    found = {kind: [] for kind, _ in PATH_KINDS}
    for path in sorted(set(b) | set(a) | set(m) | set(h)):
        was, ours, theirs, now = (t.get(path) for t in (b, a, m, h))
        if ours != was:
            seen = now == ours and theirs in (was, ours)
        else:
            seen = now == theirs
        if seen:
            continue
        if now not in (ours, theirs):
            found["neither"].append(path)
        elif now == ours:
            found["approved"].append(path)
        else:
            found["main"].append(path)
    return [[kind, found[kind]] for kind, _ in PATH_KINDS if found[kind]]


def path_span(path):
    """`path` as an inert code span, at most `PATH_CHARS` long."""
    cut = path[:PATH_CHARS]
    shown = json.dumps(cut)[1:-1].replace("`", "\\u0060")
    return "`%s%s`" % (shown, "..." if len(path) > PATH_CHARS else "")


def paths_text(paths):
    """The hand-back's paragraph for `review_paths`' answer."""
    if not paths:
        return ""
    heads = dict(PATH_KINDS)
    lines = []
    for kind, names in paths:
        shown = ", ".join(path_span(n) for n in names[:PATHS_SHOWN])
        if len(names) > PATHS_SHOWN:
            shown += " and %d more" % (len(names) - PATHS_SHOWN)
        lines.append("* %s: %s" % (heads[kind], shown))
    return "Start the re-review with:\n\n%s\n\n" % "\n".join(lines)


def status_state(statuses):
    """(state, description) of the newest `STATUS_CONTEXT` status in
    `statuses`, as REST's commits/<sha>/statuses lists them (newest
    first), counting only those STATUS_CREATOR created; (None, "") when
    there is none."""
    for status in statuses:
        if (status.get("context") == STATUS_CONTEXT
                and (status.get("creator") or {}).get("login")
                == STATUS_CREATOR):
            return (status.get("state") or "unknown",
                    status.get("description") or "")
    return None, ""


def ci_problem(runs):
    """None if the CI workflow succeeded on the head, or the project has
    none, else why not. `runs` are REST's workflow runs for the head
    SHA. A cancelled run is excused only by a successful run of the same
    workflow on the same SHA. No run at all is a wait, not a pass: a
    project that names a workflow runs it on every pull request, so a
    head without one hasn't had it yet (Actions can lag); a run that
    never comes ends in STALLED."""
    if not CI_WORKFLOW:
        return None
    ours = [r for r in runs if r.get("name") == CI_WORKFLOW]
    if not ours:
        return "%s has not started on the head" % CI_WORKFLOW
    green = any(r.get("status") == "completed"
                and r.get("conclusion") == "success" for r in ours)
    for run in ours:
        if run.get("status") != "completed":
            continue
        if run.get("conclusion") in ("success", "skipped"):
            continue
        if run.get("conclusion") == "cancelled" and green:
            continue
        return "%s run %s concluded %s" % (CI_WORKFLOW, run.get("id"),
                                          run.get("conclusion"))
    if not green:
        pending = any(r.get("status") != "completed" for r in ours)
        return "%s has %s on the head" % (
            CI_WORKFLOW, "not finished" if pending else "no successful run")
    return None


def actions_started(github, head):
    """Whether GitHub Actions has any check run on `head`. The runs
    listing filtered by head SHA can lag well behind runs that exist,
    while the commit's check runs show their jobs at once. Anything but
    a check-runs answer reads as none."""
    try:
        got = github.api("repos/%s/commits/%s/check-runs?per_page=100"
                         % (REPO_SLUG, head))
    except RuntimeError:
        return False
    checks = got.get("check_runs") if isinstance(got, dict) else None
    return any(((c.get("app") or {}).get("slug") == "github-actions")
               for c in checks or [])


def never_started(repo, head, github, now, run=sh):
    """With `merge.ci_never_started`, the decision for a head on which
    no CI run is listed: WAIT while Actions shows it starting or the
    head is younger than the limit, else a hand-back to its author."""
    if actions_started(github, head):
        return {"action": "WAIT", "reason": "%s's run is not listed for "
                "the head yet, though its jobs have started" % CI_WORKFLOW}
    committed = git(repo, "log", "-1", "--format=%ct", head,
                    run=run).stdout.strip()
    age = now - datetime.datetime.fromtimestamp(
        int(committed or 0), datetime.timezone.utc)
    if age < CI_NEVER_STARTED:
        return {"action": "WAIT", "reason": "%s has not started on the "
                "head" % CI_WORKFLOW}
    return {"action": "HAND-BACK", "to": "author", "reason": (
        "%s never started on the head in %d minutes, which no approval "
        "changes; close and reopen it, which starts CI on the same head "
        "and keeps its approvals, or push a new head" % (
            CI_WORKFLOW, CI_NEVER_STARTED.total_seconds() // 60))}


def ci_stuck_reason():
    """The reason a pull request goes back to its author once a CI run
    on its head is still unfinished STALL_AFTER after the Merger re-ran
    it. It names no run or SHA, so it is said once per approval and
    head."""
    return ("the %s workflow has not finished on this head, even after "
            "the Merger re-ran it" % CI_WORKFLOW)


def not_own_failure(reason):
    """Whether a hand-back for `reason` is no failure of the pull
    request's own (GitHub lost its head, or never finished its CI), so
    it never counts toward `merge.yield_after_hand_back`."""
    return reason in (LOST_HEAD_REASON, ci_stuck_reason())


def run_jobs(github, run_id):
    """Every job of the CI run `run_id`'s latest attempt, all pages, or
    None when GitHub couldn't be asked."""
    try:
        jobs = github.api("--paginate", "repos/%s/actions/runs/%s/jobs"
                          "?per_page=100" % (REPO_SLUG, run_id),
                          "--jq", ".jobs")
    except (RuntimeError, ValueError):
        return None
    return jobs if isinstance(jobs, list) else None


def judge_runs(runs, github):
    """(runs, stale, unfinished) for the CI workflow's runs on the head.

    GitHub sometimes goes on reporting a run `queued` or `in_progress`
    long after every job in it has completed, and considers it finished
    itself (it refuses to cancel it). So each run of CI_WORKFLOW that
    says it is unfinished is judged by its jobs when they have all
    completed: finished, concluding `success` when every job concluded
    one of GREEN_JOBS, and otherwise the first other job's conclusion.
    `runs` comes back with those runs replaced by what their jobs say;
    `stale` lists them, as {"run", "status", "finished" (the latest job
    completion), "judged" ("green" or "red")}; `unfinished` lists the
    runs whose jobs haven't all completed either (or couldn't be read),
    as {"run", "status", "since" (the run's start)}."""
    judged, stale, unfinished = [], [], []
    for run in runs:
        if run.get("name") != CI_WORKFLOW or run.get("status") == "completed":
            judged.append(run)
            continue
        jobs = run_jobs(github, run.get("id"))
        if not jobs or any(j.get("status") != "completed" for j in jobs):
            unfinished.append({"run": run.get("id"),
                               "status": run.get("status"),
                               "since": run.get("run_started_at")
                               or run.get("created_at")})
            judged.append(run)
            continue
        red = [j.get("conclusion") or "unknown" for j in jobs
               if j.get("conclusion") not in GREEN_JOBS]
        stale.append({"run": run.get("id"), "status": run.get("status"),
                      "finished": max(j.get("completed_at") or ""
                                      for j in jobs) or "?",
                      "judged": "red" if red else "green"})
        judged.append(dict(run, status="completed",
                           conclusion=red[0] if red else "success"))
    return judged, stale, unfinished


def tail(text, lines=TAIL_LINES):
    return "\n".join((text or "").strip().splitlines()[-lines:])


def tool_problem(args, env, cwd, run=sh):
    """None if the tool in `args`, run in `cwd`, exits 0, else its last
    lines. `cwd` is the checkout the head was fetched into, since
    `forge-commit-identity` reads the range from the repository it runs
    in."""
    got = run(args, cwd=cwd, env=env)
    if got.returncode == 0:
        return None
    return "%s exited %d: %s" % (os.path.basename(args[0]), got.returncode,
                                 tail(got.stdout + "\n" + got.stderr))


def gate_problem(args, env, cwd, run=sh):
    """(problem, retry) for a gate tool: `tool_problem`'s answer, and
    whether the tool refused only for now (GATE_RETRY_EXIT)."""
    got = run(args, cwd=cwd, env=env)
    if got.returncode == 0:
        return None, False
    return ("%s exited %d: %s" % (os.path.basename(args[0]), got.returncode,
                                  tail(got.stdout + "\n" + got.stderr)),
            got.returncode == GATE_RETRY_EXIT)


def parse_pages(text):
    """`gh api`'s output as one value. With `--paginate`, gh prints one
    JSON document per page, so several arrays are joined into one;
    several documents of any other kind are refused rather than guessed
    at."""
    decoder, docs, at = json.JSONDecoder(), [], 0
    text = text or ""
    while True:
        while at < len(text) and text[at].isspace():
            at += 1
        if at == len(text):
            break
        value, at = decoder.raw_decode(text, at)
        docs.append(value)
    if not docs:
        return None
    if len(docs) == 1:
        return docs[0]
    if all(isinstance(d, list) for d in docs):
        return [item for d in docs for item in d]
    raise ValueError("%d JSON documents that are not all arrays" % len(docs))


class GitHub:
    """`gh api` with a token, as one place tests replace."""

    def __init__(self, token, run=sh):
        self.env = dict(os.environ, GH_TOKEN=token)
        self.run = run
        self.fetched = {}

    def api(self, *args):
        if args in self.fetched:
            return self.fetched.pop(args)
        got = self.run(["gh", "api"] + list(args), env=self.env)
        if got.returncode != 0:
            raise RuntimeError("gh api %s: %s" % (args[0], got.stderr.strip()))
        return parse_pages(got.stdout)

    def prefetch(self, paths, workers=8):
        """GET each of `paths` at once, side by side, for the next `api`
        call that asks for it, which takes it (once: a second asks
        GitHub again). Each `gh api` costs most of a second, nearly all
        of it waiting, and a tick asked for the statuses of every gated
        pull request's head one after another: about nine seconds of a
        45-second tick on 2026-11-11 (#301). A GET that fails is left
        for `api` to ask again and report."""
        paths = [path for path in dict.fromkeys(paths)
                 if (path,) not in self.fetched]
        if not paths:
            return

        def get(path):
            got = self.run(["gh", "api", path], env=self.env)
            return path, got

        with concurrent.futures.ThreadPoolExecutor(workers) as pool:
            for path, got in pool.map(get, paths):
                if got.returncode == 0:
                    try:
                        self.fetched[(path,)] = parse_pages(got.stdout)
                    except ValueError:
                        pass

    def write(self, method, path, **fields):
        """(True, "") when GitHub took the write, else (False, why). Never
        raises: a refused write is a fact for the record."""
        args = ["gh", "api", "-X", method, path]
        for key, value in sorted(fields.items()):
            args += ["-f", "%s=%s" % (key, value)]
        got = self.run(args, env=self.env)
        if got.returncode == 0:
            return True, ""
        return False, tail(got.stderr + "\n" + got.stdout, 2)

    def create(self, path, **fields):
        """(number, "") for what a POST to `path` created, else (None,
        why). Never raises, as `write`."""
        args = ["gh", "api", "-X", "POST", path, "--jq", ".number"]
        for key, value in sorted(fields.items()):
            args += ["-f", "%s=%s" % (key, value)]
        got = self.run(args, env=self.env)
        if got.returncode == 0 and got.stdout.strip().isdigit():
            return int(got.stdout.strip()), ""
        return None, tail(got.stderr + "\n" + got.stdout, 2)


def fetch_prs(github):
    """Every open pull request as a plain dictionary: GraphQL's node,
    with `reviews` and `comments` flattened to lists and their stamps
    corrected (agent_forge/stamps.py)."""
    owner, name = REPO_SLUG.split("/")
    prs, cursor = [], None
    while True:
        args = ["graphql", "-f", "query=" + PR_QUERY, "-F", "owner=" + owner,
                "-F", "name=" + name]
        if cursor:
            args += ["-F", "cursor=" + cursor]
        page = github.api(*args)["data"]["repository"]["pullRequests"]
        for node in page["nodes"]:
            node["reviews"] = node["reviews"]["nodes"]
            node["comments"] = node["comments"]["nodes"]
            prs.append(stamps.correct(node))
        if not page["pageInfo"]["hasNextPage"]:
            return prs
        cursor = page["pageInfo"]["endCursor"]


ISSUES_QUERY = (
    "query($owner:String!,$name:String!,$endCursor:String){"
    "repository(owner:$owner,name:$name){issues(states:OPEN,first:100,"
    "after:$endCursor){nodes{number}pageInfo{hasNextPage endCursor}}}}")


def fetch_open_issues(github):
    """Numbers of every open issue, for `Blocked-by:` lines that name
    one rather than a pull request. GraphQL, numbers only: REST's issue
    list carries every issue's and pull request's whole body, and paging
    through it was about 4 s of a 13 s tick (agent-forge #301).
    `--paginate` comes first, as `gh` allows, so it pages by `endCursor`."""
    owner, name = REPO_SLUG.split("/")
    got = github.api("--paginate", "graphql", "-f", "query=" + ISSUES_QUERY,
                     "-F", "owner=" + owner, "-F", "name=" + name,
                     "--jq", "[.data.repository.issues.nodes[].number]")
    return set(got or [])


def decide(pr, approval, repo, main_tip, github, env, run=sh, below=(),
           regenerated=None, now=None, restack=None):
    """The action for one eligible pull request, as a dictionary with
    `action`, and `to` and `reason` for a hand-back. Reads, never
    writes. `below` and `regenerated` are passed to `covers_head`;
    `now` is the tick's clock. `restack`, for a stack's layer, is (the
    number of the layer below, which merged, and its final head): when
    `main` conflicts with the layer and the layer lacks that head, a
    clean merge of it is RESTACK (designs/0025)."""
    number, head = pr["number"], pr["headRefOid"]
    approver = APPROVERS.get(login(approval), "a reviewer")

    def back(to, reason):
        return {"action": "HAND-BACK", "to": to, "reason": reason}

    fetched = fetch_pr(repo, number, head, run)
    if fetched.returncode != 0:
        return {"action": "SKIP", "reason": "fetch failed: %s"
                % fetched.stderr.strip()}
    if git(repo, "rev-parse", PR_REF % number, run=run).stdout.strip() != head:
        return {"action": "SKIP", "reason": "the head moved while reading"}
    approved = (approval.get("commit") or {}).get("oid")
    if not approved:
        return back(approver, "the approval names no commit")
    main_ref = "refs/remotes/origin/" + MAIN
    covered, why = covers_head(repo, approved, head, main_ref, run, below,
                               regenerated)
    if covered is None:
        return {"action": "SKIP", "reason": why}
    if not covered:
        return dict(back(approver, why),
                    paths=review_paths(repo, approved, head, main_ref, run))
    if not is_ancestor(repo, main_tip, head, run):
        # GitHub refuses to update a head that conflicts with main, and
        # retrying it every tick would stall the queue behind it. Ask
        # git first: 1 is a conflict, and anything but 0 or 1 is git
        # failing, which leaves the question to GitHub and the backstop
        # in `tick`.
        merged = git(repo, "merge-tree", "--write-tree", "--name-only",
                     "--no-messages", main_tip, head, run=run)
        if merged.returncode == 1:
            if restack is not None and not is_ancestor(repo, restack[1],
                                                       head, run):
                after, lower = restack
                again = git(repo, "merge-tree", "--write-tree", "--name-only",
                            "--no-messages", head, lower, run=run)
                if again.returncode == 0:
                    return {"action": "RESTACK", "after": after,
                            "below": lower, "branch": pr["headRefName"]}
                if again.returncode == 1:
                    return dict(back("author", RESTACK_REASON % (
                        CONFLICT_REASON, after, lower[:10])),
                        detail=RESTACK_DETAIL % (after, lower[:10], MAIN))
            if restack is not None:
                after, lower = restack
                tree = based_merge(repo, main_tip, head, lower, run)
                if tree is not None:
                    return {"action": "STACK-UPDATE", "after": after,
                            "below": lower, "tree": tree,
                            "branch": pr["headRefName"]}
            rule = resolve_rule(conflicted_paths(merged.stdout))
            if RESOLVE and rule is not None:
                return {"action": "RESOLVE", "rule": rule}
            if UNION:
                got = union.resolve(repo, head, main_tip, UNION, run)
                if got.tree:
                    return {"action": "UNION", "tree": got.tree,
                            "files": got.files, "branch": pr["headRefName"]}
                return dict(back("author", CONFLICT_REASON),
                            detail=UNION_DETAIL % got.reason)
            return back("author", CONFLICT_REASON)
        return {"action": "UPDATE"}
    state, said = status_state(github.api(
        "repos/%s/commits/%s/statuses?per_page=100" % (REPO_SLUG, head))
        or [])
    if state in (None, "pending"):
        return {"action": "WAIT", "reason": "%s is %s" % (
            STATUS_CONTEXT, state or "absent")}
    if state != "success":
        return back("author", "%s is %s%s" % (
            STATUS_CONTEXT, state, ": " + said if said else ""))
    problem, notes = None, {}
    if CI_WORKFLOW:
        runs = github.api("repos/%s/actions/runs?head_sha=%s&per_page=100"
                          % (REPO_SLUG, head))
        runs, stale, unfinished = judge_runs(
            (runs or {}).get("workflow_runs") or [], github)
        if stale:
            notes["ci_stale"] = stale
        problem = ci_problem(runs)
        if (CI_NEVER_STARTED is not None and problem
                and not any(r.get("name") == CI_WORKFLOW for r in runs)):
            return dict(never_started(repo, head, github, now or now_utc(),
                                      run), **notes)
    if problem and ("not finished" in problem or "not started" in problem):
        if unfinished:
            notes["ci_unfinished"] = unfinished
        return dict({"action": "WAIT", "reason": problem}, **notes)
    if problem:
        return dict(back("author", problem), **notes)
    for argv in GATE:
        problem, retry = gate_problem(
            gate_args(argv, repo, number, main_tip, head,
                      restack[0] if restack else None), env, repo, run)
        if problem:
            # A gate tool may read the description, so the hand-back is
            # for this one: a new description is a new question.
            if retry:
                notes.update(retry=True, at=iso(now or now_utc()))
            return dict(back("author", problem), text=description(pr),
                        **notes)
    if AHEAD_BATCH > 1 and COVERED_TEXT in said:
        notes["covered"] = True
    return dict({"action": "MERGE"}, **notes)


def gate_args(argv, repo, number, base, head, below=None):
    """A gate tool's argument list, filled in: `{pr}`, `{base}` and
    `{head}` in any argument, an argument that is exactly `{below}` by
    the number of the merged stack layer below (designs/0025), or by
    nothing when there is none, and the tool's path, from this
    installation for a `forge-` tool and from `repo` otherwise."""
    filled = [a.replace("{pr}", str(number)).replace("{base}", base)
              .replace("{head}", head) for a in argv
              if a != "{below}" or below is not None]
    filled = [str(below) if a == "{below}" else a for a in filled]
    tool = filled[0]
    if os.sep not in tool and tool.startswith("forge-"):
        filled[0] = os.path.join(BIN, tool)
    else:
        filled[0] = os.path.join(repo, tool)
    return filled


# What a hand-back for a conflict tells the author to do. Agents read
# "a reviewer approves a head that fixes it" as every reviewer, again,
# for every merge, and asked for approvals a clean merge never needed.
CONFLICT_ADVICE = (
    "Merge `main` into the branch rather than rebasing it. Once one "
    "reviewer approves the merge that resolves the conflict, the Merger "
    "takes it again. A merge git makes cleanly, with nothing resolved, "
    "needs no new approval: the approval of the head before it still "
    "covers it, and the Merger merges `main` in itself that way.")

# The queue as the tick that posts a hand-back sees it, for
# `others_text`: set by `tick` before it acts.
QUEUE_VIEW = {}


def others_text(number, view=None):
    """For a hand-back of pull request `number`: its author's other open
    pull requests,
    oldest first, each with its place in the queue or why it is held, so
    they fix the one nearest the front first and can see which to stack
    on which. "" when they have none."""
    view = QUEUE_VIEW if view is None else view
    queue = view.get("queue") or []
    held = {str(k): v for k, v in (view.get("held") or {}).items()}
    prs = view.get("prs") or ()
    author = next((login(p) for p in prs if p["number"] == number), "")
    lines = []
    for pr in sorted(prs, key=lambda p: p["number"]):
        if pr["number"] == number or login(pr) != author or not author:
            continue
        if pr["number"] in queue:
            where = "number %d of %d in the queue" % (
                queue.index(pr["number"]) + 1, len(queue))
        elif str(pr["number"]) in held:
            where = "held: %s" % held[str(pr["number"])]
        elif pr.get("isDraft"):
            where = "a draft"
        else:
            where = "not approved at its head yet"
        lines.append("* #%d: %s" % (pr["number"], where))
    if not lines:
        return ""
    return ("Your other open pull requests, oldest first:\n\n%s\n\n"
            "Fix the one nearest the front first. Two that change the same "
            "lines merge more easily as a stack, one based on the other's "
            "branch, than side by side.\n\n" % "\n".join(lines))


def hand_back_text(decision, approver):
    """The comment a hand-back posts. To the author it is plain, with the
    decision's `detail` when it has one; for a conflict, with what to
    do (CONFLICT_ADVICE) and their other open pull requests
    (`others_text`). To the approver it starts `Not-a-review`, since it
    asks for a review."""
    if decision["to"] == "author":
        detail = decision.get("detail")
        if decision["reason"].startswith(CONFLICT_REASON):
            return ("Not merging %s: %s.\n\n%sThis is back with its "
                    "author. %s\n\n%s%s" % (
                        decision["head"][:10], decision["reason"],
                        detail + "\n\n" if detail else "",
                        CONFLICT_ADVICE,
                        others_text(decision["pr"]),
                        SIGNATURE))
        return ("Not merging %s: %s.\n\n%sThis is back with its author. "
                "Once a reviewer approves a head that fixes it, the Merger "
                "takes it again.\n\n%s" % (decision["head"][:10],
                                             decision["reason"],
                                             detail + "\n\n" if detail
                                             else "", SIGNATURE))
    return ("Not-a-review\n\nNot merging %s: %s. The approval doesn't "
            "cover the head, so this needs %s's approval of it.\n\n%s%s"
            % (decision["head"][:10], decision["reason"], approver,
               paths_text(decision.get("paths")), SIGNATURE))


def hand_back_key(approval, head, reason, text=None):
    """What `handed-back.json` keeps per pull request: the hand-back
    already said for this approval, head and reason, and for a
    `merge.gate` tool's refusal, the description (`description`) it
    was judged on."""
    key = {"approved": approval.get("submittedAt"), "head": head,
           "reason": reason}
    if text is not None:
        key["text"] = text
    return key


def told(before, key):
    """Whether `before`, a hand-back from `handed-back.json`, already
    said what the hand-back `key` (`hand_back_key`) would say. The same
    approval, head and reason always has. With ONCE_PER_HEAD (designs/
    0044, rule 1) so has any other hand-back under the same approval
    and head: the author already has it, and a second reason for the
    same head is only noise. On one project on 2026-11-04, 32 of 84
    hand-backs in a morning repeated one already told for the same head;
    one head was told 8 times in an hour, alternating between a conflict
    with main and a merge after the approval that wasn't clean, since
    each replaced the other in `said`. Three hand-backs still count as
    new: a conflict with main after the reviewer was told the merge
    wasn't clean, since the conflict is the author's to act on; one after a gate's refusal of a description (`text`), unless
    it is the same refusal of the same description, since the author
    may fix the description alone; and one after a gate's refusal for
    now (`retry`) for another reason, since that refusal wasn't the
    author's to fix."""
    if {k: v for k, v in before.items() if k != "at"} == key:
        return True
    if not ONCE_PER_HEAD or before.get("approved") != key["approved"] \
            or before.get("head") != key["head"]:
        return False
    if before.get("text") and before["text"] != key.get("text"):
        return False
    # A conflict with main is the author's to fix: telling the reviewer
    # that the author's merge wasn't clean doesn't tell the author that
    # main has moved again. Once the conflict is said, the other reason is not
    # said after it: the author's next merge makes a new head anyway.
    if CONFLICT_REASON in key["reason"] and NOT_CLEAN_MARK in str(
            before.get("reason") or ""):
        return False
    return not (before.get("retry") and before.get("reason") != key["reason"])


def description(pr):
    """A short hash of `pr`'s title and body: what a `merge.gate` tool
    that reads the description was given."""
    text = "%s\n%s" % (pr.get("title") or "", pr.get("body") or "")
    return hashlib.sha256(text.encode()).hexdigest()[:16]


def description_moved(before, pr):
    """Whether `before`, a hand-back from `handed-back.json`, was for a
    gate's refusal of another description than `pr` has now: the
    author's fix for a closing keyword is a new description, at the
    same head and approval. A record without one keeps the head and
    approval as its only key."""
    return bool(before.get("text")) and before["text"] != description(pr)


def carry_out(decision, approval, github, said):
    """Do what `decision` says, as `github`'s App, and return the result
    for the record, or None for an action that writes nothing. `said`
    maps a pull request's number, as a string, to the approval, head
    and reason it was last handed back for; a hand-back already said is
    not said again. The approval is part of the key: a new approval of
    an unchanged head that still fails is a new question, so it gets
    its own answer."""
    number, head = decision["pr"], decision["head"]
    approver = APPROVERS.get(login(approval), "a reviewer")
    path = "repos/%s/pulls/%d" % (REPO_SLUG, number)
    if decision["action"] == "UPDATE":
        ok, why = github.write("PUT", path + "/update-branch",
                               expected_head_sha=head)
        if ok:
            # Without it the approvals look stale on GitHub, and authors
            # asked every reviewer to approve again. Its failure changes
            # nothing: the update stands.
            github.write("POST", "repos/%s/issues/%d/comments"
                         % (REPO_SLUG, number), body=UPDATE_NOTE % (
                             MAIN, head[:10], SIGNATURE))
    elif decision["action"] == "RESTACK":
        # GitHub's merges API takes no lease on the head: a push between
        # reading it and this write is merged with, and judged afresh.
        lower = decision["below"]
        ok, why = github.write(
            "POST", "repos/%s/merges" % REPO_SLUG, base=decision["branch"],
            head=lower, commit_message="Merge #%d's final head %s into %s" % (
                decision["after"], lower[:10], decision["branch"]))
        if ok:
            github.write("POST", "repos/%s/issues/%d/comments"
                         % (REPO_SLUG, number), body=RESTACK_NOTE % (
                             decision["after"], lower[:10], head[:10],
                             decision["after"], MAIN, SIGNATURE))
    elif decision["action"] == "MERGE":
        ok, why = github.write("PUT", path + "/merge", sha=head,
                               merge_method="squash")
    elif decision["action"] == "RETARGET":
        ok, why = github.write("PATCH", path, base=MAIN)
    elif decision["action"] == "HAND-BACK":
        key = hand_back_key(approval, head, decision["reason"],
                            decision.get("text"))
        if decision.get("retry"):
            # A refusal for now: kept with when it was asked, so that
            # `handed_back` asks again GATE_RETRY later. Refused again
            # the same way, it is not said again; only the time moves.
            key["retry"] = True
            asked = dict(key, at=decision.get("at") or iso(now_utc()))
        before = said.get(str(number))
        if isinstance(before, dict) and told(before, key):
            if decision.get("retry") and before.get("reason") == key["reason"]:
                said[str(number)] = asked
            return "already said"
        ok, why = github.write(
            "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG, number),
            body=hand_back_text(decision, approver))
        if ok:
            said[str(number)] = asked if decision.get("retry") else key
    else:
        return None
    return "done" if ok else "refused: " + why


def load_json(path, default):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def save_json(path, value):
    with open(path + ".tmp", "w") as handle:
        json.dump(value, handle, sort_keys=True)
    os.replace(path + ".tmp", path)


def stalled_for(state_dir, waiting, when, check_state=None, repo=None,
                run=sh):
    """Whole minutes the Merger has waited on `waiting`'s head, once that
    is `STALL_AFTER` or more, else None. `waiting` is the tick's WAIT
    decision or a write GitHub refused, or None when the tick is held up
    by nothing, which forgets the wait. The wait is timed per pull
    request and head, so a new head or a different pull request starts
    it again.

    With `merge.queued_stall_minutes` and `check_state`, the build
    check's state, a WAIT is judged by where the check has the head:
    queued (waiting, not started), a stall only after
    QUEUED_STALL_AFTER; running, a stall once STALL_AFTER has passed
    since the later of the wait's start and the run's; neither, as
    without it.

    A WAIT's STALL_AFTER is stretched to STALL_RUN_FACTOR times the
    median of the build check's recent runs, when that is longer
    (`stall_limit`). A head first in a batch is timed from when the
    build check started a run of the batch's top, or of any commit with
    the top's tree (`batch_top_started`, given `repo`): the check runs a
    tree once, and a later prediction with the same tree waits for it.
    Neither started, it is timed as before. A head waiting for train 1's
    run (TRAIN_AHEAD_REASON, `train_top`) is timed from that run's start
    the same way."""
    path = os.path.join(state_dir, "waiting.json")
    if waiting is None:
        if os.path.exists(path):
            os.remove(path)
        return None
    since = load_json(path, {})
    try:
        began = datetime.datetime.strptime(
            since["since"], "%Y-%m-%dT%H:%M:%SZ").replace(
                tzinfo=datetime.timezone.utc)
        same = (since["pr"], since["head"]) == (waiting["pr"],
                                                 waiting["head"])
    except (KeyError, TypeError, ValueError):
        same = False
    if not same:
        began = when
        save_json(path, {"pr": waiting["pr"], "head": waiting["head"],
                         "since": iso(when)})
    waited = when - began
    limit, since = STALL_AFTER, began
    if waiting.get("action") == "WAIT":
        limit = stall_limit(check_state)
    queue = (check_state or {}).get("waiting")
    entry = queue.get(waiting["head"]) if isinstance(queue, dict) else None
    if (QUEUED_STALL_AFTER is not None and waiting.get("action") == "WAIT"
            and isinstance(entry, dict)):
        try:
            started = parse_time(entry.get("started"))
        except (TypeError, ValueError):
            started = None
        if started is None:
            limit = QUEUED_STALL_AFTER
        else:
            since = max(began, started)
    if waiting.get("action") == "WAIT" and waiting.get("train_top"):
        # Waiting for train 1's run, not its own: timed from that run's
        # start against a top's limit, as the train's own wait is.
        started = (check_state or {}).get("ahead_started") or {}
        try:
            top = parse_time((started if isinstance(started, dict) else {})
                             .get(waiting["train_top"]))
        except (TypeError, ValueError):
            top = None
        if top is not None:
            limit, since = stall_limit(check_state, top=True), \
                max(since, top)
    elif waiting.get("action") == "WAIT":
        top = batch_top_started(state_dir, waiting, check_state, repo, run)
        if top is not None:
            limit, since = stall_limit(check_state, top=True), \
                max(since, top)
    if when - since < limit:
        return None
    return int(waited.total_seconds() // 60)


def stall_limit(check_state, top=False):
    """How long a WAIT may last before it is a stall: STALL_AFTER, or
    STALL_RUN_FACTOR times the median length of the build check's
    STALL_RUNS most recently finished runs in `check_state` when that is
    longer. A result copied from another run (a match, a batch's cover)
    took no time of its own and isn't counted. With `top`, a wait on a
    batch's or train's top, the 90th percentile stands in for the
    median: a top's tree holds every member's changes and runs the
    steps any of them touches, so it takes as long as the longest
    single heads, and timed against the median (most heads run few
    steps) every train was called a stall (2026-11-12)."""
    if not STALL_RUN_FACTOR:
        return STALL_AFTER
    took = []
    results = (check_state or {}).get("results")
    for result in (results.values() if isinstance(results, dict) else ()):
        if not isinstance(result, dict) or result.get("covered") \
                or not result.get("seconds"):
            continue
        try:
            took.append((parse_time(result["finished"]),
                         parse_time(result["finished"])
                         - parse_time(result["started"])))
        except (KeyError, TypeError, ValueError):
            continue
    recent = sorted(t for _, t in sorted(took)[-STALL_RUNS:])
    if not recent:
        return STALL_AFTER
    if top:
        typical = recent[min(len(recent) - 1, (len(recent) * 9) // 10)]
        return max(STALL_AFTER, typical * STALL_RUN_FACTOR)
    middle = len(recent) // 2
    median = recent[middle] if len(recent) % 2 else \
        (recent[middle - 1] + recent[middle]) / 2
    return max(STALL_AFTER, median * STALL_RUN_FACTOR)


def batch_top_started(state_dir, waiting, check_state, repo=None, run=sh):
    """When the build check started the top of the batch `waiting`'s
    head is first in, by the last tick's AHEAD_FILE and the check's
    `ahead_started`, or None: not first in a batch, or its top not
    started. Such a head is never checked on its own: it waits for the
    top, whose tree includes it (designs/0032), so its wait is timed
    from the top's start, as a head the check runs is from its own.
    Given `repo`, a run in progress of any commit with the top's tree
    (the check's `running` slots) counts as the top's: the check never
    runs a tree a slot is already running, so a top whose earlier
    prediction, the same tree at another commit, is running isn't
    started until that run ends, and its green covers the top
    (2026-11-12: such waits were called stalls)."""
    started = (check_state or {}).get("ahead_started")
    running = (check_state or {}).get("running")
    if not isinstance(started, dict):
        started = {}
    if not started and not running:
        return None
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    entries = last.get("entries") if isinstance(last, dict) else None
    batch = last.get("batch") if isinstance(last, dict) else None
    try:
        size = int((batch or {}).get("size") or 0)
        first, top = entries[0], entries[size - 1]
        if size < 1 or (first["pr"], first["head"]) != (waiting["pr"],
                                                         waiting["head"]):
            return None
        if top["sha"] in started:
            return parse_time(started[top["sha"]])
    except (AttributeError, IndexError, KeyError, TypeError, ValueError):
        return None
    if repo is None or not isinstance(running, list):
        return None
    for slot in running:
        try:
            sha, at = slot["sha"], parse_time(slot["started"])
        except (KeyError, TypeError, ValueError):
            continue
        if sha == top["sha"]:
            return at
        tree = git(repo, "rev-parse", "--verify", "-q", sha + "^{tree}",
                   run=run)
        if tree.returncode == 0 and tree.stdout.strip() == top.get("tree"):
            return at
    return None


def where_to_look():
    """Where a wait that never ends is looked into: the build check, on
    its host, and the CI workflow, when the project names them."""
    return "the build check%s%s" % (
        " on " + BUILD_HOST if BUILD_HOST else "",
        ", or the %s workflow in GitHub Actions" % CI_WORKFLOW
        if CI_WORKFLOW else "")


def short(sha):
    return (sha or "?")[:12]


def lost_text(lost):
    """What GitHub said the pull request's head and its branch are, for a
    write it refused because the head it expected didn't match, from
    `lost_head`'s record (None when they couldn't be read)."""
    if not lost:
        return ("GitHub's pull request head and its branch could not be "
                "read")
    if lost["github"] == lost["branch"]:
        return ("GitHub's pull request head and its branch agree, at %s"
                % short(lost["github"]))
    nudge = lost.get("nudge") or ""
    if nudge.startswith("refused"):
        after = "a no-op base update to make GitHub read it again was " + nudge
    else:
        after = "a no-op base update didn't make GitHub read it again"
    return ("GitHub's pull request head is %s but its branch is at %s, and %s"
            % (short(lost["github"]), short(lost["branch"]), after))


def refusal_hint(stalled):
    """What a stall on a refused write says to do about it: the Merger
    App's access only when GitHub refused it as such (401, 403)."""
    if "lost" in stalled:
        return lost_text(stalled["lost"])
    if ACCESS_RE.search(stalled["refused"]):
        return "look at the Merger App's access"
    return "GitHub's answer says why"


def stall_batch(state_dir, pr):
    """(span, top sha) of the batch in the last tick's AHEAD_FILE that
    `pr` is a member of, or None. Its head's own check is then held for
    the top's run, and its status says so (agent-forge #285)."""
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    if not isinstance(last, dict):
        return None
    entries = [e for e in last.get("entries") or [] if isinstance(e, dict)]
    for batch in [last.get("batch")] + list(last.get("later") or []):
        trees = batch.get("trees") if isinstance(batch, dict) else None
        if not isinstance(trees, list) or not trees:
            continue
        members = [e for e in entries if e.get("tree") in trees]
        if not members or pr not in {e.get("pr") for e in members}:
            continue
        top = members[-1]
        if not isinstance(top.get("sha"), str):
            return None
        return "#%s..#%s" % (members[0].get("pr"), top.get("pr")), top["sha"]
    return None


def stall_text(stalled, reason=None, batch=None):
    """What a stall is, for the issue and the message: the pull request,
    the head, how long, and GitHub's own words when it refused. `reason`
    is the WAIT decision's, when it is a wait. `batch`, (span, top sha)
    from stall_batch, names the batch whose top's run the head waits
    on."""
    if "refused" in stalled:
        hint = refusal_hint(stalled)
        what = ("GitHub has refused the Merger's write for %d minutes, "
                "most recently:\n\n```\n%s\n```\n\n%s." % (
                    stalled["minutes"], stalled["refused"],
                    hint[0].upper() + hint[1:]))
    else:
        what = ("it has waited %d minutes%s; %slook at %s."
                % (stalled["minutes"], ": " + reason if reason else "",
                   "it is in the Merger's batch %s, whose top `%s` the "
                   "build check runs for it: " % (batch[0], batch[1][:10])
                   if batch else "", where_to_look()))
    if stalled.get("handed_back"):
        then = ("It has gone back to its author, and the queue moves past "
                "it.")
    else:
        then = ("It stays first in the queue, so nothing behind it merges "
                "until this clears.")
    return ("The merge queue is stalled on #%d at `%s`: %s\n\n%s"
            % (stalled["pr"], stalled["head"][:10], what, then))


def ended_by(pr, decisions):
    """How the stall on `pr` ended, from this tick's decisions."""
    for d in decisions:
        if d["pr"] == pr:
            return "this tick's %s of #%d" % (d["action"], pr)
    return "#%d is no longer first in the queue" % pr


def label_path(number, label=None):
    """The REST path of issue `number`'s labels, or of one of them. A
    label is a path segment there, so it is quoted: one may hold a
    space or a slash."""
    path = "repos/%s/issues/%d/labels" % (REPO_SLUG, number)
    return path + "/" + urllib.parse.quote(label, safe="") if label else path


def end_stall(state_dir, github, alert, decisions, out):
    """Comment how the stall in `alert` ended, take the owner's label
    off if it was put on, close its issue and forget it. The issue is
    forgotten even when GitHub refuses: closing it again on every tick
    would say the same thing each time, and a person can close it."""
    number = alert["issue"]
    github.write("POST", "repos/%s/issues/%d/comments" % (REPO_SLUG, number),
                 body="The stall has ended: %s.\n\n%s"
                 % (ended_by(alert["pr"], decisions), SIGNATURE))
    if alert.get("to_owner"):
        github.write("DELETE", label_path(number, WAITING_OWNER))
    ok, why = github.write("PATCH", "repos/%s/issues/%d" % (REPO_SLUG, number),
                           state="closed")
    out("STALL-ENDED: closed #%d" % number if ok
        else "STALL-ENDED: #%d could not be closed: %s" % (number, why))
    path = os.path.join(state_dir, STALL_ALERT_NAME)
    if os.path.exists(path):
        os.remove(path)


MERGED_PATH = ("repos/%s/pulls?state=closed&sort=updated&direction=desc"
               "&per_page=50&base=%s")


def record_hand_merges(state_dir, github, out, when):
    """merge.mode manual (agent-forge #274): append a MERGE record to
    merger.jsonl, at its merge time, for each pull request merged since
    the last run, so what counts the Merger's merges counts these. The
    first run only starts the clock: nothing before it is recorded."""
    path = os.path.join(state_dir, HAND_MERGES_NAME)
    seen = load_json(path, {})
    since = seen.get("since") if isinstance(seen, dict) else None
    if not since:
        save_json(path, {"since": iso(when)})
        out("MANUAL: merge.mode is manual; counting hand merges from now")
        return []
    merged = sorted(
        (pr["merged_at"], pr["number"], (pr.get("merged_by") or {}).get(
            "login") or (pr.get("user") or {}).get("login"))
        for pr in github.api(MERGED_PATH % (REPO_SLUG, MAIN)) or []
        if isinstance(pr, dict) and pr.get("merged_at")
        and pr["merged_at"] > since)
    records = [{"at": at, "queue": [], "held": {}, "manual": True,
                "decisions": [{"pr": number, "action": "MERGE",
                               "result": "done", "by": who}]}
               for at, number, who in merged]
    if records:
        with open(os.path.join(state_dir, "merger.jsonl"), "a") as handle:
            for record in records:
                handle.write(json.dumps(record, sort_keys=True) + "\n")
        save_json(path, {"since": merged[-1][0]})
    out("MANUAL: merge.mode is manual; %d hand merge(s) recorded%s" % (
        len(records), ": " + ", ".join("#%d" % n for _, n, _ in merged)
        if merged else ""))
    return records


def merge_ready(repo, github, number, run=sh):
    """Why pull request `number` isn't ready to merge by hand, as a
    list, empty when it is (agent-forge #274): open and not a draft,
    `checks.context` green (by its poster) and the CI workflow passed on
    the head, the default branch's tip in its history, no `Blocked-by:`
    item open, and, with merge.code_owners, an owner's word."""
    prs = fetch_prs(github)
    pr = next((p for p in prs if p["number"] == number), None)
    if pr is None:
        return ["#%d is not an open pull request" % number]
    head, why = pr["headRefOid"], []
    if pr.get("isDraft"):
        why.append("it is a draft")
    state, said = status_state(github.api(
        "repos/%s/commits/%s/statuses?per_page=100" % (REPO_SLUG, head))
        or [])
    if state != "success":
        why.append("%s is %s%s" % (STATUS_CONTEXT, state or "absent",
                                   ": " + said if said else ""))
    if CI_WORKFLOW:
        problem = ci_problem(github.api(
            "repos/%s/actions/runs?head_sha=%s&per_page=100"
            % (REPO_SLUG, head)).get("workflow_runs") or [])
        if problem:
            why.append(problem)
    git(repo, "fetch", "-q", "origin", MAIN, run=run)
    main_ref = "refs/remotes/origin/" + MAIN
    have_head(repo, pr, run)
    if git(repo, "merge-base", "--is-ancestor", main_ref, head,
           run=run).returncode != 0:
        why.append("it is not current with %s: merge %s into it first"
                   % (MAIN, MAIN))
    open_numbers = {p["number"] for p in prs} | fetch_open_issues(github)
    blocking = sorted(blockers_of(pr) & open_numbers)
    if blocking:
        why.append("Blocked-by %s, still open" % ", ".join(
            "#%d" % n for n in blocking))
    if CODE_OWNERS:
        rules = codeowners_rules(repo, main_ref, run)
        held = rules and code_owner_wait(repo, pr, rules, main_ref, run)
        if held:
            why.append(held)
    return why
def code_owner_asks(state_dir, github, waits, open_heads, out):
    """merge.code_owner_ask (agent-forge #153): one issue for each pull
    request held for a code owner at a head, so an owner working from a
    list of asks sees it. `waits` maps the pull requests judged this tick
    to (head, why held or None); `open_heads` maps every open pull
    request to its head. An ask is closed when its pull request is no
    longer open, has another head, or was judged and isn't held; one not
    judged this tick (no longer a candidate for another reason) stays.
    What GitHub refuses is tried again next tick."""
    path = os.path.join(state_dir, CODE_OWNER_ASK_NAME)
    asks = load_json(path, {})
    title, labels = CODE_OWNER_ASK
    for key, ask in sorted(asks.items()):
        number = int(key)
        head, why = waits.get(number, (ask["head"], "unjudged"))
        if open_heads.get(number) == ask["head"] == head and why:
            continue
        ended = ("#%d was closed" % number if number not in open_heads
                 else "#%d has a new head" % number
                 if open_heads[number] != ask["head"]
                 else "#%d no longer waits for a code owner" % number)
        github.write("POST", "repos/%s/issues/%d/comments"
                     % (REPO_SLUG, ask["issue"]),
                     body="%s.\n\n%s" % (ended, SIGNATURE))
        ok, refused = github.write(
            "PATCH", "repos/%s/issues/%d" % (REPO_SLUG, ask["issue"]),
            state="closed")
        out("CODE-OWNER-ASK-CLOSED: #%d for #%d" % (ask["issue"], number)
            if ok else "CODE-OWNER-ASK-CLOSED: #%d for #%d could not be "
            "closed: %s" % (ask["issue"], number, refused))
        # Forgotten even when refused, as a stall's issue is: a person
        # can close it.
        del asks[key]
    for number, (head, why) in sorted(waits.items()):
        if not why or str(number) in asks:
            continue
        body = {"title": title.replace("{pr}", str(number)),
                "body": "The Merger holds #%d at %s: it %s.\n\nIt merges "
                "once a code owner approves at this head, and closes this "
                "issue then, or when the head changes.\n\n%s"
                % (number, head, why, SIGNATURE)}
        issue, refused = github.create("repos/%s/issues" % REPO_SLUG, **body)
        if issue is None:
            out("CODE-OWNER-ASK refused: #%d: %s" % (number, refused))
            continue
        out("CODE-OWNER-ASK: opened #%d for #%d at %s"
            % (issue, number, head[:10]))
        asks[str(number)] = {"head": head, "issue": issue, "labeled": []}
    for key, ask in sorted(asks.items()):
        labeled = ask.setdefault("labeled", list(labels))
        for label in labels:
            if label in labeled:
                continue
            ok, refused = github.write("POST", label_path(ask["issue"]),
                                       **{"labels[]": label})
            if ok:
                labeled.append(label)
            else:
                out("CODE-OWNER-ASK-LABEL refused: %s on #%d: %s"
                    % (label, ask["issue"], refused))
    if asks or os.path.exists(path):
        save_json(path, asks)


def tell_stall(state_dir, github, stalled, decisions, when, send, out,
               reason=None):
    """A stall opens its own issue and messages STALL_TELL, again every
    STALL_RETELL while it lasts, adds WAITING_OWNER after STALL_TO_OWNER,
    and closes the issue when it ends. `stalled` is the tick's record of
    it, or None when nothing is stalled; `send` is a function (agent
    name, text) -> None when the relay took the message, else why not,
    or None to message nobody.

    Its own issue, so no wait recorded on another item can hide it. The
    message repeats because an agent that restarted has lost the first
    one. Nothing here raises: what GitHub refused is printed and tried
    again on the next tick, labels included, so the router can always
    see whose the issue is. A message is tried again on the next tick
    only if nobody took it; once anyone has, the rest hear again
    STALL_RETELL later."""
    path = os.path.join(state_dir, STALL_ALERT_NAME)
    alert = load_json(path, {})
    same = stalled is not None and (alert.get("pr"), alert.get("head")) == (
        stalled["pr"], stalled["head"])
    if alert.get("issue") and not same:
        end_stall(state_dir, github, alert, decisions, out)
        alert = {}
    if stalled is None:
        if os.path.exists(path):
            os.remove(path)
        return
    text = stall_text(stalled, reason,
                      None if "refused" in stalled
                      else stall_batch(state_dir, stalled["pr"]))
    if not same:
        number, why = github.create(
            "repos/%s/issues" % REPO_SLUG,
            title=STALL_TITLE.replace("{pr}", str(stalled["pr"])),
            body="%s\n\nThe Merger closes this when the stall ends.\n\n%s"
            % (text, SIGNATURE))
        if number is None:
            # Nothing is saved, so the next tick opens it again.
            out("STALL-ISSUE refused: %s" % why)
            return
        out("STALL-ISSUE: opened #%d" % number)
        alert = {"pr": stalled["pr"], "head": stalled["head"],
                 "issue": number, "labeled": []}
    number = alert["issue"]
    labeled = alert.setdefault("labeled", list(STALL_LABELS))
    for label in STALL_LABELS:
        if label in labeled:
            continue
        ok, why = github.write("POST", label_path(number),
                               **{"labels[]": label})
        if ok:
            labeled.append(label)
        else:
            out("STALL-LABEL refused: %s on #%d: %s" % (label, number, why))
    if (not alert.get("to_owner")
            and datetime.timedelta(minutes=stalled["minutes"])
            >= STALL_TO_OWNER):
        ok, why = github.write("POST", label_path(number),
                               **{"labels[]": WAITING_OWNER})
        if ok:
            alert["to_owner"] = True
            out("STALL-TO-OWNER: labeled #%d %s" % (number, WAITING_OWNER))
        else:
            out("STALL-LABEL refused: %s on #%d: %s"
                % (WAITING_OWNER, number, why))
    try:
        due = when - parse_time(alert["told"]) >= STALL_RETELL
    except (KeyError, TypeError, ValueError):
        due = True
    # No sender, no message: only `main` passes the relay, so a test
    # that ticks through a stall never messages a real agent.
    if send is not None and STALL_TELL and due:
        message = "From: %s\n%s\n\nIssue: #%d.\n%s" % (ACT_AS, text, number,
                                                       SIGNATURE)
        confirmed, problems = [], []
        for name in STALL_TELL:
            problem = send(name, message)
            if problem:
                problems.append("%s: %s" % (name, problem))
            else:
                confirmed.append(name)
        if confirmed:
            alert["told"] = iso(when)
        out("STALL-TOLD: %s%s" % (",".join(confirmed) or "nobody",
                                   "; " + "; ".join(problems)
                                   if problems else ""))
    save_json(path, alert)


def parse_time(stamp):
    return datetime.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(
        tzinfo=datetime.timezone.utc)


def load_router():
    """bin/forge-router as a module, loaded when needed: it loads this
    file itself, so it can't be imported at the top."""
    return load_tool("forge-router")


def load_tool(name):
    """bin/<name> as a module."""
    loader = importlib.machinery.SourceFileLoader(
        name.replace("-", "_"), os.path.join(BIN, name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def relay_sender(project, environ, opener=None):
    """A function (agent name, text) -> None when the relay took the
    message, else why not: the router's own poster, configured from the
    same `relay` section and addressed to each of the agent's sessions
    (hers and her twins', or her stand-in's when she is `away`), so the
    two can't diverge. Taken by any one
    session is taken."""
    router = load_router()
    router.configure(project, rules=False)
    post = router.make_poster(environ.get("FORGE_ROUTER_RELAY", router.RELAY),
                              router.relay_token(),
                              *([opener] if opener else []))

    def send(name, text):
        problems = []
        for session in (project.sessions(project.stand_in(name))
                        if name in project.agents else [name]):
            why = post(session, text)
            if why is None:
                return None
            problems.append(why)
        return "; ".join(problems)
    return send


def conflict_hand_back(pr, approval, github, said, live,
                       reason=CONFLICT_REASON, detail=None):
    """The hand-back for a head GitHub refused to update as a conflict:
    to the author, like a conflict git found. With another `reason`, the
    hand-back for a head GitHub goes on refusing, with `detail` in its
    comment."""
    decision = {"action": "HAND-BACK", "to": "author",
                "reason": reason, "pr": pr["number"],
                "head": pr["headRefOid"]}
    if detail:
        decision["detail"] = detail
    if live:
        decision["result"] = carry_out(decision, approval, github, said)
    return decision


def lost_head(decision, github, state_dir, out):
    """For a write GitHub refused because the head it expected didn't
    match: {"github", "branch", "now"}, the head GitHub holds for the
    pull request, the commit its branch is at, and the head GitHub holds
    after any nudge; None when GitHub couldn't be asked.

    GitHub sometimes moves a branch (its own update's merge commit lands
    on it) and never moves the pull request's head, and then refuses
    every write pinned to either. Setting the pull request's base to the
    base it has changes nothing but makes GitHub read the head again.
    The Merger does that once per pull request and head GitHub holds
    (RESYNC_FILE), reads the pull request again, prints one `RESYNC`
    line and adds `nudge`, "done" or "refused: ...", to the record.
    A head GitHub holds that isn't `decision`'s is a changed pull
    request, nudged or not."""
    number = decision["pr"]
    path = "repos/%s/pulls/%d" % (REPO_SLUG, number)
    try:
        pull = github.api(path)
        held = pull["head"]["sha"]
        ref = github.api("repos/%s/git/ref/heads/%s" % (
            pull["head"]["repo"]["full_name"],
            urllib.parse.quote(pull["head"]["ref"], safe="/")))
        branch = ref["object"]["sha"]
        base = pull["base"]["ref"]
    except (RuntimeError, KeyError, TypeError, ValueError, AttributeError):
        return None
    lost = {"github": held, "branch": branch, "now": held}
    if held == branch:
        return lost
    resync_path = os.path.join(state_dir, RESYNC_FILE)
    done = load_json(resync_path, {})
    if not isinstance(done, dict):
        done = {}
    before = done.get(str(number))
    if isinstance(before, dict) and before.get("head") == held:
        lost["nudge"] = before.get("result") or "done"
        return lost
    ok, why = github.write("PATCH", path, base=base)
    lost["nudge"] = "done" if ok else "refused: " + why
    done[str(number)] = {"head": held, "result": lost["nudge"]}
    save_json(resync_path, done)
    if ok:
        try:
            lost["now"] = github.api(path)["head"]["sha"]
        except (RuntimeError, KeyError, TypeError, ValueError):
            pass
        out("RESYNC #%d: GitHub had head %s, branch is at %s; nudged with a "
            "no-op base update, and GitHub now has %s"
            % (number, short(held), short(branch), short(lost["now"])))
    else:
        out("RESYNC #%d: GitHub had head %s, branch is at %s; the no-op "
            "base update was refused: %s"
            % (number, short(held), short(branch), why))
    return lost


def ci_rerun(decision, github, state_dir, when, live, out):
    """For a WAIT on CI runs GitHub has unfinished, jobs and all
    (`decision["ci_unfinished"]`, see `judge_runs`): None to go on
    waiting, or the detail of a hand-back when waiting is no use.

    A run unfinished for STALL_AFTER since it started is re-run, once
    per pull request and head (RERUN_FILE), with one `CI-RERUN` line,
    and `rerun` ("done" or "refused: ...") added to the decision. A
    dry run only says it would, and writes nothing. If the head's CI is
    still unfinished STALL_AFTER after that re-run, nothing more the
    Merger does will finish it: the answer is the hand-back's detail,
    and the queue moves past the pull request."""
    number, head = decision["pr"], decision["head"]
    path = os.path.join(state_dir, RERUN_FILE)
    done = load_json(path, {})
    if not isinstance(done, dict):
        done = {}
    before = done.get(str(number))
    if isinstance(before, dict) and before.get("head") == head:
        decision["rerun"] = before.get("result") or "done"
        try:
            at = parse_time(before["at"])
        except (KeyError, TypeError, ValueError):
            return None
        if when - at < STALL_AFTER:
            return None
        return ("GitHub has reported %s run %s unfinished, its jobs too, "
                "since %s; the Merger re-ran it at %s (%s), and it still "
                "hasn't finished. A push to the branch starts CI afresh, and "
                "if the run does finish green, the Merger takes it again"
                % (CI_WORKFLOW, before.get("run"), before.get("since") or "?",
                   before["at"], decision["rerun"]))
    for stuck in decision.get("ci_unfinished") or ():
        try:
            since = parse_time(stuck["since"])
        except (KeyError, TypeError, ValueError):
            continue
        if when - since < STALL_AFTER:
            continue
        minutes = int((when - since).total_seconds() // 60)
        if not live:
            out("CI-RERUN #%d: GitHub says run %s is %s, and so are its "
                "jobs, after %d minutes; a live tick would re-run it"
                % (number, stuck["run"], stuck["status"], minutes))
            return None
        ok, why = github.write("POST", "repos/%s/actions/runs/%s/rerun"
                               % (REPO_SLUG, stuck["run"]))
        decision["rerun"] = "done" if ok else "refused: " + why
        done[str(number)] = {"head": head, "run": stuck["run"],
                             "since": stuck["since"], "at": iso(when),
                             "result": decision["rerun"]}
        save_json(path, done)
        out("CI-RERUN #%d: GitHub says run %s is %s, and so are its jobs, "
            "after %d minutes; %s" % (
                number, stuck["run"], stuck["status"], minutes,
                "re-ran it, once for this head" if ok
                else "re-running it was refused: " + why))
        return None
    return None


# merge.resolve_slots: why one that conflicts with main is held rather
# than handed back (designs/0012, amendment of 2026-11-12).
RESOLVE_WAIT_REASON = ("conflicts with %s; waits for a resolve slot "
                       "(%d out: %s)")


def out_for_resolving(said, prs, repo, main_tip, run=sh):
    """merge.resolve_slots: the numbers of the open pull requests out for
    resolving, sorted. One is out when `said` has it handed back for a
    conflict with main (any reason that starts with CONFLICT_REASON, a
    restack's too) at the head and under the approval it has now, it
    isn't a draft, and it still conflicts. Its slot frees when its
    author pushes (the head moves), it loses its approval or gets a
    new one, it closes, merges or is drafted, or main moves so that it
    no longer conflicts. A restack's conflict is with the layer below's
    final head, which main alone doesn't settle, so it counts until
    one of the others."""
    out = []
    for pr in prs:
        before = said.get(str(pr["number"])) or {}
        approval = approval_of(pr)
        reason = before.get("reason") or ""
        if (approval is None or pr.get("isDraft")
                or not reason.startswith(CONFLICT_REASON)
                or before.get("head") != pr["headRefOid"]
                or before.get("approved") != approval.get("submittedAt")):
            continue
        if "'s final head" not in reason:
            have_head(repo, pr, run)
            if is_ancestor(repo, main_tip, pr["headRefOid"], run):
                continue
            merged = git(repo, "merge-tree", "--write-tree", "--name-only",
                         "--no-messages", main_tip, pr["headRefOid"],
                         run=run)
            if merged.returncode == 0:
                continue
        out.append(pr["number"])
    return sorted(out)


def approved_above(number, prs):
    """How many open pull requests stacked, at any depth, on `number`
    have an approval (`approval_of`)."""
    by_number = {pr["number"]: pr for pr in prs}
    branches, count = {by_number[number]["headRefName"]}, 0
    while branches:
        above = [pr for pr in prs if pr.get("baseRefName") in branches]
        count += sum(1 for pr in above if approval_of(pr) is not None)
        branches = {pr["headRefName"] for pr in above}
    return count


def resolve_slot_order(waiting, queue, prs, row=None):
    """merge.resolve_slots: `waiting`, pull requests that conflict with
    main and aren't out for resolving, in the order they get a slot:
    those labelled urgent, then the other urgent ones (`urgent`), then
    the one with right of way (`row`, unless idle), then by how soon
    they would board: their place in `queue`, the order the Merger takes
    them in, grouped by `merge.test_ahead.batch` when there are
    batches; within a group, a stack's base with more approved layers
    above it (`approved_above`) first, then the queue's order; last,
    one not in the queue (held for an instance), oldest first."""
    places = {pr["number"]: at for at, pr in enumerate(queue)}
    group = AHEAD_BATCH if TEST_AHEAD and AHEAD_BATCH > 1 else 1
    holder = row.get("pr") if row and not row.get("idle") else None

    def key(pr):
        place = places.get(pr["number"], len(places))
        return (not labelled_urgent(pr), not urgent(pr),
                pr["number"] != holder, place // group,
                -approved_above(pr["number"], prs), place,
                pr.get("createdAt") or "", pr["number"])
    return sorted(waiting, key=key)


def early_conflicts(repo, main_tip, rest, approvals, github, said, live,
                    run=sh, layers=(), restacks=None):
    """merge.early_conflicts: the hand-backs for the candidates the tick
    didn't reach (`rest`, behind the one it stopped at) whose heads
    conflict with main. Without it, such a pull request is told only
    when it reaches the front, which in a busy queue can be hours after
    the merge that made the conflict, hours its author could have spent
    on the fix. One already told of a conflict for this approval and
    head is skipped, whatever the words, and with ONCE_PER_HEAD one
    told anything for them (`told`), and so is one git can't compare
    (it is decided when it is reached, as before). So is a stack's layer
    (`layers`): the Merger restacks it when it is reached, and its own
    hand-back says which merge conflicted. Told the plain conflict here,
    a layer's two hand-backs replaced each other in `said` and each was
    posted again, every tick.

    `restacks` (merge.stacks.predict_restacked, designs/0042) is {pr:
    (after, lower)} for the layers waiting to be restacked: such a layer
    whose restack (`restacked_tree`) conflicts with main is handed back
    now, with the reason `decide` would give it when reached."""
    restacks = restacks or {}
    decisions = []
    for pr in rest:
        approval = approvals[pr["number"]]
        before = said.get(str(pr["number"])) or {}
        key = hand_back_key(approval, pr["headRefOid"], CONFLICT_REASON)
        # A restack's reason starts with CONFLICT_REASON too, so a layer
        # told it is skipped here like any other.
        if ((pr["number"] in layers and pr["number"] not in restacks)
                or ({k: before.get(k) for k in ("approved", "head")}
                    == {k: key[k] for k in ("approved", "head")}
                    and (before.get("reason") or "").startswith(
                        CONFLICT_REASON))
                or told(before, key)):
            continue
        have_head(repo, pr, run)
        if is_ancestor(repo, main_tip, pr["headRefOid"], run):
            continue
        merged = git(repo, "merge-tree", "--write-tree", "--name-only",
                     "--no-messages", main_tip, pr["headRefOid"], run=run)
        if merged.returncode != 1:
            continue
        reason, detail = CONFLICT_REASON, None
        if (RESOLVE and pr["number"] not in restacks
                and resolve_rule(conflicted_paths(merged.stdout)) is not None):
            # Generated files: the Merger regenerates them when it is
            # reached.
            continue
        if UNION and pr["number"] not in restacks:
            got = union.resolve(repo, pr["headRefOid"], main_tip, UNION, run)
            if got.tree:
                # The Merger resolves it itself when it is reached.
                continue
            detail = UNION_DETAIL % got.reason
        if pr["number"] in restacks:
            after, lower = restacks[pr["number"]]
            _, failed = restacked_tree(repo, main_tip, pr["headRefOid"],
                                       lower, run)
            if failed == "restack":
                reason = RESTACK_REASON % (CONFLICT_REASON, after, lower[:10])
                detail = RESTACK_DETAIL % (after, lower[:10], MAIN)
            elif failed != "update":
                # Clean: the Merger restacks it when it is reached. Or
                # git failed: it is decided when it is reached.
                continue
        decision = conflict_hand_back(pr, approval, github, said, live,
                                      reason, detail)
        decision["early"] = True
        decisions.append(decision)
    return decisions


def checked_ahead(state_dir, repo, pr, approval, main_tip, env, run=sh,
                  regenerated=None, when=None):
    """designs/0035, fourth amendment: (to, reason) when `pr` would be
    handed back at merge time for something its place in the queue
    doesn't change (its approval doesn't cover its head, or a
    `merge.gate` tool refuses it), else None. Checked once per head,
    approved commit, title and body (CHECKED_FILE); merge time checks
    again, as before. A gate's refusal for now (GATE_RETRY_EXIT) comes
    back as (to, reason, True) and is checked again GATE_RETRY after
    `when`, the clock it was checked by."""
    approved = (approval.get("commit") or {}).get("oid")
    approver = APPROVERS.get(login(approval), "a reviewer")
    if not approved:
        return approver, "the approval names no commit"
    key = "%s %s %s" % (pr["headRefOid"], approved, description(pr))
    path = os.path.join(state_dir, CHECKED_FILE)
    checked = load_json(path, {})
    entry = checked.get(str(pr["number"]))
    if isinstance(entry, dict) and entry.get("key") == key \
            and not retry_due(entry, when):
        return tuple(entry["failed"]) if entry.get("failed") else None
    if fetch_pr(repo, pr["number"], pr["headRefOid"], run).returncode != 0:
        return None
    covered, why = covers_head(repo, approved, pr["headRefOid"],
                               "refs/remotes/origin/" + MAIN, run, (),
                               regenerated)
    if covered is None:
        return None
    failed, retry = (None if covered else (approver, why)), False
    for argv in GATE if failed is None else ():
        problem, retry = gate_problem(
            gate_args(argv, repo, pr["number"], main_tip, pr["headRefOid"]),
            env, repo, run)
        if problem:
            failed = ("author", problem, True) if retry else \
                ("author", problem)
            break
    checked[str(pr["number"])] = {"key": key, "failed": failed}
    if failed and retry and when is not None:
        checked[str(pr["number"])].update(retry=True, at=iso(when))
    save_json(path, checked)
    return failed


def handed_back(said, pr, approval, when=None):
    """Whether `pr` was handed back under the approval it has now, at the
    head it has now, and for a gate's refusal, with the description it
    has now: it would only be handed back again, so it is not
    predicted. A gate's refusal for now (GATE_RETRY_EXIT) stops counting
    GATE_RETRY after it was last asked, by the clock `when`, so that the
    gate is asked again. Seen on 2026-10-28: refused because GitHub had
    not yet linked a declared issue, a pull request stayed out of every
    prediction for over an hour after the link appeared."""
    before = said.get(str(pr["number"])) or {}
    return bool(before.get("approved")) and \
        before["approved"] == approval.get("submittedAt") and \
        before.get("head") == pr["headRefOid"] and \
        not description_moved(before, pr) and \
        not retry_due(before, when)


def retry_due(before, when):
    """Whether `before`, a hand-back from `handed-back.json` or an entry
    of `checked.json`, was a gate's refusal for now that is due to be
    asked again at `when`. Without a clock, never."""
    if not before.get("retry") or when is None:
        return False
    try:
        return when - parse_time(before["at"]) >= GATE_RETRY
    except (KeyError, TypeError, ValueError):
        return True


def layers_below(layer, prs):
    """The numbers of the open pull requests under `layer` in its stack,
    walking down the bases. A layer's Blocked-by on one of them waits
    only for the stack, as in ready_layers and a retarget."""
    by_head = {pr.get("headRefName"): pr for pr in prs}
    numbers, base = set(), layer.get("baseRefName")
    while base in by_head and by_head[base]["number"] not in numbers:
        numbers.add(by_head[base]["number"])
        base = by_head[base].get("baseRefName")
    return numbers


def ready_layers(repo, base, prs, open_numbers, when, said, run=sh,
                 regenerated=None, rules=None, green=None, gated=None):
    """designs/0035: the layers stacked on `base`, climbing the stack,
    that would be eligible but for their base, each with an approval
    that covers its head, as [(pull request, approval)], each after the
    layer it is on. Layers side by side on one base (amendment of
    2026-11-12: three on one base, all approved and green, and none
    boarded) are taken in number order, depth first: a layer, the
    layers on it, then the next layer beside it. One that isn't ready
    ends the climb on its own branch only. A layer is ready only when
    it could merge as it is but for the batch's own check: with `gated`
    (`instance_wait`), a layer still waiting for a gated instance's
    context isn't, since the batch's run is not that instance's, and it
    would leave the batch at its merge. With `green` (`own_green_wait`),
    one waiting for its own build check isn't either; without it
    (`layers_need_own_green` false), the train's top tests it."""
    layers = []

    def climb(below, numbers):
        above = sorted((pr for pr in prs
                        if pr.get("baseRefName") == below.get("headRefName")),
                       key=lambda pr: pr["number"])
        for layer in above:
            approval = ready_layer(repo, layer, below, open_numbers,
                                   numbers, when, said, run, regenerated,
                                   rules, green, gated)
            if approval is None:
                continue
            layers.append((layer, approval))
            climb(layer, numbers | {layer["number"]})

    climb(base, {base["number"]})
    return layers


def ready_layer(repo, layer, below, open_numbers, numbers, when, said,
                run=sh, regenerated=None, rules=None, green=None,
                gated=None):
    """`ready_layers`' test of one `layer` on `below`: its approval when
    it is ready, else None. `numbers` are the layers under it."""
    approval, _ = eligible(layer, open_numbers - numbers, when,
                           any_base=True)
    oid = ((approval or {}).get("commit") or {}).get("oid")
    if not oid or handed_back(said, layer, approval, when):
        return None
    have_head(repo, layer, run)
    if git(repo, "cat-file", "-e", oid + "^{commit}",
           run=run).returncode != 0 or not covers_head(
            repo, oid, layer["headRefOid"], "refs/remotes/origin/" + MAIN,
            run, (below["headRefOid"],), regenerated)[0]:
        return None
    if rules and code_owner_wait(repo, layer, rules,
                                 "refs/remotes/origin/" + MAIN, run,
                                 regenerated):
        return None
    if green is not None and green(layer, approval):
        return None
    if gated is not None and gated(layer):
        return None
    return approval


def with_layers(queue, layers_of, last, size):
    """(queue, owed): `queue` with each pull request's ready layers
    (`layers_of(pr)`, from `ready_layers`) straight after it
    (designs/0035), and the numbers owed a place. `last` is the last
    tick's ahead.json, `size` the batch's. A layer doesn't join a batch
    already being run, which its prediction would change, unless it was
    predicted there already; and it may not push a pull request that is
    owed out of the first `size`. A pull request a layer pushes out of
    the first `size` is owed until a batch includes it."""
    last = last if isinstance(last, dict) else {}
    entries = [e for e in last.get("entries") or () if isinstance(e, dict)]
    before = {e.get("pr"): e.get("head") for e in entries}
    running = {e.get("pr") for e in
               entries[:(last.get("batch") or {}).get("size") or 0]}
    numbers = [pr["number"] for pr in queue]
    plain = numbers[:size]
    owed = [n for n in last.get("owed") or () if n in numbers]
    out, placed = [], set()
    for pr in queue:
        if pr["number"] in placed:
            continue
        out.append(pr)
        placed.add(pr["number"])
        for layer, _ in layers_of(pr):
            if layer["number"] in placed or (
                    pr["number"] in running
                    and before.get(layer["number"]) != layer["headRefOid"]):
                break
            batch = ([p["number"] for p in out] + [layer["number"]]
                     + [n for n in numbers if n not in placed])[:size]
            if any(n in plain and n not in batch for n in owed):
                break
            out.append(layer)
            placed.add(layer["number"])
    batch = {p["number"] for p in out[:size]}
    return out, [n for n in numbers
                 if n not in batch and (n in owed or n in plain)]


def have_head(repo, pr, run=sh):
    """Fetch `pr`'s head unless the checkout has it already: only the
    pull requests a tick decided on were fetched."""
    if git(repo, "cat-file", "-e", pr["headRefOid"] + "^{commit}",
           run=run).returncode != 0:
        fetch_pr(repo, pr["number"], pr["headRefOid"], run)


def conflicts_ahead(repo, queue, run=sh, main_ref=None, cache=None,
                    gone=()):
    """{P: Q} for each pull request P in `queue` whose head conflicts
    with the head of a Q ahead of it, Q not itself held this way. The
    first is never held. A comparison git can't make (anything but 0 or
    1) holds nothing. With `main_ref`, one whose head conflicts with it
    is going back to its author, so nothing waits behind it: it is
    neither a Q nor held. Nor is one whose number is in `gone`, already
    handed back at the head it has: it can't merge until its author
    pushes again (on 2026-11-11 one such held 26 others for over an
    hour).

    `cache`, {"<a> <b>": 0 or 1}, remembers each pair of commits' answer:
    two commits merge the same way every time, and asking git again for
    every pair in the queue was most of a tick (agent-forge #301). The
    pairs asked this time are left in it as `cache["used"]`'s keys, so
    the caller can drop the rest."""
    cache = {} if cache is None else cache
    used = cache.setdefault("used", {})

    def conflict(a, b):
        key = "%s %s" % (a, b)
        if key not in cache:
            got = git(repo, "merge-tree", "--write-tree", "--name-only",
                      "--no-messages", a, b, run=run).returncode
            if got not in (0, 1):
                return False
            cache[key] = got
        used[key] = cache[key]
        return cache[key] == 1

    kept, held = [], {}
    for pr in queue:
        if pr["number"] in gone:
            continue
        have_head(repo, pr, run)
        if main_ref and conflict(main_ref, pr["headRefOid"]):
            continue
        for q in kept:
            if conflict(q["headRefOid"], pr["headRefOid"]):
                held[pr["number"]] = q["number"]
                break
        if pr["number"] not in held:
            kept.append(pr)
    return held


def waiting_since(path, candidates, prs, when, save=True):
    """{pr: when a tick first saw it as a candidate} for `candidates`,
    remembered in `path` ({pr: {since, seen}}, written when `save`). An
    entry outlives a hand-back and a new head: a conflict is mostly what
    merged after the approval (designs/0037). It is dropped once its pull
    request isn't open, or hasn't been a candidate for AGE_FORGET."""
    open_numbers = {str(pr["number"]) for pr in prs}
    kept = {}
    for key, entry in load_json(path, {}).items():
        try:
            seen = parse_time(entry["seen"])
            parse_time(entry["since"])
        except (ValueError, TypeError, KeyError):
            continue
        if key in open_numbers and when - seen < AGE_FORGET:
            kept[key] = entry
    for pr in candidates:
        entry = kept.setdefault(str(pr["number"]), {"since": iso(when)})
        entry["seen"] = iso(when)
    if save:
        save_json(path, kept)
    return {pr["number"]: parse_time(kept[str(pr["number"])]["since"])
            for pr in candidates}


def overdue_first(queue, since, when, keep=None, members=(), fixed=()):
    """(`queue` with its overdue candidates first, {pr: minutes waited}
    for those): each that has waited AGE_FIRST since `since` says, the
    longest waiting first. Only `keep`, the one in flight, the members
    of a batch being merged and urgent ones stay ahead of them, and then
    the members of `fixed`, batches whose top's run has started
    (`fixed_order`, designs/0044, rule 3); the rest keep their order.
    The members keep theirs too, overdue or not: the batch's green
    covers its trees in that order only, and on 2026-10-31 an overdue
    member moved up inside a green batch of seven, which then merged two
    and waited out a new top's run."""
    waited = {pr["number"]: when - since[pr["number"]] for pr in queue
              if pr["number"] in since}
    late = {n: w for n, w in waited.items() if w >= AGE_FIRST}
    if not late:
        return queue, {}
    zero = datetime.timedelta(0)
    queue = sorted(queue, key=lambda pr: (
        pr["number"] != keep, pr["number"] not in members) + (
        (0, False, zero) if pr["number"] in members
        else (1, False, zero) if pr["number"] in fixed
        else (0 if urgent(pr) else 2, pr["number"] not in late,
              -late.get(pr["number"], zero))))
    return queue, {n: int(w.total_seconds() // 60) for n, w in late.items()}


def right_of_way(repo, prs, records, path, when, main_ref, run=sh,
                 save=True):
    """{pr, head, since} for the pull request that has right of way, or
    None. One handed back to its author for a conflict with main at
    ROW_AFTER heads in `records` has earned it; it has it for its head
    H while H is clean against `main_ref`, it wasn't handed back at H
    for anything else, no request for changes stands on it (GitHub
    refuses its merge until that reviewer's next verdict; designs/0002,
    amendment), and less than ROW_FOR has passed since a tick
    first saw H with it earned. `path` remembers that moment per pull
    request ({pr: {head, since}}), written when `save`. Of several, the
    first in the Merger's order has it. Whether it holds anyone this
    tick is `row_idle`'s question (designs/0044, rule 2)."""
    counts = conflict_hand_backs(records)
    other = {(pr, head) for pr, head, reason in author_hand_backs(records)
             if reason != CONFLICT_REASON}
    earned = order([pr for pr in prs if counts.get(pr["number"], 0)
                    >= ROW_AFTER and not pr.get("isDraft")
                    and pr.get("baseRefName") == MAIN], prs)
    seen = {k: v for k, v in load_json(path, {}).items()
            if isinstance(v, dict) and k.isdigit()
            and any(pr["number"] == int(k) for pr in earned)}
    found = None
    for pr in earned:
        head, key = pr["headRefOid"], str(pr["number"])
        if (seen.get(key) or {}).get("head") != head:
            seen[key] = {"head": head, "since": iso(when)}
        if found or (pr["number"], head) in other or changes_requested(pr):
            continue
        try:
            since = parse_time(seen[key]["since"])
        except (ValueError, TypeError, KeyError):
            continue
        if when - since >= ROW_FOR:
            continue
        have_head(repo, pr, run)
        if git(repo, "merge-tree", "--write-tree", "--name-only",
               "--no-messages", main_ref, head, run=run).returncode != 0:
            continue
        found = {"pr": pr["number"], "head": head, "since": iso(since)}
    if save:
        save_json(path, seen)
    return found


def row_idle(row, candidates, approvals, said, when):
    """Why `row`, right of way as `right_of_way` found it, holds nobody
    this tick, or None when it holds (designs/0044, rule 2): its holder
    must be a candidate (approved, covered, not drafted, nothing open
    blocking it) at the head it has right of way for, and not handed
    back at that head under its approval. One project, 2026-11-04:
    right of way was active in 70 to 90% of the Merger's ticks, holding
    3 to 6 pull requests, even while its holder was back with its
    author."""
    holder = [pr for pr in candidates if pr["number"] == row["pr"]]
    if not holder or holder[0]["headRefOid"] != row["head"]:
        return "not a candidate at %s" % row["head"][:10]
    if handed_back(said, holder[0], approvals[row["pr"]], when):
        return "handed back at %s" % row["head"][:10]
    return None


def codeowners_rules(repo, ref, run=sh):
    """[(pattern, [owner, ...]), ...] from the first CODEOWNERS file at
    `ref` (.github/, the root, docs/), in file order; [] when there is
    none."""
    for path in CODEOWNERS_PATHS:
        got = git(repo, "show", "%s:%s" % (ref, path), run=run)
        if got.returncode != 0:
            continue
        rules = []
        for line in got.stdout.splitlines():
            words = line.split("#", 1)[0].split()
            if words:
                rules.append((words[0], words[1:]))
        return rules
    return []


def codeowners_match(pattern, path):
    """Whether CODEOWNERS `pattern` covers `path`: gitignore's rules as
    GitHub applies them. A leading or inner `/` anchors it to the root,
    a trailing one makes it a directory's, `*` and `?` stay within a
    name and `**` crosses directories; a pattern also covers everything
    under a directory it names."""
    body = pattern.lstrip("/")
    directory = body.endswith("/")
    body = body.rstrip("/")
    anchored = pattern.startswith("/") or "/" in body
    out, i = [], 0
    while i < len(body):
        if body.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif body.startswith("**", i):
            out.append(".*")
            i += 2
        elif body[i] == "*":
            out.append("[^/]*")
            i += 1
        elif body[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(body[i]))
            i += 1
    regex = (("^" if anchored else "^(?:.*/)?") + "".join(out)
             + ("/.*$" if directory else "(?:/.*)?$"))
    return re.match(regex, path) is not None


def owners_of(path, rules):
    """The owners of `path`: the last matching rule's, [] for none."""
    owners = []
    for pattern, who in rules:
        if codeowners_match(pattern, path):
            owners = who
    return owners


def newest_status(statuses, context, creator):
    """(state, description) of the newest status named `context` that
    `creator` created in `statuses` (REST's list, newest first), or
    (None, "")."""
    for status in statuses or []:
        if (status.get("context") == context
                and (status.get("creator") or {}).get("login") == creator):
            return (status.get("state") or "unknown",
                    status.get("description") or "")
    return None, ""


def status_path(commit):
    """The API path of `commit`'s statuses, as `instance_verdict` asks
    for them and the tick prefetches them."""
    return "repos/%s/commits/%s/statuses?per_page=100" % (REPO_SLUG, commit)


def instance_verdict(repo, pr, main_tip, github, context, creator, run=sh):
    """(state, description, sha) of `context` for `pr`: on its head,
    or, while the head has none final, on the commit before each merge
    of the default branch into it (the Merger's own `update-branch`, or
    the author's), or of a merged layer's final head (the Merger's
    RESTACK: `on_main`), back to the first commit that isn't one. A
    merge of either changes nothing of the pull request's own, and
    an instance whose verdicts take an hour would otherwise never
    catch up with a head the Merger updates whenever the default
    branch moves. A head's own pending verdict is the answer when no
    earlier one is final."""
    commit, first, depth = pr["headRefOid"], None, 0
    while commit and depth < GATE_DEPTH:
        depth += 1
        state, said = newest_status(github.api(status_path(commit)),
                                    context, creator)
        if state not in (None, "pending"):
            return state, said, commit
        if first is None:
            first = (state, said, commit)
        parents = git(repo, "rev-list", "--parents", "-n", "1", commit,
                      run=run).stdout.split()
        if len(parents) != 3 or not on_main(repo, parents[2], main_tip,
                                            run):
            break
        commit = parents[1]
    return first or (None, "", pr["headRefOid"])


def own_green_wait(pr, approval, github, cache, repo=None, main_tip=None,
                   run=sh, boarded=None):
    """Why `pr` isn't a candidate yet under merge.own_head_green, or
    None: checks.context isn't green (success) on the commit its
    approval names, nor on its head, nor (given `repo` and `main_tip`)
    on the commit before each merge of the default branch (or of a
    merged layer's final head) into the head, back to the first commit
    that isn't one, as for an instance (`instance_verdict`). A merge of
    the default branch changes nothing
    of the pull request's own: without that, a head the Merger has just
    updated, whose build check hasn't yet posted (a batch member's
    `covered by batch` green comes a minute later), would be held for
    that minute, leave its batch, and the batch would be recut, every
    member updated and built again. The merge itself still waits for
    the context on the head it merges (`decide`). Statuses are read
    once a tick per commit, through `cache`, which keeps a green across
    ticks (`load_greens`). A pending, red or absent
    context holds the pull request: nothing merges, boards a batch or a
    train, or is predicted until the build check has passed on it.

    `boarded` (merge.test_ahead.layers_need_own_green false) is the head
    a stack's layer boarded a train with: while the head is that one, or
    that one brought up to date as above, it needs no green of its own,
    since the train's top tests it."""
    approved = ((approval or {}).get("commit") or {}).get("oid")
    head = pr.get("headRefOid")
    shas = [approved, head]
    if repo is not None and main_tip and head:
        commit, depth = head, 0
        while depth < GATE_DEPTH:
            depth += 1
            parents = git(repo, "rev-list", "--parents", "-n", "1", commit,
                          run=run).stdout.split()
            if len(parents) != 3 or not on_main(repo, parents[2],
                                                main_tip, run):
                break
            commit = parents[1]
            shas.append(commit)
    if boarded and boarded in shas[1:]:
        return None
    seen = []
    for sha in dict.fromkeys(s for s in shas if s):
        if sha not in cache:
            cache[sha] = status_state(github.api(
                "repos/%s/commits/%s/statuses?per_page=100"
                % (REPO_SLUG, sha)) or [])[0]
        if cache[sha] == "success":
            return None
        seen.append((sha, cache[sha]))
    if len(seen) > 2:
        # The reason names the head (or the approved commit), as before.
        seen = seen[:2]
    sha, state = seen[-1] if seen else ("", None)
    return GREEN_WAIT_REASON % (STATUS_CONTEXT, state or "absent",
                                sha[:10] or "its head")


def load_greens(state_dir):
    """The commits earlier ticks found green, for `own_green_wait`. A
    green is kept though a rerun could turn it red: this only says a
    pull request may be a candidate, and `decide` reads the head it
    merges afresh."""
    try:
        with open(os.path.join(state_dir, GREENS_FILE)) as handle:
            kept = json.load(handle)
    except (OSError, ValueError):
        return {}
    return ({sha: "success" for sha in kept if isinstance(sha, str)}
            if isinstance(kept, list) else {})


def save_greens(state_dir, greens):
    """Keep the GREENS_KEEP newest green commits of `greens`. A failure
    only costs the next tick its reads."""
    kept = [sha for sha, state in greens.items() if state == "success"]
    try:
        save_json(os.path.join(state_dir, GREENS_FILE), kept[-GREENS_KEEP:])
    except OSError:
        pass


def gated_instances(repo, pr, main_tip, cache, run=sh):
    """The (context, creator) of each gated instance that applies to
    `pr` (see instance_wait): only these need its head's statuses."""
    labels, found = None, []
    for context, creator, globs, label in GATED:
        applies = globs is None and label is None
        if not applies and label:
            labels = label_names(pr) if labels is None else labels
            applies = label in labels
        if not applies and globs:
            paths = changed_files(repo, main_tip, pr, cache, run)
            applies = paths is None or any(
                fnmatch.fnmatchcase(path, glob)
                for path in paths for glob in globs)
        if applies:
            found.append((context, creator))
    return found


def instance_wait(repo, pr, main_tip, github, cache, run=sh):
    """Why `pr` waits for an instance's context (checks.instances.<name>.
    gate), or None. An instance applies to a pull request when its
    block has no `pull_requests`, or the pull request carries its
    `label`, or changes a path its `paths` match (since it left the
    default branch; one whose paths git can't list applies). The
    pull request waits, held, while an instance that applies has no
    final verdict (`instance_verdict`), and stays held while it is red:
    the author's push, or the instance's rerun, moves it on. It is held
    rather than waited on at the front so the queue moves past it: an
    instance's run can take an hour. Seen on 2026-11-05: a pull request
    merged with a second platform's run still pending, and broke that
    platform's default branch for nearly three hours."""
    for context, creator in gated_instances(repo, pr, main_tip, cache, run):
        state, said, sha = instance_verdict(repo, pr, main_tip, github,
                                            context, creator, run)
        if state == "success":
            continue
        if state in (None, "pending"):
            return "waiting for %s (%s)" % (context, state or "absent")
        return "%s is %s at %s%s" % (context, state, sha[:10],
                                     ": " + said if said else "")
    return None


def code_owner_wait(repo, pr, rules, main_ref, run=sh, regenerated=None):
    """Why `pr` waits for a code owner, or None. Each path it changes
    since `main_ref` that `rules` gives owners needs one of them: its
    author, or an owner whose newest review is `APPROVED` at a commit
    that covers the head. Owners are `@login`s; a team or an email
    can't be checked, so it is never satisfied."""
    head = pr["headRefOid"]
    have_head(repo, pr, run)
    got = git(repo, "diff", "--name-only", "%s...%s" % (main_ref, head),
              run=run)
    if got.returncode != 0:
        return "waits for a code owner: its changed paths can't be listed"
    latest = {}
    for review in pr["reviews"]:
        who = login(review).lower()
        if review.get("state") in ("APPROVED", "CHANGES_REQUESTED",
                                   "DISMISSED") and (
                who not in latest or review["submittedAt"]
                > latest[who]["submittedAt"]):
            latest[who] = review
    covered = {}

    def approved(owner):
        if owner == login(pr).lower():
            return True
        review = latest.get(owner)
        if not review or review.get("state") != "APPROVED":
            return False
        oid = (review.get("commit") or {}).get("oid")
        if oid not in covered:
            covered[oid] = bool(oid) and bool(covers_head(
                repo, oid, head, main_ref, run,
                regenerated=regenerated)[0])
        return covered[oid]
    waiting = {}
    for path in got.stdout.split():
        owners = owners_of(path, rules)
        logins = [o[1:].lower() for o in owners
                  if o.startswith("@") and "/" not in o]
        if owners and not any(approved(o) for o in logins):
            waiting.setdefault(" ".join(owners), []).append(path)
    if not waiting:
        return None
    who, paths = sorted(waiting.items())[0]
    more = sum(len(p) for p in waiting.values()) - 1
    return "waits for code owner %s: %s%s" % (
        who, paths[0], " and %d more" % more if more else "")


def owned_lines(repo, pr, rules, main_ref, run=sh):
    """{path: [(first, last), ...]}: the default branch's lines each
    code-owned path `pr` changes since `main_ref` covers (a pure
    insertion as the line it follows), or None if git can't say."""
    got = git(repo, "diff", "-U0", "--no-color", "%s...%s"
              % (main_ref, pr["headRefOid"]), run=run)
    if got.returncode != 0:
        return None
    found, path = {}, None
    for line in got.stdout.splitlines():
        if line.startswith("--- "):
            name = line[4:]
            path = name[2:] if name.startswith("a/") else None
        elif line.startswith("+++ ") and path is None:
            name = line[4:]
            path = name[2:] if name.startswith("b/") else None
        elif line.startswith("@@") and path and owners_of(path, rules):
            m = HUNK_RE.match(line)
            if m:
                start, count = int(m.group(1)), int(m.group(2) or 1)
                found.setdefault(path, []).append(
                    (start, start + max(count, 1) - 1))
    return found


def sequence_owned(repo, prs, waits, rules, main_ref, run=sh):
    """merge.code_owner_sequence (agent-forge #264): {number: (head,
    why)} for each pull request held for a code owner (`waits`) that
    changes lines of an owned path an older such pull request also
    changes. It waits for the oldest, so the owner is asked once."""
    by_number = {pr["number"]: pr for pr in prs}
    held = sorted(n for n, (_head, why) in waits.items() if why)
    lines = {}
    for number in held:
        lines[number] = owned_lines(repo, by_number[number], rules,
                                    main_ref, run) or {}
    out = {}
    for i, number in enumerate(held):
        for older in held[:i]:
            if older in out:
                continue
            clash = [(path, max(a, c), min(b, d))
                     for path, ranges in sorted(lines[number].items())
                     for a, b in ranges
                     for c, d in lines[older].get(path, ())
                     if a <= d and c <= b]
            if clash:
                path, first, last = clash[0]
                out[number] = (waits[number][0],
                               SEQUENCE_REASON % (older, path, first, last))
                break
    return out


def conflicts_with(repo, head, queue, run=sh):
    """The pull requests in `queue` whose heads conflict with `head`.
    A comparison git can't make holds nothing."""
    held = []
    for pr in queue:
        have_head(repo, pr, run)
        if git(repo, "merge-tree", "--write-tree", "--name-only",
               "--no-messages", head, pr["headRefOid"],
               run=run).returncode == 1:
            held.append(pr["number"])
    return held


def row_text(head, ahead):
    """The comment a right-of-way hold posts: plain, to the author."""
    return ("Holding %s: it conflicts with #%d, which has right of way. "
            "#%d has been handed back again and again for conflicts with "
            "`main` as others merged, so for a while nothing that "
            "conflicts with it merges first.\n\nThis keeps its approval "
            "and is not handed back. Please leave it until #%d merges or "
            "its right of way ends, within %d minutes: then, if it "
            "conflicts with `main`, the Merger hands it back once.\n\n%s"
            % (head[:10], ahead, ahead, ahead,
               ROW_FOR.total_seconds() // 60, SIGNATURE))


def hold_text(head, ahead):
    """The comment a hold posts: plain, to the author, and not a
    hand-back, so it doesn't start `Not merging`."""
    return ("Holding %s: it conflicts with #%d, which is ahead of it in "
            "the queue.\n\nIt keeps its approval and is not handed back. "
            "Please leave it until #%d merges: then, if it conflicts with "
            "`main`, the Merger hands it back once, and one rebase covers "
            "both.\n\n%s" % (head[:10], ahead, ahead, SIGNATURE))


def tell_holds(state_dir, github, prs, held_by, live, row=()):
    """[{pr, head, behind, result}] for each hold. When `live`, each
    head and Q is said on its pull request once, `held-conflicting.json`
    remembering it; pull requests no longer open are forgotten. Those in
    `row` are held for right of way, which their entries say."""
    path = os.path.join(state_dir, HOLD_FILE)
    heads = {pr["number"]: pr["headRefOid"] for pr in prs}
    said = {k: v for k, v in load_json(path, {}).items()
            if k.isdigit() and int(k) in heads}
    told = []
    for number, ahead in sorted(held_by.items()):
        key = {"head": heads[number], "behind": ahead}
        if number in row:
            key["right_of_way"] = True
        entry = dict(key, pr=number)
        if live:
            if said.get(str(number)) == key:
                entry["result"] = "already said"
            else:
                ok, why = github.write(
                    "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG,
                                                           number),
                    body=(row_text if number in row else hold_text)(
                        heads[number], ahead))
                entry["result"] = "done" if ok else "refused: " + why
                if ok:
                    said[str(number)] = key
        told.append(entry)
    if live:
        save_json(path, said)
    return told


def spoken_text(approval, remark):
    """What the Merger says on a pull request it holds because `remark`
    (login, time, kind) came after `approval`."""
    who, when, kind = remark
    approver = APPROVERS.get(login(approval), login(approval))
    return ("Not-a-review\n\nHolding this: %s's %s at %s came after %s's "
            "approval, and anything said after an approval might be an "
            "objection. A newer approval releases it, so %s, if nothing "
            "needs to change, please approve again.\n\n%s\n\n%s"
            % (who, kind, when, approver, approver, what_holds(),
               SIGNATURE))


def what_holds():
    """The sentence that says what doesn't hold a pull request, as
    `merge.said_since` configures it."""
    free = []
    if not SAID_AUTHOR:
        free.append("comments by the author")
    free.append("approvals with no text" if SAID_APPROVALS
                else "approvals")
    free.append("comments marked `Not-a-review`")
    text = "%s and %s don't hold a pull request." % (", ".join(free[:-1]),
                                                     free[-1])
    text = text[0].upper() + text[1:]
    if SAID_APPROVALS:
        text += (" An approval with text after the one that counts does, "
                 "unless a line of it starts `Not-a-review`.")
    return text


def tell_spoken(state_dir, github, prs, spoken, live):
    """[{pr, approved, said, result}] for each pull request held for a
    remark after its approval. When `live`, each approval and remark is
    said once, HELD_FILE remembering it; pull requests no longer open
    are forgotten."""
    path = os.path.join(state_dir, HELD_FILE)
    open_now = {str(pr["number"]) for pr in prs}
    said = {k: v for k, v in load_json(path, {}).items() if k in open_now}
    told = []
    for pr, approval, remark in spoken:
        number = pr["number"]
        key = {"approved": approval.get("submittedAt"), "said": remark[1]}
        entry = dict(key, pr=number)
        if live:
            if said.get(str(number)) == key:
                entry["result"] = "already said"
            else:
                ok, why = github.write(
                    "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG,
                                                           number),
                    body=spoken_text(approval, remark))
                entry["result"] = "done" if ok else "refused: " + why
                if ok:
                    said[str(number)] = key
        told.append(entry)
    if live:
        save_json(path, said)
    return told


def ahead_env():
    """The environment for a prediction's commits: AHEAD_IDENTITY and
    AHEAD_DATE, so that the same inputs give the same commit."""
    name, email = AHEAD_IDENTITY
    return dict(os.environ, GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email,
                GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=email,
                GIT_AUTHOR_DATE=AHEAD_DATE, GIT_COMMITTER_DATE=AHEAD_DATE)


def restacked_tree(repo, base, head, lower, run=sh):
    """designs/0042: (tree, failed) for the layer at `head` merged onto
    `base` as the Merger will restack it once it is reached, `lower`
    being the final head of the merged layer below. These are `decide`'s
    steps: when `head` lacks `lower`, RESTACK merges it in first (here
    committed with the predictions' identity and date: only its tree
    matters to what follows), then STACK-UPDATE's `based_merge` onto
    `base`. `failed` is None with a tree; "restack" when RESTACK's merge
    conflicts, "update" when `based_merge` gives None, and "git" when
    git failed otherwise; tree is None then."""
    layer = head
    if not is_ancestor(repo, lower, head, run):
        merged = git(repo, "merge-tree", "--write-tree", "--no-messages",
                     head, lower, run=run)
        if merged.returncode == 1:
            return None, "restack"
        if merged.returncode != 0 or not merged.stdout.split():
            return None, "git"
        made = run(["git", "-C", repo, "commit-tree", "--no-gpg-sign",
                    merged.stdout.split()[0], "-p", head, "-p", lower, "-m",
                    "forge-merger: restack ahead"], env=ahead_env())
        layer = (made.stdout or "").strip()
        if made.returncode != 0 or len(layer) != 40:
            return None, "git"
    tree = based_merge(repo, base, layer, lower, run)
    return (tree, None) if tree is not None else (None, "update")


def restacking(repo, before, head, restack, run=sh):
    """Whether `head` is the Merger's own RESTACK of the layer at
    `before`: a merge whose parents are `before` and the final head of
    the merged layer below (`restack`, (after, lower), from `restacks`).
    STACK-UPDATE is still to come, so the layer is in flight, not pushed
    to: its tree is judged again once the restack is complete."""
    if not before or restack is None:
        return False
    parents = git(repo, "rev-list", "--parents", "-n", "1", head, run=run)
    return parents.returncode == 0 and \
        parents.stdout.split()[1:] == [before, restack[1]]


def own_push(repo, before, head, main_tip, run=sh, depth=OWN_PUSH_DEPTH):
    """Whether `head` is `before` brought up to date and nothing else:
    each commit from `head` back along first parents to `before` is a
    clean merge (its tree is what git merges its two parents to) whose
    second parent adds nothing `main_tip` lacks: merged into it, it
    gives `main_tip`'s tree, or it is a merged layer's final head, whose
    tree is a squash on the default branch (`squashed`; merged into a
    tip that has since changed that layer's lines, it would conflict).
    That is what the
    Merger's own pushes make, an update (GitHub merges the default
    branch in), a RESTACK (the layer below's final head, which the
    default branch has as one squash) and a STACK-UPDATE, in any
    order, and what an author's own merge of the default branch makes.
    None of them is a push mid-train: the layer's changes are the ones
    the train boarded with, so it stays (designs/0047, amendment of
    2026-11-11: a train member the Merger restacked or updated was told
    it had left, and its train and every later one were cut again).
    Anything else, a commit of the author's or a merge edited by hand,
    is a push."""
    if not before or not head:
        return False
    main_tree = git(repo, "rev-parse", main_tip + "^{tree}", run=run)
    if main_tree.returncode != 0:
        return False
    for _ in range(depth):
        if head == before:
            return True
        parents = git(repo, "rev-list", "--parents", "-n", "1", head,
                      run=run)
        got = parents.stdout.split() if parents.returncode == 0 else []
        if len(got) != 3:
            return False
        _, first, second = got
        merged = git(repo, "merge-tree", "--write-tree", "--no-messages",
                     first, second, run=run)
        tree = git(repo, "rev-parse", head + "^{tree}", run=run)
        if merged.returncode != 0 or tree.returncode != 0 or \
                merged.stdout.split()[:1] != tree.stdout.split():
            return False
        into = git(repo, "merge-tree", "--write-tree", "--no-messages",
                   main_tip, second, run=run)
        if (into.returncode != 0
                or into.stdout.split()[:1] != main_tree.stdout.split()) \
                and not squashed(repo, second, main_tip, run):
            return False
        head = first
    return head == before


def same_prediction(repo, parent, graph, before, pr, restacks=None,
                    run=sh, tree=None):
    """The prediction of `pr`'s head on `parent` (through `graph`, as
    `predict_one`), when its tree is the one the head it boarded with,
    `before`, gives there, or None. `tree` is that tree when the train
    up to `parent` is the one it was predicted in (its prediction, which
    is what the train's top tested); without it, `before` is predicted
    again, and None is returned when the checkout no longer has it.

    A push whose prediction is unchanged changes nothing the train
    tests: in effect it only merges what the train already has below
    it, whoever made the merge and however (the default branch as the
    first parent, a merge past `own_push`'s depth, a rebase onto it, or
    the head of a member ahead of it in the train, which `own_push`
    refuses, since the default branch lacks it). A merge of a member
    behind it, or of a pull request in no train, brings changes the
    train doesn't have there, and it leaves. Such a member
    keeps its place in its train (designs/0047, amendment of
    2026-11-12): taking it out cut every train behind it again and
    threw their running builds away. Its prediction is the same commit
    (the same tree on the same parent), so the train's top is too."""
    entry, _ = predict_one(repo, parent, pr, restacks, run, graph)
    if entry is None or not before:
        return None
    if tree is None:
        if git(repo, "cat-file", "-e", before + "^{commit}",
               run=run).returncode != 0:
            return None
        old, _ = predict_one(repo, parent, dict(pr, headRefOid=before),
                             restacks, run, graph)
        tree = (old or {}).get("tree")
    return entry if tree is not None and entry["tree"] == tree else None


def predict_ahead(repo, main_tip, queue, run=sh, depth=None,
                  overdue=(), restacks=None):
    """The commits the first `depth` + 1 pull requests in `queue`
    (default AHEAD_DEPTH) will have once those ahead of each have
    merged, as [{pr, head, sha, tree}], each also written as
    AHEAD_REF<k> in `repo`, and any ref past the last one deleted.

    S0 stands in for the first one's squash commit: the tree its update
    gives (its own tree when it is up to date), with `main_tip` as its
    parent. Each Sk is the next one's head merged onto S(k-1), with
    S(k-1) as its parent, which is what GitHub's update makes once the
    one before has merged. One that conflicts with what is ahead of it
    is left out and the list goes on past it (the next tick puts it
    behind the predicted ones: see `locked_order`), unless it is in
    `overdue` (designs/0037), when the list ends there, so that nothing
    is predicted past it; anything else git can't do ends the list. An
    entry whose tree is its head's own says `same_as_head`, since the
    head's own check tests it. The commits carry a fixed identity and
    date and no signature, so the same prediction is the same commit on
    every tick.

    `restacks` (merge.stacks.predict_restacked, designs/0042) is {pr:
    (after, lower)} for a stack's layers waiting to be restacked. One
    whose plain merge conflicts is predicted as `restacked_tree` makes
    it, as `decide` will once it is reached, and says `restacked`;
    only if that fails too is it a conflict."""
    depth = AHEAD_DEPTH if depth is None else depth
    entries, parent, graph = [], main_tip, None
    for pr in queue:
        if len(entries) > depth:
            break
        entry, failed = predict_one(repo, parent, pr, restacks, run,
                                    graph)
        if failed == "conflict" and entries \
                and pr["number"] not in overdue:
            # It conflicts with one predicted ahead of it: skip it,
            # so that those behind it are still tested ahead.
            continue
        if entry is None:
            break
        entries.append(entry)
        parent, graph = entry["sha"], entry.get("graph")
    write_ahead_refs(repo, entries, run)
    return entries


def predict_one(repo, parent, pr, restacks=None, run=sh, graph=None):
    """(entry, None) for `pr`'s head merged onto `parent`, as one of
    `predict_ahead`'s entries, its commit made (but no ref written); or
    (None, "conflict") when it conflicts, and (None, "git") when git
    failed otherwise. `restacks` is `predict_ahead`'s.

    `graph` is the previous entry's "graph": a commit with `parent`'s
    tree whose history also holds every head predicted so far. The
    head is merged onto that, so a stack's layer merges from its real
    merge base, the lower layer's head, not from where the stack left
    the default branch: from there, its copy of the lower layer's
    changes met their predicted copy as a conflict wherever it changed
    those lines again, and the layer was left out of its base's train.
    The entry's own commit keeps `parent` as its only parent, so a
    head the Merger updates (same tree) is still the same prediction
    and isn't built again; the entry's "graph" is the next one's."""
    head = pr["headRefOid"]
    have_head(repo, pr, run)
    graph = graph or parent
    merged = git(repo, "merge-tree", "--write-tree", "--no-messages",
                 graph, head, run=run)
    restacked = None
    if merged.returncode == 1 and pr["number"] in (restacks or {}):
        # A layer still holds the lower layer's own commits, which
        # main has as one squash: plainly it conflicts, but the
        # Merger will restack it (designs/0042).
        restacked, _ = restacked_tree(repo, parent, head,
                                      restacks[pr["number"]][1], run)
    if restacked is None:
        if merged.returncode == 1:
            return None, "conflict"
        if merged.returncode != 0 or not merged.stdout.split():
            return None, "git"
    tree = restacked or merged.stdout.split()[0]
    made = run(["git", "-C", repo, "commit-tree", "--no-gpg-sign", tree,
                "-p", parent, "-m", "forge-merger: #%d ahead"
                % pr["number"]], env=ahead_env())
    sha = (made.stdout or "").strip()
    if made.returncode != 0 or len(sha) != 40:
        return None, "git"
    entry = {"pr": pr["number"], "head": head, "sha": sha, "tree": tree}
    if not is_ancestor(repo, head, graph, run):
        made = run(["git", "-C", repo, "commit-tree", "--no-gpg-sign",
                    tree, "-p", graph, "-p", head, "-m",
                    "forge-merger: #%d ahead, with its head"
                    % pr["number"]], env=ahead_env())
        joined = (made.stdout or "").strip()
        if made.returncode != 0 or len(joined) != 40:
            return None, "git"
        entry["graph"] = joined
    elif graph != parent:
        entry["graph"] = graph
    if restacked:
        # designs/0042: the tree the restack will give, which the
        # head's own check doesn't test.
        entry["restacked"] = True
    else:
        own = git(repo, "rev-parse", head + "^{tree}", run=run)
        if own.returncode == 0 and own.stdout.strip() == tree:
            entry["same_as_head"] = True
    return entry, None


def write_ahead_refs(repo, entries, run=sh):
    """Write `entries`' commits as AHEAD_REF<k> in `repo`, and delete
    any ref past the last one."""
    listed = git(repo, "for-each-ref", "--format=%(refname)", AHEAD_REF,
                 run=run)
    stale = set(listed.stdout.split()) if listed.returncode == 0 else set()
    for k, entry in enumerate(entries):
        git(repo, "update-ref", AHEAD_REF + str(k), entry["sha"], run=run)
        stale.discard(AHEAD_REF + str(k))
    for ref in sorted(stale):
        git(repo, "update-ref", "-d", ref, run=run)


def changed_files(repo, base, pr, cache, run=sh):
    """designs/0047: the files `pr`'s head changes since it left `base`
    (`git diff --name-only base...head`), as a frozenset, or None when
    git can't say. Kept in `cache` by head."""
    head = pr["headRefOid"]
    if head not in cache:
        have_head(repo, pr, run)
        got = git(repo, "diff", "--name-only", "--no-renames",
                  "%s...%s" % (base, head), run=run)
        cache[head] = (frozenset(got.stdout.split())
                       if got.returncode == 0 else None)
    return cache[head]


def train_carriages(queue, layers_of=None):
    """designs/0047: `queue` as carriages, in its order: each pull
    request with its stack's ready layers (`layers_of(pr)`, from
    `ready_layers`, with merge.test_ahead.stacks) straight after it,
    and anything else alone."""
    out, placed = [], set()
    for pr in queue:
        if pr["number"] in placed:
            continue
        carriage = [pr]
        placed.add(pr["number"])
        for layer, _ in (layers_of(pr) if layers_of else ()):
            if layer["number"] in placed:
                break
            carriage.append(layer)
            placed.add(layer["number"])
        out.append(carriage)
    return out


def carriage_bases(carriage):
    """{number: the number of the member of `carriage` it is stacked
    on, or None for the carriage's first}. A carriage is a stack: a
    pull request and its ready layers, each after the one it is on,
    and layers side by side on one base make it a tree, not a chain
    (amendment of 2026-11-12). A member whose base isn't in the carriage
    is taken to be on the one before it."""
    by_branch = {pr.get("headRefName"): pr["number"] for pr in carriage}
    # One whose base isn't in the carriage is taken to be on the one
    # before it, as a chain.
    return {pr["number"]: by_branch.get(pr.get("baseRefName"),
                                        carriage[k - 1]["number"])
            if k else None for k, pr in enumerate(carriage)}


def stacked_on(number, bases):
    """The members `bases` (`carriage_bases`, or a train's entries'
    `on`) has stacked on `number`, directly or not."""
    out, grew = set(), True
    while grew:
        grew = False
        for n, on in bases.items():
            if n not in out and (on == number or on in out):
                out.add(n)
                grew = True
    return out


def kept_by_label(sha, github, cache):
    """labels.keep_trains: the pull request carrying KEEP_LABEL that
    `sha`, a commit on the default branch, merged, or None. Answers are
    kept in `cache` ({sha: number, or 0}); one GitHub can't give isn't
    kept, and counts as None."""
    if sha in cache:
        return cache[sha] or None
    owner, name = REPO_SLUG.split("/")
    try:
        got = github.api("graphql", "-f", "query=" + KEEP_QUERY,
                         "-F", "owner=" + owner, "-F", "name=" + name,
                         "-f", "oid=" + sha)
        nodes = got["data"]["repository"]["object"][
            "associatedPullRequests"]["nodes"]
    except (RuntimeError, KeyError, TypeError, ValueError):
        return None
    found = 0
    for node in nodes or ():
        if not isinstance(node, dict) or node.get("merged") is not True \
                or (node.get("mergeCommit") or {}).get("oid") != sha:
            continue
        if KEEP_LABEL in [(n or {}).get("name") for n in
                          ((node.get("labels") or {}).get("nodes") or ())]:
            found = node.get("number") or 0
    cache[sha] = found
    return found or None


def carried_base(repo, state_dir, last, main_tip, github, run=sh,
                 out=print):
    """labels.keep_trains (amendment of 2026-11-12, tenth): the commit
    the trains in `last` (ahead.json, `trains_before`) stay predicted
    on, and `main_tip` when they don't. They stay on their base when
    the default branch has moved since only by merges of pull requests
    carrying KEEP_LABEL (at most KEEP_MOST of them, each followed back
    by its first parent), and the last train's top still merges with
    `main_tip` cleanly: their runs go on, and a green train merges its
    tested chain with one more merge, of the default branch, on top
    (`train_merge`). Anything else moving it cuts them all again, as
    before."""
    last = trains_before(last)
    base = (last or {}).get("base")
    if not KEEP_LABEL or not last_trains(last) or not isinstance(base, str) \
            or base == main_tip or len(base) != 40:
        return main_tip
    # Kept before, the trains' base is no longer the default branch's
    # tip it was on (`main`): only what has moved it since is asked.
    since = (last or {}).get("main") or base
    if not isinstance(since, str) or since == main_tip or git(
            repo, "merge-base", "--is-ancestor", since, main_tip,
            run=run).returncode != 0:
        return base if since == main_tip else main_tip
    revs = git(repo, "rev-list", "--first-parent",
               "%s..%s" % (since, main_tip), run=run)
    shas = revs.stdout.split() if revs.returncode == 0 else []
    if not shas or len(shas) > KEEP_MOST:
        return main_tip
    path = os.path.join(state_dir, KEEP_FILE)
    cache = load_json(path, {})
    cache = cache if isinstance(cache, dict) else {}
    before = dict(cache)
    entries = [e for e in (last or {}).get("entries") or ()
               if isinstance(e, dict)]
    by = []
    for sha in reversed(shas):
        # A kept train's own merge (`train_onto`): the trains behind it
        # were predicted on its chain, which is their base now.
        second = git(repo, "rev-parse", "-q", "--verify", sha + "^2",
                     run=run)
        chain = cache.get("train:" + second.stdout.strip()) \
            if second.returncode == 0 else None
        if isinstance(chain, str):
            at = next((k for k, e in enumerate(entries)
                       if e.get("sha") == chain), None)
            if at is None or at + 1 >= len(entries):
                by.append(None)
                break
            base = chain
            continue
        by.append(kept_by_label(sha, github, cache))
    if cache != before:
        # The newest few hundred answers are plenty.
        save_json(path, dict(list(cache.items())[-300:]))
    if not all(by):
        return main_tip
    top = (entries or [{}])[-1].get("sha")
    if not top or git(repo, "merge-tree", "--write-tree", top, main_tip,
                      run=run).returncode != 0:
        out("TRAIN-KEEP: %s moved by %s, but the trains' last top doesn't "
            "merge with it cleanly; every train is cut again"
            % (MAIN, ", ".join("#%d" % n for n in by)))
        return main_tip
    return base


def last_trains(last):
    """The trains of `last`, an ahead.json (or the dry run's file) that
    cut trains, as lists of carriages, each a list of its entries; []
    when it cut none or can't be read."""
    if not isinstance(last, dict) or not last.get("trains"):
        return []
    entries = last.get("entries")
    if not isinstance(entries, list) or not all(
            isinstance(e, dict) and isinstance(e.get("pr"), int)
            for e in entries):
        return []
    sizes = [b.get("size") for b in [last.get("batch") or {}]
             + list(last.get("later") or ()) if isinstance(b, dict)]
    trains, at = [], 0
    for size in sizes:
        if not isinstance(size, int) or isinstance(size, bool) or size < 1 \
                or at + size > len(entries):
            break
        carriages = []
        for e in entries[at:at + size]:
            if carriages and e.get("carriage") is not None \
                    and e.get("carriage") == carriages[-1][-1].get(
                        "carriage"):
                carriages[-1].append(e)
            else:
                carriages.append([e])
        trains.append(carriages)
        at += size
    return trains


def cut_trains(repo, main_tip, carriages, last, heads, open_numbers,
               trains=None, red=frozenset(), restacks=None, run=sh,
               files=None, note=None, force_merges=True, started=None,
               acting=None):
    """designs/0047: (entries, sizes, events) for the trains this tick,
    end to end from `main_tip`: the predictions as `predict_ahead` makes
    them, each with `train` (its train's place) and `carriage` (its
    carriage's first pull request), the trains' sizes, and what changed
    the trains `last` cut, as [(cause, line)], each line to be said
    after `TRAIN-` (live) or `TRAIN-DRY ` (a dry run).

    `carriages` are the queue's (`train_carriages`), in its order;
    `heads` the open pull requests' heads by number; `trains` how many
    (default AHEAD_BATCHES); `red` the pull requests whose own head is
    red, which can't board; `files` a cache for `changed_files`; `note`
    a dict given `urgent_cut`, the urgent pull requests that have had
    their cut, to keep with the trains (`last`'s is read): one that then
    can't board doesn't cut them again every tick. `started(sha, tree)`
    says whether the build check has started a train's top (or has a
    verdict on its tree); without it, only the first train is kept for
    an urgent one. `acting`, the pull request the Merger acts on (its
    update or own run in flight), stays first in a train cut afresh,
    ahead of urgent ones: the Merger merges it next whatever the train
    says, and a train that didn't start with it would be predicted on a
    tree the default branch never reaches (designs/0047, second
    amendment of 2026-11-11). `force_merges` false
    (a dry run, whose trains the batches' merges don't follow) keeps the
    trains when the default branch moves.

    1. The trains `last` cut stay as cut, in their order, while what is
       left of each still merges cleanly: a member that merged or closed
       is gone, and one that left the queue, or whose head changed to a
       tree other than the one predicted, leaves with the layers of its
       stack above it (`TRAIN-LEFT`). The others keep their places.
    2. An urgent pull request, or a red default branch's fix, that is in
       no train cuts again the trains after the first whose tops the
       build check hasn't started (`TRAIN-RECUT`): a train whose run has
       started keeps it (designs/0047, amendment of 2026-11-11); or
       all of them when the queue has put it in front of the first; and
       the default branch moving to a tree no train predicted, a force
       merge, cuts them all.
    3. New trains are cut from what is left, urgent ones first, then
       the biggest carriages, then in the queue's order: the first carriage that merges cleanly, then each
       next one that touches no file the train touches (or, with
       TRAINS_WITHIN "clean", merges cleanly) and keeps it within
       AHEAD_BATCH. Urgent ones board first and share a train whenever
       they merge cleanly in order, even touching the same files
       (agent-forge #298); the train then fills up with the others,
       as any train does, rather than leaving with only the urgent
       ones. A stack is never split; one longer than AHEAD_BATCH is a
       train on its own. Only a layer that is red or won't merge parts from what is below it:
       it stays behind with the layers above it, and the ones below
       board. On 2026-11-07 two stacks' bottom pull requests, each
       fine, waited two hours while newer ones went past, because a
       layer above conflicted and the whole carriage was skipped."""
    trains = AHEAD_BATCHES if trains is None else trains
    files = {} if files is None else files
    by_number = {pr["number"]: pr for c in carriages for pr in c}
    events, kept = [], []
    prior = last_trains(last)
    if prior and force_merges and (last or {}).get("base") != main_tip:
        tip_tree = git(repo, "rev-parse", main_tip + "^{tree}", run=run)
        predicted = {e.get("tree") for t in prior for c in t for e in c}
        if tip_tree.returncode != 0 or \
                tip_tree.stdout.strip() not in predicted:
            events.append(("main moved", "RECUT: %s moved to %s, a "
                           "tree no train predicted; every train is cut "
                           "again" % (MAIN, main_tip[:10])))
            prior = []
    first = carriages[0][0] if carriages and carriages[0] else None
    if prior and first is not None and urgent(first) and first["number"] \
            not in {e.get("pr") for c in prior[0] for e in c}:
        # The queue put it in front of the first train (a red default
        # branch's fix, say, while that train isn't merging yet): the
        # Merger acts on it first, so every train is cut again.
        events.append(("urgent", "RECUT: #%d goes in front of the first "
                       "train; every train is cut again" % first["number"]))
        prior = []
    in_prior = {e.get("pr") for t in prior for c in t for e in c}
    hot = sorted(n for n, pr in by_number.items() if urgent(pr))
    had = set((last or {}).get("urgent_cut") or ()) if prior else set()
    jump = [n for n in hot if n not in in_prior and n not in had]
    if note is not None:
        note["urgent_cut"] = hot
    if len(prior) > 1 and jump:
        # Keep the trains whose top runs have started: cutting them
        # again would throw those runs away (designs/0047, amendment of
        # 2026-11-11). The first always stays.
        keep = 1
        if started is not None:
            while keep < len(prior):
                top = prior[keep][-1][-1]
                if not started(top.get("sha"), top.get("tree")):
                    break
                keep += 1
        if keep < len(prior):
            events.append(("urgent", "RECUT: #%d goes first; the trains "
                           "after train %d are cut again"
                           % (min(jump), keep)))
            prior = prior[:keep]
    entries, sizes, used, parent = [], [], set(), main_tip
    graph = None
    # The commit each member was predicted on, last time: while the
    # train up to it is the same, its prediction is still what a push
    # that only merges what is below it must give.
    was, before = {}, (last or {}).get("base")
    # A layer whose base has merged since it boarded still boarded as a
    # layer (`boarded_layers`), though it heads its carriage now.
    was_on = {e.get("pr"): e.get("on") for e in (last or {}).get(
        "entries") or () if isinstance(e, dict)
        and e.get("on") is not None}
    for e in (e for t in prior for c in t for e in c):
        was[e.get("pr")], before = before, e.get("sha")
    for k, train in enumerate(prior[:trains]):
        start = len(entries)
        for carriage in train:
            # What leaves takes the layers on it with it, and only them:
            # a layer beside it, on the same base, stays (an entry from
            # before entries said `on` takes everything after it).
            bases = {x.get("pr"): x.get("on", -1) if j else None
                     for j, x in enumerate(carriage)}
            gone = set()
            for e in carriage:
                n = e.get("pr")
                if n in gone:
                    continue
                pr = by_number.get(n)
                why, entry = None, None
                if pr is None:
                    if n not in open_numbers:
                        continue
                    head = heads.get(n)
                    why = ("pushed %s mid-train" % head[:10]
                           if head and head != e.get("head")
                           else "left the queue")
                elif pr["headRefOid"] != e.get("head"):
                    have_head(repo, pr, run)
                    tree = git(repo, "rev-parse",
                               pr["headRefOid"] + "^{tree}", run=run)
                    if (tree.returncode != 0
                            or tree.stdout.strip() != e.get("tree")) \
                            and not restacking(repo, e.get("head"),
                                               pr["headRefOid"],
                                               (restacks or {}).get(n), run) \
                            and not own_push(repo, e.get("head"),
                                             pr["headRefOid"], main_tip, run):
                        entry = same_prediction(
                            repo, parent, graph, e.get("head"), pr,
                            restacks, run, e.get("tree")
                            if was.get(n) == parent else None)
                        if entry is None:
                            why = "pushed %s mid-train" \
                                % pr["headRefOid"][:10]
                        else:
                            events.append(("kept", "KEPT #%d: pushed %s, "
                                           "same tree in its place" % (
                                               n, pr["headRefOid"][:10])))
                if why is None and entry is None:
                    entry, failed = predict_one(repo, parent, pr, restacks,
                                                run, graph)
                    if entry is None:
                        why = "no longer merges cleanly onto train %d's " \
                            "base" % (k + 1)
                if why is not None:
                    later = carriage[carriage.index(e) + 1:]
                    above = [x.get("pr") for x in later
                             if x.get("on", -1) == -1
                             or x.get("pr") in stacked_on(n, bases)]
                    events.append(("left", "LEFT #%d: %s%s" % (
                        n, why, "; its stack's layers %s leave with it"
                        % ", ".join("#%d" % a for a in above)
                        if above else "")))
                    gone.update([n] + above)
                    continue
                entry.update(train=k, carriage=carriage[0].get("pr"))
                if "on" in e:
                    entry["on"] = e["on"]
                entries.append(entry)
                used.add(n)
                parent, graph = entry["sha"], entry.get("graph")
        if len(entries) > start:
            sizes.append(len(entries) - start)
    cut = []
    # Urgent ones first, but never ahead of the one the Merger acts on:
    # on 2026-11-11 a nightly's fix headed a train while the Merger
    # waited on another member's own run, merged that member on its own
    # green, and the green train's prediction no longer held.
    # Then the biggest carriages: a stack of nine is nine merges for one
    # build, and oldest-first gave the trains to single pull requests
    # while long stacks, ready and touching nothing of theirs, waited
    # for a train (2026-11-12). Equal sizes keep the queue's order.
    pool = sorted(carriages, key=lambda c: (
        acting is None or c[0]["number"] != acting, not urgent(c[0]),
        -len(c)))
    behind = set()
    # Why each carriage left out of the last train it was tried for
    # waits, for the record (`note["waits"]`).
    waits = {}
    while len(sizes) < trains:
        start, touched, kind = len(entries), set(), None
        for carriage in pool:
            bases = carriage_bases(carriage)
            members = [pr for pr in carriage if pr["number"] not in used
                       and pr["number"] not in behind]
            # A red layer stays behind with the layers on it; one beside
            # it, on the same base, may still board.
            out_of = set()
            for pr in members:
                if pr["number"] in red and pr["number"] not in out_of:
                    out_of |= {pr["number"]} | stacked_on(pr["number"],
                                                          bases)
            members = [pr for pr in members if pr["number"] not in out_of]
            for n in out_of:
                waits[n] = "its own head is red"
            if not members:
                continue
            size = len(entries) - start
            if size and size + len(members) > AHEAD_BATCH:
                waits[members[0]["number"]] = "no room in train %d" % (
                    len(sizes) + 1)
                continue
            changed = set()
            for pr in members:
                got = changed_files(repo, main_tip, pr, files, run)
                if got is None:
                    changed = None
                    waits[members[0]["number"]] = "git can't list its files"
                    break
                changed |= got
            # Urgent ones share a train whenever they merge cleanly in
            # order, whatever files they touch: they are usually small
            # and often the same file (a project's configuration), and
            # one train each would merge them one at a time (agent-forge
            # #298). The others behind them board by the usual rule.
            if changed is None or (size and TRAINS_WITHIN == "files"
                                   and not (kind and urgent(members[0]))
                                   and changed & touched):
                if changed is not None:
                    waits[members[0]["number"]] = \
                        "touches a file train %d touches" % (len(sizes) + 1)
                continue
            made, top, top_graph, failing = [], parent, graph, set()
            for pr in members:
                if pr["number"] in failing:
                    continue
                entry, failed = predict_one(repo, top, pr, restacks, run,
                                            top_graph)
                if entry is None:
                    waits[pr["number"]] = "%s onto train %d" % (
                        "conflicts" if failed == "conflict"
                        else "git can't merge it", len(sizes) + 1)
                    # It stays behind with the layers on it; a layer
                    # beside it may still board.
                    failing |= {pr["number"]} | stacked_on(pr["number"],
                                                           bases)
                    continue
                on = bases.get(pr["number"])
                entry.update(train=len(sizes),
                             carriage=members[0]["number"],
                             on=on if on is not None
                             else was_on.get(pr["number"]))
                made.append(entry)
                top, top_graph = entry["sha"], entry.get("graph")
            if not made:
                continue
            boarded = {e["pr"] for e in made}
            left = [pr["number"] for pr in carriage
                    if pr["number"] not in used
                    and pr["number"] not in behind
                    and pr["number"] not in boarded]
            if left:
                for n in left:
                    waits.setdefault(n, "a layer below it can't board")
                behind.update(left)
                events.append(("left", "LEFT #%d: won't board with the "
                               "layers below it, which go without it%s" % (
                                   left[0], "; also held back: %s" % ", ".join(
                                       "#%d" % n for n in left[1:])
                                   if left[1:] else "")))
            entries += made
            used.update(e["pr"] for e in made)
            touched |= changed
            kind = urgent(members[0]) if not size else \
                kind and urgent(members[0])
            parent, graph = top, top_graph
            if len(entries) - start >= AHEAD_BATCH:
                break
        if len(entries) == start:
            break
        sizes.append(len(entries) - start)
        cut.append(entries[start:])
    if note is not None:
        boarded = {e["pr"] for e in entries}
        for n in by_number:
            waits.setdefault(n, "every train is full")
        note["waits"] = {str(n): why for n, why in sorted(waits.items())
                         if n not in boarded and n in by_number}
    for train in cut:
        events.append(("cut", "CUT %d: %s" % (
            train[0]["train"] + 1, " ".join(
                "#%d" % e["pr"] for e in train))))
    return entries, sizes, events


def train_batches(entries, sizes, verdict):
    """designs/0047: (size, red, later) for trains as `batch_size` and
    `later_batches` give them for batches: the first train's size, that
    size again when its top is red (else None), and the trains after it
    as ahead.json's `later`, each fixed, since a train is fixed once
    cut. Nothing follows a red first train, nor a later one whose top is
    red. A later train whose top is green is folded into the first with
    every train in front of it: the first `size` is then theirs together,
    whatever their own tops say."""
    if not sizes or sizes[0] > len(entries):
        # Fixed trains longer than what is left (a member handed back
        # since they were cut): none of them holds; the next cut says.
        return 0, None, []
    size, first = sizes[0], 1
    # A later train's green top covers it and every train in front of
    # it (amendment of 2026-11-11): its tree contains them all, and its
    # run took in every step their changes touch. They are folded into
    # the first, which merges at once, rather than waiting for their
    # own tops' verdicts.
    at = 0
    for k, n in enumerate(sizes):
        if at + n > len(entries):
            break
        at += n
        if k and verdict(entries[at - 1]["tree"]) is True:
            size, first = at, k + 1
    red = size if verdict(entries[size - 1]["tree"]) is False else None
    later, at = [], size
    for n in sizes[first:] if red is None else ():
        if at + n > len(entries):
            break
        later.append({"size": n, "trees": [e["tree"] for e in
                                           entries[at:at + n]],
                      "fixed": True})
        if verdict(entries[at + n - 1]["tree"]) is False:
            break
        at += n
    return size, red, later


def head_red(check_state, pr):
    """Whether the build check's own run of `pr`'s head is red
    (designs/0047: it can't board a train): its verdict, not a batch's
    cover. Not while the default branch is red, when every head may be,
    nor for an urgent one. Nor when it was red only because it
    conflicted with the default branch's tip of then (forge-pr-check's
    `conflicted`: no step ran): whether it merges now is the cut's own
    question, and that red stayed on the head after the default branch
    moved on and it merged cleanly again, keeping it out of every train
    (2026-11-12: four such heads, three of them layers whose base had
    merged, and only one train was cut for an hour)."""
    if (check_state or {}).get("main_red", {}).get("issue") or urgent(pr):
        return False
    got = ((check_state or {}).get("results") or {}).get(pr["headRefOid"])
    return isinstance(got, dict) and got.get("ok") is False \
        and not got.get("covered") and not got.get("conflicts") \
        and got.get("failed") != ["merge"]


def train_line(sizes, entries):
    """How the trains read in a TRAIN-DRY line: `1: #a #b | 2: #c`."""
    out, at = [], 0
    for k, n in enumerate(sizes):
        out.append("%d: %s" % (k + 1, " ".join(
            "#%d" % e["pr"] for e in entries[at:at + n])))
        at += n
    return " | ".join(out) or "none"


def train_lists(entries, sizes):
    """The trains' pull requests, as a list of lists, for the record."""
    out, at = [], 0
    for n in sizes:
        out.append([e["pr"] for e in entries[at:at + n]])
        at += n
    return out


def kept_trains(main_tip, entries, sizes, note=None):
    """The trains this tick cut, `entries` in `sizes`, as an ahead.json
    `cut_trains` reads them (`last_trains`), for a red train's search
    to keep (`trains_before`)."""
    kept = {"trains": True, "base": main_tip,
            "entries": [dict(e) for e in entries],
            "batch": {"size": sizes[0]} if sizes else {},
            "later": [{"size": n} for n in sizes[1:]]}
    if (note or {}).get("urgent_cut"):
        kept["urgent_cut"] = note["urgent_cut"]
    return kept


def trains_before(last):
    """The trains a tick cuts its own from: `last` (ahead.json) when it
    cut trains, else the trains a red train's search keeps in it
    (`kept_trains`), else `last`. A red top's members are searched with
    batches of their own, and ahead.json then holds no trains; cut
    afresh when the search ended, every train took new pull requests in
    the middle (bigger carriages go first in a new cut), and the runs
    of the trains behind it were thrown away (2026-11-12). Kept, a
    member the search found red leaves, those merged are gone, and the
    rest keep their places, as after any other train."""
    if not isinstance(last, dict) or last.get("trains") \
            or not isinstance(last.get("kept_trains"), dict):
        return last
    return last["kept_trains"]


def dry_trains(state_dir, cut, main_tip, repo, record, out, when,
               note=None):
    """merge.test_ahead.trains "dry-run" (designs/0047): cut the trains
    this tick would have, from the dry run's own last trains
    (TRAINS_DRY_FILE), without writing a ref or changing the batches.
    The record says `trains`, `trains_dry` and `train_events`, and
    `recut_avoided`
    when the batches were cut again but no train left or was cut again.
    `TRAIN-DRY 1: #a #b | 2: #c` is said when the trains change, and
    each other change as `TRAIN-DRY <what>`."""
    path = os.path.join(state_dir, TRAINS_DRY_FILE)
    last = load_json(path, {})
    entries, sizes, events = cut(last)
    record["trains"] = train_lists(entries, sizes)
    record["trains_dry"] = True
    if events:
        record["train_events"] = [c for c, _ in events]
    if record.get("recut") and not any(c not in ("cut", "kept")
                                       for c, _ in events):
        record["recut_avoided"] = True
    for cause, line in events:
        if cause != "cut":
            out("TRAIN-DRY " + line)
    said = {"at": iso(when), "base": main_tip,
            "repo": git_store(repo),
            "trains": True, "entries": entries,
            "said": "TRAIN-DRY " + train_line(sizes, entries)}
    if (note or {}).get("urgent_cut"):
        said["urgent_cut"] = note["urgent_cut"]
    if sizes:
        said["batch"] = {"size": sizes[0], "trees": [
            e["tree"] for e in entries[:sizes[0]]]}
        at, said["later"] = sizes[0], []
        for n in sizes[1:]:
            said["later"].append({"size": n, "trees": [
                e["tree"] for e in entries[at:at + n]], "fixed": True})
            at += n
    if said["said"] != (last or {}).get("said"):
        out(said["said"])
    save_json(path, said)


def locked_order(state_dir, queue):
    """{number: place} for the candidates in `queue` that the last live
    tick predicted (AHEAD_FILE) at the head they still have, in its
    order. Their runs have started, so they keep their places ahead of
    every other candidate: one approved later, an older one approved
    again, or one newly labelled urgent goes behind them, rather than
    into the middle where it would spend every prediction behind it."""
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    entries = last.get("entries") if isinstance(last, dict) else None
    heads = {pr["number"]: pr["headRefOid"] for pr in queue}
    places = {}
    for entry in entries if isinstance(entries, list) else ():
        number = entry.get("pr") if isinstance(entry, dict) else None
        if (number is not None and number not in places
                and heads.get(number) == entry.get("head")):
            places[number] = len(places)
    return places


def fixed_order(state_dir, repo, queue, open_numbers, approvals, said,
                check_state, when=None, run=sh):
    """{number: place} for the pull requests of the batches the last
    live tick predicted (AHEAD_FILE) up to and including the last whose
    top's run has started, in their order (designs/0044, rule 3). Their
    order is fixed: an overdue candidate (designs/0037), one with right
    of way, or one newly approved goes behind them, and right of way
    holds none of them. Only the batch being merged gives way to an
    urgent one less, as before, and a red default branch's fixes still
    go first. A batch's top's run has started when ahead.json says it
    is `fixed`, or the build check has started it (`ahead_started`).
    Without `batch` each prediction is a batch of its own.

    A member that drops out ends it, from its batch on, since every tree
    from there on changes anyway: one still open (`open_numbers`) but no
    longer in `queue`, handed back at its head (`said`, under its
    approval in `approvals`), or at another head whose tree is not the
    one predicted (GitHub's update of the one in flight gives the
    predicted tree, so that one stays). One that merged or closed has
    left the front, and the rest keep their places. One project,
    2026-11-04: overdue candidates, right of way and three batches in
    flight re-cut the batches about 13 times an hour, and 46% of green
    batch-top runs merged nothing."""
    heads = {pr["number"]: pr for pr in queue}
    places = {}
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    # designs/0047: a train keeps its place when a member leaves; only
    # the leaver goes, with its stack's layers above it.
    trains = TRAINS == "live" and isinstance(last, dict) \
        and bool(last.get("trains"))
    for group in started_batches(last, check_state):
        kept, gone = [], None
        for e in group:
            if gone is not None and e.get("carriage") == gone:
                continue
            pr = heads.get(e.get("pr"))
            left = False
            if pr is None:
                if e.get("pr") not in open_numbers:
                    continue
                left = True
            elif pr["headRefOid"] != e.get("head"):
                have_head(repo, pr, run)
                tree = git(repo, "rev-parse", pr["headRefOid"] + "^{tree}",
                           run=run)
                left = tree.returncode != 0 or \
                    tree.stdout.strip() != e.get("tree")
            if not left and handed_back(
                    said, pr, approvals.get(pr["number"]) or {}, when):
                left = True
            if left:
                if not trains:
                    return places
                gone = e.get("carriage", e.get("pr"))
                continue
            kept.append(pr["number"])
        for number in kept:
            places.setdefault(number, len(places))
    return places


def started_batches(last, check_state):
    """The batches of `last`, an ahead.json, as lists of its entries,
    up to and including the last whose top's run has started: ahead.json
    says it is `fixed`, or the build check has started it
    (`ahead_started`). Without `batch` each prediction is a batch of its
    own. Every tree of a later batch holds the batches before it, so a
    run started there counts for them too."""
    entries = last.get("entries") if isinstance(last, dict) else None
    if not isinstance(entries, list) or not all(
            isinstance(e, dict) for e in entries):
        return []
    batch, sizes = last.get("batch"), []
    if isinstance(batch, dict):
        for b in [batch] + list(last.get("later") or ()):
            if not isinstance(b, dict) or not isinstance(b.get("size"), int) \
                    or isinstance(b.get("size"), bool) or b["size"] < 1:
                break
            sizes.append((b["size"], b is not batch and b.get("fixed")))
    else:
        sizes = [(1, False)] * len(entries)
    groups, at, end = [], 0, 0
    for size, fixed in sizes:
        group = entries[at:at + size]
        if len(group) < size:
            break
        groups.append(group)
        top = group[-1]
        if fixed or (isinstance(top.get("sha"), str)
                     and isinstance(top.get("tree"), str)
                     and ahead_started(check_state, top["sha"], top["tree"])):
            end = len(groups)
        at += size
    if last.get("trains"):
        # designs/0047: a train is fixed once cut.
        return groups
    return groups[:end]


def recut(last, entries, open_numbers, merged, check_state):
    """Whether the predictions `entries` re-cut a batch of `last`, the
    ahead.json before them, whose top's run had started
    (`started_batches`; designs/0044, rule 5): what is left of those
    batches, without the pull requests that merged or closed since
    (`merged`, or not in `open_numbers`), is no longer a run of the
    same pull requests with the same trees. That run is then spent."""
    left = [(e.get("pr"), e.get("tree")) for group in started_batches(
        last, check_state) for e in group
        if e.get("pr") in open_numbers and e.get("pr") not in merged]
    now = [(e["pr"], e["tree"]) for e in entries]
    return bool(left) and not any(now[k:k + len(left)] == left
                                  for k in range(len(now) - len(left) + 1))


def unstable(records, recut_now):
    """How many ticks in `records` (the last UNSTABLE_WINDOW), and this
    one when `recut_now`, re-cut a batch whose top's run had started,
    when that is more than merge.test_ahead.unstable_after_recuts
    (designs/0044, rule 5); else None."""
    if UNSTABLE_AFTER is None:
        return None
    count = sum(1 for r in records if r.get("recut") is True) + bool(recut_now)
    return count if count > UNSTABLE_AFTER else None


def head_trees(repo, run=sh):
    """A callable giving a pull request's head's tree, or None, fetching
    the head first; each head is asked once. A member whose head moved
    (the Merger's own update of it, a restack, a retarget) is still the
    member it was predicted as when its head's tree is the one predicted
    for its place: merging it lands exactly the tree the batch tested."""
    cache = {}

    def tree(pr):
        head = pr["headRefOid"]
        if head not in cache:
            have_head(repo, pr, run)
            got = git(repo, "rev-parse", head + "^{tree}", run=run)
            cache[head] = got.stdout.strip() if got.returncode == 0 \
                else None
        return cache[head]
    return tree


def is_member(entry, pr, tree_of=None):
    """Whether `pr` is still batch entry `entry`: at the head or merge
    predicted for it, or (with `tree_of`, from `head_trees`) at a head
    whose tree is the one predicted for its place."""
    if pr is None:
        return False
    if pr["headRefOid"] in (entry.get("head"), entry.get("sha")):
        return True
    return (tree_of is not None and entry.get("tree") is not None
            and tree_of(pr) == entry.get("tree"))


def current_batch(state_dir, queue, tree_of=None):
    """(trees, members) of the batch the last tick (AHEAD_FILE) was
    merging: its batch while a member is still in `queue` at the head
    it was predicted at, else the first of its `later` batches while one
    of that is. Once a batch has merged, the one predicted on it comes
    next, and its top's run counts for it: on 2026-10-26 a layer went in
    front of a green later batch just after the batch below it merged.
    ([], set()) when there is none."""
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    if not isinstance(last, dict):
        return [], set()
    entries = last.get("entries")
    if not isinstance(entries, list):
        return [], set()
    prs = {pr["number"]: pr for pr in queue}
    batches = [last.get("batch")] + list((last.get("later") or [])[:1])
    for batch in batches:
        trees = batch.get("trees") if isinstance(batch, dict) else None
        if not isinstance(trees, list) or not trees:
            continue
        members = {e.get("pr") for e in entries
                   if isinstance(e, dict) and e.get("tree") in trees
                   and is_member(e, prs.get(e.get("pr")), tree_of)}
        if members:
            return trees, members
    return [], set()


def green_batch(state_dir, queue, check_state, tree_of=None):
    """Whether the batch being merged (current_batch) is green: its
    top's tree is. Between one member's merge and the next, no merge is
    in flight, but the batch is still merging: a layer that comes back
    then waits for the next batch, as it does while a merge is in
    flight, since joining in front would change every member's tree and
    spend the top's green."""
    trees, members = current_batch(state_dir, queue, tree_of)
    return bool(members) and tree_verdict(check_state, trees[-1]) is True


def green_batch_first(state_dir, queue, check_state, in_flight, main_tip,
                      tree_of=None):
    """designs/0047, amendment of 2026-11-10 (`green_batch_first`): the
    green batch that goes before `in_flight`, as (trees, members), or
    None. It does when the last tick predicted it on `main_tip`, the
    default branch's tip now, its top's tree is green, `in_flight` isn't
    one of its members, and `in_flight`'s own head has no verdict yet:
    its run would make the batch wait, and its merge would move the
    default branch under the green top and spend it. In flight, it was
    updated onto the tip anyway, so the batch's merge costs it only a
    run it was having."""
    if in_flight is None:
        return None
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    if not isinstance(last, dict) or last.get("base") != main_tip:
        return None
    trees, members = current_batch(state_dir, queue, tree_of)
    if not members or in_flight in members \
            or tree_verdict(check_state, trees[-1]) is not True:
        return None
    # A member the Merger itself just updated has a new head, neither
    # the one predicted nor the predicted merge, so current_batch no
    # longer counts it; it is still the batch's own, and the others
    # were predicted on top of it.
    if any(isinstance(e, dict) and e.get("pr") == in_flight
           and e.get("tree") in trees for e in last.get("entries") or ()):
        return None
    head = next((pr["headRefOid"] for pr in queue
                 if pr["number"] == in_flight), None)
    results = (check_state or {}).get("results") or {}
    if head is None or isinstance(results.get(head), dict):
        return None
    return trees, members


def batch_members(state_dir, queue, tree_of=None):
    """The pull requests of the batch being merged (current_batch) still
    in `queue` at the head they were predicted at."""
    return current_batch(state_dir, queue, tree_of)[1]


def fixes_first(queue, in_flight, members):
    """`queue` with MAIN_RED_FIXES first, behind only `in_flight`, a
    green batch's `members` (designs/0011, amendment) and those carrying
    `labels.urgent`, which always go first; the rest keep their order,
    and so do the members, among which a fix doesn't move up (see
    overdue_first)."""
    return sorted(queue, key=lambda pr: (
        pr["number"] != in_flight, pr["number"] not in members,
        pr["number"] not in members and not labelled_urgent(pr),
        pr["number"] not in members
        and pr["number"] not in MAIN_RED_FIXES))


def predicted(state_dir):
    """The pull requests the last live tick predicted (AHEAD_FILE), at
    any head."""
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    entries = last.get("entries") if isinstance(last, dict) else None
    return {entry.get("pr") for entry in
            (entries if isinstance(entries, list) else ())
            if isinstance(entry, dict)}


def ahead_started(check_state, sha, tree):
    """Whether the build check has started a run of the prediction
    `sha`, or has a verdict on its tree."""
    started = (check_state or {}).get("ahead_started")
    return (isinstance(started, dict) and sha in started) \
        or tree_verdict(check_state, tree) is not None


def tree_verdict(check_state, tree):
    """The build check's verdict on `tree` from its state: True when a
    run of it, or a match to one, is green, False when it has only red
    ones, None when it has none. A batch's cover of a tree is not a run
    of it, so it doesn't count."""
    oks = [r.get("ok") is True
           for r in ((check_state or {}).get("results") or {}).values()
           if isinstance(r, dict) and r.get("tree") == tree
           and not r.get("covered")]
    return any(oks) if oks else None


def main_red_fixes(check_state):
    """The pull requests forge-pr-check found closing its open issue
    saying the default branch is red (`main_red.fixes`), as a
    frozenset; empty when no such issue is open (designs/0011,
    amendment)."""
    red = (check_state or {}).get("main_red")
    if not isinstance(red, dict) or not red.get("issue"):
        return frozenset()
    fixes = red.get("fixes")
    return frozenset(n for n in fixes if isinstance(n, int)
                     and not isinstance(n, bool)) \
        if isinstance(fixes, list) else frozenset()


def instance_red_rules(project):
    """(title regex, labels, poster login) for each build-check instance
    that files its own main-red issue (checks.instances.<name>.
    main_red_issue), as forge-pr-check titles and posts it."""
    instances = project.section("checks").get("instances") or {}
    for name in sorted(instances):
        block, _host = config.instance_checks(project.data, name)
        issue = block.get("main_red_issue")
        if not isinstance(issue, dict):
            continue
        context = block.get("context", DEFAULT_CONTEXT)
        title = re.escape(issue.get("title", INSTANCE_RED_TITLE)) \
            .replace(re.escape("{sha}"), "[0-9a-f]+") \
            .replace(re.escape("{context}"), re.escape(context))
        labels = list(issue.get("labels", [])) + (
            [issue["label"]] if issue.get("label") else [])
        poster = block.get("poster", project.section("merge").get(
            "merger", "Merger"))
        yield (re.compile("^%s$" % title), tuple(labels),
               project.bot_login(poster))


def instance_red_issues(github, rules=None):
    """The numbers of the open issues an instance's check filed saying
    the default branch is red for its context (agent-forge #154): its
    labels, its title, by its poster. Empty when none is configured, or
    GitHub can't be read: then they only don't go first."""
    rules = INSTANCE_RED if rules is None else rules
    owner, name = REPO_SLUG.split("/")
    found = set()
    for title, labels, poster in rules:
        args = ["graphql", "-f", "query=" + INSTANCE_RED_QUERY,
                "-F", "owner=" + owner, "-F", "name=" + name]
        for label in labels:
            args += ["-f", "labels[]=" + label]
        try:
            nodes = github.api(*args)["data"]["repository"]["issues"]["nodes"]
        except (RuntimeError, KeyError, TypeError, ValueError):
            continue
        login = (poster or "").replace("[bot]", "").lower()
        for node in nodes or ():
            if title.match(node.get("title") or "") and (
                    (node.get("author") or {}).get("login", "")
                    .replace("[bot]", "").lower() == login):
                found.add(node["number"])
    return found


def red_fixes_of(prs, issues):
    """The pull requests among `prs` whose title or body (outside code)
    closes one of `issues`, as forge-pr-check's red_fixes reads them."""
    if not issues:
        return frozenset()
    keywords = load_tool("forge-closing-keywords")
    pattern = keywords.closing_re(REPO_SLUG)
    fixes = set()
    for pr in prs:
        text = keywords.blank_code("%s\n%s" % (pr.get("title") or "",
                                               pr.get("body") or ""))
        named = {int(next(g for g in m if g)) for m in pattern.findall(text)}
        if named & set(issues):
            fixes.add(pr["number"])
    return frozenset(fixes)


def base_red_only(check_state, records, base):
    """The steps, sorted, when every one of the red verdicts `records`
    failed only steps that the default branch's own run of `base` failed
    too: the red is the base's (designs/0011, amendment). None when any
    is green or failed a step the base passed, or the base has no red
    run of its own."""
    results = (check_state or {}).get("results") or {}
    own = results.get(base) if isinstance(base, str) else None
    if not records or not isinstance(own, dict) or not own.get("main") \
            or own.get("ok") is not False:
        return None
    broken = set(own.get("failed") or ())
    steps = set()
    for r in records:
        failed = r.get("failed") if isinstance(r, dict) else None
        if r.get("ok") is not False or not failed \
                or not set(failed) <= broken:
            return None
        steps |= set(failed)
    return sorted(steps)


def tree_base_red(check_state, tree, base):
    """base_red_only for the runs of `tree` (not covers of it)."""
    return base_red_only(check_state, [
        r for r in ((check_state or {}).get("results") or {}).values()
        if isinstance(r, dict) and r.get("tree") == tree
        and not r.get("covered")], base)


def head_base_red(check_state, head):
    """base_red_only for the verdict on `head` merged with the default
    branch, against the tip it was merged with."""
    r = ((check_state or {}).get("results") or {}).get(head)
    if not isinstance(r, dict) or not r.get("base_red"):
        return None
    return base_red_only(check_state, [r], r.get("base"))


def urgent_cap(entries, at, n, urgents):
    """`n`, cut so the batch of the predictions `entries` from `at`
    doesn't mix urgent pull requests (`urgents`, numbers) with others
    (designs/0011, amendment, part 3): it ends where the first one's
    kind changes."""
    if not urgents or n < 2:
        return n
    first = entries[at]["pr"] in urgents
    for k in range(1, n):
        if (entries[at + k]["pr"] in urgents) != first:
            return k
    return n


def batch_size(entries, last, verdict, later=(), urgents=frozenset()):
    """(size, red): how many of the predictions `entries` are the batch
    (designs/0032), and the size before any red top split it, or None.
    The batch `last` (ahead.json's, its `trees`) goes on while what is
    left of it still leads the predictions: those that merged since are
    gone from its front, the rest are unchanged. Once it is gone, the
    first of the `later` batches (designs/0035 part 2) follows it if it
    was fixed and still leads them, since its top's run counts for it.
    Otherwise a new one is the first AHEAD_BATCH, ending at a tree
    already red. A red top halves it, rounding up, until the top isn't
    red or only one is left. `verdict(tree)` is `tree_verdict`'s
    answer."""
    trees = [e["tree"] for e in entries]
    size = 0
    for old in [(last or {}).get("trees") or []] + [
            b.get("trees") or [] for b in list(later)[:1]
            if isinstance(b, dict) and b.get("fixed")]:
        # What is left of it is a suffix of it that leads the trees. Not
        # found by its top's tree: two members can have the same one (a
        # change that adds nothing on top of the one before it).
        left = [k for k in range(len(old)) if old[k:] == trees[:len(old) - k]]
        if left:
            size = len(old) - left[0]
            break
    if not size:
        size = urgent_cap(entries, 0, min(AHEAD_BATCH, len(trees)), urgents)
        red = [k for k, t in enumerate(trees[:size]) if verdict(t) is False]
        if red:
            size = red[0] + 1
    red = None
    while size > 1 and verdict(trees[size - 1]) is False:
        red = red or size
        size = (size + 1) // 2
    return size, red


def later_batches(entries, size, last, verdict, started,
                  urgents=frozenset(), batches=None):
    """designs/0035 part 2: the batches after the first `size` of the
    predictions `entries`, end to end, as [{size, trees, fixed?}], at
    most `batches` - 1 of them (default AHEAD_BATCHES). A batch of the last tick's (`last`,
    ahead.json's `later`) that was `fixed` keeps its size while its
    trees still come next; the first that isn't takes up to
    AHEAD_BATCH, so it grows at its end until its top's run starts
    (`started(sha, tree)`), and is fixed from then on. Nothing follows
    a red first batch, nor a later one whose top is red: each later
    tree contains it."""
    trees = [e["tree"] for e in entries]
    batches = AHEAD_BATCHES if batches is None else batches
    if size < 1 or verdict(trees[size - 1]) is False:
        return []
    fixed = [b["trees"] for b in (last or ())
             if isinstance(b, dict) and b.get("fixed")
             and isinstance(b.get("trees"), list) and b["trees"]]
    out, at = [], size
    while len(out) < batches - 1 and at < len(trees):
        # Matched by its trees, not its place: the first of them moves
        # up once the batch before it has merged.
        kept = [t for t in fixed if trees[at:at + len(t)] == t]
        n = len(kept[0]) if kept else urgent_cap(
            entries, at, min(AHEAD_BATCH, len(trees) - at), urgents)
        top = entries[at + n - 1]
        batch = {"size": n, "trees": trees[at:at + n]}
        if kept or started(top["sha"], top["tree"]):
            batch["fixed"] = True
        out.append(batch)
        if verdict(top["tree"]) is False:
            break
        at += n
    return out


def batch_line(entries, size, red, verdict):
    """The BATCH line for a batch of `size` (designs/0032), or None
    when there is nothing to say: a red top split it, or its top is
    green and its members are merging."""
    if not entries:
        return None
    span = lambda n: "#%d..#%d" % (entries[0]["pr"], entries[n - 1]["pr"])
    if red:
        return "BATCH %s: top red, checking %s" % (span(red), span(size))
    if size > 1 and verdict(entries[size - 1]["tree"]) is True:
        return "BATCH %s: top %s green, merging %d" % (
            span(size), entries[size - 1]["sha"][:10], size)
    return None


def batch_holds(last, pr, tree, queue, check_state, tree_of=None):
    """Whether the batch that covered pull request `pr`'s head (its
    tree `tree`) still holds (designs/0032): the last tick's ahead.json
    (`last`) names a batch with that tree, its top's tree is green, and
    every pull request in it after this one is still in `queue` at the
    head it was predicted at. A member is merged only then: otherwise
    the default branch's tip could become a tree no run tested."""
    batch = (last or {}).get("batch") or {}
    entries = ((last or {}).get("entries") or [])[:batch.get("size", 0)]
    if len(entries) < 2 or [e.get("tree") for e in entries] \
            != batch.get("trees"):
        return False
    at = [k for k, e in enumerate(entries)
          if e.get("pr") == pr and e.get("tree") == tree]
    if not at:
        return False
    prs = {p["number"]: p for p in queue}
    return (all(is_member(e, prs.get(e.get("pr")), tree_of)
                for e in entries[at[0] + 1:])
            and tree_verdict(check_state, entries[-1]["tree"]) is True)


def train_ready(last, queue, main_tip, check_state, repo=None, run=sh,
                restacks=None):
    """merge.test_ahead.train_merge: the members of the batch in `last`
    (ahead.json) that can merge as one train now, or None: one or more
    (a train of one too, so the default branch lands where the next
    train predicted it, not on an update's merge), its top's tree green, predicted from `main_tip` itself (the default
    branch hasn't moved since), and each member still in `queue` at the
    head it was predicted at. Given `repo`, a member whose head has
    moved since is still ready when its new head, predicted where it
    was, gives the same tree (`same_prediction`: it only merged the
    default branch); its entry then names the new head, which the train
    merges, so GitHub marks the pull request merged at the head it
    has. The tree merged is still the one the top tested."""
    batch = (last or {}).get("batch") or {}
    entries = ((last or {}).get("entries") or [])[:batch.get("size", 0)]
    if not entries or [e.get("tree") for e in entries] \
            != batch.get("trees") or (last or {}).get("base") != main_tip \
            or tree_verdict(check_state, entries[-1].get("tree")) is not True:
        return None
    prs = {pr["number"]: pr for pr in queue}
    ready, parent, graph = [], main_tip, None
    for e in entries:
        pr = prs.get(e.get("pr"))
        if pr is None:
            return None
        if pr["headRefOid"] != e.get("head"):
            if repo is None:
                return None
            moved = same_prediction(repo, parent, graph, e.get("head"), pr,
                                    restacks, run, e.get("tree"))
            if moved is None or moved["sha"] != e.get("sha"):
                return None
            e = dict(e, head=pr["headRefOid"])
            if "graph" in moved:
                e["graph"] = moved["graph"]
            else:
                e.pop("graph", None)
        ready.append(e)
        parent, graph = e.get("sha"), e.get("graph")
    return ready


def left_top(last, entries, sizes, base, check_state):
    """merge.test_ahead.left_top_covers (agent-forge #296): the first
    train as `last` (ahead.json) cut it, cut back to the members below
    the first to leave it, when its top's run has started and isn't red,
    as {"tree": that top's tree, "sha", "entries": those members}; or
    the one `last` kept, while it is still the start of the new first
    train. None otherwise. The old top's tree held every one of those
    members' trees as the new train does, so its green covers them, as
    a green top covers every member under it; a prediction's run is
    never stopped for another (forge-pr-check `preempt_victim`), so it
    finishes. On one project (2026-11-11) a push to the fourth member of
    six made the third wait 24 minutes for the new top's run."""
    if not LEFT_TOP_COVERS or not isinstance(last, dict) \
            or not last.get("trains") or not sizes or not entries \
            or last.get("base") != base:
        return None
    old = (last.get("entries") or [])[
        :((last.get("batch") or {}).get("size") or 0)]
    new = entries[:sizes[0]]
    kept = last.get("left_top") if isinstance(last.get("left_top"),
                                              dict) else None

    def same(a, b):
        return all(a.get(k) == b.get(k) for k in ("pr", "head", "tree",
                                                  "sha"))
    if old and old[-1].get("tree") != new[-1].get("tree") \
            and ahead_started(check_state, old[-1].get("sha"),
                              old[-1].get("tree")) \
            and tree_verdict(check_state, old[-1].get("tree")) is not False:
        k = 0
        while k < min(len(old), len(new)) and same(old[k], new[k]):
            k += 1
        if 0 < k < len(old):
            kept = {"tree": old[-1]["tree"], "sha": old[-1].get("sha"),
                    "entries": old[:k]}
    if kept is None:
        return None
    members = kept.get("entries") or []
    if not members or len(members) > len(new) \
            or tree_verdict(check_state, kept.get("tree")) is False \
            or not all(same(a, b) for a, b in zip(members, new)):
        return None
    return kept


def left_ready(last, queue, base, check_state):
    """The members of `last`'s `left_top` (ahead.json) that merge now,
    on its top's green, as one train: when that top is green, the trains
    are still predicted on `base`, and each member is in `queue` at the
    head it boarded with. None otherwise."""
    kept = (last or {}).get("left_top")
    if not LEFT_TOP_COVERS or not isinstance(kept, dict) \
            or last.get("base") != base \
            or tree_verdict(check_state, kept.get("tree")) is not True:
        return None
    members = kept.get("entries") or []
    heads = {pr["number"]: pr["headRefOid"] for pr in queue}
    if not members or any(heads.get(e.get("pr")) != e.get("head")
                          for e in members):
        return None
    return members


def boarded_layers(last):
    """{number: head} of the stack's layers on the trains in `last`
    (ahead.json): members that boarded on a pull request below them,
    which `on` names (kept when that one has merged and the layer heads
    its carriage), or that aren't the first of their carriage."""
    if not isinstance(last, dict) or not last.get("trains"):
        return {}
    return {e["pr"]: e.get("head") for e in last.get("entries") or ()
            if isinstance(e, dict) and isinstance(e.get("pr"), int)
            and (e.get("on") is not None
                 or e.get("carriage") is not None
                 and e.get("carriage") != e["pr"])}


def boarded_members(last):
    """{number: head} of every member of the trains in `last`
    (ahead.json), for merge.test_ahead.own_green_to_board false: one
    that boarded without its own green stays a candidate while its head
    is the one it boarded with, or that one brought up to date. A red
    train's search writes no trains, but the trains it keeps
    (`kept_trains`) and the batches it checks still hold them."""
    if not isinstance(last, dict):
        return {}
    lists = [last] if last.get("trains") else [
        last, last["kept_trains"]] if isinstance(
            last.get("kept_trains"), dict) else []
    return {e["pr"]: e.get("head") for one in lists
            for e in one.get("entries") or ()
            if isinstance(e, dict) and isinstance(e.get("pr"), int)}


def train_in_the_way(last, pr, check_state):
    """merge.test_ahead.train_merge: the first train in `last`
    (ahead.json) as its entries, when `pr` is not on it and merging
    `pr` on its own now would spend that train's run: the build check
    has started its top, and the top isn't red. Else None. On
    2026-11-12 a pull request pushed out of the first train merged on
    its own green 25 minutes into the train's run of eight, and every
    train was cut again."""
    if not (last or {}).get("trains"):
        return None
    batch = (last or {}).get("batch") or {}
    entries = ((last or {}).get("entries") or [])[:batch.get("size", 0)]
    if not entries or any(e.get("pr") == pr["number"] for e in entries):
        return None
    top = entries[-1]
    if tree_verdict(check_state, top.get("tree")) is False \
            or not ahead_started(check_state, top.get("sha"),
                                 top.get("tree")):
        return None
    return entries


def train_boarded(last, pr, check_state):
    """merge.test_ahead.train_merge: the size of the first train in
    `last` (ahead.json) when `pr` is boarded on it at the head it has,
    and its top isn't red, else None. A train of one counts: updating
    it would move the default branch off the tree the next train was
    predicted on, and that train would be cut again.
    Such a train goes in as one merge of its tested top (`train_merge`),
    so `pr` needs no UPDATE of its own: GitHub's merge of the default
    branch into it changes nothing the train merges and only starts a
    build of the new head (amendment of 2026-11-12)."""
    if not (last or {}).get("trains"):
        return None
    batch = (last or {}).get("batch") or {}
    entries = ((last or {}).get("entries") or [])[:batch.get("size", 0)]
    if not entries or [e.get("tree") for e in entries] \
            != batch.get("trees") \
            or tree_verdict(check_state, entries[-1].get("tree")) is False:
        return None
    if not any(e.get("pr") == pr["number"]
               and e.get("head") == pr["headRefOid"] for e in entries):
        return None
    return len(entries)


def train_commits(repo, main_tip, entries, prs, run=sh):
    """The chain of merge commits for a green train: for each member, in
    order, a commit of the tree its prediction tested, whose parents are
    the commit before it (the default branch's tip first) and the
    member's head, so every head is in the train's history. As the
    Merger (RESOLVE_IDENTITY). The top's sha, or None when git fails."""
    if RESOLVE_IDENTITY is None:
        return None
    name, email = RESOLVE_IDENTITY
    env = dict(os.environ, GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email,
               GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=email)
    parent = main_tip
    for entry in entries:
        pr = prs[entry["pr"]]
        have_head(repo, pr, run)
        made = run(["git", "-C", repo, "commit-tree", "--no-gpg-sign",
                    entry["tree"], "-p", parent, "-p", entry["head"], "-m",
                    "Merge #%d: %s" % (entry["pr"], pr.get("title", ""))],
                   env=env)
        sha = (made.stdout or "").strip()
        if made.returncode != 0 or len(sha) != 40:
            return None
        parent = sha
    return parent


def train_onto(repo, top, main, run=sh):
    """labels.keep_trains: a merge commit of `main` into `top`, a
    train's chain, as the Merger, or None when they don't merge
    cleanly or git fails."""
    if RESOLVE_IDENTITY is None:
        return None
    merged = git(repo, "merge-tree", "--write-tree", top, main, run=run)
    tree = (merged.stdout or "").split("\n")[0].strip()
    if merged.returncode != 0 or len(tree) != 40:
        return None
    name, email = RESOLVE_IDENTITY
    env = dict(os.environ, GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email,
               GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=email)
    made = run(["git", "-C", repo, "commit-tree", "--no-gpg-sign", tree,
                "-p", top, "-p", main, "-m",
                "Merge %s into the train (labels.keep_trains)" % MAIN],
               env=env)
    sha = (made.stdout or "").strip()
    return sha if made.returncode == 0 and len(sha) == 40 else None


def train_merge(repo, state_dir, entries, queue, main_tip, check_state,
                github, run=sh, sleep=time.sleep, out=print, note=None,
                main=None, tested_tree=None):
    """merge.test_ahead.train_merge (designs/0047, amendment of
    2026-11-11): merge a green train with one pull request. The chain
    of `train_commits` is pushed to TRAIN_BRANCH<first>-<last>, given
    checks.context's green (its tree is the green top's), opened as a
    pull request to the default branch listing the members, and merged
    as a merge commit pinned to its top. Each member's head is then in
    the default branch, so GitHub marks it merged. A member based on
    another's branch is retargeted to the default branch first, or
    GitHub wouldn't. Returns (merged, unmerged): the members GitHub says
    are merged, and the rest, left to the usual path; ([], members)
    when the train didn't go in, with the reason said. `note`, a dict,
    is given `pr`, the train's own pull request, once it is opened.
    `main`, the default branch's tip when the train was kept on
    `main_tip`, an older base (`carried_base`), is merged on top of the
    chain, cleanly or not at all: the tree that goes in is the tested
    one plus only the commits of labels.keep_trains. `tested_tree`,
    when the train is the members below a left member (`left_ready`), is
    the old top's tree, whose green covers them."""
    prs = {pr["number"]: pr for pr in queue}
    numbers = [e["pr"] for e in entries]
    span = "#%d..#%d" % (numbers[0], numbers[-1])

    def fail(why):
        out("TRAIN-MERGE %s: %s; each member merges on its own" % (span, why))
        return [], numbers
    if CI_WORKFLOW:
        return fail("merge.ci_workflow is set, and the train's commits "
                    "have no runs of it")
    top = train_commits(repo, main_tip, entries, prs, run)
    if top is None:
        return fail("git could not make the train's commits")
    if main and main != main_tip:
        top = train_onto(repo, top, main, run)
        if top is None:
            return fail("its chain doesn't merge cleanly with %s at %s"
                        % (MAIN, main[:10]))
        # Its merge moves the default branch off the chain the trains
        # behind it were predicted on: `carried_base` keeps them on it.
        path = os.path.join(state_dir, KEEP_FILE)
        cache = load_json(path, {})
        cache = cache if isinstance(cache, dict) else {}
        cache["train:" + top] = entries[-1]["sha"]
        save_json(path, dict(list(cache.items())[-300:]))
    branch = "%s%d-%d" % (TRAIN_BRANCH, numbers[0], numbers[-1])
    pushed = run(["git", "-C", repo, "push", "-q", "-f",
                  "https://github.com/%s.git" % REPO_SLUG,
                  "%s:refs/heads/%s" % (top, branch)], env=push_env(github))
    if pushed.returncode != 0:
        return fail("push refused: " + tail(pushed.stderr + "\n"
                                            + pushed.stdout, 1))
    tested = [sha for sha, r in ((check_state or {}).get("results")
                                 or {}).items()
              if isinstance(r, dict) and r.get("ok") is True
              and r.get("tree") == (tested_tree or entries[-1]["tree"])
              and not r.get("covered")]
    ok, why = github.write(
        "POST", "repos/%s/statuses/%s" % (REPO_SLUG, top), state="success",
        context=STATUS_CONTEXT, description=(
            "green: the Merger's train %s, %s %s%s"
            % (span, "under a top tested green as" if tested_tree
               else "its tree tested as",
               short(tested[0]) if tested else "its top",
               ", %s's kept commits merged on top" % MAIN
               if main and main != main_tip else ""))[:140])
    if not ok:
        github.write("DELETE", "repos/%s/git/refs/heads/%s"
                     % (REPO_SLUG, branch))
        return fail("could not post %s: %s" % (STATUS_CONTEXT, why))
    for number in numbers:
        if prs[number].get("baseRefName", MAIN) != MAIN:
            ok, why = github.write("PATCH", "repos/%s/pulls/%d"
                                   % (REPO_SLUG, number), base=MAIN)
            if not ok:
                github.write("DELETE", "repos/%s/git/refs/heads/%s"
                             % (REPO_SLUG, branch))
                return fail("could not retarget #%d: %s" % (number, why))
    body = ("The Merger's train %s, tested green as one tree. Each "
            "member's head is merged here as it was approved:\n\n%s\n\n%s"
            % (span, "\n".join("* #%d at %s" % (e["pr"], e["head"][:10])
                               for e in entries), SIGNATURE))
    number, why = github.create("repos/%s/pulls" % REPO_SLUG,
                                title="Merge train %s" % span, head=branch,
                                base=MAIN, body=body)
    if number is None:
        github.write("DELETE", "repos/%s/git/refs/heads/%s"
                     % (REPO_SLUG, branch))
        return fail("could not open its pull request: " + why)
    if note is not None:
        note["pr"] = number
    ok, why = github.write("PUT", "repos/%s/pulls/%d/merge"
                           % (REPO_SLUG, number), sha=top,
                           merge_method="merge",
                           commit_title="Merge train %s (#%d)" % (span, number))
    if not ok:
        github.write("PATCH", "repos/%s/pulls/%d" % (REPO_SLUG, number),
                     state="closed")
        github.write("DELETE", "repos/%s/git/refs/heads/%s"
                     % (REPO_SLUG, branch))
        return fail("GitHub refused to merge #%d: %s" % (number, why))
    github.write("DELETE", "repos/%s/git/refs/heads/%s" % (REPO_SLUG, branch))
    unmerged = list(numbers)
    for k in range(TRAIN_POLLS):
        for n in list(unmerged):
            try:
                got = github.api("repos/%s/pulls/%d" % (REPO_SLUG, n))
            except RuntimeError:
                continue
            if isinstance(got, dict) and got.get("merged") is True:
                unmerged.remove(n)
        if not unmerged:
            break
        if k + 1 < TRAIN_POLLS:
            sleep(TRAIN_POLL_S)
    merged = [n for n in numbers if n not in unmerged]
    out("TRAIN-MERGE %s: merged %d as #%d (%s)%s" % (
        span, len(merged), number, short(top),
        "; GitHub doesn't say %s merged: each goes on its own" % ", ".join(
            "#%d" % n for n in unmerged) if unmerged else ""))
    return merged, unmerged


def load_suspects(state_dir):
    """designs/0035, second amendment: the search in progress, from
    SUSPECTS_FILE, as {suspects: [{pr, head}], tree, merged, left,
    said?}, or None when there is none."""
    saved = load_json(os.path.join(state_dir, SUSPECTS_FILE), None)
    if not isinstance(saved, dict) or not isinstance(
            saved.get("suspects"), list):
        return None
    saved["suspects"] = [e for e in saved["suspects"]
                         if isinstance(e, dict) and isinstance(
                             e.get("pr"), int) and isinstance(
                             e.get("head"), str)]
    for key in ("merged", "left"):
        if not isinstance(saved.get(key), list):
            saved[key] = []
    return saved


def suspect_place(saved, queue):
    """{number: place} of the suspects in `queue` still at the head they
    were suspected at, in their order: they go first, so nothing joins
    in front of them or among them."""
    heads = {pr["number"]: pr["headRefOid"] for pr in queue}
    places = {}
    for e in (saved or {}).get("suspects") or ():
        if heads.get(e["pr"]) == e["head"] and e["pr"] not in places:
            places[e["pr"]] = len(places)
    return places


def suspect_cuts(trees, verdict, slots):
    """(green, red, cuts) for the suspects' prefixes, whose trees are
    `trees` in order (designs/0035, second amendment, section 2):
    `green` the longest prefix whose tree is green (0 for none), `red`
    the shortest longer one whose tree is red, or None, and `cuts` the
    prefix lengths to test now, evenly spaced between them. With
    `slots` (merge.test_ahead.batches) there are that many cut points
    and the last, the whole red set, isn't run; with one slot, one cut,
    designs/0032's halving. When no prefix is known red the whole set
    is one of the cuts."""
    n = len(trees)
    green = max([k for k in range(1, n + 1) if verdict(trees[k - 1])
                 is True], default=0)
    reds = [k for k in range(green + 1, n + 1)
            if verdict(trees[k - 1]) is False]
    red = reds[0] if reds else None
    runs = max(1, slots - 1)
    span = (red or n) - green
    parts = runs + 1 if red else runs
    cuts = sorted({green - (-span * k // parts) for k in range(1, parts + 1)})
    return green, red, [c for c in cuts
                        if green < c and (c < red if red else c <= n)]


def suspect_batches(green, cuts):
    """The batch's size and the `later` batches' sizes for a round of
    the search: the green prefix merges as the batch while the cuts
    after it run as later ones; with none green, the first cut is the
    batch."""
    ends = ([green] if green else []) + list(cuts)
    sizes = [b - a for a, b in zip([0] + ends, ends)]
    return (sizes[0], sizes[1:]) if sizes else (0, [])


def suspects_line(entries, n, green, red, cuts):
    """The SUSPECTS line for a round of the search."""
    span = lambda a, b: "#%d..#%d" % (entries[a]["pr"], entries[b - 1]["pr"])
    return "SUSPECTS %s: green to %s, red from %s; checking %s" % (
        span(0, n), "#%d" % entries[green - 1]["pr"] if green else "none",
        "#%d" % entries[red - 1]["pr"] if red else "none",
        ", ".join(span(0, c) for c in cuts) or "nothing")


def suspects_left(saved, queue, record, approvals, said, moved=None):
    """(saved, line): the search `saved` with the suspects that merged
    this tick (`record`'s decisions) moved to `merged`, and those no
    longer in `queue` at their head, or handed back, moved to `left`.
    `moved(head, pr)` says whether `pr`'s head is `head` brought up to
    date and nothing else (`own_push`): such a suspect stays, at its
    new head, which is predicted to the same tree. Without it, an
    update of the first suspect took it out of the search, the search
    found no suspect first in the predictions and ended, and every
    train was cut again (2026-11-12). With none left, the search is
    over: `line` says BATCH-FLAKE when every suspect merged, and the
    saved search is None."""
    done = {d["pr"] for d in record["decisions"]
            if d.get("action") == "MERGE" and d.get("result") == "done"}
    heads = {pr["number"]: pr for pr in queue}
    kept = []
    for e in saved["suspects"]:
        pr = heads.get(e["pr"])
        if pr is not None and pr["headRefOid"] != e["head"] \
                and moved is not None and moved(e["head"], pr):
            e = dict(e, head=pr["headRefOid"])
        if e["pr"] in done:
            saved["merged"].append(e["pr"])
        elif pr is None or pr["headRefOid"] != e["head"] or handed_back(
                said, pr, approvals.get(e["pr"])):
            saved["left"].append(e["pr"])
        else:
            kept.append(e)
    saved["suspects"] = kept
    if kept:
        return saved, None
    line = None
    if saved["merged"] and not saved["left"] and not saved.get("named"):
        every = saved["merged"]
        line = ("BATCH-FLAKE #%d..#%d: every suspect merged green; the red "
                "top's tree %s was a flake" % (every[0], every[-1],
                                               saved.get("tree")))
    return None, line


def with_suspects(queue, saved, prs):
    """`queue` with the suspects of the search `saved` that are open
    (`prs`) but not in it, a stack's layers held as stacked, each
    where the search has it: all of them at the first suspect's place,
    in the search's order. A red train's layers are members of it
    (`layers_need_own_green` false), and its suspects; missing from the
    queue, they left the search the tick after it started, which then
    tested the prefixes of a set the train never was, and found its
    whole red tree no longer among them (2026-11-12: "red from none")."""
    if not saved or not queue:
        return queue
    by_number = {pr["number"]: pr for pr in prs}
    order = [by_number[e["pr"]] for e in saved.get("suspects") or ()
             if e["pr"] in by_number]
    numbers = {pr["number"] for pr in order}
    if not numbers - {pr["number"] for pr in queue}:
        return queue
    out, placed = [], False
    for pr in queue:
        if pr["number"] in numbers:
            if not placed:
                out += order
                placed = True
            continue
        out.append(pr)
    return out if placed else order + out


def suspect_wait(saved, pr, last, check_state, main_tip=None):
    """merge.test_ahead.train_merge: SUSPECT_WAIT_REASON when `pr` is a
    suspect of the search `saved` at the head it has and isn't in the
    batch of `last` (ahead.json) the search found green, or, with no
    search yet, a member of one of `last`'s trains, at the head it has,
    whose top is red (not only as `main_tip` is: `tree_base_red`), else
    None. The
    search's runs test the trees predicted for the suspects' heads, and
    a green prefix merges as one train of its tested top; an update of
    a suspect only makes it a new head, and on 2026-11-12 one took the
    first suspect out of the search, which ended, and every train was
    cut again with new pull requests in it. One the search found green
    may be updated: it merges, alone or because the train couldn't."""
    batch = (last or {}).get("batch") or {}
    entries = ((last or {}).get("entries") or [])[:batch.get("size", 0)]
    if not saved:
        # The tick a train's top is found red: its members become the
        # suspects once this tick has decided, and on 2026-11-12 the
        # first was updated before that.
        for train in last_trains(last):
            members = [e for c in train for e in c]
            if not any(e.get("pr") == pr["number"]
                       and e.get("head") == pr["headRefOid"]
                       for e in members):
                continue
            top = members[-1].get("tree")
            if len(members) < 2 or tree_verdict(check_state, top) \
                    is not False \
                    or tree_base_red(check_state, top, main_tip):
                return None
            return SUSPECT_WAIT_REASON % ("#%d..#%d" % (
                members[0]["pr"], members[-1]["pr"]))
        return None
    if not any(e["pr"] == pr["number"] and e["head"] == pr["headRefOid"]
               for e in saved.get("suspects") or ()):
        return None
    if entries and batch.get("suspects") is True \
            and [e.get("tree") for e in entries] == batch.get("trees") \
            and tree_verdict(check_state, entries[-1].get("tree")) is True \
            and any(e.get("pr") == pr["number"] for e in entries):
        return None
    numbers = [e["pr"] for e in saved["suspects"]]
    return SUSPECT_WAIT_REASON % ("#%d..#%d" % (numbers[0], numbers[-1]))


def suspect_round(state_dir, saved, entries, verdict, last, said_ahead,
                  record, out, found=None):
    """One tick of the search (designs/0035, second amendment): the
    batch and `later` batches written into `said_ahead` for the
    suspects at the front of the predictions `entries`, the runs to
    stop as `stop`, and the search saved. Whether it goes on: False
    once a suspect is red on its own at the front, which is then
    checked as without batches, or when no suspect is predicted. A
    suspect red on its own, on top of every suspect before it, is
    appended to the list `found` with the number of green ones before
    it, as (entry, green) (designs/0044, rule 4)."""
    path = os.path.join(state_dir, SUSPECTS_FILE)
    numbers = {e["pr"] for e in saved["suspects"]}
    n = 0
    while n < len(entries) and entries[n]["pr"] in numbers:
        n += 1
    trees = [e["tree"] for e in entries[:n]]
    green, red, cuts = suspect_cuts(trees, verdict, AHEAD_BATCHES)
    if found is not None and red is not None and red == green + 1:
        found.append((entries[red - 1], green))
    if not n or (red == 1 and not green):
        if n:
            out("SUSPECTS #%d..#%d: #%d is red on its own; the search ends"
                % (entries[0]["pr"], entries[n - 1]["pr"], entries[0]["pr"]))
        if os.path.exists(path):
            os.remove(path)
        return False
    size, later = suspect_batches(green, cuts)
    said_ahead["batch"] = {"size": size, "trees": trees[:size],
                           "suspects": True}
    record["batch"] = [e["pr"] for e in entries[:size]]
    at, said_ahead["later"], record["later"] = size, [], []
    for k in later[:max(1, AHEAD_BATCHES - 1)]:
        said_ahead["later"].append({"size": k, "trees": trees[at:at + k]})
        record["later"].append([e["pr"] for e in entries[at:at + k]])
        at += k
    if not said_ahead["later"]:
        del said_ahead["later"], record["later"]
    if red:
        # The suspects are those up to the shortest red prefix; longer
        # prefixes contain it, so their runs are stopped, and the
        # members past it go behind, in the next batch.
        saved["stop_trees"] = sorted(set(saved.get("stop_trees") or ())
                                     | set(trees[red:n]))
        saved["suspects"] = [{"pr": e["pr"], "head": e["head"]}
                             for e in entries[:red]]
        if red == green + 1:
            saved["named"] = entries[red - 1]["pr"]
    longer = set(saved.get("stop_trees") or ())
    stop = {e.get("sha") for e in list(entries) + list(
        (last or {}).get("entries") or ())
        if isinstance(e, dict) and e.get("tree") in longer}
    if stop - {None}:
        said_ahead["stop"] = sorted(stop - {None})
    line = suspects_line(entries, n, green, red, cuts)
    if line != saved.get("said"):
        out(line)
        saved["said"] = line
    save_json(path, saved)
    return True


def red_suspects(state_dir, prs):
    """RED_SUSPECT_FILE's entries for the pull requests in `prs` still
    at the head they were found red at (designs/0044, rule 4): {number,
    as a string: {head, reason, at, main}}. A new head is new evidence,
    so its entry is dropped, and so is a closed one's. A green run of
    the same head is too, but that is `rerun_green`'s to say."""
    heads = {str(pr["number"]): pr["headRefOid"] for pr in prs}
    saved = load_json(os.path.join(state_dir, RED_SUSPECT_FILE), {})
    return {k: v for k, v in (saved.items() if isinstance(saved, dict)
                              else ())
            if isinstance(v, dict) and isinstance(v.get("reason"), str)
            and heads.get(k) is not None and heads[k] == v.get("head")}


def rerun_green(entry, head, check_state, repo, run=sh):
    """The build check's green verdict on `head`, from its state
    (`check_state`'s results), that releases the red suspect `entry`
    (designs/0044, rule 4, amendment), or None. It must have finished
    after the suspect was found red (`at`), so it is a run since, not
    the head's own green from before; with the tip it was merged with
    (`base`) known, that tip must be the one it was found red on
    (`main`) or a descendant of it, which `git merge-base --is-ancestor`
    in `repo` says. A batch's cover is not a run. An entry without `at`,
    written before the amendment, is released only by a new head."""
    r = ((check_state or {}).get("results") or {}).get(head)
    if not isinstance(r, dict) or r.get("ok") is not True \
            or r.get("covered") or not entry.get("at"):
        return None
    try:
        if parse_time(r.get("finished")) <= parse_time(entry["at"]):
            return None
    except (TypeError, ValueError):
        return None
    base, red_main = r.get("base"), entry.get("main")
    if isinstance(base, str) and base and isinstance(red_main, str) \
            and red_main and base != red_main and git(
                repo, "merge-base", "--is-ancestor", red_main, base,
                run=run).returncode != 0:
        return None
    return r


def red_hand_back(reason):
    """Whether a hand-back's `reason` is the build check's red on the
    head itself."""
    return isinstance(reason, str) and \
        reason.startswith(STATUS_CONTEXT + " is failure")


def clear_green_reruns(said, prs, check_state, out):
    """Forget each hand-back in `said` that was for the build check's
    red on a head (`red_hand_back`) that the build check has since run
    green: a run of the same head, not a batch's cover, finished after
    the hand-back was said (`at`). Without this, with `update_once`, a
    red that a rerun showed was not the pull request's (a poisoned
    cache, a timing test under load) kept it out of the queue until it
    was approved again: seen on 2026-11-04, ten hours. Returns the
    numbers released, after logging `HAND-BACK-CLEARED` for each. A
    hand-back kept without `at`, said before this, is left alone."""
    heads = {str(pr["number"]): pr["headRefOid"] for pr in prs}
    results = (check_state or {}).get("results") or {}
    cleared = []
    for key in sorted(said, key=lambda k: int(k) if k.isdigit() else 0):
        before = said[key]
        if not isinstance(before, dict) or key not in heads \
                or before.get("head") != heads[key] \
                or not red_hand_back(before.get("reason")) \
                or not before.get("at"):
            continue
        r = results.get(heads[key])
        if not isinstance(r, dict) or r.get("ok") is not True \
                or r.get("covered"):
            continue
        try:
            if parse_time(r.get("finished")) <= parse_time(before["at"]):
                continue
        except (TypeError, ValueError):
            continue
        out("HAND-BACK-CLEARED #%s: green %sat %s since its red; back in "
            "the queue under its approval" % (
                key, "rerun " if r.get("rerun_of") is not None else "run ",
                heads[key][:10]))
        del said[key]
        cleared.append(int(key))
    return cleared


def clear_returned_heads(said, prs, out):
    """Forget each hand-back in `said` said under the approval a pull
    request has now, for another head than it has now, when its head is
    now the approved commit itself: whatever was wrong with the other
    head, the approval covers this one exactly. Without this, with
    `update_once`, the pull request stayed out of the queue until it was
    approved again: seen on 2026-11-04, a head the Merger's own update
    left without the approved commit in its history went back to the
    approved commit, and waited 2.5 hours for a second approval of the
    commit already approved. Returns the numbers released, after
    logging `HAND-BACK-CLEARED` for each."""
    cleared = []
    for pr in prs:
        key = str(pr["number"])
        before = said.get(key)
        approval = approval_of(pr)
        if not isinstance(before, dict) or approval is None:
            continue
        approved = (approval.get("commit") or {}).get("oid")
        head = pr.get("headRefOid")
        if not approved or head != approved or before.get("head") == head \
                or before.get("approved") != approval.get("submittedAt"):
            continue
        out("HAND-BACK-CLEARED #%s: the head is back at the approved "
            "commit %s, not %s it was handed back at; back in the queue "
            "under its approval" % (key, head[:10],
                                    str(before.get("head") or "")[:10]))
        del said[key]
        cleared.append(pr["number"])
    return cleared


def note_closing(state_dir, number, when):
    """Remember that pull request `number` merged at `when`, so that a
    later tick closes what it says it closes and GitHub left open."""
    path = os.path.join(state_dir, CLOSING_FILE)
    closing = load_json(path, {})
    if not isinstance(closing, dict):
        closing = {}
    closing[str(number)] = iso(when)
    save_json(path, closing)


def close_merged_issues(state_dir, github, when, out):
    """Close each issue a merged pull request in CLOSING_FILE names in
    its closingIssuesReferences that is still open CLOSE_AFTER after the
    merge, with a comment naming the merge (CLOSED_NOTE), and log
    `CLOSED-ISSUE`. GitHub closes them itself, but not always: seen on
    2026-11-04, a pull request whose body said `Fixes #N` merged and
    left #N open, with no event to say why. An issue reopened since
    (`stateReason` REOPENED) was opened again on purpose and is left
    alone, as is one in another repository. A pull request is forgotten
    once asked about, or after CLOSE_GIVE_UP if GitHub can't be read.
    Returns [{"pr", "issue", "result"}]."""
    path = os.path.join(state_dir, CLOSING_FILE)
    closing = load_json(path, {})
    if not isinstance(closing, dict) or not closing:
        return []
    owner, name = REPO_SLUG.split("/")
    done, keep = [], {}
    for key, at in sorted(closing.items()):
        try:
            merged_at = parse_time(at)
        except (TypeError, ValueError):
            continue
        if when - merged_at < CLOSE_AFTER:
            keep[key] = at
            continue
        try:
            got = github.api("graphql", "-f", "query=" + CLOSING_QUERY,
                             "-F", "owner=" + owner, "-F", "name=" + name,
                             "-F", "number=" + key)
            node = got["data"]["repository"]["pullRequest"]
            refs = node["closingIssuesReferences"]["nodes"]
        except (RuntimeError, KeyError, TypeError, ValueError):
            if when - merged_at < CLOSE_GIVE_UP:
                keep[key] = at
            continue
        if not node.get("merged"):
            continue
        sha = ((node.get("mergeCommit") or {}).get("oid") or "")[:10]
        for ref in refs or []:
            if (ref.get("repository") or {}).get("nameWithOwner",
                                                  REPO_SLUG) != REPO_SLUG:
                continue
            if ref.get("state") != "OPEN" or ref.get("stateReason") \
                    == "REOPENED":
                continue
            issue = ref["number"]
            ok, why = github.write(
                "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG, issue),
                body=CLOSED_NOTE % (int(key), sha or "its merge", SIGNATURE))
            if ok:
                ok, why = github.write(
                    "PATCH", "repos/%s/issues/%d" % (REPO_SLUG, issue),
                    state="closed", state_reason="completed")
            result = "done" if ok else "refused: " + why
            out("CLOSED-ISSUE #%d: still open after #%s merged as %s; %s"
                % (issue, key, sha or "?", result))
            done.append({"pr": int(key), "issue": issue, "result": result})
    save_json(path, keep)
    return done


def clear_red_suspects(state_dir, reds, prs, check_state, repo, github,
                       said, live, out, run=sh):
    """Release each red suspect in `reds` whose head the build check has
    since run green (`rerun_green`; designs/0044, rule 4, amendment):
    drop it from `reds`, from RED_SUSPECT_FILE and from `said`, so that
    it is predicted, updated and merged again under its approval, log
    `SUSPECT-CLEARED`, and say so once on the pull request
    (SUSPECT_CLEARED_NOTE). Returns the numbers released. Seen on
    2026-11-04: a wall-clock timing test failed under load in a
    suspect's own prefix, and the only way back was a new head, a
    rebuild and, for a merge that wasn't clean, a re-review."""
    heads = {str(pr["number"]): pr["headRefOid"] for pr in prs}
    cleared = []
    for key in sorted(reds, key=int):
        entry = reds[key]
        r = rerun_green(entry, heads[key], check_state, repo, run)
        if r is None:
            continue
        head = heads[key]
        out("SUSPECT-CLEARED #%s: green %sat %s; %sback in the queue" % (
            key, "rerun " if r.get("rerun_of") is not None else "run ",
            head[:10], "" if live else "would be "))
        del reds[key]
        cleared.append(int(key))
        before = said.get(key)
        if isinstance(before, dict) and before.get("head") == head \
                and before.get("reason") == entry.get("reason"):
            del said[key]
        if not live:
            continue
        base = r.get("base")
        ok, why = github.write(
            "POST", "repos/%s/issues/%s/comments" % (REPO_SLUG, key),
            body=SUSPECT_CLEARED_NOTE % (
                head[:10], MAIN, " at %s" % base[:10]
                if isinstance(base, str) and base else "",
                r.get("finished"), SIGNATURE))
        if not ok:
            out("SUSPECT-CLEARED #%s: commenting refused: %s" % (key, why))
    if cleared and live:
        save_json(os.path.join(state_dir, RED_SUSPECT_FILE), reds)
        save_json(os.path.join(state_dir, "handed-back.json"), said)
    return cleared


def hand_back_red_suspect(state_dir, entry, green, queue, approvals, reds,
                          github, said, live, record, out, main_tip=None):
    """designs/0044, rule 4: hand back the suspect a red batch's search
    found red on its own (`entry`, its prediction, on top of `green`
    suspects found green), once, and keep it in RED_SUSPECT_FILE, so
    that it stays out of every batch until its author pushes a new head.
    Without it, the search ended, the suspect went back into the queue
    as any other, and was put into new batches, whose tops were red
    again: on one project on 2026-11-04 a suspect found red on its own
    was put back into a batch three more times before it was handed
    back."""
    pr = [p for p in queue if p["number"] == entry["pr"]]
    if not pr or pr[0]["headRefOid"] != entry["head"]:
        return
    reason = RED_SUSPECT_REASON % (STATUS_CONTEXT, MAIN)
    decision = conflict_hand_back(
        pr[0], approvals.get(entry["pr"]) or approval_of(pr[0]), github,
        said, live, reason,
        RED_SUSPECT_DETAIL % (entry["sha"][:10], MAIN, (
            " and the %d pull requests ahead of it in the batch" % green
            if green > 1 else " and the one ahead of it in the batch"
            if green else ""), MAIN,
            RED_SUSPECT_RERUN % RERUN_LABEL if RERUN_LABEL else ""))
    decision["suspect"] = True
    record["decisions"].append(decision)
    if str(entry["pr"]) not in reds:
        out("SUSPECT-RED #%d: red on its own at %s; %shanded back, and out "
            "of batches until a new head" % (
                entry["pr"], entry["head"][:10], "" if live else "would be "))
    kept = {"head": entry["head"], "reason": reason, "at": record["at"]}
    if main_tip:
        kept["main"] = main_tip
    reds[str(entry["pr"])] = kept
    if live:
        save_json(os.path.join(state_dir, RED_SUSPECT_FILE), reds)


def merged_one(record):
    """Whether the tick that wrote `record` merged a pull request."""
    return any(d.get("action") == "MERGE" and d.get("result") == "done"
               for d in (record or {}).get("decisions") or ())


def moved_a_stack(record):
    """Whether the tick that wrote `record` merged a pull request or
    retargeted a stack's next layer: either way the run goes on."""
    return merged_one(record) or any(
        d.get("action") == "RETARGET" and d.get("result") == "done"
        for d in (record or {}).get("decisions") or ())


def load_stack(state_dir, prs, when):
    """The stack in progress (designs/0025), from STACK_FILE: `heads`
    merged so far, `run` (layers merged in a row) and `pending`, each
    `{"pr", "after", "branch"}`, with the pull requests no longer open
    left out. Empty when there is none, or it is older than STACK_FOR,
    except that with STACK_WAIT a layer waiting for its approval
    (designs/0033: `since`) keeps the stack, `next_layer` timing it."""
    state = load_json(os.path.join(state_dir, STACK_FILE), {})
    if not isinstance(state, dict) or not state.get("pending"):
        return {}
    try:
        at = parse_time(state.get("at") or "")
    except ValueError:
        return {}
    open_now = {pr["number"] for pr in prs}
    state["pending"] = [e for e in state["pending"] if e.get("pr") in open_now
                        and (when - at <= STACK_FOR
                             or (STACK_WAIT and (e.get("since")
                                                 or e.get("waited"))))]
    return state if state["pending"] else {}


def next_layer(stack, prs, candidates, open_numbers, when, held):
    """(stack, retarget, expired): `stack` without the layers that end
    it, the first layer still based on the merged branch below it that
    is eligible but for its base, as (pull request, number below), or
    None, and the entries of layers that waited out STACK_WAIT. A layer
    already on `main` stays while it is a candidate. A layer that isn't
    eligible ends the stack there and is held as usual, its reason
    saying the layer below merged; with STACK_WAIT it stays instead,
    marked `since` it began waiting, and is judged again each tick until
    it is eligible (then `waited`, so it keeps its usual place in the
    queue) or STACK_WAIT has passed (designs/0033)."""
    by_number = {pr["number"]: pr for pr in prs}
    chosen = {pr["number"] for pr in candidates}
    pending, retarget, expired = [], None, []
    for entry in stack["pending"]:
        pr = by_number.get(entry["pr"])
        if pr is None:
            continue
        if pr.get("baseRefName") == MAIN:
            if pr["number"] in chosen:
                pending.append(done_waiting(entry))
            continue
        if pr.get("baseRefName") != entry["branch"]:
            continue
        # The layer below merged, though GitHub's lists can name it open
        # for a tick or two after: a `Blocked-by:` it is no reason to
        # end the stack.
        approval, why = eligible(pr, open_numbers - {entry["after"]}, when,
                                 any_base=True)
        if approval is None:
            since = entry.get("since") or iso(when)
            if STACK_WAIT and when - parse_time(since) <= STACK_WAIT:
                held[str(pr["number"])] = STACK_WAIT_REASON % (
                    STACK_REASON % entry["after"], why)
                pending.append(dict(entry, since=since))
                continue
            held[str(pr["number"])] = "%s, which merged, but %s" % (
                STACK_REASON % entry["after"], why)
            if entry.get("since"):
                expired.append(entry)
            continue
        entry = done_waiting(entry)
        pending.append(entry)
        if retarget is None:
            retarget = (pr, entry["after"])
    return (dict(stack, pending=pending) if pending else {}, retarget,
            expired)


def done_waiting(entry):
    """`entry`, marked `waited` rather than `since` if it was waiting."""
    if not entry.get("since"):
        return entry
    entry = dict(entry, waited=True)
    entry.pop("since")
    return entry


def tell_waited(github, expired, live):
    """[{pr, after, result}] for each layer that waited out STACK_WAIT;
    when `live`, STACK_WAITED_NOTE is posted on it. Said once, since the
    layer then leaves `stacks.json`."""
    told = []
    for entry in expired:
        item = {"pr": entry["pr"], "after": entry["after"]}
        if live:
            ok, why = github.write(
                "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG,
                                                       entry["pr"]),
                body=STACK_WAITED_NOTE % (
                    int(STACK_WAIT.total_seconds() // 3600), entry["after"],
                    MAIN, SIGNATURE))
            item["result"] = "done" if ok else "refused: " + why
        told.append(item)
    return told


def tell_boarded(github, state_dir, entries, heads, live):
    """merge.test_ahead.tell_boarded (agent-forge #286): [{pr, head,
    result}] for each pull request in `entries` (this tick's live
    trains) not yet told since it boarded; when `live`,
    TOLD_BOARDED_NOTE is posted on it and TOLD_BOARDED_FILE records it.
    A pull request no longer in the trains is forgotten, so it is told
    again if it reboards. `heads` are the open pull requests' heads by
    number."""
    path = os.path.join(state_dir, TOLD_BOARDED_FILE)
    told_before = load_json(path, {})
    riding = []
    for entry in entries:
        if entry["pr"] not in riding:
            riding.append(entry["pr"])
    kept = {key: head for key, head in told_before.items()
            if int(key) in riding}
    told = []
    for number in riding:
        if str(number) in kept or number not in heads:
            continue
        head = heads[number]
        item = {"pr": number, "head": head[:10]}
        if live:
            ok, why = github.write(
                "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG, number),
                body=TOLD_BOARDED_NOTE % (head[:10], SIGNATURE))
            item["result"] = "done" if ok else "refused: " + why
            if ok:
                kept[str(number)] = head
        told.append(item)
    if live and kept != told_before:
        save_json(path, kept)
    return told


def save_stack(state_dir, stack):
    """Write `stack` to STACK_FILE, or remove the file when it's empty."""
    path = os.path.join(state_dir, STACK_FILE)
    if stack:
        save_json(path, stack)
    elif os.path.exists(path):
        os.remove(path)


def stacked_above(number, prs):
    """How many open pull requests are stacked, at any depth, on `number`."""
    by_number = {pr["number"]: pr for pr in prs}
    branches, count = {by_number[number]["headRefName"]}, 0
    while branches:
        above = [pr for pr in prs if pr.get("baseRefName") in branches]
        count += len(above)
        branches = {pr["headRefName"] for pr in above}
    return count


def merged_elsewhere(state_dir, github, stack, prs, when):
    """`stack` with the layers whose base merged without the Merger
    (by hand, say) added, as `note_merge` would have added them. A
    layer is an open, non-draft pull request based on a branch that is
    no open pull request's head and isn't in the stack yet; GitHub is
    asked whether a pull request from that branch merged into MAIN.
    ELSEWHERE_FILE remembers each branch asked about, and each branch
    the Merger merged itself (`note_merge`): a branch whose layers were
    added, or that the Merger merged, isn't asked about again for
    ELSEWHERE_KEEP, so a layer that left its stack (not eligible, or
    waited out) doesn't come back; one with no merged pull
    request is asked again after ELSEWHERE_FOR, so a branch nobody
    opened a pull request for costs one call an hour."""
    heads = {pr["headRefName"] for pr in prs}
    known = {e["pr"] for e in stack.get("pending", ())}
    path = os.path.join(state_dir, ELSEWHERE_FILE)
    asked = remembered_bases(path, when)
    owner = REPO_SLUG.split("/")[0]
    found = {}
    for pr in sorted(prs, key=lambda p: (p["createdAt"], p["number"])):
        branch = pr.get("baseRefName")
        if (branch == MAIN or branch in heads or pr.get("isDraft")
                or pr["number"] in known or branch in asked):
            continue
        if branch not in found:
            try:
                pulls = github.api("repos/%s/pulls?state=closed&head=%s:%s"
                                   "&per_page=10" % (REPO_SLUG, owner, branch))
            except RuntimeError:
                continue
            merged = [p for p in (pulls if isinstance(pulls, list) else ())
                      if isinstance(p, dict) and p.get("merged_at")
                      and (p.get("base") or {}).get("ref") == MAIN]
            found[branch] = max(merged, key=lambda p: p["merged_at"]) \
                if merged else None
        below = found[branch]
        asked[branch] = {"at": iso(when),
                         "merged": below["number"] if below else None}
        if below is None:
            continue
        stack = dict(stack, at=iso(when),
                     heads=list(stack.get("heads", ())) + [
                         below["head"]["sha"]],
                     run=stack.get("run", 0), pending=list(
                         stack.get("pending", ())) + [{
                             "pr": pr["number"], "after": below["number"],
                             "branch": branch,
                             "head": below["head"]["sha"]}])
    save_json(path, asked)
    return stack


def remembered_bases(path, when):
    """ELSEWHERE_FILE's branches still worth remembering at `when`: one
    with no merged pull request for ELSEWHERE_FOR, any other for
    ELSEWHERE_KEEP, long after any stack could hold its layers."""
    keep = ELSEWHERE_KEEP
    out = {}
    for branch, said in load_json(path, {}).items():
        try:
            age = when - parse_time(said["at"])
        except (KeyError, TypeError, ValueError):
            continue
        if age <= (keep if said.get("merged") else ELSEWHERE_FOR):
            out[branch] = said
    return out


def note_merge(state_dir, stack, pr, prs, when):
    """After `pr` merged: the open, non-draft pull requests stacked on
    it become the stack's next layers, and STACK_FILE is rewritten (or
    removed when nothing is pending). Returns the new stack."""
    pending = [e for e in stack.get("pending", ()) if e["pr"] != pr["number"]]
    was_layer = len(pending) < len(stack.get("pending", ()))
    above = sorted((p for p in prs if p.get("baseRefName") == pr["headRefName"]
                    and not p.get("isDraft")),
                   key=lambda p: (p["createdAt"], p["number"]))
    pending += [{"pr": p["number"], "after": pr["number"],
                 "branch": pr["headRefName"], "head": pr["headRefOid"]}
                for p in above]
    heads = list(stack.get("heads", ()))
    if was_layer or above:
        heads.append(pr["headRefOid"])
    run = (stack.get("run", 0) + 1 if was_layer else 1 if above else 0)
    new = ({"at": iso(when), "heads": heads, "run": run, "pending": pending}
           if pending else {})
    save_stack(state_dir, new)
    if STACKS:
        path = os.path.join(state_dir, ELSEWHERE_FILE)
        asked = remembered_bases(path, when)
        asked[pr["headRefName"]] = {"at": iso(when), "merged": pr["number"]}
        save_json(path, asked)
    return new


def resolve_once(state_dir, repo, decision, approval, branch, main_tip,
                 github, run=sh):
    """`resolve`, at most once per approval and head (RESOLVED_FILE): a
    push that worked moves the head, so a second try at the same head
    means the first failed, and it would fail again. A repeat answers
    with the first try's failure, so its hand-back is said once."""
    return once(os.path.join(state_dir, RESOLVED_FILE), decision, approval,
                lambda: resolve(repo, decision, branch, main_tip, github, run))


def resolve_ahead(repo, state_dir, queue, skip, approvals, main_tip, github,
                  said, run=sh):
    """With trains: the decisions for the first pull request of `queue`
    not in `skip` (the trains' members, and any acted on this tick)
    whose only conflict with `main_tip` is one the Merger resolves, with
    the resolve carried out, and its hand-back if that failed.

    A train boards only what merges plainly, and `merge.resolve` and
    its `union` otherwise run only at the front of the queue, where
    train members come first. So such a pull request reached the front
    only when nothing clean was left to board, and nothing said so: on
    2026-11-07 one project's waited all morning. Resolving it now gives
    it a head that boards at the next cut. One a tick, like the front's.
    A stack's layer is restacked, not resolved, so it is left alone."""
    for pr in queue:
        head = pr["headRefOid"]
        if pr["number"] in skip or pr.get("baseRefName") != MAIN:
            continue
        have_head(repo, pr, run)
        if is_ancestor(repo, main_tip, head, run):
            continue
        merged = git(repo, "merge-tree", "--write-tree", "--name-only",
                     "--no-messages", main_tip, head, run=run)
        if merged.returncode != 1:
            continue
        decision = {"pr": pr["number"], "head": head, "early": True,
                    "branch": pr["headRefName"]}
        approval = approvals[pr["number"]]
        rule = resolve_rule(conflicted_paths(merged.stdout))
        if RESOLVE and rule is not None:
            decision.update(action="RESOLVE", rule=rule)
            decision["result"] = resolve_once(
                state_dir, repo, decision, approval, pr["headRefName"],
                main_tip, github, run)
        elif UNION:
            got = union.resolve(repo, head, main_tip, UNION, run)
            if not got.tree:
                continue
            decision.update(action="UNION", tree=got.tree, files=got.files)
            decision["result"] = once(
                os.path.join(state_dir, UNIONED_FILE), decision, approval,
                lambda: union_push(repo, decision, main_tip, github, run))
            decision["files"] = {path: [[len(h), len(m)] for h, m in hunks]
                                 for path, hunks in decision["files"]}
        else:
            continue
        decisions = [decision]
        if decision["result"].startswith("failed"):
            step = decision["result"][len("failed: "):].split(": ")[0]
            decisions.append(conflict_hand_back(
                pr, approval, github, said, True,
                "%s, and the Merger could not resolve it (%s)"
                % (CONFLICT_REASON, step)))
        return decisions
    return []


def restack_once(state_dir, decision, approval, github, said):
    """RESTACK, at most once per approval and head (RESTACKED_FILE), as
    `resolve_once`: "done", or "failed: why"."""
    def attempt():
        result = carry_out(decision, approval, github, said)
        return result if result == "done" else "failed: " + result
    return once(os.path.join(state_dir, RESTACKED_FILE), decision, approval,
                attempt)


def once(path, decision, approval, attempt):
    """`attempt()` unless the file at `path` says it was tried for this
    approval and head; then the first try's failure, or "failed: already
    tried at this head"."""
    tried = load_json(path, {})
    key = {"approved": approval.get("submittedAt"), "head": decision["head"]}
    before = tried.get(str(decision["pr"])) or {}
    if {k: before.get(k) for k in key} == key:
        failed = before.get("result") or ""
        return (failed if failed.startswith("failed: ")
                else "failed: already tried at this head")
    tried[str(decision["pr"])] = key
    save_json(path, tried)
    result = attempt()
    tried[str(decision["pr"])] = dict(key, result=result)
    save_json(path, tried)
    return result


def tick(repo, state_dir, github, run=sh, out=print, now=now_utc,
         sleep=time.sleep, live=False, send=None, check_state=None):
    """One tick: the queue, and the action for its first pull request
    that isn't handed back or skipped, carried out when `live`. Appends
    the record to merger.jsonl, or dry-run.jsonl when not live, and
    prints one summary line (two when stalled). With STALL_ALERT, a live
    tick then tells people of a stall, through `send` (see
    `tell_stall`). `check_state` is the build check's state, for
    `merge.queued_stall_minutes`. Returns the record."""
    fetched = git(repo, "fetch", "-q", "origin", MAIN, run=run)
    if fetched.returncode != 0 and "cannot lock ref" in fetched.stderr:
        # The checkout's refs are shared with every worktree on the host,
        # so another fetch can hold the ref for a moment.
        sleep(FETCH_RETRY_S)
        fetched = git(repo, "fetch", "-q", "origin", MAIN, run=run)
    if fetched.returncode != 0:
        raise RuntimeError("fetch %s: %s" % (MAIN, fetched.stderr.strip()))
    main_tip = git(repo, "rev-parse", "refs/remotes/origin/" + MAIN,
                   run=run).stdout.strip()
    prs = fetch_prs(github)
    open_numbers = {pr["number"] for pr in prs} | fetch_open_issues(github)
    if INSTANCE_RED:
        # An instance's red default branch: its fixes go first too.
        global MAIN_RED_FIXES
        MAIN_RED_FIXES = MAIN_RED_FIXES | red_fixes_of(
            prs, instance_red_issues(github))
    candidates, approvals, held, spoken = [], {}, {}, []
    when = now()
    heads = {pr["headRefName"]: pr["number"] for pr in prs
             if pr.get("headRefName")}
    for pr in prs:
        approval, why = eligible(pr, open_numbers, when, heads)
        if approval is not None:
            candidates.append(pr)
            approvals[pr["number"]] = approval
        elif approval_of(pr) is not None:
            held[str(pr["number"])] = why
            said_after = said_since(pr, approval_of(pr))
            if said_after and not pr.get("isDraft"):
                spoken.append((pr, approval_of(pr), said_after[0]))
    regenerated = (remembered(state_dir, lambda sha, rule: regenerated_in(
        repo, sha, rule, run)) if RESOLVE else None)
    rules = None
    if CODE_OWNERS:
        rules = codeowners_rules(repo, "refs/remotes/origin/" + MAIN, run)
        owner_waits = {}
        for pr in list(candidates):
            why = rules and code_owner_wait(repo, pr, rules, main_tip, run,
                                            regenerated)
            owner_waits[pr["number"]] = (pr["headRefOid"], why or None)
            if why:
                held[str(pr["number"])] = why
                candidates.remove(pr)
        if CODE_OWNER_SEQUENCE:
            for number, (head, why) in sequence_owned(
                    repo, prs, owner_waits, rules, main_tip, run).items():
                held[str(number)] = why
                owner_waits[number] = (head, None)
        if live and CODE_OWNER_ASK:
            code_owner_asks(state_dir, github, owner_waits,
                            {p["number"]: p["headRefOid"] for p in prs}, out)
    greens = load_greens(state_dir) if OWN_HEAD_GREEN else {}
    # merge.test_ahead.own_green_to_board false: held only for their own
    # green, they may still board a train when one is cut.
    unproven = []
    if OWN_HEAD_GREEN:
        # merge.test_ahead.layers_need_own_green false: a layer that
        # boarded a train is tested by its top, and stays a candidate
        # without a green of its own once its base has merged.
        said_trains = load_json(os.path.join(state_dir, AHEAD_FILE), {})
        aboard = {} if LAYERS_OWN_GREEN else boarded_layers(said_trains)
        if not OWN_GREEN_TO_BOARD:
            # merge.test_ahead.own_green_to_board false: so does any
            # pull request that boarded without its own green.
            aboard = dict(boarded_members(said_trains), **aboard)
        for pr in list(candidates):
            if pr["number"] in aboard:
                # The walk back to the head it boarded with reads the
                # new head's parents, which only the pull requests a
                # tick decided on were fetched for.
                have_head(repo, pr, run)
            why = own_green_wait(pr, approvals[pr["number"]], github, greens,
                                 repo, main_tip, run,
                                 aboard.get(pr["number"]))
            if why:
                held[str(pr["number"])] = why
                candidates.remove(pr)
                approved = ((approvals[pr["number"]] or {}).get("commit")
                            or {}).get("oid")
                if not OWN_GREEN_TO_BOARD \
                        and pr.get("baseRefName", MAIN) == MAIN \
                        and approved and own_push(repo, approved,
                                                  pr["headRefOid"], main_tip,
                                                  run):
                    # Only at the head approved, or that one brought up
                    # to date: a later push of the author's waits for
                    # its review, as at the front.
                    unproven.append(pr)
        save_greens(state_dir, greens)
    # Held for an instance, so outside the queue, but a conflict with
    # main won't go away by waiting for it: told like one in the queue.
    instance_held = []
    if GATED:
        files = {}
        for pr in candidates:
            have_head(repo, pr, run)
        # Only the heads a gated instance applies to: the others' statuses
        # are never read, and fetching every candidate's spent the App's
        # hourly API allowance (2026-11-11).
        github.prefetch(status_path(pr["headRefOid"]) for pr in candidates
                        if gated_instances(repo, pr, main_tip, files, run))
        for pr in list(candidates):
            why = instance_wait(repo, pr, main_tip, github, files, run)
            if why:
                held[str(pr["number"])] = why
                candidates.remove(pr)
                if pr.get("baseRefName", MAIN) == MAIN:
                    instance_held.append(pr)
        # One held for its own green boards only once its gated
        # instances pass, as any candidate.
        for pr in list(unproven):
            have_head(repo, pr, run)
            if instance_wait(repo, pr, main_tip, github, files, run):
                unproven.remove(pr)
    queue = order(candidates, prs)
    in_flight = None
    if TEST_AHEAD:
        last = load_json(os.path.join(state_dir, "next.json"), {})
        if isinstance(last, dict) and last.get("action") in IN_FLIGHT:
            in_flight = last.get("pr")
    yielded, records, row = {}, [], None
    name = "merger.jsonl" if live else "dry-run.jsonl"
    if YIELD_PLACES or RIGHT_OF_WAY:
        records = recent_records(os.path.join(state_dir, name),
                                 when - YIELD_WINDOW)
    if YIELD_PLACES:
        counts = hand_backs(records, not YIELD_IGNORES_CONFLICTS)
        spent = yields_spent(records, not YIELD_IGNORES_CONFLICTS)
        queue, yielded = yield_places(queue, prs, counts, in_flight, spent)
    trees_of = head_trees(repo, run)
    first = green_batch_first(state_dir, queue, check_state, in_flight,
                              main_tip, trees_of) \
        if GREEN_BATCH_FIRST else None
    if first is not None:
        out("BATCH-FIRST #%s: the batch of %s is green on the tip; #%d's "
            "own run is still to come, so the batch merges first"
            % (", #".join(str(n) for n in sorted(first[1])),
               first[0][-1][:10], in_flight))
        in_flight = None
    if in_flight is not None:
        # The pull request the last tick updated or waited on keeps its
        # place: a blocker promoted past it would spend the run it is
        # already having, and every prediction behind it.
        queue.sort(key=lambda pr: pr["number"] != in_flight)
    os.makedirs(state_dir, exist_ok=True)
    said_path = os.path.join(state_dir, "handed-back.json")
    said = load_json(said_path, {})
    reds = red_suspects(state_dir, prs) if TEST_AHEAD and RED_SUSPECT_OUT \
        else {}
    cleared = clear_red_suspects(
        state_dir, reds, prs, check_state, repo, github, said, live, out,
        run) if reds else []
    clear_green_reruns(said, prs, check_state, out)
    clear_returned_heads(said, prs, out)
    since, overdue = {}, {}
    if AGE_FIRST is not None:
        since = waiting_since(os.path.join(
            state_dir, AGE_FILE if live else "dry-run-" + AGE_FILE),
            candidates, prs, when)
    row_held = {}
    fixed = fixed_order(state_dir, repo, queue, {pr["number"] for pr in prs},
                        approvals, said, check_state, when, run) \
        if TEST_AHEAD and FIXED_ORDER else {}
    if RIGHT_OF_WAY:
        row = right_of_way(repo, prs, records, os.path.join(
            state_dir, ROW_FILE if live else "dry-run-" + ROW_FILE),
            when, main_tip, run)
    idle = row and ROW_WHILE_ELIGIBLE and row_idle(
        row, candidates, approvals, said, when)
    if idle:
        # designs/0044, rule 2: it holds nobody while it is back with its
        # author, drafted, or not approved at the head it has it for.
        row = dict(row, idle=idle)
    if row and not idle:
        # Nothing that conflicts with it merges first; it goes first
        # once it is a candidate, after only the one in flight.
        # Nor does a member of a batch whose top's run has started
        # (designs/0044, rule 3): it keeps its place.
        others = [pr for pr in queue if pr["number"] != row["pr"]
                  and pr["number"] not in fixed]
        if since:
            # One that has waited longer and is overdue isn't held for
            # it (designs/0037): it goes first, and the holder waits.
            mine = since.get(row["pr"], when)
            others = [pr for pr in others if not (
                pr["number"] in since and since[pr["number"]] < mine
                and when - since[pr["number"]] >= AGE_FIRST)]
        for number in conflicts_with(repo, row["head"], others, run):
            row_held[number] = row["pr"]
            held[str(number)] = ROW_REASON % row["pr"]
        queue = [pr for pr in queue if pr["number"] not in row_held]
        queue.sort(key=lambda pr: (pr["number"] != in_flight,
                                   pr["number"] != row["pr"]))
        yielded.pop(row["pr"], None)
    if TEST_AHEAD:
        # Those already predicted go first, in the order predicted.
        places = locked_order(state_dir, queue)
        queue.sort(key=lambda pr: (pr["number"] != in_flight, places.get(
            pr["number"], len(places))))
    stack, retarget = (load_stack(state_dir, prs, when) if STACKS else {}), None
    if STACKS:
        stack = merged_elsewhere(state_dir, github, stack, prs, when)
    expired = []
    if stack:
        # One held only for its own green may board a train
        # (own_green_to_board false): it keeps its place in the stack,
        # and the final head below it to restack onto.
        stack, retarget, expired = next_layer(stack, prs,
                                              candidates + unproven,
                                              open_numbers, when, held)
    if STACKS and live:
        save_stack(state_dir, stack)
    if stack:
        # A layer that waited for its approval keeps its usual place.
        first = [e["pr"] for e in stack.get("pending", ())
                 if not e.get("waited")]
        if STACK_MAX_RUN and stack.get("run", 0) >= STACK_MAX_RUN:
            first = []
        # A layer that comes back while a batch it isn't in runs goes
        # first in the next batch, not into that one, which would spend
        # its run. Predicted past the batch is not in it: on 2026-10-26
        # a layer predicted 16th went in front of a green batch's six
        # members left to merge.
        merging = TEST_AHEAD and (in_flight is not None or green_batch(
            state_dir, queue, check_state, trees_of))
        members = batch_members(state_dir, queue, trees_of) \
            if merging else set()
        late = set(first) - members if merging else set()
        places = locked_order(state_dir, queue) if late else {}
        # An urgent pull request goes ahead of a layer that comes back,
        # though not ahead of the batch being merged (Alex, 2026-10-26:
        # a pin waited behind four layers in turn, an hour and a half).
        # A batch whose top's run has started keeps its order too, behind
        # only those and urgent ones (designs/0044, rule 3).
        queue.sort(key=lambda pr: (
            pr["number"] != in_flight,
            0 if pr["number"] in members
            else 1 if urgent(pr) and pr["number"] not in first
            and pr["number"] not in fixed
            else 2 if pr["number"] in fixed
            else 3 if pr["number"] in first and pr["number"] not in late
            else 4 if pr["number"] in places
            else 5 if pr["number"] in late else 6))
    if since:
        # Overdue ones go first (designs/0037), behind only the one in
        # flight, urgent ones and a batch being merged, whose runs are
        # spent either way.
        merging = TEST_AHEAD and (in_flight is not None or green_batch(
            state_dir, queue, check_state, trees_of))
        queue, overdue = overdue_first(
            queue, since, when, in_flight,
            batch_members(state_dir, queue, trees_of) if merging else set(),
            fixed)
        for number in overdue:
            yielded.pop(number, None)
    if MAIN_RED_FIXES & {pr["number"] for pr in queue}:
        # A red default branch's fix goes first, behind only the one in
        # flight and a green batch still merging, whose run is spent
        # either way (designs/0011, amendment).
        merging = TEST_AHEAD and green_batch(state_dir, queue, check_state,
                                             trees_of)
        queue = fixes_first(queue, in_flight, batch_members(
            state_dir, queue, trees_of) if merging else set())
    saved = load_suspects(state_dir) \
        if TEST_AHEAD and AHEAD_BATCH > 1 else None
    if saved:
        # A red batch's suspects lead while the search goes on: nothing
        # joins in front of them or among them (designs/0035, second
        # amendment).
        places = suspect_place(saved, queue)
        queue.sort(key=lambda pr: (pr["number"] != in_flight, places.get(
            pr["number"], len(places))))
    if HOLD_CONFLICTING:
        pairs_path = os.path.join(state_dir, PAIRS_FILE)
        pairs = {k: v for k, v in load_json(pairs_path, {}).items()
                 if v in (0, 1)}
        held_by = conflicts_ahead(
            repo, queue, run, main_tip, pairs,
            {pr["number"] for pr in queue
             if handed_back(said, pr, approvals[pr["number"]], when)})
        if live:
            os.makedirs(state_dir, exist_ok=True)
            save_json(pairs_path, pairs.get("used", {}))
    else:
        held_by = {}
    for number, ahead in held_by.items():
        held[str(number)] = HOLD_REASON % ahead
    queue = [pr for pr in queue if pr["number"] not in held_by]
    record = {"at": iso(when), "main": main_tip, "held": held,
              "queue": [pr["number"] for pr in queue], "decisions": [],
              # Every open pull request the tick saw: those marked urgent
              # by hand, and those a tool made urgent (a red nightly's
              # or default branch's fix), for forge-flow.
              "urgent": sorted(pr["number"] for pr in prs
                               if labelled_urgent(pr)),
              "elevated": sorted(pr["number"] for pr in prs
                                 if urgent(pr) and not labelled_urgent(pr))}
    if live:
        closed = close_merged_issues(state_dir, github, when, out)
        if closed:
            record["closed_issues"] = closed
    if cleared:
        record["suspects_cleared"] = cleared
    QUEUE_VIEW.clear()
    QUEUE_VIEW.update(queue=record["queue"], held=held, prs=prs)
    if YIELD_PLACES:
        record["yielded"] = {str(n): p for n, p in sorted(yielded.items())}
    if RIGHT_OF_WAY:
        record["right_of_way"] = row
    if AGE_FIRST is not None:
        record["overdue"] = {str(n): w for n, w in sorted(overdue.items())}
    if fixed:
        record["fixed"] = sorted(fixed, key=fixed.get)
    if stack:
        record["stack"] = [dict({"pr": e["pr"], "after": e["after"]},
                                **({"waiting": True} if e.get("since")
                                   else {}))
                           for e in stack["pending"]]
    if expired:
        record["stack_waited"] = tell_waited(github, expired, live)
    if spoken or os.path.exists(os.path.join(state_dir, HELD_FILE)):
        record["spoken"] = tell_spoken(state_dir, github, prs, spoken, live)
    if HOLD_CONFLICTING or RIGHT_OF_WAY:
        record["holds"] = tell_holds(state_dir, github, prs,
                                     {**held_by, **row_held}, live,
                                     row_held)
    waiting_on = waiting = None
    stopped = len(queue)
    if retarget is not None:
        # One write a tick: the stack's next layer goes onto main, and
        # the run goes on to judge it there.
        layer, after = retarget
        decision = {"action": "RETARGET", "pr": layer["number"],
                    "head": layer["headRefOid"], "after": after}
        if live:
            decision["result"] = carry_out(decision, None, github, said)
        record["decisions"].append(decision)
        out("STACK #%d: %sretargeted to %s after #%d merged; %d above" % (
            layer["number"], "" if live else "would be ", MAIN, after,
            stacked_above(layer["number"], prs)))
        stopped = 0
    below = tuple(stack.get("heads", ())) if stack else ()
    layers = {e["pr"] for e in stack.get("pending", ())} if stack else set()
    restacks = {e["pr"]: (e["after"], e["head"])
                for e in (stack or {}).get("pending", ()) if e.get("head")}
    # A stack's layer in a batch (designs/0035) is held as stacked until
    # the layer below merges; the batch holds while it is still ready.
    batch_layers = [pr for pr in prs if AHEAD_STACKS
                    and pr.get("baseRefName") != MAIN
                    and str(pr["number"]) in held
                    and eligible(pr, open_numbers - layers_below(pr, prs),
                                 when, any_base=True)[0] is not None]
    # merge.test_ahead.train_merge: a green train goes in as one. Every
    # ready member merges this tick, not one a tick.
    trained, train_failed, last_ahead = None, False, None
    # labels.keep_trains: the commit the trains stay predicted on.
    train_base = main_tip
    if TRAINS == "live" and KEEP_LABEL and retarget is None:
        train_base = carried_base(
            repo, state_dir, load_json(os.path.join(state_dir, AHEAD_FILE),
                                       {}), main_tip, github, run, out)
        if train_base != main_tip:
            record["train_base"] = train_base
    if TRAIN_MERGE and retarget is None and AHEAD_BATCH > 1:
        last_ahead = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    if TRAIN_MERGE and live and retarget is None and AHEAD_BATCH > 1:
        # Layers held as stacked are members too: without their own
        # greens (layers_need_own_green false), the train's top is what
        # tested them.
        members = queue if LAYERS_OWN_GREEN else queue + batch_layers
        entries = train_ready(last_ahead, members, train_base, check_state,
                              repo, run,
                              restacks if PREDICT_RESTACKED else None)
        tested_tree = None
        if not entries:
            entries = left_ready(last_ahead, members, train_base,
                                 check_state)
            if entries:
                tested_tree = last_ahead["left_top"]["tree"]
                out("TRAIN-UNDER-LEFT #%d..#%d: merge on the green of the "
                    "top they were cut under, %s" % (
                        entries[0]["pr"], entries[-1]["pr"],
                        short(last_ahead["left_top"].get("sha") or "")))
        if entries:
            opened = {}
            merged, _ = train_merge(repo, state_dir, entries, members,
                                    train_base, check_state, github, run,
                                    sleep, out, opened, main=main_tip,
                                    tested_tree=tested_tree)
            # GitHub wouldn't take the train: its members merge one at
            # a time this tick, updated as before.
            train_failed = not merged
            if merged:
                trained = set(merged)
                heads = {e["pr"]: e["head"] for e in entries}
                prs_by = {pr["number"]: pr for pr in members}
                for number in merged:
                    # train_pr: the pull request the train merged as,
                    # for forge-flow ("merged as #N").
                    record["decisions"].append(dict({
                        "action": "MERGE", "pr": number,
                        "head": heads[number], "result": "done",
                        "train": True}, **({"train_pr": opened["pr"]}
                                           if "pr" in opened else {})))
                    note_closing(state_dir, number, when)
                    if STACKS:
                        stack = note_merge(state_dir, stack or {}, dict(
                            prs_by[number], headRefOid=heads[number]),
                            prs, when)
                if STACKS and stack:
                    record["stack"] = [{"pr": e["pr"], "after": e["after"]}
                                       for e in stack["pending"]]
    # merge.resolve_slots: a conflict with main is handed back only while
    # a slot is free; the others wait in `pending` until the tick's end,
    # when the free slots go to those first in `resolve_slot_order`.
    resolving = out_for_resolving(said, prs, repo, main_tip, run) \
        if RESOLVE_SLOTS else []
    pending = []

    def conflict_back(pr, approval, reason=CONFLICT_REASON, detail=None):
        gated = RESOLVE_SLOTS and pr["number"] not in resolving
        decision = conflict_hand_back(pr, approval, github, said,
                                      live and not gated, reason, detail)
        if gated:
            pending.append((pr, approval, decision))
        else:
            record["decisions"].append(decision)

    for at, pr in enumerate([] if retarget is not None or trained
                            else queue):
        approval = approvals[pr["number"]]
        found_red = reds.get(str(pr["number"]))
        if found_red:
            # Found red on its own by a red batch's search, and handed
            # back: not updated, merged or predicted until a new head
            # (designs/0044, rule 4).
            record["decisions"].append(conflict_hand_back(
                pr, approval, github, said, live, found_red["reason"]))
            continue
        decision = decide(pr, approval, repo, main_tip, github, github.env,
                          run, below if pr["number"] in layers else (),
                          regenerated, when, restacks.get(pr["number"]))
        decision.update(pr=pr["number"], head=pr["headRefOid"])
        steps = head_base_red(check_state, pr["headRefOid"]) \
            if decision["action"] == "HAND-BACK" and decision.get(
                "reason", "").startswith(STATUS_CONTEXT + " is failure") \
            else None
        if steps and ((check_state.get("main_red") or {}).get("issue")):
            base = (check_state["results"][pr["headRefOid"]].get("base")
                    or "")
            decision = {"action": "WAIT", "pr": pr["number"],
                        "head": pr["headRefOid"],
                        "reason": BASE_RED_REASON % (
                            STATUS_CONTEXT, ", ".join(steps), MAIN,
                            base[:10])}
        elif steps:
            # The tip is green again: the head is brought up to date,
            # which checks it afresh, rather than handed back.
            decision = {"action": "UPDATE", "pr": pr["number"],
                        "head": pr["headRefOid"]}
        tree = git(repo, "rev-parse", pr["headRefOid"] + "^{tree}",
                   run=run).stdout.strip() if decision.get("covered") \
            else None
        # A covered head merges while its batch holds, or once a run of
        # its tree itself (a batch split down to it) is green.
        if tree and not batch_holds(
                load_json(os.path.join(state_dir, AHEAD_FILE), {}),
                pr["number"], tree, queue + batch_layers, check_state,
                trees_of) \
                and tree_verdict(check_state, tree) is not True:
            decision = {"action": "WAIT", "pr": pr["number"],
                        "head": pr["headRefOid"],
                        "reason": BATCH_WAIT_REASON}
        boarded = train_boarded(last_ahead, pr, check_state) \
            if decision["action"] == "UPDATE" and last_ahead \
            and not train_failed else None
        if boarded:
            # merge.test_ahead.train_merge: its train goes in as one
            # merge of the tested top, which needs no update of the
            # member's own; an update would only start a build of the
            # new head (amendment of 2026-11-12).
            decision = {"action": "WAIT", "pr": pr["number"],
                        "head": pr["headRefOid"],
                        "reason": TRAIN_WAIT_REASON % boarded}
        suspected = suspect_wait(saved, pr, last_ahead, check_state,
                                 main_tip) \
            if decision["action"] == "UPDATE" and TRAIN_MERGE \
            and last_ahead is not None else None
        if suspected:
            decision = {"action": "WAIT", "pr": pr["number"],
                        "head": pr["headRefOid"], "reason": suspected}
        # Merged on its own, one outside the first train would move the
        # default branch under that train's started run. An urgent one,
        # or one the trains are kept through (labels.keep_trains), goes
        # all the same.
        ahead_of = train_in_the_way(
            last_ahead if last_ahead is not None else load_json(
                os.path.join(state_dir, AHEAD_FILE), {}), pr, check_state) \
            if decision["action"] == "MERGE" and TRAINS == "live" \
            and not train_failed and not urgent(pr) \
            and not labelled_keep(pr) else None
        if ahead_of:
            decision = {"action": "WAIT", "pr": pr["number"],
                        "head": pr["headRefOid"],
                        "reason": TRAIN_AHEAD_REASON % (
                            "#%d..#%d" % (ahead_of[0]["pr"],
                                          ahead_of[-1]["pr"])),
                        # Timed as the train's top's run (stalled_for).
                        "train_top": ahead_of[-1].get("sha")}
        if (RESOLVE_SLOTS and decision["action"] == "HAND-BACK"
                and decision.get("to") == "author"
                and decision.get("reason", "").startswith(CONFLICT_REASON)
                and pr["number"] not in resolving):
            # A slot is given, or not, at the tick's end; either way the
            # queue moves past it.
            pending.append((pr, approval, decision))
            continue
        if (decision["action"] == "UPDATE"
                and said.get(str(pr["number"])) == hand_back_key(
                    approval, pr["headRefOid"], CONFLICT_REASON)):
            # GitHub already refused this head as a conflict and the
            # author has it; asking again would only be refused again.
            record["decisions"].append(
                conflict_hand_back(pr, approval, github, said, live))
            continue
        if (decision["action"] in ("UPDATE", "MERGE")
                and said.get(str(pr["number"])) == hand_back_key(
                    approval, pr["headRefOid"], LOST_HEAD_REASON)):
            # GitHub refused this head for STALL_AFTER and it went back
            # to its author; the queue moves past it.
            record["decisions"].append(conflict_hand_back(
                pr, approval, github, said, live, LOST_HEAD_REASON))
            continue
        before = said.get(str(pr["number"])) or {}
        if (UPDATE_ONCE
                and decision["action"] in ("UPDATE", "RESOLVE", "UNION",
                                           "RESTACK", "STACK-UPDATE")
                and before.get("approved")
                and before["approved"] == approval.get("submittedAt")
                and not description_moved(before, pr)
                and not before.get("retry")):
            # Handed back under this approval: not updated again. An
            # update spends a build on a head that comes back for the
            # same reason. Only the update is withheld: a head already
            # up to date is decided as before, and a new approval is a
            # new question. A gate's refusal for now isn't the
            # author's to fix, so it doesn't withhold one.
            decision = {"action": "SKIP", "pr": pr["number"],
                        "head": pr["headRefOid"],
                        "reason": "handed back under this approval (%s); "
                                  "not updated until it is approved "
                                  "again" % before.get("reason")}
        for stale in decision.get("ci_stale") or ():
            out("CI-STALE #%d: GitHub says run %s is %s, but all its jobs "
                "finished at %s; judged by its jobs (%s)" % (
                    pr["number"], stale["run"], stale["status"],
                    stale["finished"], stale["judged"]))
        if decision["action"] == "WAIT" and decision.get("ci_unfinished"):
            stuck = ci_stuck_reason()
            if said.get(str(pr["number"])) == hand_back_key(
                    approval, pr["headRefOid"], stuck):
                # Its CI never finished, even re-run, and it went back
                # to its author; the queue moves past it until it does.
                record["decisions"].append(conflict_hand_back(
                    pr, approval, github, said, live, stuck))
                continue
            detail = ci_rerun(decision, github, state_dir, when, live, out)
            if detail:
                out("CI-STUCK #%d: %s; handed back to its author, and the "
                    "queue moves past it" % (pr["number"], detail))
                record["decisions"].append(conflict_hand_back(
                    pr, approval, github, said, live, stuck, detail + "."))
                continue
        if live and decision["action"] == "RESOLVE":
            decision["result"] = resolve_once(
                state_dir, repo, decision, approval, pr["headRefName"],
                main_tip, github, run)
        elif live and decision["action"] == "STACK-UPDATE":
            decision["result"] = once(
                os.path.join(state_dir, STACK_UPDATED_FILE), decision,
                approval, lambda: stack_update(repo, decision, main_tip,
                                               github, run))
        elif live and decision["action"] == "RESTACK":
            decision["result"] = restack_once(state_dir, decision, approval,
                                              github, said)
        elif live and decision["action"] == "UNION":
            decision["result"] = once(
                os.path.join(state_dir, UNIONED_FILE), decision, approval,
                lambda: union_push(repo, decision, main_tip, github, run))
        elif live:
            result = carry_out(decision, approval, github, said)
            if result is not None:
                decision["result"] = result
            if result == "done" and decision["action"] == "HAND-BACK" \
                    and red_hand_back(decision.get("reason")):
                # When it was said, so that a green rerun of the same
                # head after it releases it (clear_green_reruns).
                said[str(pr["number"])]["at"] = iso(when)
        if decision["action"] == "UNION":
            # The record keeps how many lines each side gave, not the
            # lines: the comment on the pull request has those.
            decision["files"] = {path: [[len(h), len(m)] for h, m in hunks]
                                 for path, hunks in decision["files"]}
        record["decisions"].append(decision)
        if decision["action"] == "RESTACK":
            if decision.get("result", "done") == "done":
                out("STACK #%d: %smerged #%d's head %s into it" % (
                    pr["number"], "" if live else "would have ",
                    decision["after"], short(decision["below"])))
            else:
                conflict_back(
                    pr, approval,
                    "%s, and the Merger could not merge #%d's final head "
                    "%s into it" % (CONFLICT_REASON, decision["after"],
                                    decision["below"][:10]),
                    RESTACK_DETAIL % (decision["after"],
                                      decision["below"][:10], MAIN))
                continue
        if decision["action"] == "STACK-UPDATE":
            if decision.get("result", "done") == "done":
                out("STACK #%d: %smerged %s into it against #%d's head %s"
                    % (pr["number"], "" if live else "would have ", MAIN,
                       decision["after"], short(decision["below"])))
            elif not decision["result"].startswith("refused"):
                conflict_back(
                    pr, approval,
                    "%s, and the Merger could not merge it in against "
                    "#%d's final head" % (CONFLICT_REASON,
                                          decision["after"]))
                continue
        if decision["action"] == "UNION":
            if decision.get("result", "done") == "done":
                out("UNION #%d: %smerged %s into it, keeping both sides' "
                    "added lines in %s" % (
                        pr["number"], "" if live else "would have ", MAIN,
                        ", ".join(sorted(decision["files"]))))
            elif not decision["result"].startswith("refused"):
                step = decision["result"][len("failed: "):].split(": ")[0]
                conflict_back(pr, approval,
                              "%s, and the Merger could not resolve it (%s)"
                              % (CONFLICT_REASON, step))
                continue
        if (decision["action"] == "RESOLVE"
                and decision.get("result", "").startswith("failed")):
            # Resolving it didn't work, so it is an ordinary conflict
            # again, with the step that failed: the output after it can
            # differ per tick, and the reason is half the key that says
            # a hand-back once.
            step = decision["result"][len("failed: "):].split(": ")[0]
            conflict_back(pr, approval,
                          "%s, and the Merger could not resolve it (%s)"
                          % (CONFLICT_REASON, step))
            continue
        if (live and decision["action"] == "MERGE"
                and decision.get("result") == "done"):
            note_closing(state_dir, pr["number"], when)
        if (STACKS and live and decision["action"] == "MERGE"
                and decision.get("result") == "done"):
            stack = note_merge(state_dir, stack or {}, pr, prs, when)
            if stack:
                record["stack"] = [{"pr": e["pr"], "after": e["after"]}
                                   for e in stack["pending"]]
        if (decision["action"] == "UPDATE"
                and "merge conflict" in (decision.get("result") or "")):
            # The backstop for a conflict git didn't see: GitHub's word
            # is final, and the pull request goes back to its author
            # like any other conflict, not round again next tick.
            conflict_back(pr, approval)
            continue
        if (live and decision["action"] in ("UPDATE", "MERGE")
                and LOST_HEAD_RE.search(decision.get("result") or "")):
            lost = lost_head(decision, github, state_dir, out)
            decision["lost"] = lost
            if lost and lost["now"] != pr["headRefOid"]:
                # GitHub holds another head now: a changed pull request,
                # judged afresh at that head next tick (its approval,
                # its check), never retried at the head it lost.
                record["decisions"].append({
                    "action": "RESYNC", "pr": pr["number"],
                    "head": pr["headRefOid"],
                    "result": "GitHub now has " + short(lost["now"])})
                continue
            minutes = stalled_for(state_dir, decision, when)
            if minutes is not None:
                # Refused for STALL_AFTER, and nothing the Merger can do
                # changes GitHub's mind: back to its author, whose push
                # makes GitHub read the head again, and the queue moves
                # past it rather than waiting behind it for ever.
                record["stalled"] = {
                    "pr": pr["number"], "head": pr["headRefOid"],
                    "minutes": minutes, "lost": lost, "handed_back": True,
                    "refused": "%s %s" % (decision["action"],
                                          decision["result"])}
                record["decisions"].append(conflict_hand_back(
                    pr, approval, github, said, live, LOST_HEAD_REASON,
                    lost_text(lost) + ". A push to the branch, or closing "
                    "and reopening the pull request, makes GitHub read its "
                    "head again."))
                continue
        if decision["action"] not in ("HAND-BACK", "SKIP"):
            waiting_on = pr["number"]
            # A refused write ends the tick on this pull request, and the
            # next tick picks it again; if GitHub goes on refusing, it is
            # as stuck as a check that never finishes.
            if (decision["action"] == "WAIT"
                    or decision.get("result", "").startswith("refused")):
                waiting = decision
            stopped = at + 1
            break
    if EARLY_CONFLICTS:
        early = early_conflicts(
            repo, main_tip, queue[stopped:] + instance_held, approvals,
            github, said, live and not RESOLVE_SLOTS, run, layers,
            restacks if PREDICT_RESTACKED else None)
        by_number = {pr["number"]: pr for pr in queue + instance_held}
        for decision in early:
            if RESOLVE_SLOTS:
                pr = by_number[decision["pr"]]
                pending.append((pr, approvals[pr["number"]], decision))
            else:
                record["decisions"].append(decision)
    slot_waiting = set()
    if pending:
        # merge.resolve_slots (designs/0012, amendment of 2026-11-12).
        seen, first = set(), []
        for entry in pending:
            if entry[0]["number"] not in seen:
                seen.add(entry[0]["number"])
                first.append(entry)
        entries = {entry[0]["number"]: entry for entry in first}
        ranked = resolve_slot_order([entry[0] for entry in first],
                                    queue + instance_held, prs, row)
        free = max(0, RESOLVE_SLOTS - len(resolving))
        for pr in ranked[:free]:
            # Told now, while the others that wait still show as queued
            # in the comment's list of the author's other pull requests.
            _, approval, decision = entries[pr["number"]]
            if live:
                decision["result"] = carry_out(decision, approval, github,
                                               said)
            record["decisions"].append(decision)
            resolving = resolving + [pr["number"]]
        slot_waiting = {pr["number"] for pr in ranked[free:]}
        for pr in ranked[free:]:
            if str(pr["number"]) not in held:
                held[str(pr["number"])] = RESOLVE_WAIT_REASON % (
                    MAIN, len(resolving),
                    ", ".join("#%d" % n for n in resolving))
        if slot_waiting:
            out("RESOLVE-WAIT %s: conflict with %s; %d of %d slots out (%s)"
                % (" ".join("#%d" % pr["number"] for pr in ranked[free:]),
                   MAIN, len(resolving), RESOLVE_SLOTS,
                   ", ".join("#%d" % n for n in resolving)))
            record["queue"] = [n for n in record["queue"]
                               if n not in slot_waiting]
    if RESOLVE_SLOTS:
        record["resolving"] = sorted(resolving)
        if slot_waiting:
            record["resolve_waiting"] = sorted(slot_waiting)
    if live:
        minutes = stalled_for(state_dir, waiting, when, check_state, repo,
                              run)
        if minutes is not None and "stalled" not in record:
            record["stalled"] = {"pr": waiting["pr"], "head": waiting["head"],
                                 "minutes": minutes}
            if waiting["action"] != "WAIT":
                record["stalled"]["refused"] = "%s %s" % (
                    waiting["action"], waiting["result"])
                if "lost" in waiting:
                    record["stalled"]["lost"] = waiting["lost"]
        save_json(said_path, said)
        said_next = {"at": record["at"], "pr": waiting_on}
        blocked = blocked_prs(held)
        if blocked:
            said_next["blocked"] = blocked
        if TEST_AHEAD:
            acted = [d["action"] for d in record["decisions"]
                     if d["pr"] == waiting_on]
            said_next["action"] = acted[-1] if acted else None
        save_json(os.path.join(state_dir, "next.json"), said_next)
        # A tick that retargets a stack's layer judges nothing, so it
        # predicts nothing. It leaves ahead.json as the last tick wrote
        # it: written empty, the batch the queue is merging was forgotten,
        # and its members waited for a new run of their own.
        if TEST_AHEAD and retarget is None and not trained:
            acting = [pr for pr in queue if pr["number"] == waiting_on]
            for pr in [pr for pr in queue if pr["number"] != waiting_on
                       and pr.get("baseRefName", MAIN) == MAIN
                       and not handed_back(said, pr, approvals[pr["number"]],
                                           when)
                       ][:AHEAD_DEPTH] if AHEAD_BATCH > 1 else ():
                # Found before its batch is predicted, not from the middle
                # of it (designs/0035, fourth amendment).
                failed = checked_ahead(state_dir, repo, pr,
                                       approvals[pr["number"]], main_tip,
                                       github.env, run, regenerated, when)
                if not failed:
                    continue
                decision = {"action": "HAND-BACK", "to": failed[0],
                            "reason": failed[1], "pr": pr["number"],
                            "head": pr["headRefOid"], "ahead": True}
                if failed[0] == "author":
                    # A gate's refusal (an approval that doesn't cover
                    # the head goes to its reviewer).
                    decision["text"] = description(pr)
                if failed[2:] == (True,):
                    decision.update(retry=True, at=iso(when))
                if live:
                    decision["result"] = carry_out(
                        decision, approvals[pr["number"]], github, said)
                    # Saved now: `said` was written before this, and a
                    # hand-back not kept is said again every tick.
                    save_json(said_path, said)
                record["decisions"].append(decision)
                out("CHECKED-AHEAD #%d: %s; %shanded back before its batch"
                    % (pr["number"], failed[1].splitlines()[0],
                       "" if live else "would be "))
            rest = [pr for pr in queue if pr["number"] != waiting_on
                    and str(pr["number"]) not in reds
                    and pr["number"] not in slot_waiting
                    and not handed_back(said, pr, approvals[pr["number"]],
                                        when)]
            ahead_queue = acting + rest if acting else []
            last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
            owed = None
            if saved:
                ahead_queue = with_suspects(ahead_queue, saved, [
                    pr for pr in prs if str(pr["number"]) not in reds])
                added = set()
                for pr in ahead_queue:
                    if pr["number"] not in approvals:
                        # A layer held as stacked: its approval, as the
                        # train boarded it with (`ready_layers`).
                        approvals[pr["number"]] = approval_of(pr) or {}
                        added.add(pr["number"])

                def updated(head, pr):
                    have_head(repo, pr, run)
                    return own_push(repo, head, pr["headRefOid"], main_tip,
                                    run)
                saved, ended = suspects_left(saved, ahead_queue, record,
                                             approvals, said, updated)
                still = {e["pr"] for e in (saved or {}).get("suspects")
                         or ()}
                ahead_queue = [pr for pr in ahead_queue
                               if pr["number"] not in added - still]
                if ended:
                    out(ended)
                if saved is None and os.path.exists(os.path.join(
                        state_dir, SUSPECTS_FILE)):
                    os.remove(os.path.join(state_dir, SUSPECTS_FILE))
            searching = bool(saved and saved["suspects"])
            sizes, events = None, []
            gated_files = {}
            layers_of = (lambda pr: ready_layers(
                repo, pr, prs, open_numbers, when, said, run, regenerated,
                rules, (lambda layer, approval: own_green_wait(
                    layer, approval, github, greens, repo, main_tip, run))
                if OWN_HEAD_GREEN and LAYERS_OWN_GREEN else None,
                (lambda layer: instance_wait(repo, layer, main_tip, github,
                                             gated_files, run))
                if GATED else None)) if AHEAD_STACKS else None
            # merge.test_ahead.own_green_to_board false: those held only
            # for their own green board too, behind the candidates; the
            # train's top tests them (amendment of 2026-11-12, ninth).
            boarding = ahead_queue + [
                pr for pr in order(unproven, prs)
                if str(pr["number"]) not in reds
                and not handed_back(said, pr, approval_of(pr) or {}, when)]
            cut = lambda before: cut_trains(
                repo, train_base, train_carriages(boarding, layers_of),
                before, {pr["number"]: pr["headRefOid"] for pr in prs},
                open_numbers, red={pr["number"] for pr in boarding
                                   if head_red(check_state, pr)},
                restacks=restacks if PREDICT_RESTACKED else None, run=run,
                files=files, note=note, force_merges=TRAINS == "live",
                started=lambda sha, tree: ahead_started(check_state, sha,
                                                        tree),
                acting=waiting_on if acting else None)
            files, note = {}, {}
            if TRAINS == "live" and not searching and boarding:
                # designs/0047: trains, cut once and kept.
                entries, sizes, events = cut(trains_before(last))
                write_ahead_refs(repo, entries, run)
                if TELL_BOARDED:
                    told = tell_boarded(
                        github, state_dir, entries,
                        {pr["number"]: pr["headRefOid"] for pr in prs}, live)
                    if told:
                        record["told_boarded"] = told
                    for item in told:
                        out("TOLD-BOARDED #%d %s%s" % (
                            item["pr"], item["head"],
                            "" if item.get("result", "done") == "done"
                            else ": " + item["result"]))
                if live and (RESOLVE or UNION):
                    record["decisions"] += resolve_ahead(
                        repo, state_dir, ahead_queue + instance_held,
                        {e["pr"] for e in entries}
                        | {d.get("pr") for d in record["decisions"]}
                        | {pr["number"] for pr in ahead_queue
                           if head_red(check_state, pr)},
                        approvals, main_tip, github, said, run)
                    save_json(said_path, said)
            else:
                if searching:
                    # Layers and pull requests owed a place wait behind
                    # the suspects, in the next batch.
                    owed = [n for n in (last or {}).get("owed") or ()
                            if n in {pr["number"] for pr in ahead_queue}]
                elif AHEAD_STACKS and ahead_queue:
                    ahead_queue, owed = with_layers(
                        ahead_queue, layers_of, last, AHEAD_BATCH)
                entries = predict_ahead(
                    repo, main_tip, ahead_queue, run, overdue=overdue,
                    restacks=restacks if PREDICT_RESTACKED else None)
            record["ahead"] = [e["pr"] for e in entries]
            said_ahead = {"at": record["at"], "base": main_tip,
                          "repo": git_store(repo),
                          "entries": entries}
            if sizes is not None and train_base != main_tip:
                # Kept on it by labels.keep_trains (`carried_base`).
                said_ahead.update(base=train_base, main=main_tip)
                if (last or {}).get("main") != main_tip:
                    out("TRAIN-KEPT: %s moved to %s; the trains stay on %s "
                        "(labels.keep_trains)" % (MAIN, main_tip[:10],
                                                  train_base[:10]))
            if sizes is None and isinstance(
                    (last or {}).get("kept_trains"), dict):
                # A red train's search goes on: its trains are kept for
                # when it ends.
                said_ahead["kept_trains"] = last["kept_trains"]
            if sizes is not None:
                said_ahead["trains"] = True
                under = left_top(last, entries, sizes,
                                 said_ahead["base"], check_state)
                if under is not None:
                    said_ahead["left_top"] = under
                if note.get("urgent_cut"):
                    said_ahead["urgent_cut"] = note["urgent_cut"]
                record["trains"] = train_lists(entries, sizes)
                if note.get("waits"):
                    # Why each that didn't board waits (2026-11-12: four
                    # waited an hour, and nothing said why).
                    record["train_waits"] = note["waits"]
                if events:
                    record["train_events"] = [c for c, _ in events]
                for _, line in events:
                    out("TRAIN-" + line)
            if owed:
                said_ahead["owed"] = record["owed"] = owed
            merged_now = {d["pr"] for d in record["decisions"]
                          if d.get("action") == "MERGE"
                          and d.get("result") == "done"}
            if entries and recut(last, entries, {pr["number"] for pr in prs},
                                 merged_now, check_state):
                record["recut"] = True
            if sizes is None and TRAINS == "dry-run" and not searching \
                    and ahead_queue:
                dry_trains(state_dir, cut, main_tip, repo, record, out,
                           when, note)
            shaky = unstable(recent_records(
                os.path.join(state_dir, name), when - UNSTABLE_WINDOW),
                record.get("recut")) if UNSTABLE_AFTER is not None else None
            if shaky is not None:
                said_ahead["unstable"] = record["unstable"] = shaky
            if bool(shaky) != bool((last or {}).get("unstable")) \
                    and AHEAD_BATCHES > UNSTABLE_BATCHES:
                out("UNSTABLE: %d re-cuts of a started batch in the last "
                    "hour, over %d; predicting %d batch%s until fewer" % (
                        shaky, UNSTABLE_AFTER, UNSTABLE_BATCHES,
                        "" if UNSTABLE_BATCHES == 1 else "es")
                    if shaky else "SETTLED: %d batches in flight again"
                    % AHEAD_BATCHES)
            # A red that is only the base's own judges nothing
            # (designs/0011, amendment): it waits for the base to change.
            verdict = lambda tree: None if tree_base_red(
                check_state, tree, main_tip) else tree_verdict(
                    check_state, tree)
            urgents = {pr["number"] for pr in ahead_queue if urgent(pr)}
            if AHEAD_BATCH > 1 and entries and not searching:
                size, red = train_batches(entries, sizes, verdict)[:2] \
                    if sizes is not None else batch_size(
                        entries, (last or {}).get("batch"), verdict,
                        (last or {}).get("later") or (), urgents)
                if red:
                    # A red top: its members are the suspects, and the
                    # search for the red one starts this tick.
                    saved = {"suspects": [{"pr": e["pr"], "head": e["head"]}
                                          for e in entries[:red]],
                             "tree": entries[red - 1]["tree"],
                             "at": record["at"], "merged": [], "left": []}
                    out("BATCH #%d..#%d: top red; its %d members are the "
                        "suspects" % (entries[0]["pr"], entries[red - 1]["pr"],
                                      red))
                    searching = True
                    if sizes is not None:
                        said_ahead["kept_trains"] = kept_trains(
                            train_base, entries, sizes, note)
                        if train_base != main_tip:
                            said_ahead["kept_trains"]["main"] = main_tip
            if searching and entries:
                # A suspect merged this tick is still predicted first,
                # from the tip before it: the rest are predicted on it,
                # and the search goes on with them.
                merged = set(saved.get("merged") or ())
                while entries and entries[0]["pr"] in merged:
                    entries = entries[1:]
                said_ahead["entries"] = entries
                record["ahead"] = [e["pr"] for e in entries]
            if searching and entries:
                found = []
                searching = suspect_round(
                    state_dir, saved, entries, verdict, last, said_ahead,
                    record, out, found if RED_SUSPECT_OUT else None)
                for entry, green in found:
                    hand_back_red_suspect(
                        state_dir, entry, green, ahead_queue, approvals,
                        reds, github, said, live, record, out, main_tip)
                if found:
                    save_json(said_path, said)
                if found and not searching:
                    # The search ended on it, at the front: it leaves
                    # the predictions now, not from its next batch.
                    gone = {e["pr"] for e, _ in found}
                    ahead_queue = [pr for pr in ahead_queue
                                   if pr["number"] not in gone]
                    entries = predict_ahead(
                        repo, main_tip, ahead_queue, run, overdue=overdue,
                        restacks=restacks if PREDICT_RESTACKED else None)
                    said_ahead["entries"] = entries
                    record["ahead"] = [e["pr"] for e in entries]
            if AHEAD_BATCH > 1 and entries and not searching:
                size, red, later = train_batches(entries, sizes, verdict) \
                    if sizes is not None else batch_size(
                        entries, (last or {}).get("batch"), verdict,
                        (last or {}).get("later") or (), urgents) + (None,)
                line = batch_line(entries, size, red, verdict)
                steps = tree_base_red(check_state, entries[size - 1]["tree"],
                                      main_tip)
                if steps:
                    line = ("BATCH-BASE-RED #%d..#%d: red only in %s, as %s "
                            "is; waits for %s to change" % (
                                entries[0]["pr"], entries[size - 1]["pr"],
                                ", ".join(steps), main_tip[:10], MAIN))
                said_ahead["batch"] = {
                    "size": size, "trees": [e["tree"]
                                            for e in entries[:size]]}
                record["batch"] = [e["pr"] for e in entries[:size]]
                if AHEAD_BATCHES > 1 and later is None:
                    later = later_batches(
                        entries, 0 if red else size,
                        (last or {}).get("later"), verdict,
                        lambda sha, tree: ahead_started(check_state, sha,
                                                        tree), urgents,
                        UNSTABLE_BATCHES if shaky else AHEAD_BATCHES)
                if later:
                    said_ahead["later"] = later
                    at, record["later"] = size, []
                    for batch in later:
                        record["later"].append([
                            e["pr"] for e in
                            entries[at:at + batch["size"]]])
                        at += batch["size"]
                if line:
                    said_ahead["batch"]["said"] = line
                    if line != ((last or {}).get("batch") or {}).get("said"):
                        out(line)
            save_json(os.path.join(state_dir, AHEAD_FILE), said_ahead)
    with open(os.path.join(state_dir, name), "a") as handle:
        handle.write(json.dumps(record, sort_keys=True) + "\n")
    out("%s %d eligible, %d approved but held; %s" % (
        "TICK" if live else "DRY-RUN", len(queue), len(held), "; ".join(
        "#%d %s%s%s" % (d["pr"], d["action"],
                        " to %s" % d["to"] if "to" in d else "",
                        " (%s)" % d["result"] if "result" in d else "")
        for d in record["decisions"]) or "nothing to do"))
    stalled = record.get("stalled")
    if stalled and "refused" in stalled:
        out("STALLED: GitHub has refused the Merger's write to #%d at %s "
            "for %d minutes, most recently %s. %s; %s" % (
                stalled["pr"], stalled["head"][:10], stalled["minutes"],
                stalled["refused"],
                "It is handed back to its author, and the queue moves past "
                "it" if stalled.get("handed_back") else
                "It stays first in the queue and is not handed back",
                refusal_hint(stalled)))
    elif stalled:
        out("STALLED: #%d has waited %d minutes on %s: %s. It stays "
            "first in the queue and is not handed back; look at %s" % (
                stalled["pr"], stalled["minutes"], stalled["head"][:10],
                waiting["reason"], where_to_look()))
    if live and STALL_ALERT:
        tell_stall(state_dir, github, stalled, record["decisions"], when,
                   send, out, (waiting or {}).get("reason"))
    return record


def mint(project, agent):
    try:
        return forge_github.token(project, agent)
    except forge_github.MintError:
        return None


def commit_identity(project, name):
    """(name, email) the App `name` commits as, or None when GitHub
    can't say its user id."""
    user_id = forge_github.bot_user_id(project, name)
    if user_id is None:
        return None
    return name, forge_github.noreply_email(project, name, user_id)


def load_check_state(state_dir):
    """The build check's state.json in `state_dir`, or None when it can't
    be read: every wait is then judged as without it. Its `running` is
    added here, not read from the file: [{pr, sha, started}] for each
    slot whose worker lock is held now, from the lock's line
    (`#<pr> <sha> <started> ...`)."""
    try:
        with open(os.path.join(state_dir, "state.json")) as handle:
            got = json.load(handle)
    except (OSError, ValueError):
        return None
    if not isinstance(got, dict):
        return None
    running = []
    try:
        names = sorted(os.listdir(state_dir))
    except OSError:
        names = []
    for name in names:
        if not (name.startswith("worker") and name.endswith(".lock")):
            continue
        parts = (locks.holder(os.path.join(state_dir, name)) or "").split()
        if len(parts) >= 3 and parts[0][:1] == "#" and parts[0][1:].isdigit():
            running.append({"pr": int(parts[0][1:]), "sha": parts[1],
                            "started": parts[2]})
    got["running"] = running
    return got


def main(argv=None, run=sh, out=print, environ=None, mint=mint,
         sender=None, identity=commit_identity):
    global RESOLVE_IDENTITY, NIGHTLY_FIXES, MAIN_RED_FIXES
    environ = os.environ if environ is None else environ
    parser = argparse.ArgumentParser(
        prog="forge-merger", description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true",
                        help="read and report, and write nothing to GitHub")
    parser.add_argument("--state-dir", default=None,
                        help="where records and state live (default "
                        "~/.local/state/agent-forge/<project>/merger)")
    parser.add_argument("--checkout", default=environ.get(
        "FORGE_CRON_CHECKOUT"), help="the checkout kept at the default "
        "branch (default $FORGE_CRON_CHECKOUT)")
    parser.add_argument("--ready", type=int, metavar="PR", default=None,
                        help="say whether pull request PR may be merged by "
                        "hand now, and exit 0 if so, 1 if not (merge.mode "
                        "manual; agent-forge #274)")
    parser.add_argument("--check-state", default=None,
                        help="the build check's state directory, read for "
                        "merge.queued_stall_minutes (default "
                        "~/.local/state/agent-forge/<project>/pr-check)")
    args = parser.parse_args(argv)
    if not args.checkout:
        out("NO-REPO: no --checkout, and FORGE_CRON_CHECKOUT is not set")
        return 2
    got = git(os.path.expanduser(args.checkout), "rev-parse",
              "--show-toplevel", run=run)
    repo = got.stdout.strip()
    if got.returncode != 0 or not repo:
        out("NO-REPO: %s is not a git checkout" % args.checkout)
        return 2
    try:
        project = config.load(os.path.join(repo, config.CONFIG_NAME))
    except config.ConfigError as err:
        out("NO-CONFIG: %s" % err)
        return 2
    configure(project)
    if args.ready is not None:
        token = environ.get("GH_TOKEN") or mint(project, READ_AS or ACT_AS)
        if not token:
            out("NO-TOKEN: no GH_TOKEN, and no token could be minted")
            return 2
        try:
            why = merge_ready(repo, GitHub(token, run), args.ready, run)
        except (RuntimeError, KeyError, TypeError, ValueError) as err:
            out("FAILED: %s" % err)
            return 2
        out("NOT READY #%d: %s" % (args.ready, "; ".join(why)) if why
            else "READY #%d: merge it with gh pr merge %d --match-head-commit"
            " <its head>" % (args.ready, args.ready))
        return 1 if why else 0
    NIGHTLY_FIXES = nightly.fixes(project, environ)
    state_dir = args.state_dir or locks.state_dir(project.name, "merger",
                                                  environ)
    os.makedirs(state_dir, exist_ok=True)
    lock = locks.try_lock(os.path.join(state_dir, "lock"), str(os.getpid()))
    if lock is None:
        out("BUSY: another tick holds %s" % os.path.join(state_dir, "lock"))
        return 0
    with lock:
        # A dry run reads as `merge.read_as` when that is set.
        reader = READ_AS if args.dry_run and READ_AS else ACT_AS
        token = mint(project, reader)
        if token is None:
            out("NO-TOKEN: could not mint %s's token" % reader)
            return 2
        if (RESOLVE or UNION or STACKS or TRAIN_MERGE) and not args.dry_run:
            RESOLVE_IDENTITY = identity(project, ACT_AS)
        check_state = None
        if QUEUED_STALL_AFTER is not None or AHEAD_BATCH > 1:
            check_state = load_check_state(
                os.path.expanduser(args.check_state) if args.check_state
                else locks.state_dir(project.name, "pr-check", environ))
        MAIN_RED_FIXES = main_red_fixes(check_state)
        if MANUAL:
            if args.dry_run:
                out("MANUAL: merge.mode is manual; nothing to merge")
                return 0
            try:
                record_hand_merges(state_dir, GitHub(token, run), out,
                                   now_utc())
            except (RuntimeError, KeyError, TypeError, ValueError) as err:
                out("FAILED: %s" % err)
                return 2
            return 0
        # Only a live tick, and only with a stall alert, is given the
        # relay: a dry run messages nobody.
        send = ((sender or relay_sender)(project, environ)
                if STALL_ALERT and not args.dry_run else None)
        try:
            # After a merge, the next pull request is taken at once
            # rather than on the next event or cron tick.
            for _ in range(TICKS_PER_RUN):
                record = tick(repo, state_dir, GitHub(token, run), run,
                              out, live=not args.dry_run, send=send,
                              **({"check_state": check_state}
                                 if check_state is not None else {}))
                if args.dry_run or not moved_a_stack(record):
                    break
        except (RuntimeError, KeyError, TypeError, ValueError) as err:
            out("FAILED: %s" % err)
            return 2
    return 2 if "stalled" in (record or {}) else 0


if __name__ == "__main__":
    sys.exit(main())
