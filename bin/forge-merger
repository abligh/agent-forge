# (context, creator login, path globs or None, label or None).
GATED = ()
# merge.own_head_green (default true): a pull request is a candidate,
# to merge or to join a batch, a train or a prediction, only once
# checks.context is green on the commit its approval names or on its
# head. A head the Merger's own merge of the default branch made is
# judged by the approved commit, as `covers_head` judges the approval.
OWN_HEAD_GREEN = True
GREEN_WAIT_REASON = ("%s is %s on %s, and no approved commit is green; "
                     "waits for the build check to pass")
# How far back through merges of the default branch an instance's
# verdict on an earlier head of the pull request still counts.
GATE_DEPTH = 20
# merge.blocked_by: "body", or "everywhere" as `blocker_state` reads it.
BLOCKED_BY = "body"
# merge.said_since: whether the author's remarks and later approvals by
# others hold too.
SAID_AUTHOR = False
