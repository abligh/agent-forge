SQUASH_DEPTH = 1000
STACK_UPDATE_MESSAGE = "Merge %s into %s against #%d's final head %s"
ROW_AFTER = 2
ROW_FOR = datetime.timedelta(minutes=60)
ROW_REASON = "conflicts with #%d, which has right of way"
ROW_FILE = "right-of-way.json"
# merge.right_of_way.while_eligible (designs/0044, rule 2): right of
