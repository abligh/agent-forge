CODE_OWNERS = False
CODEOWNERS_PATHS = (".github/CODEOWNERS", "CODEOWNERS", "docs/CODEOWNERS")
# merge.right_of_way: after ROW_AFTER conflict hand-backs, those that
# conflict with the pull request's clean head are held for ROW_FOR.
RIGHT_OF_WAY = False
# designs/0025: a stack of pull requests merges as a unit.
STACKS = False
STACK_MAX_RUN = 0
STACK_FILE = "stacks.json"
STACK_FOR = datetime.timedelta(hours=24)
STACK_REASON = "stacked on #%d"
# A layer whose base merged without the Merger: a branch found to have no
# merged pull request is asked about again only after this long.
ELSEWHERE_FILE = "merged-elsewhere.json"
ELSEWHERE_FOR = datetime.timedelta(hours=1)
ELSEWHERE_KEEP = datetime.timedelta(days=30)
# designs/0033: merge.stacks.wait_hours, how long a layer that wasn't
# ready when the layer below merged stays in its stack; None drops it.
STACK_WAIT = None
STACK_WAIT_REASON = "%s, which merged; waiting for: %s"
# What the Merger says, once, on a layer that waited out STACK_WAIT.
STACK_WAITED_NOTE = ("Not-a-review\n\nThis layer waited %d hours for its "
                     "approval after #%d merged, and the Merger no longer "
                     "retargets it. Retarget it to `%s` and ask for its "
                     "approvals again.\n\n%s")
# How many of the Merger's own merges (updates, restacks) a train
# member's head may be past the head it boarded with (`own_push`).
OWN_PUSH_DEPTH = 6
RESTACKED_FILE = "restacked.json"
