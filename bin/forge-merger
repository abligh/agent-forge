def configure(project):
    """Set the module's settings from `project`, a loaded configuration.
    The `merge` section: `merger` (the machinery App that acts, default
    "Merger"), `ci_workflow` (default "ci"; "" for none), `gate` (a list
    of argument lists), `stall_minutes` (default 30) and `stall_alert`
    (default none: a stall is only printed), and `test_ahead` (default
    none: nothing is predicted; `depth`, default 3) and
    `hold_conflicting` (default false), `yield_after_hand_back`
    (default none: nobody yields), `yield_cap` (default 3),
    `yield_ignores_conflicts` (default false) and `right_of_way`
    (default none: nobody has it; `after_conflicts`, default 2, and
    `minutes`, default 60) and `code_owners` (default false) and
    `stacks` (default none: a stacked pull request is held; `max_run`,
    default 0, no limit; `wait_hours`, default none: a layer that isn't
    ready when the layer below merges leaves the stack), and design 0026's `resolve`, `hold_labels`,
    `blocked_by`, `said_since`, `update_once`, `ci_never_started`,
    `queued_stall_minutes` and `read_as` (each off unless set). The
    `checks` section: `context` and `poster` (default the merger).
    `labels.waiting_on_owner` is the label a long stall gets, and
    `labels.urgent` the label that puts a pull request first."""
    global REPO_SLUG, MAIN, APPROVERS, QUIET_LOGINS, ACT_AS, SIGNATURE
    global STATUS_CONTEXT, STATUS_CREATOR, BUILD_HOST, GATE, CI_WORKFLOW
    global STALL_AFTER, STALL_ALERT, STALL_TELL, STALL_RETELL
    global STALL_TO_OWNER, STALL_TITLE, STALL_LABELS, WAITING_OWNER
    global TEST_AHEAD, AHEAD_DEPTH, AHEAD_BATCH, HOLD_CONFLICTING, YIELD_PLACES
    global YIELD_CAP, YIELD_IGNORES_CONFLICTS, RIGHT_OF_WAY, ROW_AFTER
    global ROW_FOR, CODE_OWNERS, CHANGERS, EARLY_CONFLICTS, URGENT_LABEL
    global STACKS, STACK_MAX_RUN, STACK_WAIT, RESOLVE, HOLD_LABELS, BLOCKED_BY
    global SAID_AUTHOR, SAID_APPROVALS, UPDATE_ONCE, CI_NEVER_STARTED
    global QUEUED_STALL_AFTER, READ_AS, AHEAD_STACKS, AHEAD_BATCHES
    global AGE_FIRST
    merge, checks = project.section("merge"), project.section("checks")
    REPO_SLUG = project.repo
    MAIN = project.default_branch
    ACT_AS = merge.get("merger", "Merger")
    SIGNATURE = "— " + ACT_AS
    APPROVERS = {project.slug(n): n for n in project.reviewers()}
    QUIET_LOGINS = frozenset((project.slug(ACT_AS),))
    CHANGERS = frozenset(APPROVERS) | {project.owner}
    STATUS_CONTEXT = checks.get("context", DEFAULT_CONTEXT)
    STATUS_CREATOR = project.bot_login(checks.get("poster", ACT_AS))
    BUILD_HOST = project.host
    GATE = tuple(tuple(argv) for argv in merge.get("gate", DEFAULT_GATE))
    CI_WORKFLOW = merge.get("ci_workflow", "ci")
    STALL_AFTER = datetime.timedelta(minutes=merge.get("stall_minutes", 30))
    alert = merge.get("stall_alert")
    STALL_ALERT = alert is not None
    alert = alert or {}
    STALL_TELL = tuple(alert.get("tell", ()))
    STALL_RETELL = datetime.timedelta(minutes=alert.get(
        "retell_minutes", DEFAULT_STALL_RETELL_MINUTES))
    STALL_TO_OWNER = datetime.timedelta(minutes=alert.get(
        "owner_after_minutes", DEFAULT_STALL_OWNER_AFTER_MINUTES))
    STALL_TITLE = alert.get("title", DEFAULT_STALL_TITLE)
    STALL_LABELS = tuple(alert.get("labels", ()))
    WAITING_OWNER = project.section("labels").get("waiting_on_owner",
                                                  DEFAULT_WAITING_OWNER)
    URGENT_LABEL = project.section("labels").get("urgent")
    ahead = merge.get("test_ahead")
    TEST_AHEAD = ahead is not None
    AHEAD_DEPTH = (ahead or {}).get("depth", DEFAULT_AHEAD_DEPTH)
    AHEAD_BATCH = (ahead or {}).get("batch", 1)
    AHEAD_BATCHES = (ahead or {}).get("batches", 1)
    HOLD_CONFLICTING = merge.get("hold_conflicting", False) is True
    YIELD_PLACES = merge.get("yield_after_hand_back", 0)
    YIELD_CAP = merge.get("yield_cap", 3)
    YIELD_IGNORES_CONFLICTS = merge.get("yield_ignores_conflicts",
                                        False) is True
    CODE_OWNERS = merge.get("code_owners", False) is True
    EARLY_CONFLICTS = merge.get("early_conflicts", False) is True
    row = merge.get("right_of_way")
    RIGHT_OF_WAY = row is not None
    ROW_AFTER = (row or {}).get("after_conflicts", 2)
    ROW_FOR = datetime.timedelta(minutes=(row or {}).get("minutes", 60))
    age = merge.get("age_first")
    AGE_FIRST = (None if age is None else datetime.timedelta(
        minutes=age.get("after_minutes", 90)))
    stacks = merge.get("stacks")
    STACKS = stacks is not None
    STACK_MAX_RUN = (stacks or {}).get("max_run", 0)
    wait = (stacks or {}).get("wait_hours")
    STACK_WAIT = datetime.timedelta(hours=wait) if wait else None
    AHEAD_STACKS = (STACKS and AHEAD_BATCH > 1
                    and (ahead or {}).get("stacks") is True)
    RESOLVE = tuple({"paths": frozenset(rule["paths"]),
                     "command": tuple(rule["command"]),
                     "check": tuple(rule["check"])}
                    for rule in merge.get("resolve", ()))
    HOLD_LABELS = tuple(merge.get("hold_labels", ()))
    BLOCKED_BY = merge.get("blocked_by", "body")
    said = merge.get("said_since") or {}
    SAID_AUTHOR = said.get("author", False) is True
    SAID_APPROVALS = said.get("approvals", False) is True
    QUIET_LOGINS = QUIET_LOGINS | {project.slug(n)
                                   for n in said.get("quiet", ())}
    UPDATE_ONCE = merge.get("update_once", False) is True
    never = merge.get("ci_never_started")
    CI_NEVER_STARTED = (datetime.timedelta(minutes=never)
                        if never is not None else None)
    queued = merge.get("queued_stall_minutes")
    QUEUED_STALL_AFTER = (datetime.timedelta(minutes=queued)
                          if queued is not None else None)
    READ_AS = merge.get("read_as")

NOT_A_REVIEW_RE = re.compile(r"^Not-a-review\b", re.MULTILINE | re.IGNORECASE)
BLOCKED_RE = re.compile(r"^\**Blocked-by:\**\s*#(\d+)\s*\**$",
                        re.MULTILINE | re.IGNORECASE)
BLOCKED_LINE_RE = re.compile(r"^\**Blocked-by:", re.IGNORECASE)
UNBLOCK_RE = re.compile(r"^\**Blocked-by:\**\s*(none|nothing)\s*\.?\**$",
                        re.MULTILINE | re.IGNORECASE)
FENCE_RE = re.compile(r"^\s*(```|~~~).*?(^\s*\1|\Z)", re.MULTILINE | re.DOTALL)
DEFER_ANY_RE = re.compile(r"^Defer-until:[ \t]*(.+?)[ \t]*$",
                          re.MULTILINE | re.IGNORECASE)
DEFER_FORMATS = ("%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M%z", "%Y-%m-%d")

PR_QUERY = """
query($owner:String!, $name:String!, $cursor:String) {
  repository(owner:$owner, name:$name) {
    pullRequests(states:OPEN, first:50, after:$cursor) {
      pageInfo { hasNextPage endCursor }
      nodes {
        number title createdAt isDraft baseRefName headRefName headRefOid body
        author { login }
        labels(first:50) { nodes { name } }
        reviews(last:100) {
          nodes { author { login } authorCanPushToRepository
                  state submittedAt body commit { oid }
                  comments { totalCount } }
        }
        comments(last:100) { nodes { author { login } createdAt body } }
      }
    }
  }
}"""


def sh(args, cwd=None, env=None):
    return subprocess.run(args, cwd=cwd, env=env, capture_output=True,
                          text=True)


def now_utc():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)


def iso(when):
    return when.strftime("%Y-%m-%dT%H:%M:%SZ")


def login(node):
    """The author's login without GitHub's "[bot]" suffix, which REST
    adds and GraphQL leaves off, or "" for a deleted account."""
    name = ((node or {}).get("author") or {}).get("login") or ""
    return name[:-len("[bot]")] if name.endswith("[bot]") else name


def markers_of(text):
    """`text` without fenced or indented code: a comment that quotes
    `Not-a-review` or `Blocked-by:` in code is not marked."""
    text = FENCE_RE.sub("", text or "")
    return "\n".join(l for l in text.splitlines()
                     if not l.startswith(("    ", "\t")))


def approval_of(pr, approvers=None):
    """The newest `APPROVED` review by an APPROVERS App (or one of the
    logins `approvers` names) that is not the pull request's author, or
    None."""
    approvers = APPROVERS if approvers is None else approvers
    best = None
    for review in pr["reviews"]:
        who = login(review)
        if (review.get("state") == "APPROVED" and who in approvers
                and who != login(pr)):
            if best is None or review["submittedAt"] > best["submittedAt"]:
                best = review
    return best


def changes_requested(pr, changers=None):
    """The reviews whose request for changes still stands, oldest first:
    for each login in CHANGERS (or `changers`), or that GitHub says can
    push to the repository, other than the author, its newest
    `APPROVED`, `CHANGES_REQUESTED` or `DISMISSED` review, when that is
    `CHANGES_REQUESTED`. GitHub refuses to merge while one
    stands, whatever another reviewer approved since, and a push or a
    comment doesn't lift it: only that reviewer's next verdict or a
    dismissal does."""
    changers = {c.lower() for c in (CHANGERS if changers is None
                                    else changers)}
    latest = {}
    for review in pr["reviews"]:
        who = login(review).lower()
        if ((who in changers or review.get("authorCanPushToRepository"))
                and who != login(pr).lower()
                and review.get("state") in ("APPROVED", "CHANGES_REQUESTED",
                                            "DISMISSED")
                and (who not in latest or (review.get("submittedAt") or "")
                     > (latest[who].get("submittedAt") or ""))):
            latest[who] = review
    return sorted((r for r in latest.values()
                   if r["state"] == "CHANGES_REQUESTED"),
                  key=lambda r: r.get("submittedAt") or "")


def said_since(pr, approval):
    """Comments and reviews after `approval`, as (login, time, kind),
    less those marked `Not-a-review`, those by QUIET_LOGINS, those by
    the pull request's author and approvals. Empty means nothing has
    been said since. With `merge.said_since.author` the author's remarks
    count too, and with `approvals` so does a later approval: another
    reviewer's assent after the one that counts is still a remark the
    approver hasn't seen."""
    at = approval["submittedAt"]
    author = login(pr)
    said = []
    for kind, items, stamp in (("review", pr["reviews"], "submittedAt"),
                               ("comment", pr["comments"], "createdAt")):
        for item in items:
            when = item.get(stamp) or ""
            if item is approval or when <= at:
                continue
            who = login(item)
            if who in QUIET_LOGINS or (author and who == author
                                       and not SAID_AUTHOR):
                continue
            if NOT_A_REVIEW_RE.search(markers_of(item.get("body"))):
                continue
            if (kind == "review" and item.get("state") == "APPROVED"
                    and not SAID_APPROVALS):
                # Assent, whatever its text: a reviewer with second
                # thoughts requests changes instead.
                continue
            said.append((who or "ghost", when, kind))
    return sorted(said, key=lambda s: s[1])


def label_names(pr):
    """`pr`'s label names, from GraphQL's `labels.nodes` or a plain
    list of names or `{"name": ...}` objects."""
    labels = pr.get("labels") or ()
    if isinstance(labels, dict):
        labels = labels.get("nodes") or ()
    return [l.get("name") if isinstance(l, dict) else l for l in labels]


def texts_of(pr):
    """The body, comments and submitted reviews of `pr`, oldest first, as
    (time, text) pairs; the body sorts first. A pending review has no
    time and is not read."""
    texts = [("", pr.get("body"))]
    texts += [(c.get("createdAt") or "", c.get("body"))
              for c in pr.get("comments") or ()]
    texts += [(r.get("submittedAt") or "", r.get("body"))
              for r in pr.get("reviews") or () if r.get("submittedAt")]
    return sorted(texts, key=lambda t: t[0])


def blocker_state(pr):
    """(numbers, unparsed) for `pr`'s `Blocked-by:` lines. With
    `merge.blocked_by: "everywhere"`, the newest text with a
    `Blocked-by:` line decides, across the body, comments and reviews,
    `Not-a-review` included: every strict line in it counts and replaces
    any earlier numbers, and `Blocked-by: none` clears them. `unparsed`
    is the first line in that text that starts `Blocked-by:` but is
    neither strict nor `none`, or None: it was meant as a hold, so it
    holds. Otherwise only the body's strict lines count, and nothing is
    unparsed."""
    if BLOCKED_BY != "everywhere":
        return ({int(m.group(1))
                 for m in BLOCKED_RE.finditer(markers_of(pr.get("body")))},
                None)
    named, unparsed = set(), None
    for _, text in texts_of(pr):
        text = markers_of(text)
        lines = [l for l in text.splitlines() if BLOCKED_LINE_RE.match(l)]
        if not lines:
            continue
        bad = [l for l in lines
               if not (BLOCKED_RE.match(l) or UNBLOCK_RE.match(l))]
        unparsed = bad[0].strip() if bad else None
        if UNBLOCK_RE.search(text):
            named = set()
        found = {int(m.group(1)) for m in BLOCKED_RE.finditer(text)}
        if found:
            named = found
    return named, unparsed


def blockers_of(pr):
    """The pull request and issue numbers `pr` is blocked by; see
    `blocker_state`."""
    return blocker_state(pr)[0]


def parse_defer(value):
    """A `Defer-until:` value as an aware datetime, or None if it is not
    one of DEFER_FORMATS. A value without a zone is UTC."""
    for fmt in DEFER_FORMATS:
        try:
            when = datetime.datetime.strptime(value.replace("Z", "+0000"), fmt)
        except ValueError:
            continue
        return when if when.tzinfo else when.replace(
            tzinfo=datetime.timezone.utc)
    return None


def deferral_of(pr, now):
    """Why `pr` is deferred at `now`, or None. The newest `Defer-until:`
    line wins, across the body, comments and reviews. An unexpired one
    holds the pull request, and so does one that isn't a time: a
    deferral nobody can read is not a release."""
    texts = [("", pr.get("body"))]
    texts += [(c.get("createdAt") or "", c.get("body")) for c in pr["comments"]]
    texts += [(r.get("submittedAt") or "", r.get("body"))
              for r in pr["reviews"] if r.get("submittedAt")]
    latest = None
    for _, text in sorted(texts, key=lambda t: t[0]):
        found = DEFER_ANY_RE.findall(markers_of(text))
        if found:
            latest = found[-1]
    if latest is None:
        return None
    until = parse_defer(latest)
    if until is None:
        return "Defer-until: %s is not a time" % latest[:40]
    if until > now:
        return "deferred until %s" % iso(until.astimezone(
            datetime.timezone.utc))
    return None


def eligible(pr, open_numbers, now=None, stacked=None, any_base=False):
    """(approval, None) when `pr` is the Merger's, so far as GitHub's
    records say, or (None, reason). Whether the approval covers the head
    needs git, so `covers_head` asks that separately. `open_numbers` is
    every open pull request and issue a `Blocked-by:` line could name;
    `now` decides whether a `Defer-until:` has passed. With STACKS,
    `stacked` maps each open pull request's head branch to its number,
    so one based on it is held as stacked on it; `any_base` judges the
    rest as if the base were `main`."""
    if pr.get("isDraft"):
        return None, "draft"
    if pr.get("baseRefName") != MAIN and not any_base:
        below = (stacked or {}).get(pr.get("baseRefName"))
        if STACKS and below is not None:
            return None, STACK_REASON % below
        return None, "based on %s, not %s" % (pr.get("baseRefName"), MAIN)
    for label in HOLD_LABELS:
        if label in label_names(pr):
            return None, "labelled %s" % label
    approval = approval_of(pr)
    if approval is None:
        return None, "no Reviewer approval"
    said = said_since(pr, approval)
    if said:
        who, when, kind = said[0]
        return None, "%s by %s at %s, after the approval" % (kind, who, when)
    standing = changes_requested(pr)
    if standing:
        return None, "changes requested by %s at %s" % (
            login(standing[0]), standing[0].get("submittedAt"))
    named, unparsed = blocker_state(pr)
    if unparsed:
        return None, "unparsed Blocked-by line: %s" % unparsed[:60]
    still = sorted(named & set(open_numbers))
    if still:
        return None, "Blocked-by: %s" % ", ".join("#%d" % n for n in still)
    deferred = deferral_of(pr, now or now_utc())
    if deferred:
        return None, deferred
    return approval, None


def urgent(pr):
    """Whether `pr` carries `labels.urgent`, or fixes a red nightly or
    a red default branch."""
    if pr.get("number") in NIGHTLY_FIXES | MAIN_RED_FIXES:
        return True
    return bool(URGENT_LABEL) and URGENT_LABEL in [
        (n or {}).get("name") for n in
        ((pr.get("labels") or {}).get("nodes") or [])]


def order(candidates, everyone=None):
    """`candidates` in the order the Merger takes them. First come those
    carrying `labels.urgent`, then those that another open pull request
    is blocked by, then the rest, each group oldest first by
    `createdAt`, then by number.

    `everyone` is every open pull request, candidates or not, and
    defaults to `candidates`. It has to include the ineligible ones: a
    pull request with an open `Blocked-by:` is never a candidate, so
    reading blockers from candidates alone would promote nothing."""
    named = set()
    for pr in candidates if everyone is None else everyone:
        named |= blockers_of(pr)
    key = lambda pr: (not urgent(pr), pr["number"] not in named,
                      pr["createdAt"], pr["number"])
    return sorted(candidates, key=key)


def recent_records(path, since, block=65536):
    """The records of the JSON-lines file `path` stamped (`at`) at or
    after `since`, oldest first, read from the end in blocks until one
    older turns up: a long record is never read whole for one tick."""
    try:
        handle = open(path, "rb")
    except OSError:
        return []
    with handle:
        handle.seek(0, os.SEEK_END)
        end = handle.tell()
        tail, records, done = b"", [], False
        while end > 0 and not done:
            start = max(0, end - block)
            handle.seek(start)
            chunk = handle.read(end - start) + tail
            end = start
            lines = chunk.split(b"\n")
            # The first line may be cut short unless the file starts here.
            tail = lines.pop(0) if start > 0 else b""
            for line in reversed(lines):
                try:
                    record = json.loads(line)
                    at = parse_time(record["at"])
                except (ValueError, KeyError, TypeError):
                    continue
                if at < since:
                    done = True
                    break
                records.append(record)
        if not done and tail:
            try:
                record = json.loads(tail)
                if parse_time(record["at"]) >= since:
                    records.append(record)
            except (ValueError, KeyError, TypeError):
                pass
    records.reverse()
    return records


def author_hand_backs(records):
    """Each distinct (pr, head, reason) handed back to its author in
    `records`, since a tick repeats a hand-back already said; one GitHub
    refused to post is not one. A hand-back to the approving reviewer
    asks for a fresh review and is not the pull request's own failure,
    so it isn't one either."""
    seen = set()
    for record in records:
        for d in record.get("decisions") or ():
            if not isinstance(d, dict) or d.get("action") != "HAND-BACK" \
                    or d.get("to") != "author":
                continue
            if str(d.get("result") or "").startswith("refused"):
                continue
            seen.add((d.get("pr"), d.get("head"), d.get("reason")))
    return seen


def hand_backs(records, conflicts=True):
    """{pr: how many times it was handed back to its author} in
    `records` (see `author_hand_backs`); without `conflicts`, a conflict
    with main doesn't count. A head GitHub lost (LOST_HEAD_REASON), or
    a CI run GitHub never finished (`ci_stuck_reason`), is never the
    pull request's own failure, so it doesn't count either."""
    counts = {}
    for pr, _, reason in author_hand_backs(records):
        if not not_own_failure(reason) and (
                conflicts or reason != CONFLICT_REASON):
            counts[pr] = counts.get(pr, 0) + 1
    return counts


def conflict_hand_backs(records):
    """{pr: how many heads were handed back to its author for a conflict
    with main} in `records`."""
    counts = {}
    for pr, _, reason in author_hand_backs(records):
        if reason == CONFLICT_REASON:
            counts[pr] = counts.get(pr, 0) + 1
    return counts


def yields_spent(records, conflicts=True):
    """{pr: how many other pull requests merged while it was a candidate,
    since its latest hand-back to its author} in `records` (oldest
    first; see `author_hand_backs` for what counts as a hand-back, and
    `hand_backs` for `conflicts`). Each such merge is a place it has
    already yielded: `yield_places` moves it back only by what it still
    owes. Without this, a yield taken afresh from every tick's order is
    a standing penalty, and the oldest candidate, first in that order,
    can't reach the front while enough others are ready."""
    last, spent = {}, {}
    for record in records:
        for d in record.get("decisions") or ():
            if not isinstance(d, dict) or d.get("action") != "HAND-BACK" \
                    or d.get("to") != "author" \
                    or str(d.get("result") or "").startswith("refused"):
                continue
            if not not_own_failure(d.get("reason")) and (
                    conflicts or d.get("reason") != CONFLICT_REASON):
                last[d.get("pr")] = record
                spent[d.get("pr")] = 0
        queue = record.get("queue") or ()
        merged = {d.get("pr") for d in record.get("decisions") or ()
                  if isinstance(d, dict) and d.get("action") == "MERGE"
                  and d.get("result") == "done"}
        for pr in spent:
            if record is not last[pr] and pr in queue:
                spent[pr] += len(merged - {pr})
    return spent


def yield_places(queue, everyone, counts, keep=None, spent=None):
    """(`queue` reordered, {pr: places moved back}): each pull request
    handed back K times (`counts`, K at most YIELD_CAP) moved back
    YIELD_PLACES times K places within its group, less the places it
    has already yielded (`spent`, see `yields_spent`), those another
    open pull request is blocked by being one group and the rest the
    other. `keep`, the pull request a run is in flight for, never moves.
    Later ones are moved first, so one yielding never takes a place
    another yielded."""
    named = set()
    for pr in everyone:
        named |= blockers_of(pr)
    # Urgent ones (labels.urgent) stay first and never yield: a person
    # put them there.
    hot = [pr for pr in queue if urgent(pr)]
    groups = ([pr for pr in queue if pr["number"] in named
               and not urgent(pr)],
              [pr for pr in queue if pr["number"] not in named
               and not urgent(pr)])
    moved = {}
    for group in groups:
        for i in range(len(group) - 1, -1, -1):
            pr = group[i]
            k = min(counts.get(pr["number"], 0), YIELD_CAP)
            owed = YIELD_PLACES * k - (spent or {}).get(pr["number"], 0)
            if owed <= 0 or pr["number"] == keep:
                continue
            to = min(i + owed, len(group) - 1)
            if to > i:
                group.insert(to, group.pop(i))
                moved[pr["number"]] = to - i
    return hot + groups[0] + groups[1], moved


def git(repo, *args, run=sh):
    return run(["git", "-C", repo] + list(args))


def fetch_pr(repo, number, head, run=sh):
    """Fetch pull request `number`'s head into PR_REF, and return the
    first fetch's result when nothing could be fetched. GitHub can fail
    to make `refs/pull/N/head`, and then a fetch of it fails on every
    tick. The head the Merger means is `head`, the SHA it already read,
    and GitHub serves a reachable commit by its SHA, so that is the
    fallback; a SHA that can't be fetched either is still a failure."""
    fetched = git(repo, "fetch", "-q", "origin",
                  "+refs/pull/%d/head:%s" % (number, PR_REF % number),
                  run=run)
    if fetched.returncode == 0 and git(
            repo, "rev-parse", PR_REF % number,
            run=run).stdout.strip() == head:
        return fetched
    # GitHub can also leave `refs/pull/N/head` at an old commit while the
    # API names a newer head: on 2026-10-26 one pull request's ref stayed
    # behind for nine hours, and it was skipped on every tick as "the head
    # moved while reading". A head that really moved can't be fetched by
    # the old SHA's ref either way, and GitHub refuses a write pinned to
    # it, so the SHA is the fallback here too.
    if git(repo, "fetch", "-q", "origin", head, run=run).returncode != 0:
        return fetched
    return git(repo, "update-ref", PR_REF % number, head, run=run)


def is_ancestor(repo, older, newer, run=sh):
    return git(repo, "merge-base", "--is-ancestor", older, newer,
               run=run).returncode == 0


def conflicted_paths(output):
    """The paths `git merge-tree --write-tree --name-only --no-messages`
    lists as conflicted: every line after the tree's id."""
    return {line for line in output.splitlines()[1:] if line}


def resolve_rule(paths):
    """The index of the first `merge.resolve` rule whose paths hold all
    of `paths` (a non-empty set), or None."""
    for at, rule in enumerate(RESOLVE):
        if paths and paths <= rule["paths"]:
            return at
    return None


def regenerated_merge(repo, parents, sha, run=sh):
    """The `merge.resolve` rule's index when merging `parents` conflicts
    only in paths one rule lists and `sha`'s tree differs from that
    merge only in those paths, else None. Whether the files themselves
    are right is the rule's `check`'s question."""
    merged = git(repo, "merge-tree", "--write-tree", "--name-only",
                 "--no-messages", *parents, run=run)
    if merged.returncode != 1:
        return None
    at = resolve_rule(conflicted_paths(merged.stdout))
    if at is None:
        return None
    differs = git(repo, "diff-tree", "-r", "--name-only",
                  merged.stdout.split()[0], sha + "^{tree}", run=run)
    if differs.returncode != 0 or not set(
            differs.stdout.split()) <= RESOLVE[at]["paths"]:
        return None
    return at


def squashed(repo, lower, main_ref, run=sh):
    """Whether a commit on `main_ref`'s first-parent history has exactly
    `lower`'s tree: the squash of the layer whose final head it is."""
    tree = git(repo, "rev-parse", lower + "^{tree}", run=run)
    if tree.returncode != 0:
        return False
    trees = git(repo, "log", "--first-parent", "--format=%T",
                "-n", str(SQUASH_DEPTH), main_ref, run=run)
    return (trees.returncode == 0
            and tree.stdout.strip() in trees.stdout.split())


def based_merge(repo, main_side, layer, lower, run=sh):
    """The tree of `main_side` merged into `layer` against `lower`, the
    final head of the merged layer below (designs/0025), or None when it
    isn't clean or isn't safe: `layer` must hold `lower`, and `main_side`
    its squash. Otherwise the base would let the layer undo the lower
    layer's later changes, without a conflict."""
    if not (is_ancestor(repo, lower, layer, run)
            and squashed(repo, lower, main_side, run)):
        return None
    merged = git(repo, "merge-tree", "--write-tree", "--no-messages",
                 "--merge-base=" + lower, main_side, layer, run=run)
    if merged.returncode != 0:
        return None
    return merged.stdout.split()[0]


def covers_head(repo, approved, head, main_ref, run=sh, below=(),
                regenerated=None):
    """(True, None) if the approval at `approved` covers `head`, (False,
    reason) if not, or (None, reason) when `regenerated` could not say,
    a question for the next tick. Both commits and `main_ref` must be in
    `repo`. `below` are the heads of a stack's layers already merged
    (STACKS): a clean merge of one of them, as of `main`, covers the
    head too. With `merge.resolve`, a merge whose only conflict was in a
    rule's paths covers it too, once `regenerated(sha, rule)` says its
    files are what the rule's `check` makes of them."""
    if not is_ancestor(repo, approved, head, run):
        return False, "the approved commit %s is not in the head's history" % (
            approved[:10])
    got = git(repo, "rev-list", "--parents", head, "^" + approved,
              "^" + main_ref, *("^" + b for b in below), run=run)
    if got.returncode != 0:
        return False, "git rev-list failed: %s" % got.stderr.strip()
    for line in got.stdout.splitlines():
        sha, *parents = line.split()
        if len(parents) != 2:
            return False, "%s, after the approval, is not a merge" % sha[:10]
        if not any(is_ancestor(repo, p, main_ref, run)
                   or any(is_ancestor(repo, p, b, run) for b in below)
                   for p in parents):
            return False, "%s merges nothing from %s" % (sha[:10], MAIN)
        merged = git(repo, "merge-tree", "--write-tree", *parents, run=run)
        tree = git(repo, "rev-parse", sha + "^{tree}", run=run)
        if (merged.returncode == 0 and tree.returncode == 0
                and merged.stdout.split()[:1] == tree.stdout.split()[:1]):
            continue
        if tree.returncode == 0 and any(
                based_merge(repo, main_side, layer, b, run)
                == tree.stdout.split()[0]
                for b in below for main_side, layer in (parents,
                                                        parents[::-1])):
            continue
        rule = (regenerated_merge(repo, parents, sha, run)
                if RESOLVE and regenerated is not None else None)
        if rule is not None:
            verdict = regenerated(sha, rule)
            if verdict is None:
                return None, ("could not check %s's regenerated files; "
                              "trying again next tick" % sha[:10])
            if verdict:
                continue
        return False, ("%s's tree is not the clean merge of its parents"
                       % sha[:10])
    return True, None


def tokenless_env():
    """The environment with every variable named like a token taken out,
    for code a pull request brings (a rule's own `command` or `check`).
    **This is not a sandbox**: the process runs as the host's user. What
    stands between an approved pull request's tool and the Merger's
    write access is the reviewer's approval of that code; taking the
    tokens out only stops the tool using the Merger's by accident."""
    return {k: v for k, v in os.environ.items() if "TOKEN" not in k.upper()}


class Checkout:
    """A temporary detached worktree of `repo` at `sha`, removed on exit.
    `path` is None when it could not be made, and `error` says why."""

    def __init__(self, repo, sha, run=sh):
        self.repo, self.sha, self.run = repo, sha, run
        self.tmp = self.path = None
        self.error = ""

    def __enter__(self):
        self.tmp = tempfile.mkdtemp(prefix="forge-merger-")
        where = os.path.join(self.tmp, "tree")
        added = git(self.repo, "worktree", "add", "-q", "--detach", where,
                    self.sha, run=self.run)
        if added.returncode == 0:
            self.path = where
        else:
            self.error = added.stderr.strip()
        return self

    def __exit__(self, *exc):
        # Removing the directory and pruning is `worktree remove --force`
        # without its refusals, and also clears a half-made worktree.
        shutil.rmtree(self.tmp, ignore_errors=True)
        git(self.repo, "worktree", "prune", run=self.run)
        return False


def tree_tool(where, argv):
    """`argv` with its tool taken from the worktree at `where`: a rule's
    tool is the tree's own copy, which is what made the tree's files."""
    tool = argv[0]
    return [tool if os.path.isabs(tool) else os.path.join(where, tool)] + \
        list(argv[1:])


def regenerated_in(repo, sha, rule, run=sh):
    """Whether `sha`'s files are what rule `rule`'s `check` makes of them,
    run from `sha`'s own tree: True when it exits 0, False when it exits
    1, and None when the check could not be made (a worktree that would
    not open, or any other exit). None is not a verdict."""
    with Checkout(repo, sha, run) as tree:
        if tree.path is None:
            return None
        try:
            got = run(tree_tool(tree.path, RESOLVE[rule]["check"]),
                      cwd=tree.path, env=tokenless_env())
        except OSError:
            return None
        return {0: True, 1: False}.get(got.returncode)


def remembered(state_dir, check):
    """`check(sha, rule)`, remembered in RESOLVE_CHECKED by commit and
    rule: the head it judges is judged every tick until it merges. Only
    a verdict is remembered; a None is asked again next time."""
    path = os.path.join(state_dir, RESOLVE_CHECKED)

    def regenerated(sha, rule):
        seen = load_json(path, {})
        key = "%s %d" % (sha, rule)
        if key in seen:
            return seen[key]
        verdict = check(sha, rule)
        if verdict is not None:
            seen[key] = bool(verdict)
            save_json(path, seen)
        return verdict
    return regenerated


def push_env(github):
    """`github`'s environment with git told to send its token to GitHub,
    through the environment, never the checkout's config."""
    token = github.env.get("GH_TOKEN", "")
    basic = base64.b64encode(("x-access-token:" + token).encode()).decode()
    return dict(github.env, GIT_CONFIG_COUNT="1",
                GIT_CONFIG_KEY_0="http.https://github.com/.extraheader",
                GIT_CONFIG_VALUE_0="AUTHORIZATION: basic " + basic)


def resolve(repo, decision, branch, main_tip, github, run=sh):
    """Merge `main_tip` into the head in a temporary worktree, regenerate
    the rule's files with the tree's own `command`, commit as the
    Merger, and push to `branch` with a lease on the head. Returns
    "done", "refused: why" when the push was refused (the head moved,
    say: the next tick judges afresh), or "failed: why" when the
    conflict could not be resolved this way."""
    head, rule = decision["head"], RESOLVE[decision["rule"]]
    if RESOLVE_IDENTITY is None:
        return "failed: identity: the Merger's commit identity is unknown"
    who = ["-c", "user.name=" + RESOLVE_IDENTITY[0],
           "-c", "user.email=" + RESOLVE_IDENTITY[1]]
    paths = sorted(rule["paths"])
    message = RESOLVE_MESSAGE % (MAIN, branch, ", ".join(paths))
    with Checkout(repo, head, run) as tree:
        if tree.path is None:
            return "failed: worktree: " + tree.error
        here = tree.path
        # --no-commit either way, so the one commit made below is the
        # merge, whether or not git stopped for the conflict.
        git(here, *who, "merge", "-q", "--no-commit", "--no-ff", main_tip,
            run=run)
        left = set(git(here, "diff", "--name-only", "--diff-filter=U",
                       run=run).stdout.split())
        if not left <= rule["paths"]:
            return "failed: the merge conflicts in %s" % ", ".join(
                sorted(left - rule["paths"]))
        # Staged before regenerating as well as after: a tool may refuse
        # an unmerged index, and it rewrites the files, so the conflict
        # markers staged here don't survive it.
        if left:
            got = git(here, "add", "--", *sorted(left), run=run)
            if got.returncode != 0:
                return "failed: git add: " + got.stderr.strip()
        try:
            made = run(tree_tool(here, rule["command"]), cwd=here,
                       env=tokenless_env())
        except OSError as err:
            return "failed: %s could not run: %s" % (
                os.path.basename(rule["command"][0]), err.strerror or err)
        if made.returncode != 0:
            return "failed: %s exited %d: %s" % (
                os.path.basename(rule["command"][0]), made.returncode,
                tail(made.stderr + "\n" + made.stdout, 2))
        for name, args in (("add", ["add", "-A", "--"] + paths),
                           ("commit", who + ["commit", "-q", "-m",
                                             message])):
            got = git(here, *args, run=run)
            if got.returncode != 0:
                return "failed: git %s: %s" % (name, got.stderr.strip())
        pushed = run(["git", "-C", here, "push", "-q",
                      "--force-with-lease=refs/heads/%s:%s" % (branch, head),
                      "https://github.com/%s.git" % REPO_SLUG,
                      "HEAD:refs/heads/" + branch], env=push_env(github))
        if pushed.returncode != 0:
            return "refused: " + tail(pushed.stderr + "\n" + pushed.stdout,
                                      2)
    return "done"


def stack_update(repo, decision, main_tip, github, run=sh):
    """Commit `decision`'s tree (`based_merge`) as a merge of `main_tip`
    into the head, as the Merger, and push it to the layer's branch with
    a lease on the head. "done", "refused: why" or "failed: why", as
    `resolve`."""
    if RESOLVE_IDENTITY is None:
        return "failed: identity: the Merger's commit identity is unknown"
    head, branch = decision["head"], decision["branch"]
    name, email = RESOLVE_IDENTITY
    made = run(["git", "-C", repo, "commit-tree", decision["tree"],
                "-p", head, "-p", main_tip, "-m", STACK_UPDATE_MESSAGE % (
                    MAIN, branch, decision["after"], decision["below"][:10])],
               env=dict(os.environ, GIT_AUTHOR_NAME=name,
                        GIT_AUTHOR_EMAIL=email, GIT_COMMITTER_NAME=name,
                        GIT_COMMITTER_EMAIL=email))
    if made.returncode != 0:
        return "failed: git commit-tree: " + made.stderr.strip()
    pushed = run(["git", "-C", repo, "push", "-q",
                  "--force-with-lease=refs/heads/%s:%s" % (branch, head),
                  "https://github.com/%s.git" % REPO_SLUG,
                  "%s:refs/heads/%s" % (made.stdout.strip(), branch)],
                 env=push_env(github))
    if pushed.returncode != 0:
        return "refused: " + tail(pushed.stderr + "\n" + pushed.stdout, 2)
    github.write("POST", "repos/%s/issues/%d/comments"
                 % (REPO_SLUG, decision["pr"]), body=STACK_UPDATE_NOTE % (
                     MAIN, head[:10], decision["after"],
                     decision["below"][:10], MAIN, MAIN, decision["after"],
                     SIGNATURE))
    return "done"


def tree_of(repo, commit, run=sh):
    """{path: (mode, blob)} for every file in `commit`, or None."""
    got = git(repo, "ls-tree", "-r", "-z", "--full-tree", commit, run=run)
    if got.returncode != 0:
        return None
    files = {}
    for entry in got.stdout.split("\0"):
        if entry:
            meta, path = entry.split("\t", 1)
            mode, _, blob = meta.split()
            files[path] = (mode, blob)
    return files


def merge_base(repo, one, other, run=sh):
    got = git(repo, "merge-base", one, other, run=run)
    return got.stdout.strip() if got.returncode == 0 else None


def review_paths(repo, approved, head, main_ref, run=sh):
    """[[kind, [path, ...]], ...] in `PATH_KINDS` order, leaving out
    empty kinds: where a re-review of `head` should start, as the
    module docstring says. [] when git can't answer."""
    main = merge_base(repo, head, main_ref, run)
    base = main and merge_base(repo, approved, main, run)
    trees = [tree_of(repo, c, run) for c in (base, approved, main, head)
             if base]
    if not trees or None in trees:
        return []
    b, a, m, h = trees
    found = {kind: [] for kind, _ in PATH_KINDS}
    for path in sorted(set(b) | set(a) | set(m) | set(h)):
        was, ours, theirs, now = (t.get(path) for t in (b, a, m, h))
        if ours != was:
            seen = now == ours and theirs in (was, ours)
        else:
            seen = now == theirs
        if seen:
            continue
        if now not in (ours, theirs):
            found["neither"].append(path)
        elif now == ours:
            found["approved"].append(path)
        else:
            found["main"].append(path)
    return [[kind, found[kind]] for kind, _ in PATH_KINDS if found[kind]]


def path_span(path):
    """`path` as an inert code span, at most `PATH_CHARS` long."""
    cut = path[:PATH_CHARS]
    shown = json.dumps(cut)[1:-1].replace("`", "\\u0060")
    return "`%s%s`" % (shown, "..." if len(path) > PATH_CHARS else "")


def paths_text(paths):
    """The hand-back's paragraph for `review_paths`' answer."""
    if not paths:
        return ""
    heads = dict(PATH_KINDS)
    lines = []
    for kind, names in paths:
        shown = ", ".join(path_span(n) for n in names[:PATHS_SHOWN])
        if len(names) > PATHS_SHOWN:
            shown += " and %d more" % (len(names) - PATHS_SHOWN)
        lines.append("* %s: %s" % (heads[kind], shown))
    return "Start the re-review with:\n\n%s\n\n" % "\n".join(lines)


def status_state(statuses):
    """(state, description) of the newest `STATUS_CONTEXT` status in
    `statuses`, as REST's commits/<sha>/statuses lists them (newest
    first), counting only those STATUS_CREATOR created; (None, "") when
    there is none."""
    for status in statuses:
        if (status.get("context") == STATUS_CONTEXT
                and (status.get("creator") or {}).get("login")
                == STATUS_CREATOR):
            return (status.get("state") or "unknown",
                    status.get("description") or "")
    return None, ""


def ci_problem(runs):
    """None if the CI workflow succeeded on the head, or the project has
    none, else why not. `runs` are REST's workflow runs for the head
    SHA. A cancelled run is excused only by a successful run of the same
    workflow on the same SHA. No run at all is a wait, not a pass: a
    project that names a workflow runs it on every pull request, so a
    head without one hasn't had it yet (Actions can lag); a run that
    never comes ends in STALLED."""
    if not CI_WORKFLOW:
        return None
    ours = [r for r in runs if r.get("name") == CI_WORKFLOW]
    if not ours:
        return "%s has not started on the head" % CI_WORKFLOW
    green = any(r.get("status") == "completed"
                and r.get("conclusion") == "success" for r in ours)
    for run in ours:
        if run.get("status") != "completed":
            continue
        if run.get("conclusion") in ("success", "skipped"):
            continue
        if run.get("conclusion") == "cancelled" and green:
            continue
        return "%s run %s concluded %s" % (CI_WORKFLOW, run.get("id"),
                                          run.get("conclusion"))
    if not green:
        pending = any(r.get("status") != "completed" for r in ours)
        return "%s has %s on the head" % (
            CI_WORKFLOW, "not finished" if pending else "no successful run")
    return None


def actions_started(github, head):
    """Whether GitHub Actions has any check run on `head`. The runs
    listing filtered by head SHA can lag well behind runs that exist,
    while the commit's check runs show their jobs at once. Anything but
    a check-runs answer reads as none."""
    try:
        got = github.api("repos/%s/commits/%s/check-runs?per_page=100"
                         % (REPO_SLUG, head))
    except RuntimeError:
        return False
    checks = got.get("check_runs") if isinstance(got, dict) else None
    return any(((c.get("app") or {}).get("slug") == "github-actions")
               for c in checks or [])


def never_started(repo, head, github, now, run=sh):
    """With `merge.ci_never_started`, the decision for a head on which
    no CI run is listed: WAIT while Actions shows it starting or the
    head is younger than the limit, else a hand-back to its author."""
    if actions_started(github, head):
        return {"action": "WAIT", "reason": "%s's run is not listed for "
                "the head yet, though its jobs have started" % CI_WORKFLOW}
    committed = git(repo, "log", "-1", "--format=%ct", head,
                    run=run).stdout.strip()
    age = now - datetime.datetime.fromtimestamp(
        int(committed or 0), datetime.timezone.utc)
    if age < CI_NEVER_STARTED:
        return {"action": "WAIT", "reason": "%s has not started on the "
                "head" % CI_WORKFLOW}
    return {"action": "HAND-BACK", "to": "author", "reason": (
        "%s never started on the head in %d minutes, which no approval "
        "changes; close and reopen it, which starts CI on the same head "
        "and keeps its approvals, or push a new head" % (
            CI_WORKFLOW, CI_NEVER_STARTED.total_seconds() // 60))}


def ci_stuck_reason():
    """The reason a pull request goes back to its author once a CI run
    on its head is still unfinished STALL_AFTER after the Merger re-ran
    it. It names no run or SHA, so it is said once per approval and
    head."""
    return ("the %s workflow has not finished on this head, even after "
            "the Merger re-ran it" % CI_WORKFLOW)


def not_own_failure(reason):
    """Whether a hand-back for `reason` is no failure of the pull
    request's own (GitHub lost its head, or never finished its CI), so
    it never counts toward `merge.yield_after_hand_back`."""
    return reason in (LOST_HEAD_REASON, ci_stuck_reason())


def run_jobs(github, run_id):
    """Every job of the CI run `run_id`'s latest attempt, all pages, or
    None when GitHub couldn't be asked."""
    try:
        jobs = github.api("--paginate", "repos/%s/actions/runs/%s/jobs"
                          "?per_page=100" % (REPO_SLUG, run_id),
                          "--jq", ".jobs")
    except (RuntimeError, ValueError):
        return None
    return jobs if isinstance(jobs, list) else None


def judge_runs(runs, github):
    """(runs, stale, unfinished) for the CI workflow's runs on the head.

    GitHub sometimes goes on reporting a run `queued` or `in_progress`
    long after every job in it has completed, and considers it finished
    itself (it refuses to cancel it). So each run of CI_WORKFLOW that
    says it is unfinished is judged by its jobs when they have all
    completed: finished, concluding `success` when every job concluded
    one of GREEN_JOBS, and otherwise the first other job's conclusion.
    `runs` comes back with those runs replaced by what their jobs say;
    `stale` lists them, as {"run", "status", "finished" (the latest job
    completion), "judged" ("green" or "red")}; `unfinished` lists the
    runs whose jobs haven't all completed either (or couldn't be read),
    as {"run", "status", "since" (the run's start)}."""
    judged, stale, unfinished = [], [], []
    for run in runs:
        if run.get("name") != CI_WORKFLOW or run.get("status") == "completed":
            judged.append(run)
            continue
        jobs = run_jobs(github, run.get("id"))
        if not jobs or any(j.get("status") != "completed" for j in jobs):
            unfinished.append({"run": run.get("id"),
                               "status": run.get("status"),
                               "since": run.get("run_started_at")
                               or run.get("created_at")})
            judged.append(run)
            continue
        red = [j.get("conclusion") or "unknown" for j in jobs
               if j.get("conclusion") not in GREEN_JOBS]
        stale.append({"run": run.get("id"), "status": run.get("status"),
                      "finished": max(j.get("completed_at") or ""
                                      for j in jobs) or "?",
                      "judged": "red" if red else "green"})
        judged.append(dict(run, status="completed",
                           conclusion=red[0] if red else "success"))
    return judged, stale, unfinished


def tail(text, lines=TAIL_LINES):
    return "\n".join((text or "").strip().splitlines()[-lines:])


def tool_problem(args, env, cwd, run=sh):
    """None if the tool in `args`, run in `cwd`, exits 0, else its last
    lines. `cwd` is the checkout the head was fetched into, since
    `forge-commit-identity` reads the range from the repository it runs
    in."""
    got = run(args, cwd=cwd, env=env)
    if got.returncode == 0:
        return None
    return "%s exited %d: %s" % (os.path.basename(args[0]), got.returncode,
                                 tail(got.stdout + "\n" + got.stderr))


def gate_problem(args, env, cwd, run=sh):
    """(problem, retry) for a gate tool: `tool_problem`'s answer, and
    whether the tool refused only for now (GATE_RETRY_EXIT)."""
    got = run(args, cwd=cwd, env=env)
    if got.returncode == 0:
        return None, False
    return ("%s exited %d: %s" % (os.path.basename(args[0]), got.returncode,
                                  tail(got.stdout + "\n" + got.stderr)),
            got.returncode == GATE_RETRY_EXIT)


def parse_pages(text):
    """`gh api`'s output as one value. With `--paginate`, gh prints one
    JSON document per page, so several arrays are joined into one;
    several documents of any other kind are refused rather than guessed
    at."""
    decoder, docs, at = json.JSONDecoder(), [], 0
    text = text or ""
    while True:
        while at < len(text) and text[at].isspace():
            at += 1
        if at == len(text):
            break
        value, at = decoder.raw_decode(text, at)
        docs.append(value)
    if not docs:
        return None
    if len(docs) == 1:
        return docs[0]
    if all(isinstance(d, list) for d in docs):
        return [item for d in docs for item in d]
    raise ValueError("%d JSON documents that are not all arrays" % len(docs))


class GitHub:
    """`gh api` with a token, as one place tests replace."""

    def __init__(self, token, run=sh):
        self.env = dict(os.environ, GH_TOKEN=token)
        self.run = run

    def api(self, *args):
        got = self.run(["gh", "api"] + list(args), env=self.env)
        if got.returncode != 0:
            raise RuntimeError("gh api %s: %s" % (args[0], got.stderr.strip()))
        return parse_pages(got.stdout)

    def write(self, method, path, **fields):
        """(True, "") when GitHub took the write, else (False, why). Never
        raises: a refused write is a fact for the record."""
        args = ["gh", "api", "-X", method, path]
        for key, value in sorted(fields.items()):
            args += ["-f", "%s=%s" % (key, value)]
        got = self.run(args, env=self.env)
        if got.returncode == 0:
            return True, ""
        return False, tail(got.stderr + "\n" + got.stdout, 2)

    def create(self, path, **fields):
        """(number, "") for what a POST to `path` created, else (None,
        why). Never raises, as `write`."""
        args = ["gh", "api", "-X", "POST", path, "--jq", ".number"]
        for key, value in sorted(fields.items()):
            args += ["-f", "%s=%s" % (key, value)]
        got = self.run(args, env=self.env)
        if got.returncode == 0 and got.stdout.strip().isdigit():
            return int(got.stdout.strip()), ""
        return None, tail(got.stderr + "\n" + got.stdout, 2)


def fetch_prs(github):
    """Every open pull request as a plain dictionary: GraphQL's node,
    with `reviews` and `comments` flattened to lists."""
    owner, name = REPO_SLUG.split("/")
    prs, cursor = [], None
    while True:
        args = ["graphql", "-f", "query=" + PR_QUERY, "-F", "owner=" + owner,
                "-F", "name=" + name]
        if cursor:
            args += ["-F", "cursor=" + cursor]
        page = github.api(*args)["data"]["repository"]["pullRequests"]
        for node in page["nodes"]:
            node["reviews"] = node["reviews"]["nodes"]
            node["comments"] = node["comments"]["nodes"]
            prs.append(node)
        if not page["pageInfo"]["hasNextPage"]:
            return prs
        cursor = page["pageInfo"]["endCursor"]


def fetch_open_issues(github):
    """Numbers of every open issue, for `Blocked-by:` lines that name
    one rather than a pull request."""
    got = github.api("--paginate", "repos/%s/issues?state=open&per_page=100"
                     % REPO_SLUG, "--jq", "[.[].number]")
    return set(got or [])


def decide(pr, approval, repo, main_tip, github, env, run=sh, below=(),
           regenerated=None, now=None, restack=None):
    """The action for one eligible pull request, as a dictionary with
    `action`, and `to` and `reason` for a hand-back. Reads, never
    writes. `below` and `regenerated` are passed to `covers_head`;
    `now` is the tick's clock. `restack`, for a stack's layer, is (the
    number of the layer below, which merged, and its final head): when
    `main` conflicts with the layer and the layer lacks that head, a
    clean merge of it is RESTACK (designs/0025)."""
    number, head = pr["number"], pr["headRefOid"]
    approver = APPROVERS.get(login(approval), "a reviewer")

    def back(to, reason):
        return {"action": "HAND-BACK", "to": to, "reason": reason}

    fetched = fetch_pr(repo, number, head, run)
    if fetched.returncode != 0:
        return {"action": "SKIP", "reason": "fetch failed: %s"
                % fetched.stderr.strip()}
    if git(repo, "rev-parse", PR_REF % number, run=run).stdout.strip() != head:
        return {"action": "SKIP", "reason": "the head moved while reading"}
    approved = (approval.get("commit") or {}).get("oid")
    if not approved:
        return back(approver, "the approval names no commit")
    main_ref = "refs/remotes/origin/" + MAIN
    covered, why = covers_head(repo, approved, head, main_ref, run, below,
                               regenerated)
    if covered is None:
        return {"action": "SKIP", "reason": why}
    if not covered:
        return dict(back(approver, why),
                    paths=review_paths(repo, approved, head, main_ref, run))
    if not is_ancestor(repo, main_tip, head, run):
        # GitHub refuses to update a head that conflicts with main, and
        # retrying it every tick would stall the queue behind it. Ask
        # git first: 1 is a conflict, and anything but 0 or 1 is git
        # failing, which leaves the question to GitHub and the backstop
        # in `tick`.
        merged = git(repo, "merge-tree", "--write-tree", "--name-only",
                     "--no-messages", main_tip, head, run=run)
        if merged.returncode == 1:
            if restack is not None and not is_ancestor(repo, restack[1],
                                                       head, run):
                after, lower = restack
                again = git(repo, "merge-tree", "--write-tree", "--name-only",
                            "--no-messages", head, lower, run=run)
                if again.returncode == 0:
                    return {"action": "RESTACK", "after": after,
                            "below": lower, "branch": pr["headRefName"]}
                if again.returncode == 1:
                    return dict(back("author", RESTACK_REASON % (
                        CONFLICT_REASON, after, lower[:10])),
                        detail=RESTACK_DETAIL % (after, lower[:10], MAIN))
            if restack is not None:
                after, lower = restack
                tree = based_merge(repo, main_tip, head, lower, run)
                if tree is not None:
                    return {"action": "STACK-UPDATE", "after": after,
                            "below": lower, "tree": tree,
                            "branch": pr["headRefName"]}
            rule = resolve_rule(conflicted_paths(merged.stdout))
            if RESOLVE and rule is not None:
                return {"action": "RESOLVE", "rule": rule}
            return back("author", CONFLICT_REASON)
        return {"action": "UPDATE"}
    state, said = status_state(github.api(
        "repos/%s/commits/%s/statuses?per_page=100" % (REPO_SLUG, head))
        or [])
    if state in (None, "pending"):
        return {"action": "WAIT", "reason": "%s is %s" % (
            STATUS_CONTEXT, state or "absent")}
    if state != "success":
        return back("author", "%s is %s%s" % (
            STATUS_CONTEXT, state, ": " + said if said else ""))
    problem, notes = None, {}
    if CI_WORKFLOW:
        runs = github.api("repos/%s/actions/runs?head_sha=%s&per_page=100"
                          % (REPO_SLUG, head))
        runs, stale, unfinished = judge_runs(
            (runs or {}).get("workflow_runs") or [], github)
        if stale:
            notes["ci_stale"] = stale
        problem = ci_problem(runs)
        if (CI_NEVER_STARTED is not None and problem
                and not any(r.get("name") == CI_WORKFLOW for r in runs)):
            return dict(never_started(repo, head, github, now or now_utc(),
                                      run), **notes)
    if problem and ("not finished" in problem or "not started" in problem):
        if unfinished:
            notes["ci_unfinished"] = unfinished
        return dict({"action": "WAIT", "reason": problem}, **notes)
    if problem:
        return dict(back("author", problem), **notes)
    for argv in GATE:
        problem, retry = gate_problem(
            gate_args(argv, repo, number, main_tip, head,
                      restack[0] if restack else None), env, repo, run)
        if problem:
            # A gate tool may read the description, so the hand-back is
            # for this one: a new description is a new question.
            if retry:
                notes.update(retry=True, at=iso(now or now_utc()))
            return dict(back("author", problem), text=description(pr),
                        **notes)
    if AHEAD_BATCH > 1 and COVERED_TEXT in said:
        notes["covered"] = True
    return dict({"action": "MERGE"}, **notes)


def gate_args(argv, repo, number, base, head, below=None):
    """A gate tool's argument list, filled in: `{pr}`, `{base}` and
    `{head}` in any argument, an argument that is exactly `{below}` by
    the number of the merged stack layer below (designs/0025), or by
    nothing when there is none, and the tool's path, from this
    installation for a `forge-` tool and from `repo` otherwise."""
    filled = [a.replace("{pr}", str(number)).replace("{base}", base)
              .replace("{head}", head) for a in argv
              if a != "{below}" or below is not None]
    filled = [str(below) if a == "{below}" else a for a in filled]
    tool = filled[0]
    if os.sep not in tool and tool.startswith("forge-"):
        filled[0] = os.path.join(BIN, tool)
    else:
        filled[0] = os.path.join(repo, tool)
    return filled


# What a hand-back for a conflict tells the author to do. Agents read
# "a reviewer approves a head that fixes it" as every reviewer, again,
# for every merge, and asked for approvals a clean merge never needed.
CONFLICT_ADVICE = (
    "Merge `main` into the branch rather than rebasing it. Once one "
    "reviewer approves the merge that resolves the conflict, the Merger "
    "takes it again. A merge git makes cleanly, with nothing resolved, "
    "needs no new approval: the approval of the head before it still "
    "covers it, and the Merger merges `main` in itself that way.")

# The queue as the tick that posts a hand-back sees it, for
# `others_text`: set by `tick` before it acts.
QUEUE_VIEW = {}


def others_text(number, view=None):
    """For a hand-back of pull request `number`: its author's other open
    pull requests,
    oldest first, each with its place in the queue or why it is held, so
    they fix the one nearest the front first and can see which to stack
    on which. "" when they have none."""
    view = QUEUE_VIEW if view is None else view
    queue = view.get("queue") or []
    held = {str(k): v for k, v in (view.get("held") or {}).items()}
    prs = view.get("prs") or ()
    author = next((login(p) for p in prs if p["number"] == number), "")
    lines = []
    for pr in sorted(prs, key=lambda p: p["number"]):
        if pr["number"] == number or login(pr) != author or not author:
            continue
        if pr["number"] in queue:
            where = "number %d of %d in the queue" % (
                queue.index(pr["number"]) + 1, len(queue))
        elif str(pr["number"]) in held:
            where = "held: %s" % held[str(pr["number"])]
        elif pr.get("isDraft"):
            where = "a draft"
        else:
            where = "not approved at its head yet"
        lines.append("* #%d: %s" % (pr["number"], where))
    if not lines:
        return ""
    return ("Your other open pull requests, oldest first:\n\n%s\n\n"
            "Fix the one nearest the front first. Two that change the same "
            "lines merge more easily as a stack, one based on the other's "
            "branch, than side by side.\n\n" % "\n".join(lines))


def hand_back_text(decision, approver):
    """The comment a hand-back posts. To the author it is plain, with the
    decision's `detail` when it has one; for a conflict, with what to
    do (CONFLICT_ADVICE) and their other open pull requests
    (`others_text`). To the approver it starts `Not-a-review`, since it
    asks for a review."""
    if decision["to"] == "author":
        detail = decision.get("detail")
        if decision["reason"].startswith(CONFLICT_REASON):
            return ("Not merging %s: %s.\n\n%sThis is back with its "
                    "author. %s\n\n%s%s" % (
                        decision["head"][:10], decision["reason"],
                        detail + "\n\n" if detail else "",
                        CONFLICT_ADVICE,
                        others_text(decision["pr"]),
                        SIGNATURE))
        return ("Not merging %s: %s.\n\n%sThis is back with its author. "
                "Once a reviewer approves a head that fixes it, the Merger "
                "takes it again.\n\n%s" % (decision["head"][:10],
                                             decision["reason"],
                                             detail + "\n\n" if detail
                                             else "", SIGNATURE))
    return ("Not-a-review\n\nNot merging %s: %s. The approval doesn't "
            "cover the head, so this needs %s's approval of it.\n\n%s%s"
            % (decision["head"][:10], decision["reason"], approver,
               paths_text(decision.get("paths")), SIGNATURE))


def hand_back_key(approval, head, reason, text=None):
    """What `handed-back.json` keeps per pull request: the hand-back
    already said for this approval, head and reason, and for a
    `merge.gate` tool's refusal, the description (`description`) it
    was judged on."""
    key = {"approved": approval.get("submittedAt"), "head": head,
           "reason": reason}
    if text is not None:
        key["text"] = text
    return key


def description(pr):
    """A short hash of `pr`'s title and body: what a `merge.gate` tool
    that reads the description was given."""
    text = "%s\n%s" % (pr.get("title") or "", pr.get("body") or "")
    return hashlib.sha256(text.encode()).hexdigest()[:16]


def description_moved(before, pr):
    """Whether `before`, a hand-back from `handed-back.json`, was for a
    gate's refusal of another description than `pr` has now: the
    author's fix for a closing keyword is a new description, at the
    same head and approval. A record without one keeps the head and
    approval as its only key."""
    return bool(before.get("text")) and before["text"] != description(pr)


def carry_out(decision, approval, github, said):
    """Do what `decision` says, as `github`'s App, and return the result
    for the record, or None for an action that writes nothing. `said`
    maps a pull request's number, as a string, to the approval, head
    and reason it was last handed back for; a hand-back already said is
    not said again. The approval is part of the key: a new approval of
    an unchanged head that still fails is a new question, so it gets
    its own answer."""
    number, head = decision["pr"], decision["head"]
    approver = APPROVERS.get(login(approval), "a reviewer")
    path = "repos/%s/pulls/%d" % (REPO_SLUG, number)
    if decision["action"] == "UPDATE":
        ok, why = github.write("PUT", path + "/update-branch",
                               expected_head_sha=head)
        if ok:
            # Without it the approvals look stale on GitHub, and authors
            # asked every reviewer to approve again. Its failure changes
            # nothing: the update stands.
            github.write("POST", "repos/%s/issues/%d/comments"
                         % (REPO_SLUG, number), body=UPDATE_NOTE % (
                             MAIN, head[:10], SIGNATURE))
    elif decision["action"] == "RESTACK":
        # GitHub's merges API takes no lease on the head: a push between
        # reading it and this write is merged with, and judged afresh.
        lower = decision["below"]
        ok, why = github.write(
            "POST", "repos/%s/merges" % REPO_SLUG, base=decision["branch"],
            head=lower, commit_message="Merge #%d's final head %s into %s" % (
                decision["after"], lower[:10], decision["branch"]))
        if ok:
            github.write("POST", "repos/%s/issues/%d/comments"
                         % (REPO_SLUG, number), body=RESTACK_NOTE % (
                             decision["after"], lower[:10], head[:10],
                             decision["after"], MAIN, SIGNATURE))
    elif decision["action"] == "MERGE":
        ok, why = github.write("PUT", path + "/merge", sha=head,
                               merge_method="squash")
    elif decision["action"] == "RETARGET":
        ok, why = github.write("PATCH", path, base=MAIN)
    elif decision["action"] == "HAND-BACK":
        key = hand_back_key(approval, head, decision["reason"],
                            decision.get("text"))
        if decision.get("retry"):
            # A refusal for now: kept with when it was asked, so that
            # `handed_back` asks again GATE_RETRY later. Refused again
            # the same way, it is not said again; only the time moves.
            key["retry"] = True
            asked = dict(key, at=decision.get("at") or iso(now_utc()))
        before = said.get(str(number))
        if isinstance(before, dict) and \
                {k: v for k, v in before.items() if k != "at"} == key:
            if decision.get("retry"):
                said[str(number)] = asked
            return "already said"
        ok, why = github.write(
            "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG, number),
            body=hand_back_text(decision, approver))
        if ok:
            said[str(number)] = asked if decision.get("retry") else key
    else:
        return None
    return "done" if ok else "refused: " + why


def load_json(path, default):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def save_json(path, value):
    with open(path + ".tmp", "w") as handle:
        json.dump(value, handle, sort_keys=True)
    os.replace(path + ".tmp", path)


def stalled_for(state_dir, waiting, when, check_state=None):
    """Whole minutes the Merger has waited on `waiting`'s head, once that
    is `STALL_AFTER` or more, else None. `waiting` is the tick's WAIT
    decision or a write GitHub refused, or None when the tick is held up
    by nothing, which forgets the wait. The wait is timed per pull
    request and head, so a new head or a different pull request starts
    it again.

    With `merge.queued_stall_minutes` and `check_state`, the build
    check's state, a WAIT is judged by where the check has the head:
    queued (waiting, not started), a stall only after
    QUEUED_STALL_AFTER; running, a stall once STALL_AFTER has passed
    since the later of the wait's start and the run's; neither, as
    without it."""
    path = os.path.join(state_dir, "waiting.json")
    if waiting is None:
        if os.path.exists(path):
            os.remove(path)
        return None
    since = load_json(path, {})
    try:
        began = datetime.datetime.strptime(
            since["since"], "%Y-%m-%dT%H:%M:%SZ").replace(
                tzinfo=datetime.timezone.utc)
        same = (since["pr"], since["head"]) == (waiting["pr"],
                                                 waiting["head"])
    except (KeyError, TypeError, ValueError):
        same = False
    if not same:
        began = when
        save_json(path, {"pr": waiting["pr"], "head": waiting["head"],
                         "since": iso(when)})
    waited = when - began
    limit, since = STALL_AFTER, began
    queue = (check_state or {}).get("waiting")
    entry = queue.get(waiting["head"]) if isinstance(queue, dict) else None
    if (QUEUED_STALL_AFTER is not None and waiting.get("action") == "WAIT"
            and isinstance(entry, dict)):
        try:
            started = parse_time(entry.get("started"))
        except (TypeError, ValueError):
            started = None
        if started is None:
            limit = QUEUED_STALL_AFTER
        else:
            since = max(began, started)
    if waiting.get("action") == "WAIT":
        top = batch_top_started(state_dir, waiting, check_state)
        if top is not None:
            limit, since = STALL_AFTER, max(since, top)
    if when - since < limit:
        return None
    return int(waited.total_seconds() // 60)


def batch_top_started(state_dir, waiting, check_state):
    """When the build check started the top of the batch `waiting`'s
    head is first in, by the last tick's AHEAD_FILE and the check's
    `ahead_started`, or None: not first in a batch, or its top not
    started. Such a head is never checked on its own: it waits for the
    top, whose tree includes it (designs/0032), so its wait is timed
    from the top's start, as a head the check runs is from its own."""
    started = (check_state or {}).get("ahead_started")
    if not isinstance(started, dict):
        return None
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    entries = last.get("entries") if isinstance(last, dict) else None
    batch = last.get("batch") if isinstance(last, dict) else None
    try:
        size = int((batch or {}).get("size") or 0)
        first, top = entries[0], entries[size - 1]
        if size < 1 or (first["pr"], first["head"]) != (waiting["pr"],
                                                         waiting["head"]):
            return None
        return parse_time(started.get(top["sha"]))
    except (AttributeError, IndexError, KeyError, TypeError, ValueError):
        return None


def where_to_look():
    """Where a wait that never ends is looked into: the build check, on
    its host, and the CI workflow, when the project names them."""
    return "the build check%s%s" % (
        " on " + BUILD_HOST if BUILD_HOST else "",
        ", or the %s workflow in GitHub Actions" % CI_WORKFLOW
        if CI_WORKFLOW else "")


def short(sha):
    return (sha or "?")[:12]


def lost_text(lost):
    """What GitHub said the pull request's head and its branch are, for a
    write it refused because the head it expected didn't match, from
    `lost_head`'s record (None when they couldn't be read)."""
    if not lost:
        return ("GitHub's pull request head and its branch could not be "
                "read")
    if lost["github"] == lost["branch"]:
        return ("GitHub's pull request head and its branch agree, at %s"
                % short(lost["github"]))
    nudge = lost.get("nudge") or ""
    if nudge.startswith("refused"):
        after = "a no-op base update to make GitHub read it again was " + nudge
    else:
        after = "a no-op base update didn't make GitHub read it again"
    return ("GitHub's pull request head is %s but its branch is at %s, and %s"
            % (short(lost["github"]), short(lost["branch"]), after))


def refusal_hint(stalled):
    """What a stall on a refused write says to do about it: the Merger
    App's access only when GitHub refused it as such (401, 403)."""
    if "lost" in stalled:
        return lost_text(stalled["lost"])
    if ACCESS_RE.search(stalled["refused"]):
        return "look at the Merger App's access"
    return "GitHub's answer says why"


def stall_text(stalled, reason=None):
    """What a stall is, for the issue and the message: the pull request,
    the head, how long, and GitHub's own words when it refused. `reason`
    is the WAIT decision's, when it is a wait."""
    if "refused" in stalled:
        hint = refusal_hint(stalled)
        what = ("GitHub has refused the Merger's write for %d minutes, "
                "most recently:\n\n```\n%s\n```\n\n%s." % (
                    stalled["minutes"], stalled["refused"],
                    hint[0].upper() + hint[1:]))
    else:
        what = ("it has waited %d minutes%s; look at %s."
                % (stalled["minutes"], ": " + reason if reason else "",
                   where_to_look()))
    if stalled.get("handed_back"):
        then = ("It has gone back to its author, and the queue moves past "
                "it.")
    else:
        then = ("It stays first in the queue, so nothing behind it merges "
                "until this clears.")
    return ("The merge queue is stalled on #%d at `%s`: %s\n\n%s"
            % (stalled["pr"], stalled["head"][:10], what, then))


def ended_by(pr, decisions):
    """How the stall on `pr` ended, from this tick's decisions."""
    for d in decisions:
        if d["pr"] == pr:
            return "this tick's %s of #%d" % (d["action"], pr)
    return "#%d is no longer first in the queue" % pr


def label_path(number, label=None):
    """The REST path of issue `number`'s labels, or of one of them. A
    label is a path segment there, so it is quoted: one may hold a
    space or a slash."""
    path = "repos/%s/issues/%d/labels" % (REPO_SLUG, number)
    return path + "/" + urllib.parse.quote(label, safe="") if label else path


def end_stall(state_dir, github, alert, decisions, out):
    """Comment how the stall in `alert` ended, take the owner's label
    off if it was put on, close its issue and forget it. The issue is
    forgotten even when GitHub refuses: closing it again on every tick
    would say the same thing each time, and a person can close it."""
    number = alert["issue"]
    github.write("POST", "repos/%s/issues/%d/comments" % (REPO_SLUG, number),
                 body="The stall has ended: %s.\n\n%s"
                 % (ended_by(alert["pr"], decisions), SIGNATURE))
    if alert.get("to_owner"):
        github.write("DELETE", label_path(number, WAITING_OWNER))
    ok, why = github.write("PATCH", "repos/%s/issues/%d" % (REPO_SLUG, number),
                           state="closed")
    out("STALL-ENDED: closed #%d" % number if ok
        else "STALL-ENDED: #%d could not be closed: %s" % (number, why))
    path = os.path.join(state_dir, STALL_ALERT_NAME)
    if os.path.exists(path):
        os.remove(path)


def tell_stall(state_dir, github, stalled, decisions, when, send, out,
               reason=None):
    """A stall opens its own issue and messages STALL_TELL, again every
    STALL_RETELL while it lasts, adds WAITING_OWNER after STALL_TO_OWNER,
    and closes the issue when it ends. `stalled` is the tick's record of
    it, or None when nothing is stalled; `send` is a function (agent
    name, text) -> None when the relay took the message, else why not,
    or None to message nobody.

    Its own issue, so no wait recorded on another item can hide it. The
    message repeats because an agent that restarted has lost the first
    one. Nothing here raises: what GitHub refused is printed and tried
    again on the next tick, labels included, so the router can always
    see whose the issue is. A message is tried again on the next tick
    only if nobody took it; once anyone has, the rest hear again
    STALL_RETELL later."""
    path = os.path.join(state_dir, STALL_ALERT_NAME)
    alert = load_json(path, {})
    same = stalled is not None and (alert.get("pr"), alert.get("head")) == (
        stalled["pr"], stalled["head"])
    if alert.get("issue") and not same:
        end_stall(state_dir, github, alert, decisions, out)
        alert = {}
    if stalled is None:
        if os.path.exists(path):
            os.remove(path)
        return
    text = stall_text(stalled, reason)
    if not same:
        number, why = github.create(
            "repos/%s/issues" % REPO_SLUG,
            title=STALL_TITLE.replace("{pr}", str(stalled["pr"])),
            body="%s\n\nThe Merger closes this when the stall ends.\n\n%s"
            % (text, SIGNATURE))
        if number is None:
            # Nothing is saved, so the next tick opens it again.
            out("STALL-ISSUE refused: %s" % why)
            return
        out("STALL-ISSUE: opened #%d" % number)
        alert = {"pr": stalled["pr"], "head": stalled["head"],
                 "issue": number, "labeled": []}
    number = alert["issue"]
    labeled = alert.setdefault("labeled", list(STALL_LABELS))
    for label in STALL_LABELS:
        if label in labeled:
            continue
        ok, why = github.write("POST", label_path(number),
                               **{"labels[]": label})
        if ok:
            labeled.append(label)
        else:
            out("STALL-LABEL refused: %s on #%d: %s" % (label, number, why))
    if (not alert.get("to_owner")
            and datetime.timedelta(minutes=stalled["minutes"])
            >= STALL_TO_OWNER):
        ok, why = github.write("POST", label_path(number),
                               **{"labels[]": WAITING_OWNER})
        if ok:
            alert["to_owner"] = True
            out("STALL-TO-OWNER: labeled #%d %s" % (number, WAITING_OWNER))
        else:
            out("STALL-LABEL refused: %s on #%d: %s"
                % (WAITING_OWNER, number, why))
    try:
        due = when - parse_time(alert["told"]) >= STALL_RETELL
    except (KeyError, TypeError, ValueError):
        due = True
    # No sender, no message: only `main` passes the relay, so a test
    # that ticks through a stall never messages a real agent.
    if send is not None and STALL_TELL and due:
        message = "From: %s\n%s\n\nIssue: #%d.\n%s" % (ACT_AS, text, number,
                                                       SIGNATURE)
        confirmed, problems = [], []
        for name in STALL_TELL:
            problem = send(name, message)
            if problem:
                problems.append("%s: %s" % (name, problem))
            else:
                confirmed.append(name)
        if confirmed:
            alert["told"] = iso(when)
        out("STALL-TOLD: %s%s" % (",".join(confirmed) or "nobody",
                                   "; " + "; ".join(problems)
                                   if problems else ""))
    save_json(path, alert)


def parse_time(stamp):
    return datetime.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(
        tzinfo=datetime.timezone.utc)


def load_router():
    """bin/forge-router as a module, loaded when needed: it loads this
    file itself, so it can't be imported at the top."""
    loader = importlib.machinery.SourceFileLoader(
        "forge_router", os.path.join(BIN, "forge-router"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def relay_sender(project, environ, opener=None):
    """A function (agent name, text) -> None when the relay took the
    message, else why not: the router's own poster, configured from the
    same `relay` section and addressed to each of the agent's sessions
    (hers and her twins', or her stand-in's when she is `away`), so the
    two can't diverge. Taken by any one
    session is taken."""
    router = load_router()
    router.configure(project, rules=False)
    post = router.make_poster(environ.get("FORGE_ROUTER_RELAY", router.RELAY),
                              router.relay_token(),
                              *([opener] if opener else []))

    def send(name, text):
        problems = []
        for session in (project.sessions(project.stand_in(name))
                        if name in project.agents else [name]):
            why = post(session, text)
            if why is None:
                return None
            problems.append(why)
        return "; ".join(problems)
    return send


def conflict_hand_back(pr, approval, github, said, live,
                       reason=CONFLICT_REASON, detail=None):
    """The hand-back for a head GitHub refused to update as a conflict:
    to the author, like a conflict git found. With another `reason`, the
    hand-back for a head GitHub goes on refusing, with `detail` in its
    comment."""
    decision = {"action": "HAND-BACK", "to": "author",
                "reason": reason, "pr": pr["number"],
                "head": pr["headRefOid"]}
    if detail:
        decision["detail"] = detail
    if live:
        decision["result"] = carry_out(decision, approval, github, said)
    return decision


def lost_head(decision, github, state_dir, out):
    """For a write GitHub refused because the head it expected didn't
    match: {"github", "branch", "now"}, the head GitHub holds for the
    pull request, the commit its branch is at, and the head GitHub holds
    after any nudge; None when GitHub couldn't be asked.

    GitHub sometimes moves a branch (its own update's merge commit lands
    on it) and never moves the pull request's head, and then refuses
    every write pinned to either. Setting the pull request's base to the
    base it has changes nothing but makes GitHub read the head again.
    The Merger does that once per pull request and head GitHub holds
    (RESYNC_FILE), reads the pull request again, prints one `RESYNC`
    line and adds `nudge`, "done" or "refused: ...", to the record.
    A head GitHub holds that isn't `decision`'s is a changed pull
    request, nudged or not."""
    number = decision["pr"]
    path = "repos/%s/pulls/%d" % (REPO_SLUG, number)
    try:
        pull = github.api(path)
        held = pull["head"]["sha"]
        ref = github.api("repos/%s/git/ref/heads/%s" % (
            pull["head"]["repo"]["full_name"],
            urllib.parse.quote(pull["head"]["ref"], safe="/")))
        branch = ref["object"]["sha"]
        base = pull["base"]["ref"]
    except (RuntimeError, KeyError, TypeError, ValueError, AttributeError):
        return None
    lost = {"github": held, "branch": branch, "now": held}
    if held == branch:
        return lost
    resync_path = os.path.join(state_dir, RESYNC_FILE)
    done = load_json(resync_path, {})
    if not isinstance(done, dict):
        done = {}
    before = done.get(str(number))
    if isinstance(before, dict) and before.get("head") == held:
        lost["nudge"] = before.get("result") or "done"
        return lost
    ok, why = github.write("PATCH", path, base=base)
    lost["nudge"] = "done" if ok else "refused: " + why
    done[str(number)] = {"head": held, "result": lost["nudge"]}
    save_json(resync_path, done)
    if ok:
        try:
            lost["now"] = github.api(path)["head"]["sha"]
        except (RuntimeError, KeyError, TypeError, ValueError):
            pass
        out("RESYNC #%d: GitHub had head %s, branch is at %s; nudged with a "
            "no-op base update, and GitHub now has %s"
            % (number, short(held), short(branch), short(lost["now"])))
    else:
        out("RESYNC #%d: GitHub had head %s, branch is at %s; the no-op "
            "base update was refused: %s"
            % (number, short(held), short(branch), why))
    return lost


def ci_rerun(decision, github, state_dir, when, live, out):
    """For a WAIT on CI runs GitHub has unfinished, jobs and all
    (`decision["ci_unfinished"]`, see `judge_runs`): None to go on
    waiting, or the detail of a hand-back when waiting is no use.

    A run unfinished for STALL_AFTER since it started is re-run, once
    per pull request and head (RERUN_FILE), with one `CI-RERUN` line,
    and `rerun` ("done" or "refused: ...") added to the decision. A
    dry run only says it would, and writes nothing. If the head's CI is
    still unfinished STALL_AFTER after that re-run, nothing more the
    Merger does will finish it: the answer is the hand-back's detail,
    and the queue moves past the pull request."""
    number, head = decision["pr"], decision["head"]
    path = os.path.join(state_dir, RERUN_FILE)
    done = load_json(path, {})
    if not isinstance(done, dict):
        done = {}
    before = done.get(str(number))
    if isinstance(before, dict) and before.get("head") == head:
        decision["rerun"] = before.get("result") or "done"
        try:
            at = parse_time(before["at"])
        except (KeyError, TypeError, ValueError):
            return None
        if when - at < STALL_AFTER:
            return None
        return ("GitHub has reported %s run %s unfinished, its jobs too, "
                "since %s; the Merger re-ran it at %s (%s), and it still "
                "hasn't finished. A push to the branch starts CI afresh, and "
                "if the run does finish green, the Merger takes it again"
                % (CI_WORKFLOW, before.get("run"), before.get("since") or "?",
                   before["at"], decision["rerun"]))
    for stuck in decision.get("ci_unfinished") or ():
        try:
            since = parse_time(stuck["since"])
        except (KeyError, TypeError, ValueError):
            continue
        if when - since < STALL_AFTER:
            continue
        minutes = int((when - since).total_seconds() // 60)
        if not live:
            out("CI-RERUN #%d: GitHub says run %s is %s, and so are its "
                "jobs, after %d minutes; a live tick would re-run it"
                % (number, stuck["run"], stuck["status"], minutes))
            return None
        ok, why = github.write("POST", "repos/%s/actions/runs/%s/rerun"
                               % (REPO_SLUG, stuck["run"]))
        decision["rerun"] = "done" if ok else "refused: " + why
        done[str(number)] = {"head": head, "run": stuck["run"],
                             "since": stuck["since"], "at": iso(when),
                             "result": decision["rerun"]}
        save_json(path, done)
        out("CI-RERUN #%d: GitHub says run %s is %s, and so are its jobs, "
            "after %d minutes; %s" % (
                number, stuck["run"], stuck["status"], minutes,
                "re-ran it, once for this head" if ok
                else "re-running it was refused: " + why))
        return None
    return None


def early_conflicts(repo, main_tip, rest, approvals, github, said, live,
                    run=sh, layers=()):
    """merge.early_conflicts: the hand-backs for the candidates the tick
    didn't reach (`rest`, behind the one it stopped at) whose heads
    conflict with main. Without it, such a pull request is told only
    when it reaches the front, which in a busy queue can be hours after
    the merge that made the conflict, hours its author could have spent
    on the fix. One already told of a conflict for this approval and
    head is skipped, whatever the words, and so is one git can't compare
    (it is decided when it is reached, as before). So is a stack's layer
    (`layers`): the Merger restacks it when it is reached, and its own
    hand-back says which merge conflicted. Told the plain conflict here,
    a layer's two hand-backs replaced each other in `said` and each was
    posted again, every tick."""
    decisions = []
    for pr in rest:
        approval = approvals[pr["number"]]
        before = said.get(str(pr["number"])) or {}
        key = hand_back_key(approval, pr["headRefOid"], CONFLICT_REASON)
        if (pr["number"] in layers
                or ({k: before.get(k) for k in ("approved", "head")}
                    == {k: key[k] for k in ("approved", "head")}
                    and (before.get("reason") or "").startswith(
                        CONFLICT_REASON))):
            continue
        have_head(repo, pr, run)
        if is_ancestor(repo, main_tip, pr["headRefOid"], run):
            continue
        if git(repo, "merge-tree", "--write-tree", "--name-only",
               "--no-messages", main_tip, pr["headRefOid"],
               run=run).returncode != 1:
            continue
        decision = conflict_hand_back(pr, approval, github, said, live)
        decision["early"] = True
        decisions.append(decision)
    return decisions


def checked_ahead(state_dir, repo, pr, approval, main_tip, env, run=sh,
                  regenerated=None, when=None):
    """designs/0035, fourth amendment: (to, reason) when `pr` would be
    handed back at merge time for something its place in the queue
    doesn't change (its approval doesn't cover its head, or a
    `merge.gate` tool refuses it), else None. Checked once per head,
    approved commit, title and body (CHECKED_FILE); merge time checks
    again, as before. A gate's refusal for now (GATE_RETRY_EXIT) comes
    back as (to, reason, True) and is checked again GATE_RETRY after
    `when`, the clock it was checked by."""
    approved = (approval.get("commit") or {}).get("oid")
    approver = APPROVERS.get(login(approval), "a reviewer")
    if not approved:
        return approver, "the approval names no commit"
    key = "%s %s %s" % (pr["headRefOid"], approved, description(pr))
    path = os.path.join(state_dir, CHECKED_FILE)
    checked = load_json(path, {})
    entry = checked.get(str(pr["number"]))
    if isinstance(entry, dict) and entry.get("key") == key \
            and not retry_due(entry, when):
        return tuple(entry["failed"]) if entry.get("failed") else None
    if fetch_pr(repo, pr["number"], pr["headRefOid"], run).returncode != 0:
        return None
    covered, why = covers_head(repo, approved, pr["headRefOid"],
                               "refs/remotes/origin/" + MAIN, run, (),
                               regenerated)
    if covered is None:
        return None
    failed, retry = (None if covered else (approver, why)), False
    for argv in GATE if failed is None else ():
        problem, retry = gate_problem(
            gate_args(argv, repo, pr["number"], main_tip, pr["headRefOid"]),
            env, repo, run)
        if problem:
            failed = ("author", problem, True) if retry else \
                ("author", problem)
            break
    checked[str(pr["number"])] = {"key": key, "failed": failed}
    if failed and retry and when is not None:
        checked[str(pr["number"])].update(retry=True, at=iso(when))
    save_json(path, checked)
    return failed


def handed_back(said, pr, approval, when=None):
    """Whether `pr` was handed back under the approval it has now, at the
    head it has now, and for a gate's refusal, with the description it
    has now: it would only be handed back again, so it is not
    predicted. A gate's refusal for now (GATE_RETRY_EXIT) stops counting
    GATE_RETRY after it was last asked, by the clock `when`, so that the
    gate is asked again. Seen on 2026-10-28: refused because GitHub had
    not yet linked a declared issue, a pull request stayed out of every
    prediction for over an hour after the link appeared."""
    before = said.get(str(pr["number"])) or {}
    return bool(before.get("approved")) and \
        before["approved"] == approval.get("submittedAt") and \
        before.get("head") == pr["headRefOid"] and \
        not description_moved(before, pr) and \
        not retry_due(before, when)


def retry_due(before, when):
    """Whether `before`, a hand-back from `handed-back.json` or an entry
    of `checked.json`, was a gate's refusal for now that is due to be
    asked again at `when`. Without a clock, never."""
    if not before.get("retry") or when is None:
        return False
    try:
        return when - parse_time(before["at"]) >= GATE_RETRY
    except (KeyError, TypeError, ValueError):
        return True


def ready_layers(repo, base, prs, open_numbers, when, said, run=sh,
                 regenerated=None, rules=None):
    """designs/0035: the layers stacked on `base`, climbing the stack,
    that would be eligible but for their base, each with an approval
    that covers its head, as [(pull request, approval)]. The first that
    isn't ready ends the climb, as does a layer with another beside it,
    since which goes first is the author's to say."""
    layers, below, numbers = [], base, {base["number"]}
    while True:
        above = [pr for pr in prs
                 if pr.get("baseRefName") == below.get("headRefName")]
        if len(above) != 1:
            return layers
        layer = above[0]
        approval, _ = eligible(layer, open_numbers - numbers, when,
                               any_base=True)
        oid = ((approval or {}).get("commit") or {}).get("oid")
        if not oid or handed_back(said, layer, approval, when):
            return layers
        have_head(repo, layer, run)
        if git(repo, "cat-file", "-e", oid + "^{commit}",
               run=run).returncode != 0 or not covers_head(
                repo, oid, layer["headRefOid"], "refs/remotes/origin/" + MAIN,
                run, (below["headRefOid"],), regenerated)[0]:
            return layers
        if rules and code_owner_wait(repo, layer, rules,
                                     "refs/remotes/origin/" + MAIN, run,
                                     regenerated):
            return layers
        layers.append((layer, approval))
        below = layer
        numbers.add(layer["number"])


def with_layers(queue, layers_of, last, size):
    """(queue, owed): `queue` with each pull request's ready layers
    (`layers_of(pr)`, from `ready_layers`) straight after it
    (designs/0035), and the numbers owed a place. `last` is the last
    tick's ahead.json, `size` the batch's. A layer doesn't join a batch
    already being run, which its prediction would change, unless it was
    predicted there already; and it may not push a pull request that is
    owed out of the first `size`. A pull request a layer pushes out of
    the first `size` is owed until a batch includes it."""
    last = last if isinstance(last, dict) else {}
    entries = [e for e in last.get("entries") or () if isinstance(e, dict)]
    before = {e.get("pr"): e.get("head") for e in entries}
    running = {e.get("pr") for e in
               entries[:(last.get("batch") or {}).get("size") or 0]}
    numbers = [pr["number"] for pr in queue]
    plain = numbers[:size]
    owed = [n for n in last.get("owed") or () if n in numbers]
    out, placed = [], set()
    for pr in queue:
        if pr["number"] in placed:
            continue
        out.append(pr)
        placed.add(pr["number"])
        for layer, _ in layers_of(pr):
            if layer["number"] in placed or (
                    pr["number"] in running
                    and before.get(layer["number"]) != layer["headRefOid"]):
                break
            batch = ([p["number"] for p in out] + [layer["number"]]
                     + [n for n in numbers if n not in placed])[:size]
            if any(n in plain and n not in batch for n in owed):
                break
            out.append(layer)
            placed.add(layer["number"])
    batch = {p["number"] for p in out[:size]}
    return out, [n for n in numbers
                 if n not in batch and (n in owed or n in plain)]


def have_head(repo, pr, run=sh):
    """Fetch `pr`'s head unless the checkout has it already: only the
    pull requests a tick decided on were fetched."""
    if git(repo, "cat-file", "-e", pr["headRefOid"] + "^{commit}",
           run=run).returncode != 0:
        fetch_pr(repo, pr["number"], pr["headRefOid"], run)


def conflicts_ahead(repo, queue, run=sh, main_ref=None):
    """{P: Q} for each pull request P in `queue` whose head conflicts
    with the head of a Q ahead of it, Q not itself held this way. The
    first is never held. A comparison git can't make (anything but 0 or
    1) holds nothing. With `main_ref`, one whose head conflicts with it
    is going back to its author, so nothing waits behind it: it is
    neither a Q nor held."""
    kept, held = [], {}
    for pr in queue:
        have_head(repo, pr, run)
        if main_ref and git(repo, "merge-tree", "--write-tree",
                            "--name-only", "--no-messages", main_ref,
                            pr["headRefOid"], run=run).returncode == 1:
            continue
        for q in kept:
            merged = git(repo, "merge-tree", "--write-tree", "--name-only",
                         "--no-messages", q["headRefOid"], pr["headRefOid"],
                         run=run)
            if merged.returncode == 1:
                held[pr["number"]] = q["number"]
                break
        if pr["number"] not in held:
            kept.append(pr)
    return held


def waiting_since(path, candidates, prs, when, save=True):
    """{pr: when a tick first saw it as a candidate} for `candidates`,
    remembered in `path` ({pr: {since, seen}}, written when `save`). An
    entry outlives a hand-back and a new head: a conflict is mostly what
    merged after the approval (designs/0037). It is dropped once its pull
    request isn't open, or hasn't been a candidate for AGE_FORGET."""
    open_numbers = {str(pr["number"]) for pr in prs}
    kept = {}
    for key, entry in load_json(path, {}).items():
        try:
            seen = parse_time(entry["seen"])
            parse_time(entry["since"])
        except (ValueError, TypeError, KeyError):
            continue
        if key in open_numbers and when - seen < AGE_FORGET:
            kept[key] = entry
    for pr in candidates:
        entry = kept.setdefault(str(pr["number"]), {"since": iso(when)})
        entry["seen"] = iso(when)
    if save:
        save_json(path, kept)
    return {pr["number"]: parse_time(kept[str(pr["number"])]["since"])
            for pr in candidates}


def overdue_first(queue, since, when, keep=None, members=()):
    """(`queue` with its overdue candidates first, {pr: minutes waited}
    for those): each that has waited AGE_FIRST since `since` says, the
    longest waiting first. Only `keep`, the one in flight, the members
    of a batch being merged and urgent ones stay ahead of them; the rest
    keep their order."""
    waited = {pr["number"]: when - since[pr["number"]] for pr in queue
              if pr["number"] in since}
    late = {n: w for n, w in waited.items() if w >= AGE_FIRST}
    if not late:
        return queue, {}
    zero = datetime.timedelta(0)
    queue = sorted(queue, key=lambda pr: (
        pr["number"] != keep, pr["number"] not in members,
        not urgent(pr), pr["number"] not in late,
        -late.get(pr["number"], zero)))
    return queue, {n: int(w.total_seconds() // 60) for n, w in late.items()}


def right_of_way(repo, prs, records, path, when, main_ref, run=sh,
                 save=True):
    """{pr, head, since} for the pull request that has right of way, or
    None. One handed back to its author for a conflict with main at
    ROW_AFTER heads in `records` has earned it; it has it for its head
    H while H is clean against `main_ref`, it wasn't handed back at H
    for anything else, and less than ROW_FOR has passed since a tick
    first saw H with it earned. `path` remembers that moment per pull
    request ({pr: {head, since}}), written when `save`. Of several, the
    first in the Merger's order has it."""
    counts = conflict_hand_backs(records)
    other = {(pr, head) for pr, head, reason in author_hand_backs(records)
             if reason != CONFLICT_REASON}
    earned = order([pr for pr in prs if counts.get(pr["number"], 0)
                    >= ROW_AFTER and not pr.get("isDraft")
                    and pr.get("baseRefName") == MAIN], prs)
    seen = {k: v for k, v in load_json(path, {}).items()
            if isinstance(v, dict) and k.isdigit()
            and any(pr["number"] == int(k) for pr in earned)}
    found = None
    for pr in earned:
        head, key = pr["headRefOid"], str(pr["number"])
        if (seen.get(key) or {}).get("head") != head:
            seen[key] = {"head": head, "since": iso(when)}
        if found or (pr["number"], head) in other:
            continue
        try:
            since = parse_time(seen[key]["since"])
        except (ValueError, TypeError, KeyError):
            continue
        if when - since >= ROW_FOR:
            continue
        have_head(repo, pr, run)
        if git(repo, "merge-tree", "--write-tree", "--name-only",
               "--no-messages", main_ref, head, run=run).returncode != 0:
            continue
        found = {"pr": pr["number"], "head": head, "since": iso(since)}
    if save:
        save_json(path, seen)
    return found


def codeowners_rules(repo, ref, run=sh):
    """[(pattern, [owner, ...]), ...] from the first CODEOWNERS file at
    `ref` (.github/, the root, docs/), in file order; [] when there is
    none."""
    for path in CODEOWNERS_PATHS:
        got = git(repo, "show", "%s:%s" % (ref, path), run=run)
        if got.returncode != 0:
            continue
        rules = []
        for line in got.stdout.splitlines():
            words = line.split("#", 1)[0].split()
            if words:
                rules.append((words[0], words[1:]))
        return rules
    return []


def codeowners_match(pattern, path):
    """Whether CODEOWNERS `pattern` covers `path`: gitignore's rules as
    GitHub applies them. A leading or inner `/` anchors it to the root,
    a trailing one makes it a directory's, `*` and `?` stay within a
    name and `**` crosses directories; a pattern also covers everything
    under a directory it names."""
    body = pattern.lstrip("/")
    directory = body.endswith("/")
    body = body.rstrip("/")
    anchored = pattern.startswith("/") or "/" in body
    out, i = [], 0
    while i < len(body):
        if body.startswith("**/", i):
            out.append("(?:.*/)?")
            i += 3
        elif body.startswith("**", i):
            out.append(".*")
            i += 2
        elif body[i] == "*":
            out.append("[^/]*")
            i += 1
        elif body[i] == "?":
            out.append("[^/]")
            i += 1
        else:
            out.append(re.escape(body[i]))
            i += 1
    regex = (("^" if anchored else "^(?:.*/)?") + "".join(out)
             + ("/.*$" if directory else "(?:/.*)?$"))
    return re.match(regex, path) is not None


def owners_of(path, rules):
    """The owners of `path`: the last matching rule's, [] for none."""
    owners = []
    for pattern, who in rules:
        if codeowners_match(pattern, path):
            owners = who
    return owners


def code_owner_wait(repo, pr, rules, main_ref, run=sh, regenerated=None):
    """Why `pr` waits for a code owner, or None. Each path it changes
    since `main_ref` that `rules` gives owners needs one of them: its
    author, or an owner whose newest review is `APPROVED` at a commit
    that covers the head. Owners are `@login`s; a team or an email
    can't be checked, so it is never satisfied."""
    head = pr["headRefOid"]
    have_head(repo, pr, run)
    got = git(repo, "diff", "--name-only", "%s...%s" % (main_ref, head),
              run=run)
    if got.returncode != 0:
        return "waits for a code owner: its changed paths can't be listed"
    latest = {}
    for review in pr["reviews"]:
        who = login(review).lower()
        if review.get("state") in ("APPROVED", "CHANGES_REQUESTED",
                                   "DISMISSED") and (
                who not in latest or review["submittedAt"]
                > latest[who]["submittedAt"]):
            latest[who] = review
    covered = {}

    def approved(owner):
        if owner == login(pr).lower():
            return True
        review = latest.get(owner)
        if not review or review.get("state") != "APPROVED":
            return False
        oid = (review.get("commit") or {}).get("oid")
        if oid not in covered:
            covered[oid] = bool(oid) and bool(covers_head(
                repo, oid, head, main_ref, run,
                regenerated=regenerated)[0])
        return covered[oid]
    waiting = {}
    for path in got.stdout.split():
        owners = owners_of(path, rules)
        logins = [o[1:].lower() for o in owners
                  if o.startswith("@") and "/" not in o]
        if owners and not any(approved(o) for o in logins):
            waiting.setdefault(" ".join(owners), []).append(path)
    if not waiting:
        return None
    who, paths = sorted(waiting.items())[0]
    more = sum(len(p) for p in waiting.values()) - 1
    return "waits for code owner %s: %s%s" % (
        who, paths[0], " and %d more" % more if more else "")


def conflicts_with(repo, head, queue, run=sh):
    """The pull requests in `queue` whose heads conflict with `head`.
    A comparison git can't make holds nothing."""
    held = []
    for pr in queue:
        have_head(repo, pr, run)
        if git(repo, "merge-tree", "--write-tree", "--name-only",
               "--no-messages", head, pr["headRefOid"],
               run=run).returncode == 1:
            held.append(pr["number"])
    return held


def row_text(head, ahead):
    """The comment a right-of-way hold posts: plain, to the author."""
    return ("Holding %s: it conflicts with #%d, which has right of way. "
            "#%d has been handed back again and again for conflicts with "
            "`main` as others merged, so for a while nothing that "
            "conflicts with it merges first.\n\nThis keeps its approval "
            "and is not handed back. Please leave it until #%d merges or "
            "its right of way ends, within %d minutes: then, if it "
            "conflicts with `main`, the Merger hands it back once.\n\n%s"
            % (head[:10], ahead, ahead, ahead,
               ROW_FOR.total_seconds() // 60, SIGNATURE))


def hold_text(head, ahead):
    """The comment a hold posts: plain, to the author, and not a
    hand-back, so it doesn't start `Not merging`."""
    return ("Holding %s: it conflicts with #%d, which is ahead of it in "
            "the queue.\n\nIt keeps its approval and is not handed back. "
            "Please leave it until #%d merges: then, if it conflicts with "
            "`main`, the Merger hands it back once, and one rebase covers "
            "both.\n\n%s" % (head[:10], ahead, ahead, SIGNATURE))


def tell_holds(state_dir, github, prs, held_by, live, row=()):
    """[{pr, head, behind, result}] for each hold. When `live`, each
    head and Q is said on its pull request once, `held-conflicting.json`
    remembering it; pull requests no longer open are forgotten. Those in
    `row` are held for right of way, which their entries say."""
    path = os.path.join(state_dir, HOLD_FILE)
    heads = {pr["number"]: pr["headRefOid"] for pr in prs}
    said = {k: v for k, v in load_json(path, {}).items()
            if k.isdigit() and int(k) in heads}
    told = []
    for number, ahead in sorted(held_by.items()):
        key = {"head": heads[number], "behind": ahead}
        if number in row:
            key["right_of_way"] = True
        entry = dict(key, pr=number)
        if live:
            if said.get(str(number)) == key:
                entry["result"] = "already said"
            else:
                ok, why = github.write(
                    "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG,
                                                           number),
                    body=(row_text if number in row else hold_text)(
                        heads[number], ahead))
                entry["result"] = "done" if ok else "refused: " + why
                if ok:
                    said[str(number)] = key
        told.append(entry)
    if live:
        save_json(path, said)
    return told


def spoken_text(approval, remark):
    """What the Merger says on a pull request it holds because `remark`
    (login, time, kind) came after `approval`."""
    who, when, kind = remark
    approver = APPROVERS.get(login(approval), login(approval))
    return ("Not-a-review\n\nHolding this: %s's %s at %s came after %s's "
            "approval, and anything said after an approval might be an "
            "objection. A newer approval releases it, so %s, if nothing "
            "needs to change, please approve again.\n\n"
            "Comments by the author, approvals and comments marked "
            "`Not-a-review` don't hold a pull request.\n\n%s"
            % (who, kind, when, approver, approver, SIGNATURE))


def tell_spoken(state_dir, github, prs, spoken, live):
    """[{pr, approved, said, result}] for each pull request held for a
    remark after its approval. When `live`, each approval and remark is
    said once, HELD_FILE remembering it; pull requests no longer open
    are forgotten."""
    path = os.path.join(state_dir, HELD_FILE)
    open_now = {str(pr["number"]) for pr in prs}
    said = {k: v for k, v in load_json(path, {}).items() if k in open_now}
    told = []
    for pr, approval, remark in spoken:
        number = pr["number"]
        key = {"approved": approval.get("submittedAt"), "said": remark[1]}
        entry = dict(key, pr=number)
        if live:
            if said.get(str(number)) == key:
                entry["result"] = "already said"
            else:
                ok, why = github.write(
                    "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG,
                                                           number),
                    body=spoken_text(approval, remark))
                entry["result"] = "done" if ok else "refused: " + why
                if ok:
                    said[str(number)] = key
        told.append(entry)
    if live:
        save_json(path, said)
    return told


def predict_ahead(repo, main_tip, queue, run=sh, depth=None,
                  overdue=()):
    """The commits the first `depth` + 1 pull requests in `queue`
    (default AHEAD_DEPTH) will have once those ahead of each have
    merged, as [{pr, head, sha, tree}], each also written as
    AHEAD_REF<k> in `repo`, and any ref past the last one deleted.

    S0 stands in for the first one's squash commit: the tree its update
    gives (its own tree when it is up to date), with `main_tip` as its
    parent. Each Sk is the next one's head merged onto S(k-1), with
    S(k-1) as its parent, which is what GitHub's update makes once the
    one before has merged. One that conflicts with what is ahead of it
    is left out and the list goes on past it (the next tick puts it
    behind the predicted ones: see `locked_order`), unless it is in
    `overdue` (designs/0037), when the list ends there, so that nothing
    is predicted past it; anything else git can't do ends the list. An
    entry whose tree is its head's own says `same_as_head`, since the
    head's own check tests it. The commits carry a fixed identity and
    date and no signature, so the same prediction is the same commit on
    every tick."""
    depth = AHEAD_DEPTH if depth is None else depth
    name, email = AHEAD_IDENTITY
    env = dict(os.environ, GIT_AUTHOR_NAME=name, GIT_AUTHOR_EMAIL=email,
               GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=email,
               GIT_AUTHOR_DATE=AHEAD_DATE, GIT_COMMITTER_DATE=AHEAD_DATE)
    entries, parent = [], main_tip
    for pr in queue:
        if len(entries) > depth:
            break
        head = pr["headRefOid"]
        have_head(repo, pr, run)
        merged = git(repo, "merge-tree", "--write-tree", "--no-messages",
                     parent, head, run=run)
        if merged.returncode == 1 and entries \
                and pr["number"] not in overdue:
            # It conflicts with one predicted ahead of it: skip it, so
            # that those behind it are still tested ahead.
            continue
        if merged.returncode != 0 or not merged.stdout.split():
            break
        tree = merged.stdout.split()[0]
        made = run(["git", "-C", repo, "commit-tree", "--no-gpg-sign", tree,
                    "-p", parent, "-m", "forge-merger: #%d ahead"
                    % pr["number"]], env=env)
        sha = (made.stdout or "").strip()
        if made.returncode != 0 or len(sha) != 40:
            break
        entry = {"pr": pr["number"], "head": head, "sha": sha, "tree": tree}
        own = git(repo, "rev-parse", head + "^{tree}", run=run)
        if own.returncode == 0 and own.stdout.strip() == tree:
            entry["same_as_head"] = True
        entries.append(entry)
        parent = sha
    listed = git(repo, "for-each-ref", "--format=%(refname)", AHEAD_REF,
                 run=run)
    stale = set(listed.stdout.split()) if listed.returncode == 0 else set()
    for k, entry in enumerate(entries):
        git(repo, "update-ref", AHEAD_REF + str(k), entry["sha"], run=run)
        stale.discard(AHEAD_REF + str(k))
    for ref in sorted(stale):
        git(repo, "update-ref", "-d", ref, run=run)
    return entries


def locked_order(state_dir, queue):
    """{number: place} for the candidates in `queue` that the last live
    tick predicted (AHEAD_FILE) at the head they still have, in its
    order. Their runs have started, so they keep their places ahead of
    every other candidate: one approved later, an older one approved
    again, or one newly labelled urgent goes behind them, rather than
    into the middle where it would spend every prediction behind it."""
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    entries = last.get("entries") if isinstance(last, dict) else None
    heads = {pr["number"]: pr["headRefOid"] for pr in queue}
    places = {}
    for entry in entries if isinstance(entries, list) else ():
        number = entry.get("pr") if isinstance(entry, dict) else None
        if (number is not None and number not in places
                and heads.get(number) == entry.get("head")):
            places[number] = len(places)
    return places


def current_batch(state_dir, queue):
    """(trees, members) of the batch the last tick (AHEAD_FILE) was
    merging: its batch while a member is still in `queue` at the head
    it was predicted at, else the first of its `later` batches while one
    of that is. Once a batch has merged, the one predicted on it comes
    next, and its top's run counts for it: on 2026-10-26 a layer went in
    front of a green later batch just after the batch below it merged.
    ([], set()) when there is none."""
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    if not isinstance(last, dict):
        return [], set()
    entries = last.get("entries")
    if not isinstance(entries, list):
        return [], set()
    heads = {pr["number"]: pr["headRefOid"] for pr in queue}
    batches = [last.get("batch")] + list((last.get("later") or [])[:1])
    for batch in batches:
        trees = batch.get("trees") if isinstance(batch, dict) else None
        if not isinstance(trees, list) or not trees:
            continue
        members = {e.get("pr") for e in entries
                   if isinstance(e, dict) and e.get("tree") in trees
                   and heads.get(e.get("pr")) is not None
                   and heads[e["pr"]] in (e.get("head"), e.get("sha"))}
        if members:
            return trees, members
    return [], set()


def green_batch(state_dir, queue, check_state):
    """Whether the batch being merged (current_batch) is green: its
    top's tree is. Between one member's merge and the next, no merge is
    in flight, but the batch is still merging: a layer that comes back
    then waits for the next batch, as it does while a merge is in
    flight, since joining in front would change every member's tree and
    spend the top's green."""
    trees, members = current_batch(state_dir, queue)
    return bool(members) and tree_verdict(check_state, trees[-1]) is True


def batch_members(state_dir, queue):
    """The pull requests of the batch being merged (current_batch) still
    in `queue` at the head they were predicted at."""
    return current_batch(state_dir, queue)[1]


def fixes_first(queue, in_flight, members):
    """`queue` with MAIN_RED_FIXES first, behind only `in_flight` and a
    green batch's `members` (designs/0011, amendment); the rest keep
    their order."""
    return sorted(queue, key=lambda pr: (
        pr["number"] != in_flight, pr["number"] not in members,
        pr["number"] not in MAIN_RED_FIXES))


def predicted(state_dir):
    """The pull requests the last live tick predicted (AHEAD_FILE), at
    any head."""
    last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
    entries = last.get("entries") if isinstance(last, dict) else None
    return {entry.get("pr") for entry in
            (entries if isinstance(entries, list) else ())
            if isinstance(entry, dict)}


def ahead_started(check_state, sha, tree):
    """Whether the build check has started a run of the prediction
    `sha`, or has a verdict on its tree."""
    started = (check_state or {}).get("ahead_started")
    return (isinstance(started, dict) and sha in started) \
        or tree_verdict(check_state, tree) is not None


def tree_verdict(check_state, tree):
    """The build check's verdict on `tree` from its state: True when a
    run of it, or a match to one, is green, False when it has only red
    ones, None when it has none. A batch's cover of a tree is not a run
    of it, so it doesn't count."""
    oks = [r.get("ok") is True
           for r in ((check_state or {}).get("results") or {}).values()
           if isinstance(r, dict) and r.get("tree") == tree
           and not r.get("covered")]
    return any(oks) if oks else None


def main_red_fixes(check_state):
    """The pull requests forge-pr-check found closing its open issue
    saying the default branch is red (`main_red.fixes`), as a
    frozenset; empty when no such issue is open (designs/0011,
    amendment)."""
    red = (check_state or {}).get("main_red")
    if not isinstance(red, dict) or not red.get("issue"):
        return frozenset()
    fixes = red.get("fixes")
    return frozenset(n for n in fixes if isinstance(n, int)
                     and not isinstance(n, bool)) \
        if isinstance(fixes, list) else frozenset()


def base_red_only(check_state, records, base):
    """The steps, sorted, when every one of the red verdicts `records`
    failed only steps that the default branch's own run of `base` failed
    too: the red is the base's (designs/0011, amendment). None when any
    is green or failed a step the base passed, or the base has no red
    run of its own."""
    results = (check_state or {}).get("results") or {}
    own = results.get(base) if isinstance(base, str) else None
    if not records or not isinstance(own, dict) or not own.get("main") \
            or own.get("ok") is not False:
        return None
    broken = set(own.get("failed") or ())
    steps = set()
    for r in records:
        failed = r.get("failed") if isinstance(r, dict) else None
        if r.get("ok") is not False or not failed \
                or not set(failed) <= broken:
            return None
        steps |= set(failed)
    return sorted(steps)


def tree_base_red(check_state, tree, base):
    """base_red_only for the runs of `tree` (not covers of it)."""
    return base_red_only(check_state, [
        r for r in ((check_state or {}).get("results") or {}).values()
        if isinstance(r, dict) and r.get("tree") == tree
        and not r.get("covered")], base)


def head_base_red(check_state, head):
    """base_red_only for the verdict on `head` merged with the default
    branch, against the tip it was merged with."""
    r = ((check_state or {}).get("results") or {}).get(head)
    if not isinstance(r, dict) or not r.get("base_red"):
        return None
    return base_red_only(check_state, [r], r.get("base"))


def urgent_cap(entries, at, n, urgents):
    """`n`, cut so the batch of the predictions `entries` from `at`
    doesn't mix urgent pull requests (`urgents`, numbers) with others
    (designs/0011, amendment, part 3): it ends where the first one's
    kind changes."""
    if not urgents or n < 2:
        return n
    first = entries[at]["pr"] in urgents
    for k in range(1, n):
        if (entries[at + k]["pr"] in urgents) != first:
            return k
    return n


def batch_size(entries, last, verdict, later=(), urgents=frozenset()):
    """(size, red): how many of the predictions `entries` are the batch
    (designs/0032), and the size before any red top split it, or None.
    The batch `last` (ahead.json's, its `trees`) goes on while what is
    left of it still leads the predictions: those that merged since are
    gone from its front, the rest are unchanged. Once it is gone, the
    first of the `later` batches (designs/0035 part 2) follows it if it
    was fixed and still leads them, since its top's run counts for it.
    Otherwise a new one is the first AHEAD_BATCH, ending at a tree
    already red. A red top halves it, rounding up, until the top isn't
    red or only one is left. `verdict(tree)` is `tree_verdict`'s
    answer."""
    trees = [e["tree"] for e in entries]
    size = 0
    for old in [(last or {}).get("trees") or []] + [
            b.get("trees") or [] for b in list(later)[:1]
            if isinstance(b, dict) and b.get("fixed")]:
        # What is left of it is a suffix of it that leads the trees. Not
        # found by its top's tree: two members can have the same one (a
        # change that adds nothing on top of the one before it).
        left = [k for k in range(len(old)) if old[k:] == trees[:len(old) - k]]
        if left:
            size = len(old) - left[0]
            break
    if not size:
        size = urgent_cap(entries, 0, min(AHEAD_BATCH, len(trees)), urgents)
        red = [k for k, t in enumerate(trees[:size]) if verdict(t) is False]
        if red:
            size = red[0] + 1
    red = None
    while size > 1 and verdict(trees[size - 1]) is False:
        red = red or size
        size = (size + 1) // 2
    return size, red


def later_batches(entries, size, last, verdict, started,
                  urgents=frozenset()):
    """designs/0035 part 2: the batches after the first `size` of the
    predictions `entries`, end to end, as [{size, trees, fixed?}], at
    most AHEAD_BATCHES - 1 of them. A batch of the last tick's (`last`,
    ahead.json's `later`) that was `fixed` keeps its size while its
    trees still come next; the first that isn't takes up to
    AHEAD_BATCH, so it grows at its end until its top's run starts
    (`started(sha, tree)`), and is fixed from then on. Nothing follows
    a red first batch, nor a later one whose top is red: each later
    tree contains it."""
    trees = [e["tree"] for e in entries]
    if size < 1 or verdict(trees[size - 1]) is False:
        return []
    fixed = [b["trees"] for b in (last or ())
             if isinstance(b, dict) and b.get("fixed")
             and isinstance(b.get("trees"), list) and b["trees"]]
    out, at = [], size
    while len(out) < AHEAD_BATCHES - 1 and at < len(trees):
        # Matched by its trees, not its place: the first of them moves
        # up once the batch before it has merged.
        kept = [t for t in fixed if trees[at:at + len(t)] == t]
        n = len(kept[0]) if kept else urgent_cap(
            entries, at, min(AHEAD_BATCH, len(trees) - at), urgents)
        top = entries[at + n - 1]
        batch = {"size": n, "trees": trees[at:at + n]}
        if kept or started(top["sha"], top["tree"]):
            batch["fixed"] = True
        out.append(batch)
        if verdict(top["tree"]) is False:
            break
        at += n
    return out


def batch_line(entries, size, red, verdict):
    """The BATCH line for a batch of `size` (designs/0032), or None
    when there is nothing to say: a red top split it, or its top is
    green and its members are merging."""
    if not entries:
        return None
    span = lambda n: "#%d..#%d" % (entries[0]["pr"], entries[n - 1]["pr"])
    if red:
        return "BATCH %s: top red, checking %s" % (span(red), span(size))
    if size > 1 and verdict(entries[size - 1]["tree"]) is True:
        return "BATCH %s: top %s green, merging %d" % (
            span(size), entries[size - 1]["sha"][:10], size)
    return None


def batch_holds(last, pr, tree, queue, check_state):
    """Whether the batch that covered pull request `pr`'s head (its
    tree `tree`) still holds (designs/0032): the last tick's ahead.json
    (`last`) names a batch with that tree, its top's tree is green, and
    every pull request in it after this one is still in `queue` at the
    head it was predicted at. A member is merged only then: otherwise
    the default branch's tip could become a tree no run tested."""
    batch = (last or {}).get("batch") or {}
    entries = ((last or {}).get("entries") or [])[:batch.get("size", 0)]
    if len(entries) < 2 or [e.get("tree") for e in entries] \
            != batch.get("trees"):
        return False
    at = [k for k, e in enumerate(entries)
          if e.get("pr") == pr and e.get("tree") == tree]
    if not at:
        return False
    heads = {p["number"]: p["headRefOid"] for p in queue}
    return (all(heads.get(e.get("pr")) == e.get("head")
                for e in entries[at[0] + 1:])
            and tree_verdict(check_state, entries[-1]["tree"]) is True)


def load_suspects(state_dir):
    """designs/0035, second amendment: the search in progress, from
    SUSPECTS_FILE, as {suspects: [{pr, head}], tree, merged, left,
    said?}, or None when there is none."""
    saved = load_json(os.path.join(state_dir, SUSPECTS_FILE), None)
    if not isinstance(saved, dict) or not isinstance(
            saved.get("suspects"), list):
        return None
    saved["suspects"] = [e for e in saved["suspects"]
                         if isinstance(e, dict) and isinstance(
                             e.get("pr"), int) and isinstance(
                             e.get("head"), str)]
    for key in ("merged", "left"):
        if not isinstance(saved.get(key), list):
            saved[key] = []
    return saved


def suspect_place(saved, queue):
    """{number: place} of the suspects in `queue` still at the head they
    were suspected at, in their order: they go first, so nothing joins
    in front of them or among them."""
    heads = {pr["number"]: pr["headRefOid"] for pr in queue}
    places = {}
    for e in (saved or {}).get("suspects") or ():
        if heads.get(e["pr"]) == e["head"] and e["pr"] not in places:
            places[e["pr"]] = len(places)
    return places


def suspect_cuts(trees, verdict, slots):
    """(green, red, cuts) for the suspects' prefixes, whose trees are
    `trees` in order (designs/0035, second amendment, section 2):
    `green` the longest prefix whose tree is green (0 for none), `red`
    the shortest longer one whose tree is red, or None, and `cuts` the
    prefix lengths to test now, evenly spaced between them. With
    `slots` (merge.test_ahead.batches) there are that many cut points
    and the last, the whole red set, isn't run; with one slot, one cut,
    designs/0032's halving. When no prefix is known red the whole set
    is one of the cuts."""
    n = len(trees)
    green = max([k for k in range(1, n + 1) if verdict(trees[k - 1])
                 is True], default=0)
    reds = [k for k in range(green + 1, n + 1)
            if verdict(trees[k - 1]) is False]
    red = reds[0] if reds else None
    runs = max(1, slots - 1)
    span = (red or n) - green
    parts = runs + 1 if red else runs
    cuts = sorted({green - (-span * k // parts) for k in range(1, parts + 1)})
    return green, red, [c for c in cuts
                        if green < c and (c < red if red else c <= n)]


def suspect_batches(green, cuts):
    """The batch's size and the `later` batches' sizes for a round of
    the search: the green prefix merges as the batch while the cuts
    after it run as later ones; with none green, the first cut is the
    batch."""
    ends = ([green] if green else []) + list(cuts)
    sizes = [b - a for a, b in zip([0] + ends, ends)]
    return (sizes[0], sizes[1:]) if sizes else (0, [])


def suspects_line(entries, n, green, red, cuts):
    """The SUSPECTS line for a round of the search."""
    span = lambda a, b: "#%d..#%d" % (entries[a]["pr"], entries[b - 1]["pr"])
    return "SUSPECTS %s: green to %s, red from %s; checking %s" % (
        span(0, n), "#%d" % entries[green - 1]["pr"] if green else "none",
        "#%d" % entries[red - 1]["pr"] if red else "none",
        ", ".join(span(0, c) for c in cuts) or "nothing")


def suspects_left(saved, queue, record, approvals, said):
    """(saved, line): the search `saved` with the suspects that merged
    this tick (`record`'s decisions) moved to `merged`, and those no
    longer in `queue` at their head, or handed back, moved to `left`.
    With none left, the search is over: `line` says BATCH-FLAKE when
    every suspect merged, and the saved search is None."""
    done = {d["pr"] for d in record["decisions"]
            if d.get("action") == "MERGE" and d.get("result") == "done"}
    heads = {pr["number"]: pr for pr in queue}
    kept = []
    for e in saved["suspects"]:
        pr = heads.get(e["pr"])
        if e["pr"] in done:
            saved["merged"].append(e["pr"])
        elif pr is None or pr["headRefOid"] != e["head"] or handed_back(
                said, pr, approvals.get(e["pr"])):
            saved["left"].append(e["pr"])
        else:
            kept.append(e)
    saved["suspects"] = kept
    if kept:
        return saved, None
    line = None
    if saved["merged"] and not saved["left"] and not saved.get("named"):
        every = saved["merged"]
        line = ("BATCH-FLAKE #%d..#%d: every suspect merged green; the red "
                "top's tree %s was a flake" % (every[0], every[-1],
                                               saved.get("tree")))
    return None, line


def suspect_round(state_dir, saved, entries, verdict, last, said_ahead,
                  record, out):
    """One tick of the search (designs/0035, second amendment): the
    batch and `later` batches written into `said_ahead` for the
    suspects at the front of the predictions `entries`, the runs to
    stop as `stop`, and the search saved. Whether it goes on: False
    once a suspect is red on its own at the front, which is then
    checked as without batches, or when no suspect is predicted."""
    path = os.path.join(state_dir, SUSPECTS_FILE)
    numbers = {e["pr"] for e in saved["suspects"]}
    n = 0
    while n < len(entries) and entries[n]["pr"] in numbers:
        n += 1
    trees = [e["tree"] for e in entries[:n]]
    green, red, cuts = suspect_cuts(trees, verdict, AHEAD_BATCHES)
    if not n or (red == 1 and not green):
        if n:
            out("SUSPECTS #%d..#%d: #%d is red on its own; the search ends"
                % (entries[0]["pr"], entries[n - 1]["pr"], entries[0]["pr"]))
        if os.path.exists(path):
            os.remove(path)
        return False
    size, later = suspect_batches(green, cuts)
    said_ahead["batch"] = {"size": size, "trees": trees[:size],
                           "suspects": True}
    record["batch"] = [e["pr"] for e in entries[:size]]
    at, said_ahead["later"], record["later"] = size, [], []
    for k in later[:max(1, AHEAD_BATCHES - 1)]:
        said_ahead["later"].append({"size": k, "trees": trees[at:at + k]})
        record["later"].append([e["pr"] for e in entries[at:at + k]])
        at += k
    if not said_ahead["later"]:
        del said_ahead["later"], record["later"]
    if red:
        # The suspects are those up to the shortest red prefix; longer
        # prefixes contain it, so their runs are stopped, and the
        # members past it go behind, in the next batch.
        saved["stop_trees"] = sorted(set(saved.get("stop_trees") or ())
                                     | set(trees[red:n]))
        saved["suspects"] = [{"pr": e["pr"], "head": e["head"]}
                             for e in entries[:red]]
        if red == green + 1:
            saved["named"] = entries[red - 1]["pr"]
    longer = set(saved.get("stop_trees") or ())
    stop = {e.get("sha") for e in list(entries) + list(
        (last or {}).get("entries") or ())
        if isinstance(e, dict) and e.get("tree") in longer}
    if stop - {None}:
        said_ahead["stop"] = sorted(stop - {None})
    line = suspects_line(entries, n, green, red, cuts)
    if line != saved.get("said"):
        out(line)
        saved["said"] = line
    save_json(path, saved)
    return True


def merged_one(record):
    """Whether the tick that wrote `record` merged a pull request."""
    return any(d.get("action") == "MERGE" and d.get("result") == "done"
               for d in (record or {}).get("decisions") or ())


def moved_a_stack(record):
    """Whether the tick that wrote `record` merged a pull request or
    retargeted a stack's next layer: either way the run goes on."""
    return merged_one(record) or any(
        d.get("action") == "RETARGET" and d.get("result") == "done"
        for d in (record or {}).get("decisions") or ())


def load_stack(state_dir, prs, when):
    """The stack in progress (designs/0025), from STACK_FILE: `heads`
    merged so far, `run` (layers merged in a row) and `pending`, each
    `{"pr", "after", "branch"}`, with the pull requests no longer open
    left out. Empty when there is none, or it is older than STACK_FOR,
    except that with STACK_WAIT a layer waiting for its approval
    (designs/0033: `since`) keeps the stack, `next_layer` timing it."""
    state = load_json(os.path.join(state_dir, STACK_FILE), {})
    if not isinstance(state, dict) or not state.get("pending"):
        return {}
    try:
        at = parse_time(state.get("at") or "")
    except ValueError:
        return {}
    open_now = {pr["number"] for pr in prs}
    state["pending"] = [e for e in state["pending"] if e.get("pr") in open_now
                        and (when - at <= STACK_FOR
                             or (STACK_WAIT and (e.get("since")
                                                 or e.get("waited"))))]
    return state if state["pending"] else {}


def next_layer(stack, prs, candidates, open_numbers, when, held):
    """(stack, retarget, expired): `stack` without the layers that end
    it, the first layer still based on the merged branch below it that
    is eligible but for its base, as (pull request, number below), or
    None, and the entries of layers that waited out STACK_WAIT. A layer
    already on `main` stays while it is a candidate. A layer that isn't
    eligible ends the stack there and is held as usual, its reason
    saying the layer below merged; with STACK_WAIT it stays instead,
    marked `since` it began waiting, and is judged again each tick until
    it is eligible (then `waited`, so it keeps its usual place in the
    queue) or STACK_WAIT has passed (designs/0033)."""
    by_number = {pr["number"]: pr for pr in prs}
    chosen = {pr["number"] for pr in candidates}
    pending, retarget, expired = [], None, []
    for entry in stack["pending"]:
        pr = by_number.get(entry["pr"])
        if pr is None:
            continue
        if pr.get("baseRefName") == MAIN:
            if pr["number"] in chosen:
                pending.append(done_waiting(entry))
            continue
        if pr.get("baseRefName") != entry["branch"]:
            continue
        # The layer below merged, though GitHub's lists can name it open
        # for a tick or two after: a `Blocked-by:` it is no reason to
        # end the stack.
        approval, why = eligible(pr, open_numbers - {entry["after"]}, when,
                                 any_base=True)
        if approval is None:
            since = entry.get("since") or iso(when)
            if STACK_WAIT and when - parse_time(since) <= STACK_WAIT:
                held[str(pr["number"])] = STACK_WAIT_REASON % (
                    STACK_REASON % entry["after"], why)
                pending.append(dict(entry, since=since))
                continue
            held[str(pr["number"])] = "%s, which merged, but %s" % (
                STACK_REASON % entry["after"], why)
            if entry.get("since"):
                expired.append(entry)
            continue
        entry = done_waiting(entry)
        pending.append(entry)
        if retarget is None:
            retarget = (pr, entry["after"])
    return (dict(stack, pending=pending) if pending else {}, retarget,
            expired)


def done_waiting(entry):
    """`entry`, marked `waited` rather than `since` if it was waiting."""
    if not entry.get("since"):
        return entry
    entry = dict(entry, waited=True)
    entry.pop("since")
    return entry


def tell_waited(github, expired, live):
    """[{pr, after, result}] for each layer that waited out STACK_WAIT;
    when `live`, STACK_WAITED_NOTE is posted on it. Said once, since the
    layer then leaves `stacks.json`."""
    told = []
    for entry in expired:
        item = {"pr": entry["pr"], "after": entry["after"]}
        if live:
            ok, why = github.write(
                "POST", "repos/%s/issues/%d/comments" % (REPO_SLUG,
                                                       entry["pr"]),
                body=STACK_WAITED_NOTE % (
                    int(STACK_WAIT.total_seconds() // 3600), entry["after"],
                    MAIN, SIGNATURE))
            item["result"] = "done" if ok else "refused: " + why
        told.append(item)
    return told


def save_stack(state_dir, stack):
    """Write `stack` to STACK_FILE, or remove the file when it's empty."""
    path = os.path.join(state_dir, STACK_FILE)
    if stack:
        save_json(path, stack)
    elif os.path.exists(path):
        os.remove(path)


def stacked_above(number, prs):
    """How many open pull requests are stacked, at any depth, on `number`."""
    by_number = {pr["number"]: pr for pr in prs}
    branches, count = {by_number[number]["headRefName"]}, 0
    while branches:
        above = [pr for pr in prs if pr.get("baseRefName") in branches]
        count += len(above)
        branches = {pr["headRefName"] for pr in above}
    return count


def merged_elsewhere(state_dir, github, stack, prs, when):
    """`stack` with the layers whose base merged without the Merger
    (by hand, say) added, as `note_merge` would have added them. A
    layer is an open, non-draft pull request based on a branch that is
    no open pull request's head and isn't in the stack yet; GitHub is
    asked whether a pull request from that branch merged into MAIN.
    ELSEWHERE_FILE remembers each branch asked about, and each branch
    the Merger merged itself (`note_merge`): a branch whose layers were
    added, or that the Merger merged, isn't asked about again for
    ELSEWHERE_KEEP, so a layer that left its stack (not eligible, or
    waited out) doesn't come back; one with no merged pull
    request is asked again after ELSEWHERE_FOR, so a branch nobody
    opened a pull request for costs one call an hour."""
    heads = {pr["headRefName"] for pr in prs}
    known = {e["pr"] for e in stack.get("pending", ())}
    path = os.path.join(state_dir, ELSEWHERE_FILE)
    asked = remembered_bases(path, when)
    owner = REPO_SLUG.split("/")[0]
    found = {}
    for pr in sorted(prs, key=lambda p: (p["createdAt"], p["number"])):
        branch = pr.get("baseRefName")
        if (branch == MAIN or branch in heads or pr.get("isDraft")
                or pr["number"] in known or branch in asked):
            continue
        if branch not in found:
            try:
                pulls = github.api("repos/%s/pulls?state=closed&head=%s:%s"
                                   "&per_page=10" % (REPO_SLUG, owner, branch))
            except RuntimeError:
                continue
            merged = [p for p in (pulls if isinstance(pulls, list) else ())
                      if isinstance(p, dict) and p.get("merged_at")
                      and (p.get("base") or {}).get("ref") == MAIN]
            found[branch] = max(merged, key=lambda p: p["merged_at"]) \
                if merged else None
        below = found[branch]
        asked[branch] = {"at": iso(when),
                         "merged": below["number"] if below else None}
        if below is None:
            continue
        stack = dict(stack, at=iso(when),
                     heads=list(stack.get("heads", ())) + [
                         below["head"]["sha"]],
                     run=stack.get("run", 0), pending=list(
                         stack.get("pending", ())) + [{
                             "pr": pr["number"], "after": below["number"],
                             "branch": branch,
                             "head": below["head"]["sha"]}])
    save_json(path, asked)
    return stack


def remembered_bases(path, when):
    """ELSEWHERE_FILE's branches still worth remembering at `when`: one
    with no merged pull request for ELSEWHERE_FOR, any other for
    ELSEWHERE_KEEP, long after any stack could hold its layers."""
    keep = ELSEWHERE_KEEP
    out = {}
    for branch, said in load_json(path, {}).items():
        try:
            age = when - parse_time(said["at"])
        except (KeyError, TypeError, ValueError):
            continue
        if age <= (keep if said.get("merged") else ELSEWHERE_FOR):
            out[branch] = said
    return out


def note_merge(state_dir, stack, pr, prs, when):
    """After `pr` merged: the open, non-draft pull requests stacked on
    it become the stack's next layers, and STACK_FILE is rewritten (or
    removed when nothing is pending). Returns the new stack."""
    pending = [e for e in stack.get("pending", ()) if e["pr"] != pr["number"]]
    was_layer = len(pending) < len(stack.get("pending", ()))
    above = sorted((p for p in prs if p.get("baseRefName") == pr["headRefName"]
                    and not p.get("isDraft")),
                   key=lambda p: (p["createdAt"], p["number"]))
    pending += [{"pr": p["number"], "after": pr["number"],
                 "branch": pr["headRefName"], "head": pr["headRefOid"]}
                for p in above]
    heads = list(stack.get("heads", ()))
    if was_layer or above:
        heads.append(pr["headRefOid"])
    run = (stack.get("run", 0) + 1 if was_layer else 1 if above else 0)
    new = ({"at": iso(when), "heads": heads, "run": run, "pending": pending}
           if pending else {})
    save_stack(state_dir, new)
    if STACKS:
        path = os.path.join(state_dir, ELSEWHERE_FILE)
        asked = remembered_bases(path, when)
        asked[pr["headRefName"]] = {"at": iso(when), "merged": pr["number"]}
        save_json(path, asked)
    return new


def resolve_once(state_dir, repo, decision, approval, branch, main_tip,
                 github, run=sh):
    """`resolve`, at most once per approval and head (RESOLVED_FILE): a
    push that worked moves the head, so a second try at the same head
    means the first failed, and it would fail again. A repeat answers
    with the first try's failure, so its hand-back is said once."""
    return once(os.path.join(state_dir, RESOLVED_FILE), decision, approval,
                lambda: resolve(repo, decision, branch, main_tip, github, run))


def restack_once(state_dir, decision, approval, github, said):
    """RESTACK, at most once per approval and head (RESTACKED_FILE), as
    `resolve_once`: "done", or "failed: why"."""
    def attempt():
        result = carry_out(decision, approval, github, said)
        return result if result == "done" else "failed: " + result
    return once(os.path.join(state_dir, RESTACKED_FILE), decision, approval,
                attempt)


def once(path, decision, approval, attempt):
    """`attempt()` unless the file at `path` says it was tried for this
    approval and head; then the first try's failure, or "failed: already
    tried at this head"."""
    tried = load_json(path, {})
    key = {"approved": approval.get("submittedAt"), "head": decision["head"]}
    before = tried.get(str(decision["pr"])) or {}
    if {k: before.get(k) for k in key} == key:
        failed = before.get("result") or ""
        return (failed if failed.startswith("failed: ")
                else "failed: already tried at this head")
    tried[str(decision["pr"])] = key
    save_json(path, tried)
    result = attempt()
    tried[str(decision["pr"])] = dict(key, result=result)
    save_json(path, tried)
    return result


def tick(repo, state_dir, github, run=sh, out=print, now=now_utc,
         sleep=time.sleep, live=False, send=None, check_state=None):
    """One tick: the queue, and the action for its first pull request
    that isn't handed back or skipped, carried out when `live`. Appends
    the record to merger.jsonl, or dry-run.jsonl when not live, and
    prints one summary line (two when stalled). With STALL_ALERT, a live
    tick then tells people of a stall, through `send` (see
    `tell_stall`). `check_state` is the build check's state, for
    `merge.queued_stall_minutes`. Returns the record."""
    fetched = git(repo, "fetch", "-q", "origin", MAIN, run=run)
    if fetched.returncode != 0 and "cannot lock ref" in fetched.stderr:
        # The checkout's refs are shared with every worktree on the host,
        # so another fetch can hold the ref for a moment.
        sleep(FETCH_RETRY_S)
        fetched = git(repo, "fetch", "-q", "origin", MAIN, run=run)
    if fetched.returncode != 0:
        raise RuntimeError("fetch %s: %s" % (MAIN, fetched.stderr.strip()))
    main_tip = git(repo, "rev-parse", "refs/remotes/origin/" + MAIN,
                   run=run).stdout.strip()
    prs = fetch_prs(github)
    open_numbers = {pr["number"] for pr in prs} | fetch_open_issues(github)
    candidates, approvals, held, spoken = [], {}, {}, []
    when = now()
    heads = {pr["headRefName"]: pr["number"] for pr in prs
             if pr.get("headRefName")}
    for pr in prs:
        approval, why = eligible(pr, open_numbers, when, heads)
        if approval is not None:
            candidates.append(pr)
            approvals[pr["number"]] = approval
        elif approval_of(pr) is not None:
            held[str(pr["number"])] = why
            said_after = said_since(pr, approval_of(pr))
            if said_after and not pr.get("isDraft"):
                spoken.append((pr, approval_of(pr), said_after[0]))
    regenerated = (remembered(state_dir, lambda sha, rule: regenerated_in(
        repo, sha, rule, run)) if RESOLVE else None)
    rules = None
    if CODE_OWNERS:
        rules = codeowners_rules(repo, "refs/remotes/origin/" + MAIN, run)
        for pr in list(candidates):
            why = rules and code_owner_wait(repo, pr, rules, main_tip, run,
                                            regenerated)
            if why:
                held[str(pr["number"])] = why
                candidates.remove(pr)
    queue = order(candidates, prs)
    in_flight = None
    if TEST_AHEAD:
        last = load_json(os.path.join(state_dir, "next.json"), {})
        if isinstance(last, dict) and last.get("action") in IN_FLIGHT:
            in_flight = last.get("pr")
    yielded, records, row = {}, [], None
    name = "merger.jsonl" if live else "dry-run.jsonl"
    if YIELD_PLACES or RIGHT_OF_WAY:
        records = recent_records(os.path.join(state_dir, name),
                                 when - YIELD_WINDOW)
    if YIELD_PLACES:
        counts = hand_backs(records, not YIELD_IGNORES_CONFLICTS)
        spent = yields_spent(records, not YIELD_IGNORES_CONFLICTS)
        queue, yielded = yield_places(queue, prs, counts, in_flight, spent)
    if in_flight is not None:
        # The pull request the last tick updated or waited on keeps its
        # place: a blocker promoted past it would spend the run it is
        # already having, and every prediction behind it.
        queue.sort(key=lambda pr: pr["number"] != in_flight)
    os.makedirs(state_dir, exist_ok=True)
    since, overdue = {}, {}
    if AGE_FIRST is not None:
        since = waiting_since(os.path.join(
            state_dir, AGE_FILE if live else "dry-run-" + AGE_FILE),
            candidates, prs, when)
    row_held = {}
    if RIGHT_OF_WAY:
        row = right_of_way(repo, prs, records, os.path.join(
            state_dir, ROW_FILE if live else "dry-run-" + ROW_FILE),
            when, main_tip, run)
    if row:
        # Nothing that conflicts with it merges first; it goes first
        # once it is a candidate, after only the one in flight.
        others = [pr for pr in queue if pr["number"] != row["pr"]]
        if since:
            # One that has waited longer and is overdue isn't held for
            # it (designs/0037): it goes first, and the holder waits.
            mine = since.get(row["pr"], when)
            others = [pr for pr in others if not (
                pr["number"] in since and since[pr["number"]] < mine
                and when - since[pr["number"]] >= AGE_FIRST)]
        for number in conflicts_with(repo, row["head"], others, run):
            row_held[number] = row["pr"]
            held[str(number)] = ROW_REASON % row["pr"]
        queue = [pr for pr in queue if pr["number"] not in row_held]
        queue.sort(key=lambda pr: (pr["number"] != in_flight,
                                   pr["number"] != row["pr"]))
        yielded.pop(row["pr"], None)
    if TEST_AHEAD:
        # Those already predicted go first, in the order predicted.
        places = locked_order(state_dir, queue)
        queue.sort(key=lambda pr: (pr["number"] != in_flight, places.get(
            pr["number"], len(places))))
    stack, retarget = (load_stack(state_dir, prs, when) if STACKS else {}), None
    if STACKS:
        stack = merged_elsewhere(state_dir, github, stack, prs, when)
    expired = []
    if stack:
        stack, retarget, expired = next_layer(stack, prs, candidates,
                                              open_numbers, when, held)
    if STACKS and live:
        save_stack(state_dir, stack)
    if stack:
        # A layer that waited for its approval keeps its usual place.
        first = [e["pr"] for e in stack.get("pending", ())
                 if not e.get("waited")]
        if STACK_MAX_RUN and stack.get("run", 0) >= STACK_MAX_RUN:
            first = []
        # A layer that comes back while a batch it isn't in runs goes
        # first in the next batch, not into that one, which would spend
        # its run. Predicted past the batch is not in it: on 2026-10-26
        # a layer predicted 16th went in front of a green batch's six
        # members left to merge.
        merging = TEST_AHEAD and (in_flight is not None or green_batch(
            state_dir, queue, check_state))
        members = batch_members(state_dir, queue) if merging else set()
        late = set(first) - members if merging else set()
        places = locked_order(state_dir, queue) if late else {}
        # An urgent pull request goes ahead of a layer that comes back,
        # though not ahead of the batch being merged (Alex, 2026-10-26:
        # a pin waited behind four layers in turn, an hour and a half).
        queue.sort(key=lambda pr: (
            pr["number"] != in_flight,
            0 if pr["number"] in members
            else 1 if urgent(pr) and pr["number"] not in first
            else 2 if pr["number"] in first and pr["number"] not in late
            else 3 if pr["number"] in places
            else 4 if pr["number"] in late else 5))
    if since:
        # Overdue ones go first (designs/0037), behind only the one in
        # flight, urgent ones and a batch being merged, whose runs are
        # spent either way.
        merging = TEST_AHEAD and (in_flight is not None or green_batch(
            state_dir, queue, check_state))
        queue, overdue = overdue_first(
            queue, since, when, in_flight,
            batch_members(state_dir, queue) if merging else set())
        for number in overdue:
            yielded.pop(number, None)
    if MAIN_RED_FIXES & {pr["number"] for pr in queue}:
        # A red default branch's fix goes first, behind only the one in
        # flight and a green batch still merging, whose run is spent
        # either way (designs/0011, amendment).
        merging = TEST_AHEAD and green_batch(state_dir, queue, check_state)
        queue = fixes_first(queue, in_flight, batch_members(
            state_dir, queue) if merging else set())
    saved = load_suspects(state_dir) \
        if TEST_AHEAD and AHEAD_BATCH > 1 else None
    if saved:
        # A red batch's suspects lead while the search goes on: nothing
        # joins in front of them or among them (designs/0035, second
        # amendment).
        places = suspect_place(saved, queue)
        queue.sort(key=lambda pr: (pr["number"] != in_flight, places.get(
            pr["number"], len(places))))
    held_by = (conflicts_ahead(repo, queue, run, main_tip)
               if HOLD_CONFLICTING else {})
    for number, ahead in held_by.items():
        held[str(number)] = HOLD_REASON % ahead
    queue = [pr for pr in queue if pr["number"] not in held_by]
    record = {"at": iso(when), "main": main_tip, "held": held,
              "queue": [pr["number"] for pr in queue], "decisions": []}
    QUEUE_VIEW.clear()
    QUEUE_VIEW.update(queue=record["queue"], held=held, prs=prs)
    if YIELD_PLACES:
        record["yielded"] = {str(n): p for n, p in sorted(yielded.items())}
    if RIGHT_OF_WAY:
        record["right_of_way"] = row
    if AGE_FIRST is not None:
        record["overdue"] = {str(n): w for n, w in sorted(overdue.items())}
    if stack:
        record["stack"] = [dict({"pr": e["pr"], "after": e["after"]},
                                **({"waiting": True} if e.get("since")
                                   else {}))
                           for e in stack["pending"]]
    if expired:
        record["stack_waited"] = tell_waited(github, expired, live)
    said_path = os.path.join(state_dir, "handed-back.json")
    said = load_json(said_path, {})
    if spoken or os.path.exists(os.path.join(state_dir, HELD_FILE)):
        record["spoken"] = tell_spoken(state_dir, github, prs, spoken, live)
    if HOLD_CONFLICTING or RIGHT_OF_WAY:
        record["holds"] = tell_holds(state_dir, github, prs,
                                     {**held_by, **row_held}, live,
                                     row_held)
    waiting_on = waiting = None
    stopped = len(queue)
    if retarget is not None:
        # One write a tick: the stack's next layer goes onto main, and
        # the run goes on to judge it there.
        layer, after = retarget
        decision = {"action": "RETARGET", "pr": layer["number"],
                    "head": layer["headRefOid"], "after": after}
        if live:
            decision["result"] = carry_out(decision, None, github, said)
        record["decisions"].append(decision)
        out("STACK #%d: %sretargeted to %s after #%d merged; %d above" % (
            layer["number"], "" if live else "would be ", MAIN, after,
            stacked_above(layer["number"], prs)))
        stopped = 0
    below = tuple(stack.get("heads", ())) if stack else ()
    layers = {e["pr"] for e in stack.get("pending", ())} if stack else set()
    restacks = {e["pr"]: (e["after"], e["head"])
                for e in (stack or {}).get("pending", ()) if e.get("head")}
    # A stack's layer in a batch (designs/0035) is held as stacked until
    # the layer below merges; the batch holds while it is still ready.
    batch_layers = [pr for pr in prs if AHEAD_STACKS
                    and pr.get("baseRefName") != MAIN
                    and str(pr["number"]) in held
                    and eligible(pr, open_numbers, when,
                                 any_base=True)[0] is not None]
    for at, pr in enumerate([] if retarget is not None else queue):
        approval = approvals[pr["number"]]
        decision = decide(pr, approval, repo, main_tip, github, github.env,
                          run, below if pr["number"] in layers else (),
                          regenerated, when, restacks.get(pr["number"]))
        decision.update(pr=pr["number"], head=pr["headRefOid"])
        steps = head_base_red(check_state, pr["headRefOid"]) \
            if decision["action"] == "HAND-BACK" and decision.get(
                "reason", "").startswith(STATUS_CONTEXT + " is failure") \
            else None
        if steps and ((check_state.get("main_red") or {}).get("issue")):
            base = (check_state["results"][pr["headRefOid"]].get("base")
                    or "")
            decision = {"action": "WAIT", "pr": pr["number"],
                        "head": pr["headRefOid"],
                        "reason": BASE_RED_REASON % (
                            STATUS_CONTEXT, ", ".join(steps), MAIN,
                            base[:10])}
        elif steps:
            # The tip is green again: the head is brought up to date,
            # which checks it afresh, rather than handed back.
            decision = {"action": "UPDATE", "pr": pr["number"],
                        "head": pr["headRefOid"]}
        tree = git(repo, "rev-parse", pr["headRefOid"] + "^{tree}",
                   run=run).stdout.strip() if decision.get("covered") \
            else None
        # A covered head merges while its batch holds, or once a run of
        # its tree itself (a batch split down to it) is green.
        if tree and not batch_holds(
                load_json(os.path.join(state_dir, AHEAD_FILE), {}),
                pr["number"], tree, queue + batch_layers, check_state) \
                and tree_verdict(check_state, tree) is not True:
            decision = {"action": "WAIT", "pr": pr["number"],
                        "head": pr["headRefOid"],
                        "reason": BATCH_WAIT_REASON}
        if (decision["action"] == "UPDATE"
                and said.get(str(pr["number"])) == hand_back_key(
                    approval, pr["headRefOid"], CONFLICT_REASON)):
            # GitHub already refused this head as a conflict and the
            # author has it; asking again would only be refused again.
            record["decisions"].append(
                conflict_hand_back(pr, approval, github, said, live))
            continue
        if (decision["action"] in ("UPDATE", "MERGE")
                and said.get(str(pr["number"])) == hand_back_key(
                    approval, pr["headRefOid"], LOST_HEAD_REASON)):
            # GitHub refused this head for STALL_AFTER and it went back
            # to its author; the queue moves past it.
            record["decisions"].append(conflict_hand_back(
                pr, approval, github, said, live, LOST_HEAD_REASON))
            continue
        before = said.get(str(pr["number"])) or {}
        if (UPDATE_ONCE
                and decision["action"] in ("UPDATE", "RESOLVE", "RESTACK",
                                           "STACK-UPDATE")
                and before.get("approved")
                and before["approved"] == approval.get("submittedAt")
                and not description_moved(before, pr)
                and not before.get("retry")):
            # Handed back under this approval: not updated again. An
            # update spends a build on a head that comes back for the
            # same reason. Only the update is withheld: a head already
            # up to date is decided as before, and a new approval is a
            # new question. A gate's refusal for now isn't the
            # author's to fix, so it doesn't withhold one.
            decision = {"action": "SKIP", "pr": pr["number"],
                        "head": pr["headRefOid"],
                        "reason": "handed back under this approval (%s); "
                                  "not updated until it is approved "
                                  "again" % before.get("reason")}
        for stale in decision.get("ci_stale") or ():
            out("CI-STALE #%d: GitHub says run %s is %s, but all its jobs "
                "finished at %s; judged by its jobs (%s)" % (
                    pr["number"], stale["run"], stale["status"],
                    stale["finished"], stale["judged"]))
        if decision["action"] == "WAIT" and decision.get("ci_unfinished"):
            stuck = ci_stuck_reason()
            if said.get(str(pr["number"])) == hand_back_key(
                    approval, pr["headRefOid"], stuck):
                # Its CI never finished, even re-run, and it went back
                # to its author; the queue moves past it until it does.
                record["decisions"].append(conflict_hand_back(
                    pr, approval, github, said, live, stuck))
                continue
            detail = ci_rerun(decision, github, state_dir, when, live, out)
            if detail:
                out("CI-STUCK #%d: %s; handed back to its author, and the "
                    "queue moves past it" % (pr["number"], detail))
                record["decisions"].append(conflict_hand_back(
                    pr, approval, github, said, live, stuck, detail + "."))
                continue
        if live and decision["action"] == "RESOLVE":
            decision["result"] = resolve_once(
                state_dir, repo, decision, approval, pr["headRefName"],
                main_tip, github, run)
        elif live and decision["action"] == "STACK-UPDATE":
            decision["result"] = once(
                os.path.join(state_dir, STACK_UPDATED_FILE), decision,
                approval, lambda: stack_update(repo, decision, main_tip,
                                               github, run))
        elif live and decision["action"] == "RESTACK":
            decision["result"] = restack_once(state_dir, decision, approval,
                                              github, said)
        elif live:
            result = carry_out(decision, approval, github, said)
            if result is not None:
                decision["result"] = result
        record["decisions"].append(decision)
        if decision["action"] == "RESTACK":
            if decision.get("result", "done") == "done":
                out("STACK #%d: %smerged #%d's head %s into it" % (
                    pr["number"], "" if live else "would have ",
                    decision["after"], short(decision["below"])))
            else:
                record["decisions"].append(conflict_hand_back(
                    pr, approval, github, said, live,
                    "%s, and the Merger could not merge #%d's final head "
                    "%s into it" % (CONFLICT_REASON, decision["after"],
                                    decision["below"][:10]),
                    RESTACK_DETAIL % (decision["after"],
                                      decision["below"][:10], MAIN)))
                continue
        if decision["action"] == "STACK-UPDATE":
            if decision.get("result", "done") == "done":
                out("STACK #%d: %smerged %s into it against #%d's head %s"
                    % (pr["number"], "" if live else "would have ", MAIN,
                       decision["after"], short(decision["below"])))
            elif not decision["result"].startswith("refused"):
                record["decisions"].append(conflict_hand_back(
                    pr, approval, github, said, live,
                    "%s, and the Merger could not merge it in against "
                    "#%d's final head" % (CONFLICT_REASON,
                                          decision["after"])))
                continue
        if (decision["action"] == "RESOLVE"
                and decision.get("result", "").startswith("failed")):
            # Resolving it didn't work, so it is an ordinary conflict
            # again, with the step that failed: the output after it can
            # differ per tick, and the reason is half the key that says
            # a hand-back once.
            step = decision["result"][len("failed: "):].split(": ")[0]
            record["decisions"].append(conflict_hand_back(
                pr, approval, github, said, live,
                "%s, and the Merger could not resolve it (%s)"
                % (CONFLICT_REASON, step)))
            continue
        if (STACKS and live and decision["action"] == "MERGE"
                and decision.get("result") == "done"):
            stack = note_merge(state_dir, stack or {}, pr, prs, when)
            if stack:
                record["stack"] = [{"pr": e["pr"], "after": e["after"]}
                                   for e in stack["pending"]]
        if (decision["action"] == "UPDATE"
                and "merge conflict" in (decision.get("result") or "")):
            # The backstop for a conflict git didn't see: GitHub's word
            # is final, and the pull request goes back to its author
            # like any other conflict, not round again next tick.
            record["decisions"].append(
                conflict_hand_back(pr, approval, github, said, live))
            continue
        if (live and decision["action"] in ("UPDATE", "MERGE")
                and LOST_HEAD_RE.search(decision.get("result") or "")):
            lost = lost_head(decision, github, state_dir, out)
            decision["lost"] = lost
            if lost and lost["now"] != pr["headRefOid"]:
                # GitHub holds another head now: a changed pull request,
                # judged afresh at that head next tick (its approval,
                # its check), never retried at the head it lost.
                record["decisions"].append({
                    "action": "RESYNC", "pr": pr["number"],
                    "head": pr["headRefOid"],
                    "result": "GitHub now has " + short(lost["now"])})
                continue
            minutes = stalled_for(state_dir, decision, when)
            if minutes is not None:
                # Refused for STALL_AFTER, and nothing the Merger can do
                # changes GitHub's mind: back to its author, whose push
                # makes GitHub read the head again, and the queue moves
                # past it rather than waiting behind it for ever.
                record["stalled"] = {
                    "pr": pr["number"], "head": pr["headRefOid"],
                    "minutes": minutes, "lost": lost, "handed_back": True,
                    "refused": "%s %s" % (decision["action"],
                                          decision["result"])}
                record["decisions"].append(conflict_hand_back(
                    pr, approval, github, said, live, LOST_HEAD_REASON,
                    lost_text(lost) + ". A push to the branch, or closing "
                    "and reopening the pull request, makes GitHub read its "
                    "head again."))
                continue
        if decision["action"] not in ("HAND-BACK", "SKIP"):
            waiting_on = pr["number"]
            # A refused write ends the tick on this pull request, and the
            # next tick picks it again; if GitHub goes on refusing, it is
            # as stuck as a check that never finishes.
            if (decision["action"] == "WAIT"
                    or decision.get("result", "").startswith("refused")):
                waiting = decision
            stopped = at + 1
            break
    if EARLY_CONFLICTS:
        record["decisions"] += early_conflicts(
            repo, main_tip, queue[stopped:], approvals, github, said, live,
            run, layers)
    if live:
        minutes = stalled_for(state_dir, waiting, when, check_state)
        if minutes is not None and "stalled" not in record:
            record["stalled"] = {"pr": waiting["pr"], "head": waiting["head"],
                                 "minutes": minutes}
            if waiting["action"] != "WAIT":
                record["stalled"]["refused"] = "%s %s" % (
                    waiting["action"], waiting["result"])
                if "lost" in waiting:
                    record["stalled"]["lost"] = waiting["lost"]
        save_json(said_path, said)
        said_next = {"at": record["at"], "pr": waiting_on}
        if TEST_AHEAD:
            acted = [d["action"] for d in record["decisions"]
                     if d["pr"] == waiting_on]
            said_next["action"] = acted[-1] if acted else None
        save_json(os.path.join(state_dir, "next.json"), said_next)
        # A tick that retargets a stack's layer judges nothing, so it
        # predicts nothing. It leaves ahead.json as the last tick wrote
        # it: written empty, the batch the queue is merging was forgotten,
        # and its members waited for a new run of their own.
        if TEST_AHEAD and retarget is None:
            acting = [pr for pr in queue if pr["number"] == waiting_on]
            for pr in [pr for pr in queue if pr["number"] != waiting_on
                       and pr.get("baseRefName", MAIN) == MAIN
                       and not handed_back(said, pr, approvals[pr["number"]],
                                           when)
                       ][:AHEAD_DEPTH] if AHEAD_BATCH > 1 else ():
                # Found before its batch is predicted, not from the middle
                # of it (designs/0035, fourth amendment).
                failed = checked_ahead(state_dir, repo, pr,
                                       approvals[pr["number"]], main_tip,
                                       github.env, run, regenerated, when)
                if not failed:
                    continue
                decision = {"action": "HAND-BACK", "to": failed[0],
                            "reason": failed[1], "pr": pr["number"],
                            "head": pr["headRefOid"], "ahead": True}
                if failed[0] == "author":
                    # A gate's refusal (an approval that doesn't cover
                    # the head goes to its reviewer).
                    decision["text"] = description(pr)
                if failed[2:] == (True,):
                    decision.update(retry=True, at=iso(when))
                if live:
                    decision["result"] = carry_out(
                        decision, approvals[pr["number"]], github, said)
                    # Saved now: `said` was written before this, and a
                    # hand-back not kept is said again every tick.
                    save_json(said_path, said)
                record["decisions"].append(decision)
                out("CHECKED-AHEAD #%d: %s; %shanded back before its batch"
                    % (pr["number"], failed[1].splitlines()[0],
                       "" if live else "would be "))
            rest = [pr for pr in queue if pr["number"] != waiting_on
                    and not handed_back(said, pr, approvals[pr["number"]],
                                        when)]
            ahead_queue = acting + rest if acting else []
            last = load_json(os.path.join(state_dir, AHEAD_FILE), {})
            owed = None
            if saved:
                saved, ended = suspects_left(saved, ahead_queue, record,
                                             approvals, said)
                if ended:
                    out(ended)
                if saved is None and os.path.exists(os.path.join(
                        state_dir, SUSPECTS_FILE)):
                    os.remove(os.path.join(state_dir, SUSPECTS_FILE))
            searching = bool(saved and saved["suspects"])
            if searching:
                # Layers and pull requests owed a place wait behind the
                # suspects, in the next batch.
                owed = [n for n in (last or {}).get("owed") or ()
                        if n in {pr["number"] for pr in ahead_queue}]
            elif AHEAD_STACKS and ahead_queue:
                ahead_queue, owed = with_layers(
                    ahead_queue, lambda pr: ready_layers(
                        repo, pr, prs, open_numbers, when, said, run,
                        regenerated, rules), last, AHEAD_BATCH)
            entries = predict_ahead(repo, main_tip, ahead_queue, run,
                                    overdue=overdue)
            record["ahead"] = [e["pr"] for e in entries]
            said_ahead = {"at": record["at"], "base": main_tip,
                          "repo": repo, "entries": entries}
            if owed:
                said_ahead["owed"] = record["owed"] = owed
            # A red that is only the base's own judges nothing
            # (designs/0011, amendment): it waits for the base to change.
            verdict = lambda tree: None if tree_base_red(
                check_state, tree, main_tip) else tree_verdict(
                    check_state, tree)
            urgents = {pr["number"] for pr in ahead_queue if urgent(pr)}
            if AHEAD_BATCH > 1 and entries and not searching:
                size, red = batch_size(entries, (last or {}).get("batch"),
                                       verdict, (last or {}).get("later")
                                       or (), urgents)
                if red:
                    # A red top: its members are the suspects, and the
                    # search for the red one starts this tick.
                    saved = {"suspects": [{"pr": e["pr"], "head": e["head"]}
                                          for e in entries[:red]],
                             "tree": entries[red - 1]["tree"],
                             "at": record["at"], "merged": [], "left": []}
                    out("BATCH #%d..#%d: top red; its %d members are the "
                        "suspects" % (entries[0]["pr"], entries[red - 1]["pr"],
                                      red))
                    searching = True
            if searching and entries:
                # A suspect merged this tick is still predicted first,
                # from the tip before it: the rest are predicted on it,
                # and the search goes on with them.
                merged = set(saved.get("merged") or ())
                while entries and entries[0]["pr"] in merged:
                    entries = entries[1:]
                said_ahead["entries"] = entries
                record["ahead"] = [e["pr"] for e in entries]
            if searching and entries:
                searching = suspect_round(
                    state_dir, saved, entries, verdict, last, said_ahead,
                    record, out)
            if AHEAD_BATCH > 1 and entries and not searching:
                size, red = batch_size(entries, (last or {}).get("batch"),
                                       verdict, (last or {}).get("later")
                                       or (), urgents)
                line = batch_line(entries, size, red, verdict)
                steps = tree_base_red(check_state, entries[size - 1]["tree"],
                                      main_tip)
                if steps:
                    line = ("BATCH-BASE-RED #%d..#%d: red only in %s, as %s "
                            "is; waits for %s to change" % (
                                entries[0]["pr"], entries[size - 1]["pr"],
                                ", ".join(steps), main_tip[:10], MAIN))
                said_ahead["batch"] = {
                    "size": size, "trees": [e["tree"]
                                            for e in entries[:size]]}
                record["batch"] = [e["pr"] for e in entries[:size]]
                if AHEAD_BATCHES > 1:
                    later = later_batches(
                        entries, 0 if red else size,
                        (last or {}).get("later"), verdict,
                        lambda sha, tree: ahead_started(check_state, sha,
                                                        tree), urgents)
                    if later:
                        said_ahead["later"] = later
                        at, record["later"] = size, []
                        for batch in later:
                            record["later"].append([
                                e["pr"] for e in
                                entries[at:at + batch["size"]]])
                            at += batch["size"]
                if line:
                    said_ahead["batch"]["said"] = line
                    if line != ((last or {}).get("batch") or {}).get("said"):
                        out(line)
            save_json(os.path.join(state_dir, AHEAD_FILE), said_ahead)
    with open(os.path.join(state_dir, name), "a") as handle:
        handle.write(json.dumps(record, sort_keys=True) + "\n")
    out("%s %d eligible, %d approved but held; %s" % (
        "TICK" if live else "DRY-RUN", len(queue), len(held), "; ".join(
        "#%d %s%s%s" % (d["pr"], d["action"],
                        " to %s" % d["to"] if "to" in d else "",
                        " (%s)" % d["result"] if "result" in d else "")
        for d in record["decisions"]) or "nothing to do"))
    stalled = record.get("stalled")
    if stalled and "refused" in stalled:
        out("STALLED: GitHub has refused the Merger's write to #%d at %s "
            "for %d minutes, most recently %s. %s; %s" % (
                stalled["pr"], stalled["head"][:10], stalled["minutes"],
                stalled["refused"],
                "It is handed back to its author, and the queue moves past "
                "it" if stalled.get("handed_back") else
                "It stays first in the queue and is not handed back",
                refusal_hint(stalled)))
    elif stalled:
        out("STALLED: #%d has waited %d minutes on %s: %s. It stays "
            "first in the queue and is not handed back; look at %s" % (
                stalled["pr"], stalled["minutes"], stalled["head"][:10],
                waiting["reason"], where_to_look()))
    if live and STALL_ALERT:
        tell_stall(state_dir, github, stalled, record["decisions"], when,
                   send, out, (waiting or {}).get("reason"))
    return record


def mint(project, agent):
    try:
        return forge_github.token(project, agent)
    except forge_github.MintError:
        return None


def commit_identity(project, name):
    """(name, email) the App `name` commits as, or None when GitHub
    can't say its user id."""
    user_id = forge_github.bot_user_id(project, name)
    if user_id is None:
        return None
    return name, forge_github.noreply_email(project, name, user_id)


def load_check_state(state_dir):
    """The build check's state.json in `state_dir`, or None when it can't
    be read: every wait is then judged as without it."""
    try:
        with open(os.path.join(state_dir, "state.json")) as handle:
            got = json.load(handle)
    except (OSError, ValueError):
        return None
    return got if isinstance(got, dict) else None


def main(argv=None, run=sh, out=print, environ=None, mint=mint,
         sender=None, identity=commit_identity):
    global RESOLVE_IDENTITY, NIGHTLY_FIXES, MAIN_RED_FIXES
    environ = os.environ if environ is None else environ
    parser = argparse.ArgumentParser(
        prog="forge-merger", description=__doc__.splitlines()[0])
    parser.add_argument("--dry-run", action="store_true",
                        help="read and report, and write nothing to GitHub")
    parser.add_argument("--state-dir", default=None,
                        help="where records and state live (default "
                        "~/.local/state/agent-forge/<project>/merger)")
    parser.add_argument("--checkout", default=environ.get(
        "FORGE_CRON_CHECKOUT"), help="the checkout kept at the default "
        "branch (default $FORGE_CRON_CHECKOUT)")
    parser.add_argument("--check-state", default=None,
                        help="the build check's state directory, read for "
                        "merge.queued_stall_minutes (default "
                        "~/.local/state/agent-forge/<project>/pr-check)")
    args = parser.parse_args(argv)
    if not args.checkout:
        out("NO-REPO: no --checkout, and FORGE_CRON_CHECKOUT is not set")
        return 2
    got = git(os.path.expanduser(args.checkout), "rev-parse",
              "--show-toplevel", run=run)
    repo = got.stdout.strip()
    if got.returncode != 0 or not repo:
        out("NO-REPO: %s is not a git checkout" % args.checkout)
        return 2
    try:
        project = config.load(os.path.join(repo, config.CONFIG_NAME))
    except config.ConfigError as err:
        out("NO-CONFIG: %s" % err)
        return 2
    configure(project)
    NIGHTLY_FIXES = nightly.fixes(project, environ)
    state_dir = args.state_dir or locks.state_dir(project.name, "merger",
                                                  environ)
    os.makedirs(state_dir, exist_ok=True)
    lock = locks.try_lock(os.path.join(state_dir, "lock"), str(os.getpid()))
    if lock is None:
        out("BUSY: another tick holds %s" % os.path.join(state_dir, "lock"))
        return 0
    with lock:
        # A dry run reads as `merge.read_as` when that is set.
        reader = READ_AS if args.dry_run and READ_AS else ACT_AS
        token = mint(project, reader)
        if token is None:
            out("NO-TOKEN: could not mint %s's token" % reader)
            return 2
        if (RESOLVE or STACKS) and not args.dry_run:
            RESOLVE_IDENTITY = identity(project, ACT_AS)
        check_state = None
        if QUEUED_STALL_AFTER is not None or AHEAD_BATCH > 1:
            check_state = load_check_state(
                os.path.expanduser(args.check_state) if args.check_state
                else locks.state_dir(project.name, "pr-check", environ))
        MAIN_RED_FIXES = main_red_fixes(check_state)
        # Only a live tick, and only with a stall alert, is given the
        # relay: a dry run messages nobody.
        send = ((sender or relay_sender)(project, environ)
                if STALL_ALERT and not args.dry_run else None)
        try:
            # After a merge, the next pull request is taken at once
            # rather than on the next event or cron tick.
            for _ in range(TICKS_PER_RUN):
                record = tick(repo, state_dir, GitHub(token, run), run,
                              out, live=not args.dry_run, send=send,
                              **({"check_state": check_state}
                                 if check_state is not None else {}))
                if args.dry_run or not moved_a_stack(record):
                    break
        except (RuntimeError, KeyError, TypeError, ValueError) as err:
            out("FAILED: %s" % err)
            return 2
    return 2 if "stalled" in (record or {}) else 0


if __name__ == "__main__":
    sys.exit(main())
