ROW_WHILE_ELIGIBLE = True
# merge.age_first (designs/0037): a candidate that has waited AGE_FIRST
# since a tick first saw it as one is overdue, and goes first. AGE_FILE
# remembers when; an entry no candidate for AGE_FORGET is dropped.
AGE_FIRST = None
