#!/usr/bin/env python3
"""Clear the build output of worktrees nobody is using (designs/0016).

Agents work in a git worktree per task, and each builds its own cache
(a Rust `target/` is 10 to 30 GB) that nothing removes when the task
ends. This deletes such caches, and only them: a directory is a
candidate only if it carries a valid CACHEDIR.TAG, which Cargo writes
into every `target/`. Source, git data and anything written by hand are
never touched, so a wrong decision costs one rebuild.

A cache directory is cleared only when ALL of these hold:

  1. no process has its working directory, or a file open, inside the
     worktree;
  2. every Cargo build lock in it can be taken without waiting;
  3. no FILE in it was read or written for N hours (newest atime and
     mtime of files; directories' times, and the tag file's, are
     updated by scans like this one, so they are not evidence). N is --merged-hours when the
     worktree's branch heads a merged or closed pull request, else
     --idle-hours, including when that can't be read.

The two thresholds guard each other: a merged pull request is not
proof that a worktree is finished (agents reuse them), and with
`relatime` a file's atime may be up to a day stale, which the longer
threshold allows for.

Each worktree is a directory directly under a --root (for example the
supervisor's agents directory) that has a `.git`. The pull-request
state is read from the configuration's repository, with the read token
forge-config's other tools use; without a configuration, every
worktree is judged by --idle-hours.

Designs/0041 adds, each off unless given:

  --high-water / --low-water PCT: when a root's filesystem is at least
     --high-water percent used after the normal pass, more is cleared:
     any cache that passes rules 1 and 2, whatever its idle time, least
     recently used first, until the filesystem is under --low-water. A
     cache used in the last --pressure-floor-hours (default 1) is kept.
  --every-minutes N: a run that finds every root under --high-water,
     with the last full scan less than N minutes ago, exits at once,
     so cron can run this every few minutes cheaply.
  --shared DIR: DIR's direct subdirectories that carry a valid
     CACHEDIR.TAG are caches shared between worktrees (a Cargo
     CARGO_TARGET_DIR). They are judged by --idle-hours alone, and are
     in use also while a process's environment names them as
     CARGO_TARGET_DIR.

Trimming by age (off unless given):

  --aged-cache DIR: DIR is a cache that keeps entries rather than a
     build per directory, and carries no CACHEDIR.TAG (a Go build cache,
     GOCACHE, is one). Every FILE under it neither read nor written for
     --aged-days days (default 5: the age Go's own trim uses) is
     deleted, whatever the disk use; directories are kept, since the
     cache's owner creates its layout once and expects it. The walk
     never follows a symbolic link, and a link is judged as a file by
     its own times, so nothing outside DIR is ever touched. A cache
     loses only entries old enough to be rebuilt cheaply.

Exit status:

    0   the scan finished (whatever it cleared or kept)
    2   bad arguments, or a --root could not be read
"""

import argparse
import errno
import fcntl
import hashlib
import os
import shutil
import subprocess
import sys
import time
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from agent_forge import config, github  # noqa: E402

PROG = "forge-prune-builds"

# The Cache Directory Tagging Specification's signature line.
TAG = "CACHEDIR.TAG"
SIGNATURE = b"Signature: 8a477f597d28d172789f06886806bc55"
# How deep below a worktree a cache directory may sit (target/,
# desktop/target/, crates/x/target/).
CACHE_DEPTH = 3
# The lock files Cargo holds while it builds, in each profile directory
# (debug/, release/) and each target's (wasm32-unknown-unknown/debug/).
CARGO_LOCKS = (".cargo-lock", ".cargo-build-lock", ".cargo-artifact-lock")
LOCK_DEPTH = 2
PRUNING = ".forge-pruning"


def is_cache_dir(path):
    """True if `path` holds a CACHEDIR.TAG that starts with the signature."""
    try:
        with open(os.path.join(path, TAG), "rb") as handle:
            return handle.read(len(SIGNATURE)) == SIGNATURE
    except OSError:
        return False


def walk_limited(top, depth):
    """(dirpath, dirnames) for `top` and its subdirectories down to
    `depth` levels below it, skipping .git and not following links.
    The caller may prune `dirnames` in place, as with os.walk."""
    stack = [(top, 0)]
    while stack:
        path, level = stack.pop()
        try:
            entries = [e for e in os.scandir(path)
                       if e.is_dir(follow_symlinks=False) and e.name != ".git"]
        except OSError:
            continue
        names = sorted(e.name for e in entries)
        yield path, level, names
        if level < depth:
            stack.extend((os.path.join(path, n), level + 1)
                         for n in reversed(names))


def find_caches(worktree):
    """(caches, leftovers): the tagged cache directories in `worktree`,
    and directories an interrupted run left renamed for deletion."""
    caches, leftovers = [], []
    for path, level, names in walk_limited(worktree, CACHE_DEPTH):
        if path != worktree and path.endswith(PRUNING):
            leftovers.append(path)
            names[:] = []
        elif path != worktree and is_cache_dir(path):
            caches.append(path)
            names[:] = []
    return caches, leftovers


def newest_file_time(top):
    """The newest atime or mtime of any regular file under `top`, as
    seconds; 0 when it holds no files. Links are not followed.

    Not the top's own CACHEDIR.TAG: reading it, to recognise the cache,
    is what this tool does, and that sets its atime to now."""
    newest = 0.0
    for dirpath, _dirs, files in os.walk(top):
        for name in files:
            if dirpath == top and name == TAG:
                continue
            try:
                st = os.lstat(os.path.join(dirpath, name))
            except OSError:
                continue
            newest = max(newest, st.st_atime, st.st_mtime)
    return newest


def busy_paths(proc="/proc"):
    """Every path some process has as its working directory or an open
    file, resolved."""
    paths = set()
    try:
        pids = [p for p in os.listdir(proc) if p.isdigit()]
    except OSError:
        return paths
    for pid in pids:
        base = os.path.join(proc, pid)
        links = [os.path.join(base, "cwd")]
        try:
            fds = os.listdir(os.path.join(base, "fd"))
        except OSError:
            fds = []
        links.extend(os.path.join(base, "fd", fd) for fd in fds)
        for link in links:
            try:
                target = os.readlink(link)
            except OSError:
                continue
            if target.startswith("/"):
                paths.add(target)
    return paths


def target_dirs(proc="/proc"):
    """Every CARGO_TARGET_DIR named in a process's environment, resolved
    (only processes this user may read: the agents' own)."""
    dirs = set()
    try:
        pids = [p for p in os.listdir(proc) if p.isdigit()]
    except OSError:
        return dirs
    for pid in pids:
        try:
            with open(os.path.join(proc, pid, "environ"), "rb") as handle:
                env = handle.read()
        except OSError:
            continue
        for item in env.split(b"\0"):
            if item.startswith(b"CARGO_TARGET_DIR="):
                value = os.fsdecode(item[len(b"CARGO_TARGET_DIR="):])
                if value:
                    dirs.add(os.path.realpath(value))
    return dirs


def shared_caches(root):
    """The tagged cache directories directly under `root` that aren't
    worktrees, and leftovers of an interrupted run there."""
    caches, leftovers = [], []
    try:
        entries = sorted(os.scandir(root), key=lambda e: e.name)
    except OSError:
        return caches, leftovers
    for entry in entries:
        if not entry.is_dir(follow_symlinks=False):
            continue
        if entry.name.endswith(PRUNING):
            leftovers.append(entry.path)
        elif not os.path.exists(os.path.join(entry.path, ".git")) and \
                is_cache_dir(entry.path):
            caches.append(entry.path)
    return caches, leftovers


def used_percent(path):
    """The used percentage of `path`'s filesystem, as df shows it:
    used / (used + available to unprivileged users)."""
    st = os.statvfs(path)
    used = (st.f_blocks - st.f_bfree) * st.f_frsize
    avail = st.f_bavail * st.f_frsize
    total = used + avail
    return 100.0 * used / total if total else 0.0


def is_busy(worktree, paths):
    real = os.path.realpath(worktree)
    prefix = real.rstrip("/") + "/"
    return any(p == real or p.startswith(prefix) for p in paths)


class Locks:
    """Every Cargo build lock in a cache directory, held exclusively, or
    none: `acquired` is False if any is held elsewhere."""

    def __init__(self, cache):
        self.handles = []
        self.acquired = True
        for path, _level, _names in walk_limited(cache, LOCK_DEPTH):
            for name in CARGO_LOCKS:
                lock = os.path.join(path, name)
                if not os.path.isfile(lock):
                    continue
                try:
                    handle = open(lock, "rb")
                except OSError:
                    continue
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError as err:
                    handle.close()
                    if err.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
                        self.acquired = False
                        self.release()
                        return
                    continue
                self.handles.append(handle)

    def release(self):
        for handle in self.handles:
            handle.close()
        self.handles = []


def current_branch(worktree, run=subprocess.run):
    """The worktree's branch, or None when detached or unreadable."""
    try:
        done = run(["git", "-C", worktree, "branch", "--show-current"],
                   capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    branch = done.stdout.strip() if done.returncode == 0 else ""
    return branch or None


def pr_finished(repo, token, branch, call=github.api_call):
    """True if `branch` heads a merged or closed pull request and none
    open; None when it can't be told (no repository, an API failure)."""
    if not repo or not branch:
        return None
    owner = repo.split("/")[0]
    head = urllib.parse.quote("%s:%s" % (owner, branch), safe="")
    status, items = github.paged(
        token, "/repos/%s/pulls?state=all&head=%s" % (repo, head), call=call)
    if status != 200:
        return None
    if not items:
        return False
    return all(p.get("state") == "closed" for p in items)


def hours(seconds):
    return seconds / 3600.0


def judge(cache, worktree, *, now, busy, merged_hours, idle_hours, finished,
          newest=None):
    """(clear, reason) for one cache directory. `finished()` is asked
    only when the answer depends on it."""
    if busy:
        return False, "busy (a process is using the worktree)"
    if newest is None:
        newest = newest_file_time(cache)
    idle = hours(now - newest)
    if idle < merged_hours:
        return False, "used %.0fh ago" % idle
    if idle >= idle_hours:
        return True, "idle %.0fh" % idle
    done = finished()
    if done:
        return True, "pull request finished, idle %.0fh" % idle
    why = "pull request open" if done is False else "pull request state unknown"
    return False, "%s, idle %.0fh (< %gh)" % (why, idle, idle_hours)


def delete(path):
    shutil.rmtree(path, ignore_errors=True)


def size_kib(path):
    total = 0
    for dirpath, _dirs, files in os.walk(path):
        for name in files:
            try:
                total += os.lstat(os.path.join(dirpath, name)).st_blocks // 2
            except OSError:
                pass
    return total


def worktrees(root):
    for entry in sorted(os.scandir(root), key=lambda e: e.name):
        if entry.is_dir(follow_symlinks=False) and \
                os.path.exists(os.path.join(entry.path, ".git")):
            yield entry.path


def clear(cache, reason, *, dry_run, out):
    """Clear one cache under its Cargo locks; its size in KiB, or None
    when a build holds a lock."""
    locks = Locks(cache)
    if not locks.acquired:
        out("kept %s: locked (a build is running)" % cache)
        return None
    try:
        kib = size_kib(cache)
        if dry_run:
            out("would clear %s (%.1f GB): %s" % (cache, kib / 1048576, reason))
        else:
            doomed = cache + PRUNING
            os.rename(cache, doomed)
            locks.release()
            delete(doomed)
            out("cleared %s (%.1f GB): %s" % (cache, kib / 1048576, reason))
        return kib
    finally:
        locks.release()


def drop_leftovers(leftovers, *, dry_run, out):
    for left in leftovers:
        out("%s %s: leftover of an interrupted run" % (
            "would delete" if dry_run else "deleted", left))
        if not dry_run:
            delete(left)


def prune(roots, *, dry_run, merged_hours, idle_hours, repo, token,
          now=None, busy=None, branch_of=current_branch, finished_of=pr_finished,
          out=print, shared=(), high_water=None, low_water=None,
          floor_hours=1.0, targets=None, usage=used_percent):
    """Scan `roots` (and `shared`), clear what the rules allow, then,
    with `high_water`, clear more under pressure; (cleared, kept, KiB)."""
    now = time.time() if now is None else now
    busy = busy_paths() if busy is None else busy
    cleared = kept = freed = 0
    # Kept caches nothing is using, for the pressure pass:
    # (newest file time, cache, the root it was found under).
    spare = []
    for root in roots:
        for wt in worktrees(root):
            caches, leftovers = find_caches(wt)
            drop_leftovers(leftovers, dry_run=dry_run, out=out)
            in_use = is_busy(wt, busy)
            branch = []

            def finished():
                if not branch:
                    branch.append(branch_of(wt))
                return finished_of(repo, token, branch[0])

            for cache in caches:
                newest = None if in_use else newest_file_time(cache)
                ok, reason = judge(
                    cache, wt, now=now, busy=in_use, merged_hours=merged_hours,
                    idle_hours=idle_hours, finished=finished, newest=newest)
                kib = clear(cache, reason, dry_run=dry_run, out=out) if ok else None
                if kib is None:
                    if not ok:
                        out("kept %s: %s" % (cache, reason))
                    kept += 1
                    if not in_use:
                        spare.append((newest, cache, root))
                    continue
                cleared += 1
                freed += kib
    if shared:
        targets = target_dirs() if targets is None else targets
    for root in shared:
        caches, leftovers = shared_caches(root)
        drop_leftovers(leftovers, dry_run=dry_run, out=out)
        for cache in caches:
            real = os.path.realpath(cache)
            in_use = is_busy(cache, busy) or any(
                t == real or t.startswith(real.rstrip("/") + "/")
                for t in targets)
            if in_use:
                out("kept %s: busy (a process is using it)" % cache)
                kept += 1
                continue
            newest = newest_file_time(cache)
            idle = hours(now - newest)
            ok = idle >= idle_hours
            reason = "shared, idle %.0fh" % idle
            kib = clear(cache, reason, dry_run=dry_run, out=out) if ok else None
            if kib is None:
                if not ok:
                    out("kept %s: shared, used %.0fh ago (< %gh)" % (
                        cache, idle, idle_hours))
                kept += 1
                spare.append((newest, cache, root))
                continue
            cleared += 1
            freed += kib
    if high_water is not None:
        n, kib = relieve(spare, sorted(set(roots) | set(shared)),
                         dry_run=dry_run, now=now, high_water=high_water,
                         low_water=low_water, floor_hours=floor_hours,
                         usage=usage, out=out)
        cleared += n
        kept -= n
        freed += kib
    return cleared, kept, freed


def relieve(spare, roots, *, dry_run, now, high_water, low_water,
            floor_hours, usage, out):
    """The pressure pass: for each root whose filesystem is at least
    `high_water` percent used, clear its spare caches, least recently
    used first, until it is under `low_water`; (cleared, KiB)."""
    cleared = freed = 0
    for root in roots:
        before = usage(root)
        if before < high_water:
            continue
        out("pressure: %s is %.0f%% used (high-water %g%%)" % (
            root, before, high_water))
        # A dry run deletes nothing, so it estimates from sizes.
        st = os.statvfs(root)
        total_kib = ((st.f_blocks - st.f_bfree) + st.f_bavail) * st.f_frsize / 1024
        pretend = 0
        now_used = before
        for newest, cache, where in sorted(c for c in spare if c[2] == root):
            if now_used < low_water:
                break
            idle = hours(now - newest)
            if idle < floor_hours:
                continue
            kib = clear(cache, "pressure: used %.0fh ago" % idle,
                        dry_run=dry_run, out=out)
            if kib is None:
                continue
            cleared += 1
            freed += kib
            if dry_run:
                pretend += kib
                now_used = before - (100.0 * pretend / total_kib if total_kib else 0)
            else:
                now_used = usage(root)
        out("pressure: %s %s %.0f%% used (low-water %g%%)" % (
            root, "would be" if dry_run else "now", now_used, low_water))
    return cleared, freed


def stamp_path(roots, environ):
    """Where the time of the last full scan of these roots is kept."""
    home = environ.get("HOME") or os.path.expanduser("~")
    base = environ.get("FORGE_STATE_DIR") or os.path.join(
        environ.get("XDG_STATE_HOME") or os.path.join(home, ".local", "state"),
        "agent-forge")
    key = hashlib.sha256("\0".join(sorted(roots)).encode()).hexdigest()[:16]
    return os.path.join(base, PROG, "last-scan-" + key)


def last_scan(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return None


def mark_scan(path, now):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as handle:
        handle.write("%d\n" % now)
    os.utime(path, (now, now))


def trim_aged(path, max_age_s, *, now, dry_run, out):
    """Delete every file under `path` not read or written for `max_age_s`
    seconds (newest of atime and mtime, by lstat: a link is judged by
    itself and never followed). Directories stay. Returns (files, KiB)."""
    cutoff = now - max_age_s
    files = kib = 0
    for dirpath, _dirs, names in os.walk(path, followlinks=False):
        for name in names:
            full = os.path.join(dirpath, name)
            try:
                st = os.lstat(full)
            except OSError:
                continue
            if max(st.st_atime, st.st_mtime) >= cutoff:
                continue
            if not dry_run:
                try:
                    os.unlink(full)
                except OSError:
                    continue
            files += 1
            kib += st.st_blocks // 2
    out("%s: %s %d file(s), %.1f MB older than %.1f days in %s" % (
        PROG, "would trim" if dry_run else "trimmed", files, kib / 1024,
        max_age_s / 86400, path))
    return files, kib


def main(argv=None, out=print, err=None, environ=None, **hooks):
    err = err or (lambda m: print(m, file=sys.stderr))
    environ = os.environ if environ is None else environ
    parser = argparse.ArgumentParser(prog=PROG, description=__doc__.splitlines()[0])
    parser.add_argument("--root", action="append", required=True,
                        help="a directory whose subdirectories are worktrees (repeatable)")
    parser.add_argument("--merged-hours", type=float, default=6,
                        help="idle hours before clearing, when the pull request is finished (default 6)")
    parser.add_argument("--idle-hours", type=float, default=48,
                        help="idle hours before clearing otherwise (default 48)")
    parser.add_argument("--dry-run", action="store_true",
                        help="report what would be cleared, delete nothing")
    parser.add_argument("--shared", action="append", default=[],
                        help="a directory whose tagged subdirectories are "
                             "caches shared between worktrees (repeatable)")
    parser.add_argument("--high-water", type=float,
                        help="used percent of a root's filesystem at which "
                             "to clear more, least recently used first")
    parser.add_argument("--low-water", type=float,
                        help="used percent to clear down to under pressure")
    parser.add_argument("--pressure-floor-hours", type=float, default=1,
                        help="under pressure, keep caches used this recently "
                             "(default 1)")
    parser.add_argument("--aged-cache", action="append", default=[],
                        help="an untagged cache (such as GOCACHE) whose "
                             "files are deleted once --aged-days old "
                             "(repeatable)")
    parser.add_argument("--aged-days", type=float, default=5,
                        help="days unused before an --aged-cache file is "
                             "deleted (default 5)")
    parser.add_argument("--every-minutes", type=float,
                        help="skip the scan if every root is under "
                             "--high-water and the last was this recent")
    args = parser.parse_args(argv)
    if args.merged_hours < 0 or args.idle_hours < args.merged_hours:
        err("%s: need 0 <= --merged-hours <= --idle-hours" % PROG)
        return 2
    if (args.high_water is None) != (args.low_water is None):
        err("%s: --high-water and --low-water go together" % PROG)
        return 2
    if args.high_water is not None and not (
            0 < args.low_water <= args.high_water <= 100):
        err("%s: need 0 < --low-water <= --high-water <= 100" % PROG)
        return 2
    if args.aged_days <= 0:
        err("%s: --aged-days must be > 0" % PROG)
        return 2
    if args.pressure_floor_hours < 0 or (
            args.every_minutes is not None and args.every_minutes <= 0):
        err("%s: --pressure-floor-hours must be >= 0, --every-minutes > 0" % PROG)
        return 2
    roots = [os.path.expanduser(r) for r in args.root]
    shared = [os.path.expanduser(r) for r in args.shared]
    aged = [os.path.expanduser(r) for r in args.aged_cache]
    for top in aged:
        # A link as the cache itself would send the walk elsewhere, and
        # "/" or the home directory is never a cache.
        if os.path.islink(top) or not os.path.isdir(top) or \
                os.path.realpath(top) in ("/", os.path.realpath(
                    os.path.expanduser("~"))):
            err("%s: --aged-cache %s is not a cache directory" % (PROG, top))
            return 2
    for root in roots + shared:
        if not os.path.isdir(root):
            err("%s: %s is not a directory" % (PROG, root))
            return 2
    now = hooks.get("now")
    now = time.time() if now is None else now
    usage = hooks.get("usage", used_percent)
    stamp = stamp_path(roots + shared, environ)
    if args.every_minutes is not None:
        last = last_scan(stamp)
        calm = args.high_water is None or all(
            usage(r) < args.high_water for r in roots + shared)
        if calm and last is not None and now - last < args.every_minutes * 60:
            out("%s: skipped, last full scan %.0f min ago and no root over "
                "its high-water mark" % (PROG, (now - last) / 60))
            return 0
    repo = token = None
    if "finished_of" not in hooks:
        try:
            project = config.load(environ=environ)
            repo = project.repo
            token = github.read_token(project, environ)
        except config.ConfigError as e:
            err("%s: no configuration (%s); judging every worktree by --idle-hours"
                % (PROG, e))
    hooks = dict(hooks, now=now)
    cleared, kept, kib = prune(
        roots, dry_run=args.dry_run, merged_hours=args.merged_hours,
        idle_hours=args.idle_hours, repo=repo, token=token, out=out,
        shared=shared, high_water=args.high_water, low_water=args.low_water,
        floor_hours=args.pressure_floor_hours, **hooks)
    for top in aged:
        trim_aged(top, args.aged_days * 86400, now=now,
                  dry_run=args.dry_run, out=out)
    if args.every_minutes is not None and not args.dry_run:
        mark_scan(stamp, now)
    out("%s: %s %d, kept %d, %.1f GB" % (
        PROG, "would clear" if args.dry_run else "cleared", cleared, kept, kib / 1048576))
    return 0


if __name__ == "__main__":
    sys.exit(main())
