#!/usr/bin/env python3
"""Compare a host's agent settings and crontab with the project's tracked copies, or install them.

Every agent session on a host loads the same files: Claude Code's
~/.claude/settings.json, and the hooks it names. Each host also runs a
crontab. Edited by hand on one host, they drift silently from the
others, and a crontab installed on the wrong host runs its jobs twice.
The project tracks its copies, lists the files in its configuration's
`host_settings.files` and each host's crontab in
`host_settings.crontabs` (keyed by the host's short name); they change
by pull request like anything else.

    forge-host-settings --check      0 when the host matches; 1 when it
                                     differs (a unified diff on stdout);
                                     2 when a tracked copy can't be read
    forge-host-settings --install    write the tracked copies over the host's
    forge-host-settings --apply      the same, from cron: says nothing
                                     when there is nothing to do

**Installing follows approval on the default branch.** The settings
decide what agents may do without asking, and the crontab what runs
unattended, so their tracked copies should be code-owned: a change
reaches the default branch only with the owner's approving review.
Once it has, `--apply`, run from each host's crontab every few minutes,
installs it there, so nobody types install commands on each host. A
project that wants a person to install by hand leaves `--apply` out of
its crontabs and runs `--install`. Running sessions pick settings up
only when they next start.

**Which crontab.** A host installs the entry in `host_settings.crontabs`
for its own short name (`--host`, else $FORGE_HOST_NAME, else the
hostname up to its first dot), and never another host's. A host with no
entry keeps whatever crontab it has: `--check` and `--install` say so,
and `--apply` says nothing. A crontab compares as text. `--apply` won't
install a crontab that drops the `forge-host-settings --apply` line the
host's own crontab has, since that would turn the installing off
silently; `--install`, run by a person, will.

**What counts as a difference.** A file marked `json` is compared as
JSON, so key order and layout don't count, and the keys in
`host_settings.host_keys`, which Claude Code writes itself to record a choice
made in its interface, are the host's: `--check` ignores them and
`--install` keeps them.

**What `--install` guarantees.** It refuses a JSON file that isn't
valid, before writing anything. It writes only the files that differ,
keeps each replaced file under
~/.local/state/agent-forge/<project>/host-settings/backups/ as
`<name>.<UTC timestamp>` (never beside the file: every file in a hooks
directory is taken for a hook), and writes through a temporary file and
a rename, so a failure leaves the old file whole. A replaced crontab is
kept there too, as `crontab.<UTC timestamp>`. A second run finds
nothing to do.

The copies are read from the project's cron checkout
($FORGE_CRON_CHECKOUT), which is kept at the default branch, not from
the working tree this runs in: installing a branch by mistake would
otherwise be one `cd` away. `--tree PATH` reads another checkout, on
purpose.
"""
import argparse
import datetime
import difflib
import json
import os
import socket
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from agent_forge import config, locks  # noqa: E402


class Unreadable(Exception):
    """A tracked copy is missing, unreadable or invalid."""


def read(path):
    """The file's text, or None if it doesn't exist."""
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except FileNotFoundError:
        return None


def tracked(tree, files, home):
    """[(installed path, text, mode, is JSON)] for every tracked file,
    validated."""
    out = []
    for rel, dest, mode, is_json in files:
        src = os.path.join(tree, rel)
        try:
            text = read(src)
        except OSError as err:
            raise Unreadable("%s: %s" % (src, err)) from err
        if text is None:
            raise Unreadable("%s: no such file" % src)
        if is_json:
            try:
                json.loads(text)
            except ValueError as err:
                raise Unreadable("%s is not valid JSON: %s" % (src, err)) from err
        out.append((os.path.join(home, dest), text, mode, is_json))
    return out


def settings_of(text, host_keys=()):
    """The settings `text` holds, less the host's own keys. ValueError if
    it isn't a JSON object: a host file of `[]` or `null` is no settings."""
    d = json.loads(text)
    if not isinstance(d, dict):
        raise ValueError("not a JSON object")
    for k in host_keys:
        d.pop(k, None)
    return d


def same(have, text, is_json, host_keys=()):
    """Whether the host's file `have` matches the tracked `text`. A JSON
    file matches when it holds the same settings: Claude Code rewrites the
    file when it records a host key, and may reorder an object's keys as
    it does, so neither key order nor layout is a difference."""
    if have == text:
        return True
    if not is_json or have is None:
        return False
    try:
        return settings_of(have, host_keys) == settings_of(text, host_keys)
    except ValueError:
        return False


def wanted(text, have, is_json, host_keys=()):
    """What to install over `have`: the tracked text, plus the host keys
    `have` sets, so an install doesn't undo a choice made on the host."""
    if not is_json or have is None:
        return text
    try:
        host = json.loads(have)
    except ValueError:
        return text  # a corrupt host file has no choices to keep
    if not isinstance(host, dict):
        return text
    kept = {k: host[k] for k in host_keys if k in host}
    if not kept:
        return text
    d = json.loads(text)
    d.update(kept)
    return json.dumps(d, indent=2, ensure_ascii=False) + "\n"


def differences(files, host_keys=(), read=read):
    """[(installed path, unified diff)] for each file the host has wrong."""
    out = []
    for dest, text, _mode, is_json in files:
        have = read(dest)
        if same(have, text, is_json, host_keys):
            continue
        want = wanted(text, have, is_json, host_keys)
        diff = "".join(difflib.unified_diff(
            (have or "").splitlines(keepends=True), want.splitlines(keepends=True),
            fromfile=dest + (" (absent)" if have is None else ""),
            tofile="tracked"))
        out.append((dest, diff))
    return out


def install_one(dest, text, mode, backups, now=None):
    """Write `text` to `dest` atomically, keeping the old file. The backup's
    path, or None when there was no old file."""
    now = now or datetime.datetime.now(datetime.timezone.utc)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    backup = None
    if os.path.exists(dest):
        folder = backups
        os.makedirs(folder, exist_ok=True)
        backup = os.path.join(folder, "%s.%s" % (
            os.path.basename(dest), now.strftime("%Y%m%dT%H%M%SZ")))
        with open(dest, "rb") as src, open(backup, "wb") as out:
            out.write(src.read())
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(dest),
                               prefix="." + os.path.basename(dest) + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, dest)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return backup


# The line in a crontab that keeps installing it; --apply won't drop it.
APPLY_LINE = "forge-host-settings --apply"


def run_crontab(args, text=None):
    """(exit status, stdout, stderr) of `crontab <args>`."""
    try:
        got = subprocess.run(["crontab"] + list(args), input=text,
                             capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as err:
        return 127, "", str(err)
    return got.returncode, got.stdout, got.stderr


def installed_crontab(run=run_crontab):
    """The host's crontab, or None if it has none. Unreadable when
    `crontab -l` fails for any other reason."""
    code, out, err = run(["-l"])
    if code == 0:
        return out
    if "no crontab" in err.lower():
        return None
    raise Unreadable("crontab -l: %s" % (err.strip() or "exit %d" % code))


def crontab_of(project, tree, host):
    """The tracked crontab for `host`, or None when it has no entry."""
    rel = project.section("host_settings").get("crontabs", {}).get(host)
    if rel is None:
        return None
    src = os.path.join(tree, rel)
    try:
        text = read(src)
    except OSError as err:
        raise Unreadable("%s: %s" % (src, err)) from err
    if text is None:
        raise Unreadable("%s: no such file" % src)
    return text


def install_crontab(text, have, backups, run=run_crontab, now=None):
    """Install `text` as the crontab, keeping `have`. The backup's path,
    or None when there was no crontab. Unreadable when crontab refuses
    it, which leaves the old one in place."""
    now = now or datetime.datetime.now(datetime.timezone.utc)
    backup = None
    if have is not None:
        os.makedirs(backups, exist_ok=True)
        backup = os.path.join(backups, "crontab.%s"
                              % now.strftime("%Y%m%dT%H%M%SZ"))
        with open(backup, "w", encoding="utf-8") as fh:
            fh.write(have)
    code, _out, err = run(["-"], text)
    if code != 0:
        raise Unreadable("crontab refused the tracked copy: %s"
                         % (err.strip() or "exit %d" % code))
    return backup


def host_name(args, environ, hostname=socket.gethostname):
    return args.host or environ.get("FORGE_HOST_NAME") \
        or hostname().split(".")[0]


def files_of(project):
    """(tracked path, installed path, mode, is JSON) for each host file."""
    return [(f["from"], f["to"], int(f.get("mode", "0644"), 8),
             bool(f.get("json"))) for f in project.section("host_settings")
            .get("files", [])]


def main(argv=None, out=sys.stdout, err=sys.stderr, environ=None,
         run=run_crontab, hostname=socket.gethostname):
    environ = os.environ if environ is None else environ
    parser = argparse.ArgumentParser(prog="forge-host-settings",
                                     description=__doc__.splitlines()[0])
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--check", action="store_true",
                       help="report differences; change nothing")
    group.add_argument("--install", action="store_true",
                       help="write the tracked copies over the host's")
    group.add_argument("--apply", action="store_true",
                       help="--install, from cron: quiet when nothing "
                       "differs")
    parser.add_argument("--tree", default=environ.get("FORGE_CRON_CHECKOUT"),
                        help="the checkout to read the copies from "
                        "(default $FORGE_CRON_CHECKOUT)")
    parser.add_argument("--host", help="this host's short name, for its "
                        "crontab (default $FORGE_HOST_NAME, else the "
                        "hostname)")
    args = parser.parse_args(argv)
    if not args.tree:
        print("forge-host-settings: no --tree, and FORGE_CRON_CHECKOUT is "
              "not set", file=err)
        return 2
    tree = os.path.expanduser(args.tree)
    home = os.path.expanduser(environ.get("HOME") or "~")
    try:
        project = config.load(os.path.join(tree, config.CONFIG_NAME))
    except config.ConfigError as exc:
        print("forge-host-settings: %s" % exc, file=err)
        return 2
    section = project.section("host_settings")
    host_keys = tuple(section.get("host_keys", []))
    if not files_of(project) and not section.get("crontabs"):
        print("forge-host-settings: %s lists no host_settings.files or "
              "crontabs" % project.path, file=err)
        return 2
    host = host_name(args, environ, hostname)
    try:
        files = tracked(tree, files_of(project), home)
        cron = crontab_of(project, tree, host)
        have_cron = installed_crontab(run) if cron is not None else None
    except Unreadable as exc:
        print("forge-host-settings: %s; nothing written" % exc, file=err)
        return 2
    wrong = differences(files, host_keys)
    cron_wrong = cron is not None and cron != have_cron
    if section.get("crontabs") and cron is None and not args.apply:
        print("forge-host-settings: no crontab is tracked for host %r; its "
              "crontab is left alone" % host, file=out)
    if args.check:
        for _dest, diff in wrong:
            out.write(diff)
        if cron_wrong:
            out.write("".join(difflib.unified_diff(
                (have_cron or "").splitlines(keepends=True),
                cron.splitlines(keepends=True),
                fromfile="crontab -l" + (" (none)" if have_cron is None
                                         else ""),
                tofile="tracked crontab for %s" % host)))
        if wrong or cron_wrong:
            names = [d for d, _ in wrong] + (["crontab"] if cron_wrong else [])
            print("forge-host-settings: %d file(s) differ from %s: %s"
                  % (len(names), tree, ", ".join(names)), file=err)
            return 1
        print("forge-host-settings: host matches %s" % tree, file=out)
        return 0
    if not wrong and not cron_wrong:
        if not args.apply:
            print("forge-host-settings: nothing to install; host matches %s"
                  % tree, file=out)
        return 0
    backups = os.path.join(locks.state_dir(project.name, "host-settings",
                                           environ), "backups")
    modes = {dest: (text, mode, is_json) for dest, text, mode, is_json in files}
    for dest, _diff in wrong:
        text, mode, is_json = modes[dest]
        backup = install_one(dest, wanted(text, read(dest), is_json,
                                          host_keys), mode, backups)
        print("forge-host-settings: installed %s%s" % (
            dest, "; kept the old file as %s" % backup if backup else ""),
            file=out)
    if wrong:
        print("forge-host-settings: sessions pick the settings up when they "
              "next start", file=out)
    if cron_wrong:
        if args.apply and have_cron is not None and APPLY_LINE in have_cron \
                and APPLY_LINE not in cron:
            print("forge-host-settings: the tracked crontab for %s has no "
                  "%r line, so installing it would stop these installs; "
                  "left alone: install it by hand with --install" % (
                      host, APPLY_LINE), file=err)
            return 1
        try:
            backup = install_crontab(cron, have_cron, backups, run)
        except Unreadable as exc:
            print("forge-host-settings: %s" % exc, file=err)
            return 1
        print("forge-host-settings: installed the crontab for %s%s" % (
            host, "; kept the old one as %s" % backup if backup else ""),
            file=out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
