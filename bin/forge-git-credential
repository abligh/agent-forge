#!/usr/bin/env python3
"""Give git a push credential: the stamped agent's App installation token.

Every agent's writes to GitHub go through its own App, and that
includes `git push`. Over SSH with a host's deploy key, GitHub records
every push, and every workflow run a push starts, as the key owner's.
A worktree switched over by `forge-worktree-identity --push app` pushes
over HTTPS instead, and git asks this helper for the credential.

It speaks git's credential-helper protocol (gitcredentials(7)). On
`get` for `https://github.com` it:

1. reads the agent from `git config --worktree user.name`, the identity
   stamp. Only the worktree scope counts, and only with
   `extensions.worktreeConfig` on: without it `--worktree` reads the
   repository's shared config, and a name there would stamp every
   worktree at once;
2. mints that agent's installation token (agent_forge.github), with the
   project's configuration found from the worktree;
3. answers `username=x-access-token` and `password=<token>`.

**It never falls back.** An unstamped worktree, or a mint that fails,
answers nothing and exits 1 after saying on stderr which it was, and
git then fails the push. Borrowing another credential would bring back
the misattribution this exists to remove.

**It stores nothing.** A token lasts an hour and a push takes seconds,
so each `get` mints afresh. `store` and `erase` are accepted and
ignored, as is a `get` for any other host or protocol, which exits 0
with no answer so git can ask whatever else is configured.

The token is written only to git, on stdout. It is never logged.

Exit status:

    0   answered, or nothing to answer
    1   no credential: the worktree is unstamped, or the mint failed
    2   usage: no action, or an unknown one
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from agent_forge import config, github, proc  # noqa: E402

HOST = "github.com"


def read_request(stream):
    """The key=value attributes git sent, up to a blank line or EOF."""
    attrs = {}
    for line in stream:
        line = line.rstrip("\n")
        if not line:
            break
        key, sep, value = line.partition("=")
        if sep:
            attrs[key] = value
    return attrs


def stamped_agent(run=proc.sh):
    """The agent this worktree is stamped as, or (None, why not)."""
    ext = run(["git", "config", "--get", "extensions.worktreeConfig"])
    if ext.stdout.strip().lower() != "true":
        return None, ("extensions.worktreeConfig is off, so this worktree "
                      "has no stamp of its own")
    name = run(["git", "config", "--worktree", "--get", "user.name"])
    agent = name.stdout.strip() if name.returncode == 0 else ""
    if not agent:
        return None, "this worktree has no user.name at worktree scope"
    return agent, None


def mint(agent, load=config.load, token=github.token):
    """(token, None) or (None, why not)."""
    try:
        return token(load(), agent), None
    except (config.ConfigError, github.MintError) as err:
        return None, str(err)


def main(argv=None, stdin=None, stdout=None, run=proc.sh, minter=mint):
    argv = sys.argv[1:] if argv is None else argv
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    if len(argv) != 1 or argv[0] not in ("get", "store", "erase"):
        print("usage: forge-git-credential get|store|erase "
              "(git runs this; see gitcredentials(7))", file=sys.stderr)
        return 2
    request = read_request(stdin)
    if argv[0] != "get":
        return 0
    if request.get("protocol") != "https" or request.get("host") != HOST:
        return 0
    agent, why = stamped_agent(run)
    if agent is None:
        print("forge-git-credential: no push credential: %s. Run "
              "forge-worktree-identity <Agent> here first; this helper "
              "does not fall back to another login." % why, file=sys.stderr)
        return 1
    token, why = minter(agent)
    if token is None:
        print("forge-git-credential: no push credential for %s: %s"
              % (agent, why), file=sys.stderr)
        return 1
    stdout.write("username=x-access-token\npassword=%s\n" % token)
    return 0


if __name__ == "__main__":
    sys.exit(main())
