#!/usr/bin/env python3
"""Write a body file from stdin with the agent's sign-off appended.

    forge-new-body NAME < body.txt    writes NAME.md, prints its path

The rules are agent_forge.signing's: the agent is $FORGE_AGENT, never
guessed; exactly one sign-off ends the file however many the caller
wrote; an @-mention outside code is refused; a backticked handle is
warned about, since a squash commit message carries it live.

**Where.** Outside any repository, so `git add -A` can't stage a draft:
$FORGE_BODY_DIR if set, else ${TMPDIR:-/tmp}/agent-forge-bodies/<agent>.
Per agent, so two agents writing `body` don't post each other's text
over their own signatures. Not a temporary directory: drafts persist so
they can be found again. `NAME.md` and `NAME` both write NAME.md.

Exit: 0 written (the path on stdout); 1 could not write; 2 usage or a
bad FORGE_AGENT; 3 the sign-off postcondition failed; 4 an @-mention.
"""
import os
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from agent_forge import signing  # noqa: E402


def body_dir(name, environ=None):
    environ = os.environ if environ is None else environ
    return environ.get("FORGE_BODY_DIR") or os.path.join(
        environ.get("TMPDIR") or tempfile.gettempdir(),
        "agent-forge-bodies", name)


def main(argv=None, stdin=None, out=print, err=None, environ=None):
    argv = sys.argv[1:] if argv is None else argv
    stdin = sys.stdin if stdin is None else stdin
    err = err or (lambda line: print(line, file=sys.stderr))
    if len(argv) != 1 or not argv[0] or "/" in argv[0]:
        err("usage: forge-new-body NAME < body")
        return 2
    try:
        agent = signing.agent(environ)
    except signing.SigningError as e:
        err("forge-new-body: %s" % e)
        return e.status
    directory = body_dir(agent, environ)
    name = argv[0][:-3] if argv[0].endswith(".md") else argv[0]
    path = os.path.join(directory, name + ".md")
    body = signing.signed(stdin.read(), agent)
    try:
        os.makedirs(directory, exist_ok=True)
        with open(path, "w") as handle:
            handle.write(body)
    except OSError as e:
        err("forge-new-body: %s" % e)
        return 1
    found = signing.mentions(body)
    if found:
        err("forge-new-body: %s contains an @-mention; these resolve to real "
            "strangers' GitHub accounts. Write the name plain:" % path)
        for number, handle in found:
            err("    %d: %s" % (number, handle))
        return 4
    handles = signing.code_handles(body)
    if handles:
        err("forge-new-body: NOTE %s has backticked handles: %s. Inert in a "
            "comment, NOT in a commit message, which isn't rendered as "
            "markdown: a single-commit pull request's squash message carries "
            "them live." % (path, " ".join(handles)))
    lines = body.splitlines()
    if lines.count(signing.sign_off(agent)) != 1 or \
            lines[-1] != signing.sign_off(agent):
        err("forge-new-body: %s does not end with exactly one sign-off"
            % path)
        return 3
    out(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
