.tile .v{font-size:28px;font-weight:600}
.tile .l{color:var(--ink2);font-size:13px}
.now{font-size:14px}.now b{font-variant-numeric:tabular-nums}
"""


def esc(value):
    return html.escape("-" if value is None else str(value))


def num(value, digits=1):
    if value is None:
        return "-"
    if isinstance(value, float):
        return "%.*f" % (digits, value)
    return str(value)


def minutes_text(m):
    if m is None:
        return "-"
    return "%d min" % m if m < 120 else "%.1f h" % (m / 60)


def css_vars():
    light = "".join("--s%d:%s;" % (i, COLOURS[s][0])
                    for i, s in enumerate(STATES))
    dark = "".join("--s%d:%s;" % (i, COLOURS[s][1])
                   for i, s in enumerate(STATES))
    return CSS % (light, dark)


def state_var(state):
    return "var(--s%d)" % STATES.index(state)


def key_html():
    return '<div class="key">%s</div>' % "".join(
        '<span><i class="sw" style="background:%s"></i>%s</span>'
        % (state_var(s), esc(s)) for s in STATES)


def hourly_svg(rows):
    """Minutes in each state, one stacked column an hour."""
    width, height, left, bottom = 720, 190, 28, 18
    col = (width - left) / max(1, len(rows))
    scale = (height - bottom - 6) / 60.0
    parts = ['<svg viewBox="0 0 %d %d" width="100%%" role="img" '
             'aria-label="Minutes in each Merger state, each hour">'
             % (width, height)]
    for m in (0, 30, 60):
        y = height - bottom - m * scale
        parts.append('<line x1="%d" x2="%d" y1="%.1f" y2="%.1f" '
                     'style="stroke:var(--grid)"/><text x="0" y="%.1f">%d'
                     '</text>' % (left, width, y, y, y + 3, m))
    for i, row in enumerate(rows):
        x = left + i * col + 1
        y = height - bottom
        for state in STATES:
            m = row["states"].get(state, 0)
            if m <= 0:
                continue
            h = m * scale
            y -= h
            parts.append(
                '<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" '
                'rx="1.5" style="fill:%s"><title>%s %s: %.0f min</title></rect>'
                % (x, y, col - 2, max(0.5, h - 1), state_var(state),
                   esc(row["hour"][11:16]), esc(state), m))
        if i % 3 == 0:
            parts.append('<text x="%.1f" y="%d">%s</text>'
                         % (x, height - 4, esc(row["hour"][11:13])))
    parts.append("</svg>")
    return "".join(parts)


# The graphs' two series colours: the categorical slots 1 and 2.
SERIES = ("var(--c1)", "var(--c2)")
# Targets: the owner's bar for merges, and where builds per pull request
# would be with full batching.
MERGE_BAR = 10
RUNS_PER_MERGE_TARGET = 1.1
RUNS_PER_PR_TARGET = 2


def nice_ticks(top):
    """Clean y ticks from 0 to at least `top`: 0 and up to 4 more."""
    top = top if top and top > 0 else 1
    base = 10 ** math.floor(math.log10(top / 4))
    for m in (1, 2, 2.5, 5, 10):
        step = base * m
        if top / step <= 4:
            break
    count = math.ceil(top / step - 1e-9)
    return [round(step * i, 6) for i in range(count + 1)]


def tick_text(value):
    return ("%d" % value if value == int(value)
            else ("%.2f" % value).rstrip("0"))


def chart(cid, title, desc, unit, slots, series, ticks_x, ref=None,
          bars=False, x_label="hour (UTC)", gap="no value", partial=()):
    """One small graph, as inline SVG: `slots` names each x position
    (for its tooltip), `series` is [(name, values)] with None for a
    gap, `ticks_x` is [(index, text)], `ref` an optional (value, text)
    reference line. Bars for one series, else lines. A gap draws
    nothing, and `gap` says why under a run of three or more; a zero
    bar is a stub on the baseline. A bar whose slot is in `partial` (the
    hour under way) is drawn lighter: so far, not a whole hour."""
    width, height = 360, 200
    left, right, top, bottom = 30, 10, 18, 30
    multi = len(series) > 1
    if multi:
        right = 44
    values = [v for _, vs in series for v in vs if v is not None]
    ticks = nice_ticks(max(values + ([ref[0] * 1.15] if ref else []),
                           default=0))
    y_top = ticks[-1]
    plot_w, plot_h = width - left - right, height - top - bottom
    col = plot_w / max(1, len(slots))

    def x(i):
        return left + (i + 0.5) * col

    def y(v):
        return top + plot_h * (1 - v / y_top)
    parts = ['<svg viewBox="0 0 %d %d" width="100%%" role="img" '
             'aria-labelledby="%s-t %s-d"><title id="%s-t">%s</title>'
             '<desc id="%s-d">%s</desc>'
             % (width, height, cid, cid, cid, esc(title), cid, esc(desc))]
    for t in ticks:
        parts.append('<line x1="%d" x2="%d" y1="%.1f" y2="%.1f" class="%s"/>'
                     '<text x="%d" y="%.1f" text-anchor="end">%s</text>'
                     % (left, width - right, y(t), y(t),
                        "axis" if t == 0 else "grid", left - 4, y(t) + 3.5,
                        tick_text(t)))
    parts.append('<text x="0" y="9">%s</text>' % esc(unit))
    parts.append('<text x="%d" y="%d" text-anchor="end">%s</text>'
                 % (width - right, height - 2, esc(x_label)))
    for i, text in ticks_x:
        parts.append('<text x="%.1f" y="%d" text-anchor="middle">%s</text>'
                     % (x(i), top + plot_h + 13, esc(text)))
    if ref:
        # The line across the plot, keyed above it, clear of the marks.
        key_x = width - right - 6 * len(ref[1]) - 22
        parts.append('<line x1="%d" x2="%d" y1="%.1f" y2="%.1f" '
                     'class="ref"/><line x1="%d" x2="%d" y1="6" y2="6" '
                     'class="ref"/><text x="%d" y="9" class="reft">%s</text>'
                     % (left, width - right, y(ref[0]), y(ref[0]), key_x,
                        key_x + 16, key_x + 20, esc(ref[1])))
    if not values:
        parts.append('<text x="%.1f" y="%.1f" text-anchor="middle" '
                     'class="reft">no data yet</text>'
                     % (left + plot_w / 2, top + plot_h / 2))
    ends = []
    for k, (name, vs) in enumerate(series):
        colour = SERIES[k]
        if bars:
            w = min(24.0, col - 2)
            r = min(4.0, w / 2)
            for i, v in enumerate(vs):
                if v is None:
                    continue
                if v == 0:
                    parts.append('<rect x="%.1f" y="%.1f" width="%.1f" '
                                 'height="1.5" class="zero"/>'
                                 % (x(i) - w / 2, y(0) - 1.5, w))
                    continue
                x0, y0, h = x(i) - w / 2, y(v), y(0) - y(v)
                rr = min(r, h)
                parts.append(
                    '<path d="M%.1f %.1fV%.1fQ%.1f %.1f %.1f %.1fH%.1fQ%.1f '
                    '%.1f %.1f %.1fV%.1fZ" style="fill:%s"%s/>'
                    % (x0, y(0), y0 + rr, x0, y0, x0 + rr, y0, x0 + w - rr,
                       x0 + w, y0, x0 + w, y0 + rr, y(0), colour,
                       ' class="partial"' if i in partial else ""))
            continue
        runs, run = [], []
        for i, v in enumerate(vs):
            if v is None:
                if run:
                    runs.append(run)
                run = []
            else:
                run.append((x(i), y(v)))
        if run:
            runs.append(run)
        for run in runs:
            if len(run) > 1:
                parts.append('<path d="M%s" class="line" style="stroke:%s"/>'
                             % ("L".join("%.1f %.1f" % p for p in run),
                                colour))
        dots = [run[0] for run in runs if len(run) == 1]
        if runs:
            dots.append(runs[-1][-1])
            ends.append((runs[-1][-1], name))
        for px, py in dots:
            parts.append('<circle cx="%.1f" cy="%.1f" r="4" class="dot" '
                         'style="fill:%s"/>' % (px, py, colour))
    # Direct labels at the lines' ends, unless they would collide.
    if multi and len(ends) == len(series) and all(
            abs(a[0][1] - b[0][1]) >= 11 for a in ends for b in ends
            if a is not b):
        for (px, py), name in ends:
            parts.append('<text x="%.1f" y="%.1f" class="lab">%s</text>'
                         % (px + 7, py + 3.5, esc(name)))
    # Say so under a run of 3 or more slots with no value at all.
    empty = [all(vs[i] is None for _, vs in series)
             for i in range(len(slots))]
    i = 0
    while values and i < len(slots):
        j = i
        while j < len(slots) and empty[j]:
            j += 1
        if j - i >= 3:
            parts.append('<text x="%.1f" y="%.1f" text-anchor="middle">'
                         "%s</text>" % ((x(i) + x(j - 1)) / 2, y(0) - 5,
                                        esc(gap)))
        i = j + 1
    # A hit target a slot, the whole plot high, carrying its values.
    for i, slot in enumerate(slots):
        said = ["%s: %s" % (name, num(vs[i], 2) if isinstance(vs[i], float)
                            else vs[i]) for name, vs in series
                if vs[i] is not None]
        parts.append('<rect x="%.1f" y="%d" width="%.1f" height="%.1f" '
                     'class="hit"><title>%s: %s</title></rect>'
                     % (left + i * col, top, col, plot_h, esc(slot),
                        esc("; ".join(said) or gap)))
    parts.append("</svg>")
    key = ""
    if multi:
        key = '<div class="key">%s</div>' % "".join(
            '<span><i class="ln" style="background:%s"></i>%s</span>'
            % (SERIES[k], esc(name)) for k, (name, _) in enumerate(series))
    rows = [[esc(slot)] + [esc(num(vs[i], 2) if isinstance(vs[i], float)
                               else vs[i]) for _, vs in series]
            for i, slot in enumerate(slots)]
    return ('<figure class="chart"><figcaption><b>%s</b><span class="note">'
            '%s</span></figcaption>%s%s<details><summary>Values</summary>%s'
            "</details></figure>"
            % (esc(title), esc(desc), "".join(parts), key,
               table([""] + [name for name, _ in series], rows)))


def hour_ticks(rows):
    """Every 6th hour's label, as HH."""
    return [(i, row["hour"][11:13]) for i, row in enumerate(rows)
            if int(row["hour"][11:13]) % 6 == 0]


def graph_values(rows, key, scale=1.0):
    return [None if not row.get("records") or row.get(key) is None
            else row[key] / scale for row in rows]


def latency_scale(rows):
    """Minutes, or hours when the p90 runs past 3 hours."""
    worst = max([v for v in graph_values(rows, "approval_p90")
                 if v is not None], default=0)
    return (60.0, "hours") if worst > 180 else (1.0, "minutes")


def whole_hours(rows):
    """`rows` without the hour under way: a ratio over part of an hour
    says little."""
    return [r for r in rows if not r.get("partial")]


def flow_graphs(rows):
    """Section 2's graph: merges each hour, against the bar, and the
    hour under way so far, lighter."""
    slots = [r["hour"][11:16] + ("\u2013%s so far" % r["until"][11:16]
                                 if r.get("partial") and r.get("until")
                                 else "") for r in rows]
    return '<div class="charts">%s</div>' % chart(
        "merges", "Merges per hour, last 24 h",
        "Pull requests merged in each whole hour (UTC), against the bar "
        "of %d an hour, and, lighter at the right, the hour under way so "
        "far. A gap is an hour with no Merger record; a stub on the "
        "baseline is an hour with none merged." % MERGE_BAR,
        "merges/h", slots, [("merges", graph_values(rows, "merges"))],
        hour_ticks(rows), ref=(MERGE_BAR, "bar %d/h" % MERGE_BAR),
        bars=True, gap="no records",
        partial={i for i, r in enumerate(rows) if r.get("partial")})


def efficiency_graphs(rows):
    rows = whole_hours(rows)
    slots = [r["hour"][11:16] for r in rows]
    ticks = hour_ticks(rows)
    return '<div class="charts">%s%s%s</div>' % (
        chart("rpm", "Builds per merge, each hour",
              "All build-check runs started in the hour, divided by the "
              "pull requests merged in it. Full batching brings it towards "
              "about %s. A gap is an hour with no merge."
              % RUNS_PER_MERGE_TARGET, "builds per merge", slots,
              [("builds per merge", graph_values(rows, "runs_per_merge"))],
              ticks, ref=(RUNS_PER_MERGE_TARGET, "target %s"
                          % RUNS_PER_MERGE_TARGET)),
        chart("rppr", "Builds per merged PR, each hour",
              "For the pull requests merged in the hour, the mean of each "
              "one's own runs from its first push to its merge: its head "
              "runs and the batch runs it was in. The optimum is about %d. A "
              "gap is an hour with no merge." % RUNS_PER_PR_TARGET,
              "builds per PR", slots,
              [("builds per merged PR",
                graph_values(rows, "runs_per_merged_pr"))],
              ticks, ref=(RUNS_PER_PR_TARGET, "optimum %d"
                          % RUNS_PER_PR_TARGET)),
        chart("pps", "Pull requests per merge slot, each hour",
              "Pull requests merged in the hour, over the green runs they "
              "rested on. Higher means more merged on each green run. A gap "
              "is an hour with no merge.",
              "PRs per slot", slots,
              [("PRs per slot", graph_values(rows, "prs_per_slot"))],
              ticks))


def latency_graphs(rows):
    rows = whole_hours(rows)
    scale, unit = latency_scale(rows)
    slots = [r["hour"][11:16] for r in rows]
    return '<div class="charts">%s</div>' % chart(
        "lat", "First approval to merge, each hour",
        "For the pull requests merged in the hour, the time from their "
        "first approval to their merge: median and p90, in %s. A gap "
        "is an hour with no merge." % unit,
        unit, slots,
        [("median", graph_values(rows, "approval_median", scale)),
         ("p90", graph_values(rows, "approval_p90", scale))],
        hour_ticks(rows))


def build_graphs(rows):
    """Run time of the build check, mean and median, 6-hour buckets."""
    slots = ["%s %s-%s%s" % (r["since"][5:10], r["since"][11:13],
                             r["until"][11:13] if r["until"][11:13] != "00"
                             else "24", " so far" if r["partial"] else "")
             for r in rows]
    ticks = [(i, r["since"][5:10]) for i, r in enumerate(rows)
             if r["since"][11:13] == "00"]
    ticks = ticks[1::2] if len(ticks) > 4 else ticks

    def values(kind, key):
        return [None if (r.get(kind) or {}).get(key) is None
                else round(r[kind][key] / 60, 1) for r in rows]
    out = []
    for kind, what in (("head", "Head runs"), ("batch", "Batch runs")):
        out.append(chart(
            "bt-" + kind, "%s: build time, last 7 days" % what,
            "The build check's run time, in minutes, of the %s that built "
            "to a verdict, in 6-hour buckets (UTC): mean and median. A gap "
            "is a bucket with none." % what.lower(), "minutes", slots,
            [("mean", values(kind, "mean")),
             ("median", values(kind, "median"))], ticks, x_label="day (UTC)"))
    return '<div class="charts">%s</div>' % "".join(out)


def share_bar(states):
    total = sum(states.values()) or 1
    return '<div class="bar">%s</div>' % "".join(
        '<i style="width:%.2f%%;background:%s" title="%s: %.0f min"></i>'
        % (100 * states[s] / total, state_var(s), esc(s), states[s])
        for s in STATES if states.get(s))


def table(head, rows):
    return "<table><tr>%s</tr>%s</table>" % (
        "".join("<th>%s</th>" % esc(h) for h in head),
        "".join("<tr>%s</tr>" % "".join("<td>%s</td>" % c for c in row)
                for row in rows))


def per_hour(fig, minutes):
    """Minutes an hour, so windows of every length compare."""
    return minutes / fig["hours"] if fig["hours"] else 0


def glance(w, names, head):
    """The figures the owner reads first: merges an hour and the two
    builds-per-pull-request figures, each beside its target."""
    day = w["24h"]
    tiles = [("%s /h" % num(day["merges_per_hour"]),
              "merges an hour, last 24 h (bar %d)" % MERGE_BAR),
             (num(day["runs_per_merge"], 2),
              "builds per merge, last 24 h (target about %s)"
              % RUNS_PER_MERGE_TARGET),
             (num(day["runs_per_merged_pr"]["mean"], 2),
              "builds per merged PR, last 24 h (optimum about %d)"
              % RUNS_PER_PR_TARGET)]
    rows = [["merges per hour"]
            + [num(ratio(w[k]["merges"], w[k]["hours"], 1)) for k in names]
            + ["%d" % MERGE_BAR],
            ["Builds per merge (all build runs &divide; PRs merged)"]
            + [num(w[k]["runs_per_merge"], 2) for k in names]
            + ["&asymp; %s" % RUNS_PER_MERGE_TARGET],
            ["Builds per merged PR along its own path"]
            + [num(w[k]["runs_per_merged_pr"]["mean"], 2) for k in names]
            + ["&asymp; %d" % RUNS_PER_PR_TARGET]]
    return ('<section><h2>At a glance</h2><div class="tile">%s</div>%s'
            '<p class="note">Builds per merge counts every build-check run '
            "started in the window (heads, batch predictions, the default "
            "branch, stopped runs and reruns) over the pull requests merged "
            "in it; full batching brings it towards one build a merge. "
            "Builds per merged PR follows each pull request merged in the "
            "window from its first push to its merge, and counts its own "
            "head runs and the batch runs it was in; at best that is one "
            "of each.</p></section>"
            % ("".join('<div><div class="v">%s</div><div class="l">%s</div>'
                       "</div>" % (esc(v), esc(l)) for v, l in tiles),
               table(head + ["target"], rows)))


def pr_link(data, pr):
    """#N, linked to the pull request when the repository is known."""
    if data.get("repo"):
        return '<a href="https://github.com/%s/pull/%d">#%d</a>' % (
            esc(data["repo"]), pr, pr)
    return "#%d" % pr


def train_class(state):
    return ("t-green" if state.startswith("green") else "t-testing"
            if state == "testing" else "t-red" if state in ("red",)
            else "t-wait")


# What a train's engine shows, by its class.
ENGINE_SAYS = {"t-green": "green: merging, flag out",
               "t-testing": "testing: steaming",
               "t-red": "red: lamp lit red",
               "t-wait": "waiting for a slot: standing"}
# What a stack's status dot means, by its colour.
DOT_SAYS = {GREEN: "can merge", ORANGE: "testing underway",
            RED: "cannot merge"}
PRI_MARK = {URGENT: "!!", ELEVATED: "!"}


def engine_svg(cls, says=None):
    """A small locomotive facing left, the way the train goes: puffs of
    steam (moving only while it tests), a lamp at the front and a flag
    on the cab once it is green. Colours come from the train's class."""
    return (
        '<svg class="engine" viewBox="0 0 66 42" width="66" height="42" '
        'role="img" aria-label="engine, %s"><title>engine, %s</title>'
        '<circle class="puff p1" cx="13" cy="9" r="3"/>'
        '<circle class="puff p2" cx="9" cy="5" r="3.5"/>'
        '<circle class="puff p3" cx="15" cy="2.5" r="2.5"/>'
        '<rect class="body" x="10" y="11" width="7" height="8" rx="1"/>'
        '<rect class="body" x="4" y="18" width="36" height="13" rx="4"/>'
        '<rect class="body" x="38" y="9" width="20" height="22" rx="2"/>'
        '<rect class="roof" x="36" y="7" width="24" height="3" rx="1"/>'
        '<rect class="win" x="43" y="13" width="10" height="7" rx="1"/>'
        '<path class="body" d="M0 35 L5 28 L7 35 Z"/>'
        '<circle class="lamp" cx="5" cy="22" r="3"/>'
        '<line class="pole" x1="57" y1="7" x2="57" y2="0"/>'
        '<path class="flag" d="M57 0 L65 2.5 L57 5 Z"/>'
        '<circle class="wheel" cx="14" cy="35" r="5"/>'
        '<circle class="wheel" cx="29" cy="35" r="5"/>'
        '<circle class="wheel" cx="49" cy="36" r="4"/></svg>'
        % ((esc(says or ENGINE_SAYS[cls]),) * 2))


def pri_html(data, pr):
    """A priority badge for `pr`: "!!" urgent, "!" elevated, or
    nothing."""
    got = (data.get("priority") or {}).get(str(pr))
    if not got or got.get("level") not in PRI_MARK:
        return ""
    return ('<span class="pri p-%s" title="%s"><span aria-hidden="true">'
            '%s</span><span class="vh"> (%s)</span></span>'
            % (got["level"], esc(got.get("why")), PRI_MARK[got["level"]],
               esc(got["level"])))


def dot_html(colour, why):
    if colour not in DOT_SAYS:
        return ""
    said = DOT_SAYS[colour] + (": %s" % why if why else "")
    return ('<i class="dot d-%s" role="img" aria-label="%s" title="%s">'
            "</i>" % (colour, esc(said), esc(said)))


def train_legend():
    return ('<div class="key">%s<span><span class="carriage mini">'
            '<span class="car">#</span></span>a carriage: a pull request '
            "and the stacked layers that board with it</span>"
            '<span><span class="carriage mini van"><span class="car lg top">'
            "#</span></span>the guard's van: the top's carriage</span>"
            "%s</div>" % ("".join(
                '<span class="train %s legend">%s%s</span>'
                % (cls, engine_svg(cls), esc(ENGINE_SAYS[cls]))
                for cls in ("t-testing", "t-wait", "t-green", "t-red")),
                pri_legend()))


def pri_legend():
    return ('<span><span class="pri p-urgent">!!</span> urgent: carries '
            'the urgent label</span><span><span class="pri p-elevated">!'
            "</span> elevated: the Merger puts it first all the same (it "
            "fixes a red nightly or default branch) or it has right of "
            "way</span>")


# A recent train's engine, by its outcome: the class that lights its
# lamp, and what it says. It never steams: the train is gone.
OUTCOME_ENGINE = {"merged": ("t-green", "merged: green lamp, flag out"),
                  "partly merged": ("t-partly", "partly merged: amber lamp"),
                  "red": ("t-red", "red: red lamp"),
                  "re-cut": ("t-wait", "re-cut: lamp unlit"),
                  "running": ("t-testing", "still running: amber lamp")}
# A member's outcome in a recent train: its colour class and its name.
MEMBER_SAYS = (("merged", "merged"), ("culprit", "the culprit: red on its "
               "own, handed back"), ("left", "left the train"),
               ("recut", "re-cut into a later train"),
               ("waiting", "still in the train"))
TRAIN_OUTCOMES = ("merged", "partly merged", "red", "re-cut", "running")


def duration_text(minutes):
    return "%d min" % minutes if minutes < 120 else "%.1f h" % (
        minutes / 60)


def recent_html(data):
    """The last trains, newest first: one row each, its outcome, when
    it was cut and how long it ran, and its carriages with each member
    coloured by what became of it."""
    recent = data.get("recent_trains") or []
    if not recent:
        return ("<section><h2>Recent trains</h2><p class=\"note\">No "
                "train in the Merger's records.</p></section>")
    rows = []
    for t in recent:
        boxes = []
        top_pr = t["prs"][-1]
        for c, car in enumerate(t["carriages"]):
            inner = []
            for pr in car:
                m = t["members"].get(str(pr)) or {}
                kind = m.get("outcome", "waiting")
                inner.append('<span class="car m-%s%s" title="%s%s">%s%s'
                             '<span class="vh"> (%s)</span></span>' % (
                                 kind, " top" if pr == top_pr else "",
                                 esc(m.get("why")),
                                 " at %s" % esc(m["at"]) if m.get("at")
                                 else "", pr_link(data, pr),
                                 pri_html(data, pr), esc(kind)))
            van = top_pr in car
            boxes.append('<span class="carriage%s" title="%s">%s%s</span>'
                         % (" van" if van else "",
                            "the guard's van, carriage %d" % (c + 1)
                            if van else "carriage %d: %s" % (
                                c + 1, ", ".join("#%d" % p for p in car)),
                            "".join(inner),
                            '<i class="tail" aria-hidden="true"></i>'
                            if van else ""))
        cls, says = OUTCOME_ENGINE.get(t["outcome"], ("t-wait", None))
        tops = t.get("tops") or []
        last = tops[-1] if tops else None
        top = ""
        if last:
            top = " · top run %s%s" % (esc(last["res"]), " after %s"
                                       % duration_text(last["ran"] // 60)
                                       if last.get("ran") else "")
        n, c = len(t["prs"]), len(t["carriages"])
        rows.append(
            '<div class="rtrain %s"><p class="lab"><span class="ob o-%s">%s'
            "</span> cut %s · %d PR%s in %d carriage%s · %s%s%s · %s</p>"
            '<div class="cars">%s%s%s</div></div>' % (cls,
                t["outcome"].replace(" ", "-"), esc(t["outcome"]),
                esc(t["cut"]), n, "" if n == 1 else "s", c,
                "" if c == 1 else "s", duration_text(t["minutes"]),
                " to %s" % esc(t["end"][11:]) if t.get("end") else
                " so far", top, esc(t["why"]), engine_svg(cls, says),
                '<i class="coupling" aria-hidden="true"></i>',
                '<i class="coupling" aria-hidden="true"></i>'.join(boxes)))
    key = '<div class="key">%s%s</div>' % ("".join(
        '<span><span class="ob o-%s">%s</span></span>'
        % (o.replace(" ", "-"), esc(o)) for o in TRAIN_OUTCOMES), "".join(
        '<span><span class="car m-%s lg">#</span>%s</span>' % (k, esc(w))
        for k, w in MEMBER_SAYS))
    return ("<section><h2>Recent trains</h2>%s%s<p class=\"note\">The "
            "last %d trains the Merger cut, newest first, from "
            "merger.jsonl: each record's <i>trains</i> (a train that is "
            "what is left of one before goes on as it; any other was cut "
            "that tick, and every one when the default branch moved), its "
            "MERGE decisions (<i>train</i>: the train's own merge) and "
            "hand-backs (<i>suspect</i>: the culprit a red train's search "
            "found), and the build check's runs of the tops. A member that "
            "boards a train cut later was re-cut; one that drops out of "
            "the trains otherwise left (its hold says why). Hover a "
            "member for what became of it. The time is from the cut to "
            "the train's last member leaving it.</p></section>"
            % ("".join(rows), key, len(recent)))


def trains_html(data):
    trains = data.get("trains") or []
    if not trains:
        return ("<section><h2>Trains now</h2><p class=\"note\">No train: "
                "the Merger is testing nothing ahead.</p></section>")
    rows = []
    for n, t in enumerate(trains):
        carriages = t.get("carriages") or [[pr] for pr in t["prs"]]
        top_pr = t["prs"][-1]
        boxes = []
        for c, car in enumerate(carriages):
            van = top_pr in car and t["train"] is not None
            inner = "".join(
                '<span class="car%s" title="%s">%s%s</span>' % (
                    " top" if pr == top_pr and t["train"] is not None
                    else "",
                    "the top, %s, is tested for the whole train"
                    % esc(t["top"]) if pr == top_pr and t["train"]
                    is not None else "carriage %d of %d"
                    % (c + 1, len(carriages)),
                    pr_link(data, pr), pri_html(data, pr)) for pr in car)
            boxes.append('<span class="carriage%s" title="%s">%s%s</span>'
                         % (" van" if van else "",
                            "the guard's van, carriage %d" % (c + 1)
                            if van else "carriage %d: %s" % (
                                c + 1, ", ".join("#%d" % p for p in car)),
                            inner, '<i class="tail" aria-hidden="true"></i>'
                            if van else ""))
        couple = '<i class="coupling" aria-hidden="true"></i>'
        count = "%d PR%s in %d carriage%s" % (
            len(t["prs"]), "" if len(t["prs"]) == 1 else "s",
            len(carriages), "" if len(carriages) == 1 else "s")
        if t["train"] is None:
            rows.append('<div class="train t-wait siding"><p class="lab">'
                        "Next in the queue, predicted but in no train yet "
                        '· %s</p><div class="cars">%s</div></div>'
                        % (count, couple.join(boxes)))
            continue
        cls = train_class(t["state"])
        label = "%s · %s · %s%s · top %s%s" % (
            "Train %d (merging next)" % t["train"] if n == 0 else
            "Train %d" % t["train"], count, esc(t["state"]),
            " since %s" % esc(t["since"]) if t.get("since") else "",
            esc(t["top"]),
            ' · <span class="urgent">cut for urgent PRs</span>'
            if t.get("urgent") else "")
        rows.append('<div class="train %s"><p class="lab">%s</p>'
                    '<div class="cars">%s%s%s</div></div>'
                    % (cls, label, engine_svg(cls), couple,
                       couple.join(boxes)))
    return ("<section><h2>Trains now</h2>%s%s<p class=\"note\">From "
            "ahead.json at %s. Each train leaves engine first and merges "
            "front to back once its top (the double border, in the guard's "
            "van at the back), tested with every pull request before it, "
            "is green. A carriage is a pull request with the stacked "
            "layers that board with it (ahead.json's <i>carriage</i>, or "
            "a layer held as stacked on the one before it). Priority: "
            "<b>!!</b> urgent, carrying the urgent label (read from GitHub "
            "with --github; otherwise inferred, as one the Merger cut a "
            "train for, ahead.json's <i>urgent_cut</i>, that fixes nothing "
            "red); <b>!</b> elevated, a fix of a red nightly "
            "(forge-nightly's file) or default branch (the build check's "
            "state.json), or the holder of right of way (the last Merger "
            "record).</p></section>"
            % ("".join(rows), train_legend(), esc(data.get("ahead_at"))))


def stack_items(data, node):
    inner = "".join(stack_items(data, k) for k in node["layers"])
    return "<li>%s%s%s%s</li>" % (
        dot_html(node.get("status"), node.get("why")),
        pr_link(data, node["pr"]), pri_html(data, node["pr"]),
        "<ul>%s</ul>" % inner if inner else "")


def singles_html(data):
    """One line of the candidates in no stack, each with its dot."""
    singles = data.get("singles") or []
    if not singles:
        return ""
    return ('<p class="singles"><b>Not stacked</b> (%d): %s</p>'
            % (len(singles), " ".join(
                '<span class="one">%s%s%s</span>' % (
                    dot_html(o.get("status"), o.get("why")),
                    pr_link(data, o["pr"]), pri_html(data, o["pr"]))
                for o in singles)))


def stacks_html(data):
    stacks = data.get("stacks") or []
    if not stacks:
        return ("<section><h2>Stacks now</h2><p class=\"note\">No stacked "
                "pull request is waiting.</p>%s</section>" % singles_html(data))
    layers = sum(t["count"] for t in stacks)
    parts = []
    for t in stacks:
        parts.append(
            '<details class="stk"%s><summary>%s: %d layer%s, %d deep · '
            "%s</summary><ul class=\"stack\">%s</ul></details>"
            % (" open" if t["count"] >= 3 else "", pr_link(data, t["pr"]),
               t["count"], "" if t["count"] == 1 else "s", t["depth"],
               esc(t["root_where"]), stack_items(data, t)))
    key = '<div class="key">%s%s</div>' % ("".join(
        "<span>%s%s</span>" % (dot_html(c, None), esc(DOT_SAYS[c]))
        for c in (GREEN, ORANGE, RED)), pri_legend())
    return ("<section><h2>Stacks now</h2><p class=\"now\"><b>%d</b> "
            "layers in <b>%d</b> stacks.</p>%s%s%s<p class=\"note\">Each "
            "tree is rooted at the stack's base, the pull request on the "
            "default branch; every layer above it waits (held as "
            "<i>stacked on #N</i>) until the one below merges, so where "
            "the base waits is where the whole stack waits. Each dot is "
            "the Merger's last record first, then the build check; hover "
            "it for why. <b>Green</b>, can merge: in a green train, in "
            "the Merger's queue (eligible), merged, or a layer held only "
            "as stacked whose own check last said green. <b>Orange</b>, "
            "testing underway: in a train testing or waiting for a slot, "
            "its own check running or not yet run while only stacked, a "
            "queued one whose check is running, or held for a check "
            "still pending. <b>Red</b>, cannot merge: in a red train, "
            "handed back, held for anything else (a conflict, a review "
            "after the approval, Blocked-by, a draft, a label, a red "
            "check), its own check red, or not a candidate at all (not "
            "approved or not open). The own check is the last one the "
            "build check ran for the pull request, which a push since "
            "may have made stale. Priority marks as in the trains. "
            "<b>Not stacked</b>: the other candidates, in the Merger's "
            "queue order, then those it holds.</p></section>"
            % (layers, len(stacks), "".join(parts), singles_html(data),
               key))


def page(data):
    w = data["windows"]
    names = [k for k, _ in WINDOWS] + [BASELINE[0]]
    head = [""] + ["last %s" % k for k in names[:-1]] + ["7 days"]
    snap = data["now"]
    out = ['<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">'
           '<meta name="viewport" content="width=device-width,'
           'initial-scale=1"><title>Merge flow: %s</title><style>%s</style>'
           '</head><body><main>' % (esc(data["project"]), css_vars())]
    out.append("<h1>Merge flow: %s</h1><p class=\"sub\">Written %s from "
               "the records to %s. The 7-day column covers %s h.</p>"
               % (esc(data["project"]), esc(data["generated"]),
                  esc(snap.get("at")), num(w[BASELINE[0]]["hours"], 0)))
    graphs = data.get("graph_hours") or []
    out.append(glance(w, names, head))
    # 1. States.
    rows = []
    for state in STATES:
        rows.append(['<i class="sw" style="background:%s"></i> %s'
                     % (state_var(state), esc(state))] + [
            "%.0f min" % w[k]["states"][state] for k in names[:-1]] + [
            "%.0f min/h" % per_hour(w[names[-1]], w[names[-1]]["states"]
                                    [state])])
    rows.append(["share"] + [share_bar(w[k]["states"]) for k in names])
    out.append("<section><h2>1. Why so few merges</h2>%s%s%s"
               '<p class="note">Minutes in each state, each hour (UTC). '
               "Each Merger tick is put in one state; the time to the next "
               "tick counts to it. %s</p></section>"
               % (hourly_svg(data["hours"]), key_html(), table(head, rows),
                  " ".join("<b>%s</b>: %s." % (esc(s), esc(WHAT[s]))
                           for s in STATES)))
    # 2. Flow.
    def hourly_rate(label, count):
        """A row of a count per hour, the count itself in a tooltip."""
        cells = []
        for k in names:
            n = count(w[k])
            cells.append('<span title="%s in %s h">%s /h</span>' % (
                esc(n), num(w[k]["hours"], 1),
                num(ratio(n, w[k]["hours"], 1))))
        return [label] + cells
    rows = [hourly_rate("merges", lambda f: f["merges"]),
            hourly_rate("arrivals (first run of a pull request)",
                        lambda f: f["arrivals"]),
            hourly_rate("approvals (first listed by the Merger)",
                        lambda f: f["approvals"]),
            hourly_rate("build-check runs started",
                        lambda f: f["runs_total"]),
            hourly_rate("hand-backs told", lambda f: f["hand_backs"]["told"]),
            hourly_rate("batch re-cuts", lambda f: f["recuts"]),
            ["eligible, mean"] + [num(w[k]["eligible_mean"]) for k in names],
            ["held, mean"] + [num(w[k]["held_mean"]) for k in names]]
    where = [["in the batch", ", ".join("#%d" % p for p in snap.get(
        "batch", [])) or "-"],
        ["in later batches", ", ".join("#%d" % p for p in snap.get(
            "later", [])) or "-"],
        ["queued, not yet in a batch", ", ".join("#%d" % p for p in snap.get(
            "queued", [])) or "-"],
        ["back with the author", ", ".join(
            "#%d%s" % (p, " (%s)" % snap["handed_back_causes"][p]
                       if p in snap.get("handed_back_causes", {}) else "")
            for p in snap.get("handed_back", [])) or "-"]]
    for kind, prs in sorted(snap.get("held", {}).items()):
        where.append(["held: %s" % kind, ", ".join("#%d" % p for p in prs)])
    out.append("<section><h2>2. Flow</h2>%s<p class=\"note\">Counts are "
               "per hour in every window; hover one for the count itself. "
               "Means are means over the Merger's ticks.</p>%s"
               "<h2 style=\"margin-top:12px\">"
               "Waiting now (%s, %s)</h2>%s</section>"
               % (table(head, rows), flow_graphs(graphs),
                  esc(snap.get("at")),
                  esc(snap.get("state")),
                  table(["where", "pull requests"],
                        [[esc(a), esc(b)] for a, b in where])))
    out.append(recent_html(data))
    out.append(trains_html(data))
    out.append(stacks_html(data))
    # 3. Efficiency.

    def slots(f):
        s = f["merge_slots"]["sizes"]
        return "%s / %s / %s" % (s["1"], s["2-3"], s["4+"])

    def tops(f):
        t = f["green_batch_tops"]
        return "%d: %d all, %d part, %d none" % (
            t["green"], t["all"], t["part"], t["none"])
    rows = [["(a) runs per merged pull request, mean"]
            + [num(w[k]["runs_per_merged_pr"]["mean"], 2) for k in names],
            ["(a) of them head runs / batch runs"]
            + ["%s / %s" % (num(w[k]["runs_per_merged_pr"]["heads_mean"], 2),
                            num(w[k]["runs_per_merged_pr"]["batches_mean"],
                                2)) for k in names],
            ["(a) median / p90"]
            + ["%s / %s" % (num(w[k]["runs_per_merged_pr"]["median"]),
                            num(w[k]["runs_per_merged_pr"]["p90"]))
               for k in names],
            ["(b) runs per merge"]
            + [num(w[k]["runs_per_merge"], 2) for k in names],
            ["pull requests per merge slot"]
            + [num(w[k]["merge_slots"]["prs_per_slot"], 2) for k in names],
            ["slots of 1 / 2-3 / 4+"] + [slots(w[k]) for k in names],
            ["green batch tops"] + [tops(w[k]) for k in names],
            ["pull requests per green batch top or train"]
            + [num(w[k]["prs_per_green_top"], 2) for k in names]]
    out.append("<section><h2>3. Efficiency</h2>%s<p class=\"note\">(a) counts"
               " a pull request's head runs and the batch runs it was a "
               "member of, from its first push to its merge. (b) counts every"
               " run started in the window: heads, predictions and main. A "
               "merge slot is the green run a merge rested on.</p>%s"
               "</section>" % (table(head, rows), efficiency_graphs(graphs)))
    # 4. Rework.
    causes = sorted({c for k in names for c in
                     w[k]["hand_backs"]["per_merge_by_cause"]})
    rows = [["hand-backs told, all pull requests, &divide; merges"]
            + [num(w[k]["hand_backs"]["per_merge"], 2) for k in names]]
    for cause in causes:
        rows.append(["&nbsp;&nbsp;%s" % esc(cause)] + [num(
            w[k]["hand_backs"]["per_merge_by_cause"].get(cause), 2)
            for k in names])
    rows.append(["repeats for the same head"] + [
        "%d of %d" % (w[k]["hand_backs"]["repeats_total"],
                      w[k]["hand_backs"]["told"]) for k in names])
    rows.append(["head checks: green / red(merge) / other red"] + [
        "%d / %d / %d" % (w[k]["head_checks"].get("green", 0),
                          w[k]["head_checks"].get("red(merge)", 0),
                          w[k]["head_checks"].get("red", 0))
        for k in names])
    rows.append(["batch tops: green / red"] + [
        "%d / %d" % (w[k].get("batch_checks", {}).get("green", 0),
                     w[k].get("batch_checks", {}).get("red", 0))
        for k in names])
    out.append("<section><h2>4. Rework</h2>%s<p class=\"note\">The first "
               "row counts the hand-backs told to every pull request, "
               "merged or not, and divides them by the merges: it is not "
               "how often one merged pull request was handed back. A "
               "repeat is a hand-back told again for a head already "
               "handed back. red(merge) is a head that conflicts with the "
               "default branch. A batch top is the Merger's prediction "
               "of several pull requests together; its red is not any "
               "one head's red.</p></section>" % table(head, rows))
    # 5. Latency.

    def lat(f, key):
        got = f["approval_to_merge"].get(key)
        if not got or not got["n"]:
            return "-"
        return "%s / %s (%d)" % (minutes_text(got["median"]),
                                 minutes_text(got["p90"]), got["n"])
    rows = [["first approval to merge, median / p90 (local)"]
            + [lat(w[k], "local_minutes") for k in names]]
    if "github_minutes" in w["24h"]["approval_to_merge"]:
        rows.append(["the same, from GitHub's first approval"]
                    + [lat(w[k], "github_minutes") for k in names])
    out.append("<section><h2>5. Latency</h2>%s<p class=\"note\">Locally, "
               "the first approval is the first Merger tick that listed the "
               "pull request as queued or held. The graph uses GitHub's "
               "first approval where it has it.</p>%s</section>"
               % (table(head, rows), latency_graphs(graphs)))
    # 6. Capacity.
    cats = sorted({c for k in names for c in w[k]["slot_hours"]},
                  key=lambda c: -w[BASELINE[0]]["slot_hours"].get(c, 0))
    rows = []
    for cat in cats:
        rows.append([esc(cat)] + ["%.1f" % w[k]["slot_hours"].get(cat, 0)
                                  for k in names])
    rows.append(["used of available"] + [
        "%.1f of %.1f" % (w[k]["slot_hours_used"],
                          w[k]["slot_hours_available"]) for k in names])
    rows.append(["head wait for a slot, median"] + [
        num(w[k]["head_wait_seconds"]["median"], 0) + " s" for k in names])
    rows.append(["run time, median"] + [
        num(w[k]["run_seconds"]["median"], 0) + " s" for k in names])
    for kind, what in (("head", "head runs"), ("batch", "batch runs")):
        rows.append(["run time of %s, mean / median" % what] + [
            "%s / %s s" % (num(got.get("mean"), 0), num(got.get("median"), 0))
            for got in ((w[k].get("run_seconds_by_kind") or {}).get(kind, {})
                        for k in names)])
    busy = []
    for name, got in w["6h"]["busy"].items():
        week = w[BASELINE[0]]["busy"].get(name, {}).get("busy")
        busy.append(["%s%s" % (esc(name), " (reviewer)" if got["reviewer"]
                               else ""),
                     '<div class="hbar"><i style="width:%.0f%%"></i></div>'
                     % (100 * got["busy"]),
                     "%.0f%%" % (100 * got["busy"]),
                     "-" if week is None else "%.0f%%" % (100 * week)])
    out.append("<section><h2>6. Capacity</h2>%s<p class=\"note\">Slot-hours"
               " of the runs started in the window; %d slots.</p>"
               "<h2 style=\"margin-top:12px\">Busy, last 6 h</h2>%s"
               "<p class=\"note\">Busy is the share of the time an agent was "
               "listed that she was busy, not idle or in a shell.</p>"
               "<h2 style=\"margin-top:12px\">Build time, last 7 days</h2>%s"
               "</section>"
               % (table(head[:1] + head[1:], rows), w["24h"]["slots"],
                  table(["agent", "", "6 h", "7 d"], busy) if busy
                  else "<p>No presence records.</p>",
                  build_graphs(data.get("build_times") or [])))
    # 7. Policy.
    row = snap.get("right_of_way") or {}
    rows = [["right of way held, share of ticks"] + [
        "-" if w[k]["right_of_way_share"] is None else
        "%.0f%%" % (100 * w[k]["right_of_way_share"]) for k in names],
        ["overdue, mean"] + [num(w[k]["overdue_mean"]) for k in names],
        ["batch re-cuts an hour"] + [num(w[k]["recuts_per_hour"])
                                     for k in names],
        ["re-cuts of a started batch or train, by cause"] + [esc(", ".join(
            "%s %d" % kv for kv in w[k]["recuts_by_cause"].items()) or "-")
            for k in names]]
    if any(w[k]["recuts_avoided"] or w[k]["dry_train_changes"]
           for k in names):
        rows += [["trains dry run: batch re-cuts a train would not have "
                  "made"] + [num(w[k]["recuts_avoided"]) for k in names],
                 ["trains dry run: train changes"] + [esc(", ".join(
                     "%s %d" % kv for kv in w[k]["dry_train_changes"]
                     .items()) or "-") for k in names]]
    out.append("<section><h2>7. Policy</h2><p class=\"now\">Right of way "
               "now: <b>%s</b>%s. Overdue now: <b>%d</b>.</p>%s</section>"
               % ("#%d" % row["pr"] if row.get("pr") else "nobody",
                  " since %s" % esc(row["since"]) if row.get("since") else "",
                  snap.get("overdue", 0), table(head, rows)))
    out.append('<p class="note">forge-flow, agent-forge (designs/0045). '
               "Every number is in flow.json.</p></main></body></html>")
    return "".join(out)


# ---------------------------------------------------------------- main

def write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as handle:
        handle.write(text)
    os.replace(tmp, path)


def compute(flow, project_name, repo=None, recent=RECENT_TRAINS):
    windows = {k: flow.figures(flow.now - span, flow.now)
               for k, span in WINDOWS}
    start = flow.now - BASELINE[1]
    if flow.records:
        start = max(start, flow.records[0]["_t"])
    windows[BASELINE[0]] = flow.figures(start, flow.now)
    return {"project": project_name, "generated": stamp(flow.now),
            "windows": windows, "hours": flow.hourly(), "now":
            flow.snapshot(), "graph_hours": flow.graph_hours(),
            "build_times": flow.build_times(), "stacks": flow.stacks(),
            "singles": flow.singles(),
            "trains": flow.trains(), "ahead_at": flow.ahead.get("at"),
            "recent_trains": flow.recent_trains(recent),
            "priority": flow.priorities(),
            "repo": repo}


def main(argv=None, out=print, err=None, environ=None, now=None,
         call=github.api_call, token=None):
    err = err or (lambda line: print(line, file=sys.stderr))
    environ = os.environ if environ is None else environ
    parser = argparse.ArgumentParser(prog=PROG,
                                     description=__doc__.splitlines()[0])
    parser.add_argument("--state-dir", help="the project's state directory "
                        "(default from the configuration)")
    parser.add_argument("--out", required=True,
                        help="where index.html, flow.json and "
                        "flow-history.jsonl go")
    parser.add_argument("--now", help="read the records as at this time "
                        "(UTC; default now)")
    parser.add_argument("--recent-trains", type=int, default=RECENT_TRAINS,
                        metavar="N", help="how many of the last trains "
                        "\"Recent trains\" tells of (default %(default)s)")
    parser.add_argument("--github", action="store_true",
                        help="also ask GitHub for each merged pull "
                        "request's first approval")
    parser.add_argument("--checkout", default=environ.get(
        "FORGE_CRON_CHECKOUT"), help="where the configuration is found "
        "(default $FORGE_CRON_CHECKOUT, else the current directory)")
    args = parser.parse_args(argv)
    project = None
    try:
        project = config.load(None, environ, cwd=os.path.expanduser(
            args.checkout) if args.checkout else None)
    except config.ConfigError as error:
        if not args.state_dir or args.github:
            err("NO-CONFIG: %s" % error)
            return 2
    state_dir = args.state_dir or os.path.dirname(locks.state_dir(
        project.name, "merger", environ, create=False))
    now = parse_time(args.now) if args.now else (
        now or datetime.datetime.now(datetime.timezone.utc))
    slots, reviewers, name = None, set(), os.path.basename(
        os.path.normpath(state_dir))
    if project is not None:
        name = project.name
        slots = project.section("checks").get("slots")
        agents = set(project.reviewers())
        reviewers = {s for s, a in project.by_session().items()
                     if a in agents} | agents
    os.makedirs(args.out, exist_ok=True)
    cache_path = os.path.join(args.out, "approvals.json")
    approvals = load_json(cache_path, {}) if args.github else {}
    flow = Flow(state_dir, now, slots, reviewers, approvals)
    if not flow.records and not flow.runs:
        err("NO-RECORDS: nothing in %s" % state_dir)
        return 2
    if args.github:
        wanted = [m["pr"] for m in flow.merges
                  if m["t"] >= now - BASELINE[1]]
        try:
            token = token or github.read_token(project, environ)
            first_approvals(token, project.repo, wanted, approvals, call)
            write(cache_path, json.dumps(approvals, sort_keys=True))
        except (RuntimeError, github.MintError, OSError) as error:
            err("%s: GitHub's approvals left out: %s" % (PROG, error))
        label = project.section("labels").get("urgent")
        if label:
            try:
                token = token or github.read_token(project, environ)
                flow.labelled = labelled_open(token, project.repo, label,
                                              call)
            except (RuntimeError, github.MintError, OSError) as error:
                err("%s: urgent labels inferred, not read: %s"
                    % (PROG, error))
    data = compute(flow, name, project.repo if project else None,
                   args.recent_trains)
    write(os.path.join(args.out, "flow.json"),
          json.dumps(data, indent=1, sort_keys=True))
    write(os.path.join(args.out, "index.html"), page(data))
    added = append_history(flow, os.path.join(args.out,
                                              "flow-history.jsonl"))
    out("%s: wrote %s (%s; %d merges in the last hour; %d history lines)"
        % (PROG, args.out, data["now"].get("state"),
           data["windows"]["1h"]["merges"], added))
    return 0


if __name__ == "__main__":
    sys.exit(main())
