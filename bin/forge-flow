# The categorical slots, in their fixed order, one for each state.
COLOURS = {
    MERGING: ("#008300", "#008300"),
    SEARCH: ("#e34948", "#e66767"),
    BATCH_WAIT: ("#2a78d6", "#3987e5"),
    HEAD_WAIT: ("#1baf7a", "#199e70"),
    HANDED: ("#eb6834", "#d95926"),
    HELD: ("#6250d6", "#9085e9"),
    NOTHING: ("#e87ba4", "#d55181"),
    NO_TICKS: ("#898781", "#5d5c58"),
}
WHAT = {
    MERGING: "the tick merged",
    SEARCH: "a batch top went red; its members are being sorted out",
    BATCH_WAIT: "waiting for the run of a batch's top",
    HEAD_WAIT: "waiting for a head's own check, or its update",
    HANDED: "every eligible pull request is back with its author",
    HELD: "approved pull requests, but every one held (check pending,"
          " stacked, Blocked-by): nothing may merge",
    NOTHING: "no approved pull request",
    NO_TICKS: "no Merger record for over %d minutes" % (
        GAP.total_seconds() // 60),
}

