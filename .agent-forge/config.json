{
  "project": "agent-forge",
  "repo": "abligh/agent-forge",
  "owner": "abligh",
  "key_dir": "~/agent-keys/agent-forge",
  "naming": {
    "app_slug_suffix": "amonagent"
  },
  "agents": {
    "XMPPEngineer": {
      "app_id": 5111152,
      "installation_id": 165866872
    }
  },
  "merge": {
    "merger": "Merger",
    "ci_workflow": "",
    "approval": "green",
    "own_head_green": true,
    "stall_minutes": 30,
    "stall_alert": {
      "tell": [
        "XMPPEngineer"
      ],
      "retell_minutes": 30
    }
  },
  "checks": {
    "context": "build-and-test",
    "poster": "Merger",
    "slots": 1,
    "memory_max": "8G",
    "step_timeout_minutes": 20,
    "steps": [
      {
        "name": "test",
        "run": [
          "env",
          "-u",
          "GH_TOKEN",
          "make",
          "test"
        ]
      }
    ]
  },
  "relay": {
    "url": "http://127.0.0.1:8788"
  },
  "labels": {
    "urgent": "urgent",
    "bug": "bug"
  },
  "router": {
    "idle_offer": {
      "idle_minutes": 3,
      "shell_minutes": 5,
      "retell_minutes": 30
    },
    "merge_notice": {
      "window_minutes": 30
    },
    "stuck": {
      "retarget": true,
      "self_blocked": true,
      "draft_hours": 2
    },
    "red_first": {
      "fallback_hours": 2
    },
    "issue_blocked_by": "agents",
    "quiet_labels": [
      "Status:waiting-backlog"
    ],
    "owners": {
      "triage": "XMPPEngineer"
    }
  },
  "machinery": {
    "Merger": {
      "app_id": 5111152,
      "installation_id": 165866872,
      "slug": "xmppengineeramonagent",
      "key": "XMPPEngineer.pem"
    }
  }
}
